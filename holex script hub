local function ripple(btn)
        local m = UIS:GetMouseLocation()
        local sc = userScale.Scale * openScale.Scale
        local x = (m.X - btn.AbsolutePosition.X) / sc
        local y = (m.Y - btn.AbsolutePosition.Y) / sc
        local r = make("Frame", {Size = UDim2.fromOffset(0, 0), Position = UDim2.fromOffset(x, y), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = Theme.text, BackgroundTransparency = 0.75, BorderSizePixel = 0, ZIndex = 5}, btn)
