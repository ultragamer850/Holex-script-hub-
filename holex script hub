function UI.rebuildConfig()
        if not HX.m then return end
        UI.closeDropdown()
        for _, info in ipairs(UI.cfgCards) do pcall(function() info.frame:Destroy() end) end
        for _, page in pairs(UI.pages) do
                local keep = {}
                for _, c in ipairs(page.cards) do
                        if not c.cfg then keep[#keep + 1] = c end
                end
                page.cards = keep
        end
        UI.cfgCards = {}
        UI.byLabel = {}
        UI.curBody = nil
        UI.building = true
        local ok, err = pcall(HX.m.Config, UI.window)
        UI.building = false
        UI.curBody = nil
        if not ok then HX.warn("[Holex] Config build error: " .. tostring(err)) end
        UI.refreshMirrors()
        local more = UI.pages["Collision"]
        if more and more.nav then more.nav.btn.Visible = #more.cards > 0 end
        if UI.searchBox then UI.applySearch(UI.searchBox.Text) end
end

-- sidebar status + home tiles (cheap, 1.5 s)
