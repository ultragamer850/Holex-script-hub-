                                logCard.Size = UDim2.new(0.64, -8, 0, 236)
                                return holder
                        end
                        local url = Boot.MEDIA_URL
                        local ext, file
                        local path
                        local have = false
                        if type(url) == "string" and url ~= "" then
                                ext = (url:match("%.(%w+)[%?#]?[^/]*$") or ""):lower()
