        function X.weaponBreakWelds(handle)
                if not handle then return end
                pcall(function()
                        for _, d in ipairs(handle:GetDescendants()) do
                                if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("AccessoryWeld") then
                                        d:Destroy()
                                end
                        end
                        for _, d in ipairs(handle:GetChildren()) do
                                if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("AccessoryWeld") then
                                        d:Destroy()
                                end
                        end
                        -- also break welds on accessory parent
                        local acc = handle.Parent
                        if acc and acc:IsA("Accessory") then
                                for _, d in ipairs(acc:GetDescendants()) do
                                        if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("AccessoryWeld") then
                                                d:Destroy()
                                        end
                                end
                        end
                end)
        end

        function X.weaponEnsureOverride(held, groupName)
                if not held or not held.Handle then return end
                -- Genesis / Melon: never steal hat CFrames into HatCFrameOverride
                if HX.hatSafeMode and HX.hatSafeMode() then return end
                local hr = X.getHatReanimator and X.getHatReanimator() or nil
                if not hr then return end
                pcall(function()
                        hr.HatCFrameOverride = hr.HatCFrameOverride or {}
                        if held.Override and held.Override._weapon then
                                held.Override.CFrame = held.TargetCF or held.Override.CFrame
                                return
                        end
                        -- remove old entries for this handle
                        for i = #hr.HatCFrameOverride, 1, -1 do
                                local e = hr.HatCFrameOverride[i]
                                if e and e._weapon and e.Handle == held.Handle then
                                        table.remove(hr.HatCFrameOverride, i)
                                end
                        end
                        local entry = {
                                Group = groupName or "Weapon",
                                CFrame = held.TargetCF or CFrame.identity,
                                Name = held.Name or X.hatAccessoryName(held.Handle) or "Weapon",
                                Handle = held.Handle,
                                _weapon = true,
                        }
                        held.Override = entry
                        table.insert(hr.HatCFrameOverride, entry)
                end)
        end

        function X.weaponEnsureStep()
                if X.weaponStepConn then return end
                local function hardLock()
                        if X.PanEquipped and m.PanForceHold ~= false and X.PanHeld then
                                local hd = X.PanHeld
                                local cf = hd.TargetCF
                                local p = hd.Handle
                                if cf and p and p.Parent then
                                        pcall(function()
                                                p.CFrame = cf
                                                if hd.Override then hd.Override.CFrame = cf end
                                        end)
                                end
                        end
                        if X.RpgEquipped and m.RpgForceHold ~= false and X.RpgHeld then
                                local hd = X.RpgHeld
                                local cf = hd.TargetCF
                                local p = hd.Handle
                                if cf and p and p.Parent then
                                        pcall(function()
                                                p.CFrame = cf
                                                if hd.Override then hd.Override.CFrame = cf end
                                        end)
                                end
                        end
                end
                X.weaponStepConn = RunService.Stepped:Connect(hardLock)
                X.weaponHbConn = RunService.Heartbeat:Connect(hardLock)
        end

        function X.panPark()
                if HX.hatSafeMode and HX.hatSafeMode() then return end
                if m.PanUnderground == false then return end
                local held = X.PanHeld
                if not (held and held.Handle and held.Handle.Parent) then return end
                local root = X.getMyHRP()
                if not root then return end
                local d = math.abs(tonumber(m.PanDepth) or 20)
                local cf = CFrame.new(root.Position + Vector3.new(0, -d, 0))
                held.TargetCF = cf
                X.weaponEnsureOverride(held, "Weapon")
                if held.Override then held.Override.CFrame = cf end
                X.peDriveHandle(held, cf)
                pcall(function() held.Handle.CFrame = cf end)
        end

        function X.rpgPark()
                if HX.hatSafeMode and HX.hatSafeMode() then return end
                if m.RpgUnderground == false then return end
                local held = X.RpgHeld
                if not (held and held.Handle and held.Handle.Parent) then return end
                local root = X.getMyHRP()
                if not root then return end
                local d = math.abs(tonumber(m.RpgDepth) or 22)
                local cf = CFrame.new(root.Position + Vector3.new(1.5, -d, 0))
                held.TargetCF = cf
                X.weaponEnsureOverride(held, "Weapon")
                if held.Override then held.Override.CFrame = cf end
                X.peDriveHandle(held, cf)
                pcall(function() held.Handle.CFrame = cf end)
        end

        function X.panTakeHat()
                local lab = X.cleanHatLabel(m.PanHat)
                if lab == "" then
                        warn("[HatCollision] Set a Frying Pan hat first")
                        return nil
                end
                X.HandleCacheT = 0
                local h = X.findHandleByLabel(lab)
                if not h then
                        warn("[HatCollision] Pan hat not found: " .. lab)
                        return nil
                end
                X.weaponBreakWelds(h)
                local oldForce = m.PowerUpEffectForceTake
                m.PowerUpEffectForceTake = true
                local held = X.peAttachFE(h, "pan") or { Handle = h, Kind = "pan" }
                m.PowerUpEffectForceTake = oldForce
                held.Name = lab
                X.PanHeld = held
                X.weaponEnsureOverride(held, "Weapon")
                X.weaponEnsureStep()
                X.weaponBreakWelds(h)
                return held
        end

        function X.rpgTakeHat()
                local lab = X.cleanHatLabel(m.RpgHat)
                if lab == "" then
                        warn("[HatCollision] Set an RPG hat first")
                        return nil
                end
                X.HandleCacheT = 0
                local h = X.findHandleByLabel(lab)
                if not h then
                        warn("[HatCollision] RPG hat not found: " .. lab)
                        return nil
                end
                X.weaponBreakWelds(h)
                local oldForce = m.PowerUpEffectForceTake
                m.PowerUpEffectForceTake = true
                local held = X.peAttachFE(h, "rpg") or { Handle = h, Kind = "rpg" }
                m.PowerUpEffectForceTake = oldForce
                held.Name = lab
                X.RpgHeld = held
                X.weaponEnsureOverride(held, "Weapon")
                X.weaponEnsureStep()
                X.weaponBreakWelds(h)
                return held
        end

        -- longest local axis of a hat handle (so a weapon can be aimed no matter how its accessory mesh is oriented)
        function X.weaponLongAxis(handle, flip)
                local sz = handle.Size
                local ax, len = Vector3.new(0, 1, 0), sz.Y
                if sz.X >= sz.Y and sz.X >= sz.Z then
                        ax, len = Vector3.new(1, 0, 0), sz.X
                elseif sz.Z >= sz.X and sz.Z >= sz.Y then
                        ax, len = Vector3.new(0, 0, 1), sz.Z
                end
                if flip then ax = -ax end
                return ax, len
        end

        -- rotation that points the handle's long axis along `dir` (right = fixed side axis, perpendicular to dir)
        function X.weaponAimRot(handle, dir, right, flip)
                local ax, len = X.weaponLongAxis(handle, flip)
                local up = right:Cross(dir)
                local base = CFrame.fromMatrix(Vector3.zero, right, up, -dir) -- LookVector = dir
                local rot
                if ax.Z < -0.5 then rot = CFrame.identity
                elseif ax.Z > 0.5 then rot = CFrame.Angles(0, math.pi, 0)
                elseif ax.Y > 0.5 then rot = CFrame.Angles(-math.pi / 2, 0, 0)
                elseif ax.Y < -0.5 then rot = CFrame.Angles(math.pi / 2, 0, 0)
                elseif ax.X > 0.5 then rot = CFrame.Angles(0, math.pi / 2, 0)
                else rot = CFrame.Angles(0, -math.pi / 2, 0) end
                return base * rot, len
        end

        -- world point inside the end of the right hand (follows whatever pose the arm is in)
        function X.weaponGripPoint(fig, root)
                local ra = fig and (fig:FindFirstChild("Right Arm") or fig:FindFirstChild("RightHand"))
                if ra and ra:IsA("BasePart") then
                        return (ra.CFrame * CFrame.new(0, -ra.Size.Y * 0.5 + 0.2, 0)).Position
                end
                return (root.CFrame * CFrame.new(1.5, -0.3, -0.2)).Position
        end

        function X.panDriveInHand(now)
                local held = X.PanHeld
                if not held or not (held.Handle and held.Handle.Parent) then
                        held = X.panTakeHat()
                        if not held then return end
                end
                local fig = X.getMyCharacter()
                local root = fig and X.getRoot(fig)
                if not root then return end
                X.weaponBreakWelds(held.Handle)
                local hy = tonumber(m.PanPlaceHeight) or 0
                local hs = tonumber(m.PanPlaceSide) or 0
                local hf = tonumber(m.PanPlaceForward) or 0
                local swing = 0
                if X.PanPhase == "slam" then
                        local t = (now - (X.PanT0 or now)) / math.max(tonumber(m.PanSlamTime) or 0.22, 0.05)
                        swing = math.rad(-120 + 160 * math.clamp(t, 0, 1))
                elseif X.PanPhase == "lift" then
                        swing = math.rad(-40)
                end
                local cf
                if m.PanAutoAlign ~= false then
                        local rcf = root.CFrame
                        local right = rcf.RightVector
                        -- pan extends away from the fist, pitched about the body's side axis (raised when idle, overhead on lift, down on slam)
                        local pitch = math.rad(tonumber(m.PanIdlePitch) or 15) - swing
                        local aim = CFrame.fromAxisAngle(right, pitch):VectorToWorldSpace(rcf.LookVector)
                        local rot, len = X.weaponAimRot(held.Handle, aim, right, m.PanFlip == true)
                        local grip = X.weaponGripPoint(fig, root)
                        local center = grip + aim * math.max(len * 0.5 - 0.6, 0)
                                + right * hs + rcf.UpVector * hy + rcf.LookVector * hf
                        local tw = CFrame.Angles(math.rad(tonumber(m.PanTweakX) or 0), math.rad(tonumber(m.PanTweakY) or 0), math.rad(tonumber(m.PanTweakZ) or 0))
                        cf = CFrame.new(center) * rot * tw
                else
                        -- manual mode (old behaviour)
                        local hand = nil
                        pcall(function()
                                local ra = fig:FindFirstChild("Right Arm") or fig:FindFirstChild("RightHand")
                                if ra then hand = ra.CFrame * CFrame.new(0, -1.1, 0) end
                        end)
                        if not hand then hand = root.CFrame * CFrame.new(1.4, 0.2, -0.8) end
                        hand = hand * CFrame.new(hs, hy, -hf)
                        local rx = math.rad(tonumber(m.PanRotX) or 0)
                        local ry = math.rad(tonumber(m.PanRotY) or 90)
                        local rz = math.rad(tonumber(m.PanRotZ) or 0)
                        cf = hand * CFrame.Angles(swing + rx, ry, rz)
                end
                held.TargetCF = cf
                X.weaponEnsureOverride(held, "Weapon")
                if held.Override then held.Override.CFrame = cf end
                X.peDriveHandle(held, cf)
                pcall(function()
                        local p = held.Handle
                        p.Anchored = false
                        p.CanCollide = false
                        p.CFrame = cf
                        p.AssemblyLinearVelocity = Vector3.zero
                        p.AssemblyAngularVelocity = Vector3.zero
                end)
        end

        function X.rpgDriveInHand(now)
                local held = X.RpgHeld
                if not held or not (held.Handle and held.Handle.Parent) then
                        held = X.rpgTakeHat()
                        if not held then return end
                end
                local fig = X.getMyCharacter()
                local root = fig and X.getRoot(fig)
                if not root then return end
                X.weaponBreakWelds(held.Handle)
                local hy = tonumber(m.RpgPlaceHeight) or 0
                local hs = tonumber(m.RpgPlaceSide) or 0
                local hf = tonumber(m.RpgPlaceForward) or 0
                local cf
                if m.RpgAutoAlign ~= false then
                        local rcf = root.CFrame
                        local aim = rcf.LookVector
                        if m.RpgAimCamera ~= false then
                                local cam = Workspace.CurrentCamera
                                if cam then aim = cam.CFrame.LookVector end
                        end
                        -- keep the tube out of vertical so the side axis stays valid
                        aim = Vector3.new(aim.X, math.clamp(aim.Y, -0.85, 0.85), aim.Z).Unit
                        local right = aim:Cross(Vector3.yAxis).Unit
                        local rot, len = X.weaponAimRot(held.Handle, aim, right, m.RpgFlip == true)
                        -- resting on the right shoulder: sits above the arm, tube pushed forward so the back end sticks out behind
                        local shoulder = (rcf * CFrame.new(1.4, 1.5, 0)).Position
                        local center = shoulder + aim * (len * 0.25)
                                + rcf.RightVector * hs + rcf.UpVector * hy + rcf.LookVector * hf
                        local tw = CFrame.Angles(math.rad(tonumber(m.RpgTweakX) or 0), math.rad(tonumber(m.RpgTweakY) or 0), math.rad(tonumber(m.RpgTweakZ) or 0))
                        cf = CFrame.new(center) * rot * tw
                else
                        -- manual mode (old behaviour)
                        local rx = math.rad(tonumber(m.RpgRotX) or 0)
                        local ry = math.rad(tonumber(m.RpgRotY) or 180)
                        local rz = math.rad(tonumber(m.RpgRotZ) or 0)
                        cf = root.CFrame * CFrame.new(0.8 + hs, 0.4 + hy, -1.6 - hf) * CFrame.Angles(rx, ry, rz)
                end
                held.TargetCF = cf
                X.weaponEnsureOverride(held, "Weapon")
                if held.Override then held.Override.CFrame = cf end
                X.peDriveHandle(held, cf)
                pcall(function()
                        local p = held.Handle
                        p.Anchored = false
                        p.CanCollide = false
                        p.CFrame = cf
                        p.AssemblyLinearVelocity = Vector3.zero
                        p.AssemblyAngularVelocity = Vector3.zero
                end)
        end

