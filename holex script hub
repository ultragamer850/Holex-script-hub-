        do
                local HEAD, BODY = 28, 84
                local open = V.get("friendsOpen", false)
                local function fullH() return open and (HEAD + BODY) or HEAD end
                local fw = make("Frame", {AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 10, 1, -56), Size = UDim2.new(1, -20, 0, fullH()), BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 6}, side)
                bind(fw, "BackgroundColor3", "card"); corner(fw, 9); stroke(fw)
                local function layout()
                        tw(fw, 0.3, {Size = UDim2.new(1, -20, 0, fullH())})
                        X.tabScroll.Size = UDim2.new(1, 0, 1, -(56 + fullH() + 8))
                end
                X.tabScroll.Size = UDim2.new(1, 0, 1, -(56 + fullH() + 8))
                local head = make("TextButton", {Size = UDim2.new(1, 0, 0, HEAD), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 7}, fw)
                local title = make("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -90, 1, 0), Text = "FRIENDS", Font = Enum.Font.GothamBold, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = Theme.sub, ZIndex = 8}, head)
                local count = make("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(1, -78, 0, 0), Size = UDim2.fromOffset(56, HEAD), Text = "0 online", Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = Theme.sub, ZIndex = 8}, head)
                local arrow = make("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(1, -20, 0, 0), Size = UDim2.fromOffset(14, HEAD), Text = open and "v" or "^", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.sub, ZIndex = 8}, head)
                head.MouseButton1Click:Connect(function()
                        open = not open
                        V.set("friendsOpen", open)
                        arrow.Text = open and "v" or "^"
                        layout()
                end)
                local body = make("ScrollingFrame", {Position = UDim2.fromOffset(0, HEAD), Size = UDim2.new(1, 0, 0, BODY), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 7}, fw)
                make("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}, body)
                make("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 4)}, body)
                local GREEN = Color3.fromRGB(46, 226, 122)
                local function row(order, text, on, unread, cb)
                        local r = make("TextButton", {Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = Theme.hover, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = order, ZIndex = 8}, body)
                        corner(r, 6)
                        if on ~= nil then
                                local dot = make("Frame", {Size = UDim2.fromOffset(7, 7), Position = UDim2.new(0, 6, 0.5, -3), BackgroundColor3 = on and GREEN or Theme.sub, BorderSizePixel = 0, ZIndex = 9}, r)
                                circle(dot)
                        end
                        make("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(on ~= nil and 20 or 6, 0), Size = UDim2.new(1, -(on ~= nil and 44 or 12), 1, 0), Text = text, Font = on and Enum.Font.GothamMedium or Enum.Font.Gotham, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = on and Theme.text or Theme.sub, ZIndex = 9}, r)
                        if unread and unread > 0 then
                                local pill = make("Frame", {Size = UDim2.fromOffset(18, 16), Position = UDim2.new(1, -22, 0.5, -8), BackgroundColor3 = Theme.accent, BorderSizePixel = 0, ZIndex = 9}, r)
                                corner(pill, 8)
                                make("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = tostring(math.min(unread, 99)), Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = Theme.accentText, ZIndex = 10}, pill)
                        end
                        r.MouseEnter:Connect(function() tw(r, 0.15, {BackgroundTransparency = 0.5}) end)
                        r.MouseLeave:Connect(function() tw(r, 0.2, {BackgroundTransparency = 1}) end)
                        r.MouseButton1Click:Connect(cb)
                end
                local function refresh()
                        for _, c in ipairs(body:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
                        local names = {}
                        for n in pairs(N.friends()) do names[#names + 1] = n end
                        table.sort(names, function(a, b)
                                local ao, bo = N.isOnline(a), N.isOnline(b)
                                if ao ~= bo then return ao end
                                return lower(a) < lower(b)
                        end)
                        local onlineN = 0
                        for i, name in ipairs(names) do
                                local on = N.isOnline(name)
                                if on then onlineN = onlineN + 1 end
                                row(i, name, on and true or false, N.unread[lower(name)], function() N.openDM(name) end)
                        end
                        if #names == 0 then row(1, "No friends yet - tap to add", nil, nil, function() switch("Friends") end) end
                        count.Text = onlineN .. " online"
                        count.TextColor3 = onlineN > 0 and GREEN or Theme.sub
                        if Call.pending then title.Text = "CALL: " .. tostring(Call.pending.from); title.TextColor3 = Theme.accent
                        elseif Call.active then title.Text = "IN CALL: " .. tostring(Call.target); title.TextColor3 = Theme.accent
                        else title.Text = "FRIENDS"; title.TextColor3 = Theme.sub end
                        arrow.TextColor3 = Theme.sub
                end
                N.refreshWidget = refresh
                task.spawn(function() while not V.dead do pcall(refresh); task.wait(2.5) end end)
                head.MouseButton1Click:Connect(function() if Call.pending then switch("Friends") end end)
        end

        V.hooks[#V.hooks + 1] = function() Call.ringing(false) end
end
module()
