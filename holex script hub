function HX.resolveFigure()
        local mode = HX.Settings.Mode
        if HX.Settings.ClientFakeRig and HX.FakeRig and HX.FakeRig.Parent then
                return HX.FakeRig, "Client fake rig"
        end
        if mode == "Custom model name" and HX.Settings.CustomName ~= "" then
                local name = HX.Settings.CustomName
                local m = Workspace:FindFirstChild(name) or Workspace:FindFirstChild(name, true)
                if m and m:IsA("Model") and validFig(m) then return m, "Custom" end
        end

        local list = HX.findFakeRigs()
        local function pick(preferLabels)
                for _, e in ipairs(list) do
                        for _, pref in ipairs(preferLabels) do
                                if string.find(e.label, pref, 1, true) then
                                        return e.model, e.label
                                end
                        end
                end
                return nil
        end

        if mode == "Uhhhhhh" then
                local f, s = pick({"Uhhhhhh"})
                if f then return f, s end
        elseif mode == "FE Genesis" then
                local f, s = pick({"Genesis", "Camera subject", "FDless", "Patchma"})
                if f then return f, s end
        elseif mode == "Melon Scripter" then
                local f, s = pick({"Melon", "non", "Camera subject"})
                if f then return f, s end
        elseif mode == "Camera subject (fake rig)" then
                local c = cameraFigure()
                if c then return c, "Camera subject" end
        elseif mode == "Other reanimate (character)" then
                local f, s = pick({"Other", "Workspace", "Clone"})
                if f then return f, s end
        end

        -- Auto: best score
        if #list > 0 then
                return list[1].model, list[1].label
        end
        return LocalPlayer.Character, "Character"
end

