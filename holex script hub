        function X.scanWorldNPCs(maxN)
                maxN = math.clamp(math.floor(tonumber(maxN) or 80), 5, 200)
                local out, seen = {}, {}
                local function consider(model)
                        if not model or seen[model] then return end
                        if not X.isNPC(model) then return end
                        seen[model] = true
                        out[#out + 1] = model
                end
                -- selected first
                for _, e in ipairs(NPCList) do
                        if e and e.model then consider(e.model) end
                end
                if m.NPCConsoleShowWorld == false then return out end

                local myPos = nil
                local hrp = X.getMyHRP()
                if hrp then myPos = hrp.Position end
                local scored = {}

                local function scoreModel(inst)
                        if not inst or seen[inst] then return end
                        if not X.isNPC(inst) then return end
                        local root = X.getRoot(inst)
                        local d = 1e9
                        if myPos and root then d = (root.Position - myPos).Magnitude end
                        -- prioritise name hints slightly
                        if X.nameLooksLikeNPC(inst.Name) then d = d * 0.85 end
                        scored[#scored + 1] = { m = inst, d = d }
                end

                local function scanContainer(container, depth)
                        if not container or depth > 3 then return end
                        for _, inst in ipairs(container:GetChildren()) do
                                if inst:IsA("Model") then
                                        scoreModel(inst)
                                        -- nested character models
                                        if depth < 2 then
                                                for _, child in ipairs(inst:GetChildren()) do
                                                        if child:IsA("Model") then scoreModel(child) end
                                                end
                                        end
                                elseif inst:IsA("Folder") or inst:IsA("Configuration") then
                                        scanContainer(inst, depth + 1)
                                end
                        end
                end

                -- 1) known dummy/NPC folders by name
                for _, fname in ipairs(X.NPC_FOLDER_NAMES) do
                        local folder = Workspace:FindFirstChild(fname)
                        if folder then scanContainer(folder, 0) end
                end

                -- 2) CollectionService tags (many games tag NPCs)
                pcall(function()
                        local CS = game:GetService("CollectionService")
                        for _, tag in ipairs(X.NPC_TAG_NAMES) do
                                for _, inst in ipairs(CS:GetTagged(tag)) do
                                        if inst:IsA("Model") then scoreModel(inst)
                                        elseif inst:IsA("BasePart") and inst.Parent and inst.Parent:IsA("Model") then
                                                scoreModel(inst.Parent)
                                        end
                                end
                        end
                end)

                -- 3) full workspace shallow + one folder depth
                scanContainer(Workspace, 0)

                -- 4) descendants near player (radius catch-all for odd hierarchies)
                if myPos then
                        pcall(function()
                                local op = OverlapParams.new()
                                op.FilterType = Enum.RaycastFilterType.Exclude
                                local exclude = {}
                                if LocalPlayer.Character then exclude[#exclude + 1] = LocalPlayer.Character end
                                local fig = X.getMyCharacter and X.getMyCharacter()
                                if fig then exclude[#exclude + 1] = fig end
                                op.FilterDescendantsInstances = exclude
                                op.MaxParts = 120
                                local parts = Workspace:GetPartBoundsInRadius(myPos, 220, op)
                                for _, p in ipairs(parts or {}) do
                                        local model = p:FindFirstAncestorOfClass("Model")
                                        if model then scoreModel(model) end
                                end
                        end)
                end

                table.sort(scored, function(a, b) return a.d < b.d end)
                for _, s in ipairs(scored) do
                        if #out >= maxN then break end
                        consider(s.m)
                end
                return out
        end

        function X.getLockInfo(hum)
                if not hum then return nil end
                local L = X.HealthLocks and X.HealthLocks[hum]
                if not L then return nil end
                local left = (L.untilT or 0) - os.clock()
                if left <= 0 and (tonumber(m.CombatLockSeconds) or 600) > 0 then return nil end
                return {
                        hp = L.hp,
                        left = left,
                        forever = (tonumber(m.CombatLockSeconds) or 600) <= 0,
                        holding = hum.Health <= (L.hp or 0) + 0.5,
                }
        end

        function X.describeNPC(model)
                if not model or not model.Parent then return nil end
                local hum = model:FindFirstChildOfClass("Humanoid")
                local root = X.getRoot(model)
                local hp = hum and math.floor((hum.Health or 0) + 0.5) or 0
                local maxHp = hum and math.floor((hum.MaxHealth or 0) + 0.5) or 0
                local owned = root and X.partOwner(root) or false
                local selected = NPCSet[model] ~= nil
                local primary = X.PrimaryNPC == model
                local lock = X.getLockInfo(hum)
                local dmg = X.NPCDamageLog[model]
                local rideHat = "-"
                if selected and m.NPCHatRide then
                        -- find index among selected
                        local idx = 1
                        for i, e in ipairs(NPCList) do
                                if e.model == model then idx = i break end
                        end
                        local h = X.getRideHatForIndex(idx, #NPCList)
                        if h then rideHat = X.hatAccessoryName(h) end
                end
                local lockStr = "no lock"
                if lock then
                        if lock.forever then
                                lockStr = string.format("LOCK@%d forever %s", math.floor(lock.hp + 0.5), lock.holding and "HOLDING" or "BROKEN")
                        else
                                lockStr = string.format("LOCK@%d %.0fs %s", math.floor(lock.hp + 0.5), math.max(0, lock.left), lock.holding and "HOLDING" or "BROKEN")
                        end
                end
                local dmgStr = ""
                if dmg and (dmg.total or 0) > 0 then
                        dmgStr = string.format(" dmgTot=%.0f last=%.0f", dmg.total or 0, dmg.lastDmg or 0)
                end
                local flags = {}
                if selected then flags[#flags + 1] = "SEL" end
                if primary then flags[#flags + 1] = "PRI" end
                if owned then flags[#flags + 1] = "OWN" else flags[#flags + 1] = "no-own" end
                if m.NPCHatRide and selected then flags[#flags + 1] = "RIDE:" .. rideHat end
                return {
                        model = model,
                        name = model.Name,
                        hp = hp,
                        maxHp = maxHp,
                        owned = owned,
                        selected = selected,
                        primary = primary,
                        lock = lock,
                        lockStr = lockStr,
                        dmgStr = dmgStr,
                        rideHat = rideHat,
                        flags = table.concat(flags, " "),
                        line = string.format("%s  HP %d/%d  [%s]  %s%s",
                                model.Name, hp, maxHp, table.concat(flags, " "), lockStr, dmgStr),
                }
        end

        function X.buildConsoleText()
                local lines = {}
                lines[#lines + 1] = string.format("=== NPC/DUMMY CONSOLE ===  selected %d/%d  solid=%s  hatDmg=%s  lock=%s",
                        #NPCList, X.maxFollowCount(),
                        m.HatsSolid and "ON" or "off",
                        m.HatDamageEnabled and "ON" or "off",
                        (m.CombatLockHealth ~= false) and "ON" or "off")
                local folderHits = 0
                for _, fname in ipairs(X.NPC_FOLDER_NAMES or {}) do
                        if Workspace:FindFirstChild(fname) then folderHits = folderHits + 1 end
                end
                local tagHits = 0
                pcall(function()
                        local CS = game:GetService("CollectionService")
                        for _, tag in ipairs(X.NPC_TAG_NAMES or {}) do
                                tagHits = tagHits + #CS:GetTagged(tag)
                        end
                end)
                lines[#lines + 1] = string.format("detect: folders=%d  tags=%d  worldScan=%s", folderHits, tagHits, m.NPCConsoleShowWorld ~= false and "ON" or "off")
                local rideN = 0
                for _ in pairs(X.HatRideTargetSet or {}) do rideN = rideN + 1 end
                lines[#lines + 1] = string.format("rideHats=%d  distribute=%s  lockSec=%s",
                        rideN,
                        m.NPCHatRideDistribute ~= false and "yes" or "no",
                        (tonumber(m.CombatLockSeconds) or 600) <= 0 and "forever" or tostring(math.floor(m.CombatLockSeconds or 600)))
                lines[#lines + 1] = "---"
                local models = X.scanWorldNPCs(m.NPCConsoleMaxRows or 40)
                local locked, holding, broken = 0, 0, 0
                for _, model in ipairs(models) do
                        local d = X.describeNPC(model)
                        if d then
                                lines[#lines + 1] = d.line
                                if d.lock then
                                        locked = locked + 1
                                        if d.lock.holding then holding = holding + 1 else broken = broken + 1 end
                                end
                        end
                end
                if #models == 0 then
                        lines[#lines + 1] = "(no NPCs/dummies found nearby — select or spawn some)"
                end
                lines[#lines + 1] = "---"
                lines[#lines + 1] = string.format("locks: %d  holding after attacks: %d  broken: %d", locked, holding, broken)
                lines[#lines + 1] = "HOLDING = your damage stayed  |  BROKEN = something raised HP above lock"
                X.NPCConsoleLines = lines
                return table.concat(lines, "\n")
        end

        function X.refreshNPCConsoleUI()
