                                        img.ImageRectOffset = Vector2.new((i % 8) * 128, (i // 8) * 68)
                                end
                                return true
                        end
                        if ext == "webm" or ext == "mp4" or ext == "ogv" then
                                local vf = make("VideoFrame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Video = asset, Looped = true, Playing = true, Volume = 0}, holder)
                                local t0 = os.clock()
                                while not vf.IsLoaded and os.clock() - t0 < 3 do task.wait(0.1) end
                                if vf.IsLoaded then
                                        log("OK    media loaded (" .. file .. ")", "ok")
                                elseif useSheet() then
                                        vf:Destroy()
                                        log("OK    video unsupported here - using the spritesheet", "ok")
                                else
                                        log("WARN  video did not load (add boot_sheet.png as fallback)", "warn")
                                end
                        else
                                make("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = asset, ScaleType = Enum.ScaleType.Crop}, holder)
                                log("OK    media loaded (" .. file .. ")", "ok")
                        end
                end}

                tasks[#tasks + 1] = {"Preloading sounds", function(sub)
                        for i, s in ipairs(Boot.SOUNDS) do
                                local snd = Instance.new("Sound")
                                snd.SoundId = s[2]
                                local done = false
                                task.spawn(function() pcall(function() CP:PreloadAsync({snd}) end); done = true end)
                                local t0 = os.clock()
                                while not done and os.clock() - t0 < 4 do task.wait(0.05) end
                                local ok = false
                                pcall(function() ok = snd.IsLoaded or snd.TimeLength > 0 end)
                                log((ok and "OK    " or "SLOW  ") .. s[1], ok and "ok" or "warn")
                                snd:Destroy()
                                sub(i / #Boot.SOUNDS)
                        end
                end}

                tasks[#tasks + 1] = {"Applying saved settings", function()
                        local n = 0
                        for _ in pairs(Persist.data) do n += 1 end
                        log(hasFileApi and ("OK    " .. n .. " saved values found") or "MISS  no save file support", hasFileApi and "ok" or "warn")
                        task.wait(fast and 0 or 0.2)
                end}

                for i, t in ipairs(tasks) do
                        status.Text = t[1] .. "..."
                        local base = (i - 1) / #tasks
                        local ok, err = pcall(t[2], function(f) target = base + math.clamp(f, 0, 1) / #tasks end)
                        if not ok then log("FAIL  " .. t[1] .. ": " .. tostring(err), "bad") end
                        target = i / #tasks
                        if not fast then task.wait(0.15) end
                end
                status.Text = "Ready"
                local w0 = os.clock()
                while shown < 0.995 and os.clock() - w0 < 2 do task.wait(0.05) end
                log("Loaded. Opening the hub.", "ok")
                task.wait(fast and 0.1 or 0.6)
                finish()
                return true
        end
