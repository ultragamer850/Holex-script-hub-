function UI.select(name)
        local page = UI.pages[name]
        local sf = UI.hostScroll
        if not page or not sf or not page.header then return end
        UI.closeDropdown()
        UI.current = name
        local sc = math.max(HOST.getScale(), 0.05)
        local y = (page.header.AbsolutePosition.Y - sf.AbsolutePosition.Y) / sc + sf.CanvasPosition.Y - 6
        tween(sf, 0.45, { CanvasPosition = Vector2.new(0, math.max(y, 0)) }, Enum.EasingStyle.Quint)
        if page.onShow then pcall(page.onShow) end
end

function UI.applySearch(q)
        q = string.lower(q or "")
        for _, page in pairs(UI.pages) do
                local anyVisible = false
                for _, card in ipairs(page.cards) do
                        if card.rows and #card.rows > 0 then
                                local any = (q == "")
                                for _, r in ipairs(card.rows) do
                                        local vis = (q == "") or string.find(r.text, q, 1, true) ~= nil or string.find(string.lower(card.title or ""), q, 1, true) ~= nil
                                        r.row.Visible = vis
                                        if vis then any = true end
                                end
                                card.frame.Visible = any
                        end
                        if card.frame.Visible then anyVisible = true end
                end
                if page.header then page.header.Visible = (q == "") or anyVisible end
                if page.scroll then page.scroll.Visible = (q == "") or anyVisible end
        end
end

