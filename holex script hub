                tw(main, 0.3, {GroupTransparency = 1}).Completed:Connect(function() if not visible then main.Visible = false end end)
        end
end

closeBtn.MouseButton1Click:Connect(function() setVisible(false) end)
minBtn.MouseButton1Click:Connect(function() setVisible(false) end)
conns[#conns + 1] = UIS.InputBegan:Connect(function(i, gp)
