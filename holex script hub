                bind(box, "BackgroundColor3", "hover"); bind(box, "TextColor3", "text"); bind(box, "PlaceholderColor3", "sub")
                corner(box, 8); pad(box, 8, 0, 8, 0)

                local sf = make("ScrollingFrame", {Size = UDim2.new(1, -20, 1, -60), Position = UDim2.fromOffset(10, 50), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, row)
                bind(sf, "ScrollBarImageColor3", "sub")
                make("UIGridLayout", {CellSize = UDim2.new(0.5, -4, 0, 36), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder}, sf)
                pad(sf, 0, 2, 6, 2)

                local cells, sel = {}, saved
                local function mark(which)
                        if which then sel = which end
                        for n, c in pairs(cells) do
                                local on = n == sel
                                c.st.Thickness = on and 2 or 1
                                c.st.Color = on and Theme.accent or Theme.stroke
                                c.tick.Visible = on
                                c.dot.BackgroundColor3 = on and Theme.accent or Theme.sub
                        end
                end
                X.langGalleryMark = mark

                local function choose(n)
                        if n == sel then return end
                        sel = n
                        mark()
                        V.applyLanguage(n, {restart = true})
                end

                local order = 0
                for _, n in ipairs(langs) do
                        order += 1
                        local b = make("TextButton", {Text = "", AutoButtonColor = false, BorderSizePixel = 0, LayoutOrder = order}, sf)
                        bind(b, "BackgroundColor3", "hover")
                        corner(b, 8)
                        local st = stroke(b, "stroke", 1)
                        local dot = make("Frame", {Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(12, 13), BorderSizePixel = 0}, b)
                        circle(dot)
                        bind(dot, "BackgroundColor3", "sub")
                        local lbl = label(b, n, 13, "text", Enum.Font.GothamMedium, {Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -48, 1, 0)})
                        local tick = make("Frame", {Size = UDim2.fromOffset(8, 8), Position = UDim2.new(1, -18, 0.5, -4), BorderSizePixel = 0, Visible = false}, b)
                        circle(tick)
                        bind(tick, "BackgroundColor3", "accent")
                        cells[n] = {btn = b, st = st, tick = tick, dot = dot, name = n}
                        b.MouseEnter:Connect(function() if n ~= sel then tw(b, 0.15, {BackgroundColor3 = Theme.card}) end end)
                        b.MouseLeave:Connect(function() if n ~= sel then tw(b, 0.2, {BackgroundColor3 = Theme.hover}) end end)
                        b.MouseButton1Click:Connect(function() choose(n) end)
                end
                mark(saved)

                local function filter(q)
                        q = string.lower(tostring(q or ""))
                        local shown = 0
                        for n, c in pairs(cells) do
                                local ok = (q == "") or string.find(string.lower(n), q, 1, true)
                                c.btn.Visible = ok and true or false
                                if ok then shown += 1 end
                        end
                        countLbl.Text = shown .. " / " .. #langs .. " languages  -  pick one to translate & restart"
                end
                box:GetPropertyChangedSignal("Text"):Connect(function() filter(box.Text) end)

                return row
        end

