        local trI, lastMouse = 1, Vector2.new(-999, -999)

        --------------------------------------------------------------
        -- one-shot effects
        --------------------------------------------------------------
        local function burst(pal)
                local cx, cy = rnd(0.15, 0.85), rnd(0.12, 0.5)
                local col = pal[math.random(1, #pal)]
                for i = 1, 16 do
                        local a = i / 16 * 6.2832 + rnd(-0.1, 0.1)
                        local r = rnd(36, 80)
                        local d = make("Frame", {Size = UDim2.fromOffset(4, 4), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(cx, cy), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 3, Active = false}, over)
                        make("UICorner", {CornerRadius = UDim.new(1, 0)}, d)
                        tw(d, 0.95, {Position = UDim2.new(cx, math.cos(a) * r, cy, math.sin(a) * r + 20), BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1)}, Enum.EasingStyle.Quad)
                        task.delay(1, function() d:Destroy() end)
                end
        end

        local function shoot(pal)
                local x0, y0 = rnd(0.5, 1), rnd(0.03, 0.4)
                local s = make("Frame", {Size = UDim2.fromOffset(90, 2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(x0, 0, y0, 0), Rotation = -25, BackgroundColor3 = pal[math.random(1, #pal)]:Lerp(W, 0.5), BorderSizePixel = 0, ZIndex = 3, Active = false}, over)
                make("UIGradient", {Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)})}, s)
                tw(s, 0.9, {Position = UDim2.new(x0, -300, y0, 140)}, Enum.EasingStyle.Quad)
                task.delay(0.95, function() s:Destroy() end)
        end

        local function lightning()
                task.spawn(function()
                        flashF.BackgroundTransparency = 0.78
                        tw(flashF, 0.14, {BackgroundTransparency = 1})
                        task.wait(0.2)
                        flashF.BackgroundTransparency = 0.68
                        tw(flashF, 0.4, {BackgroundTransparency = 1})
                end)
        end

        local function glitch()
                task.spawn(function()
                        for _ = 1, 4 do
                                titleLbl.Position = titleBase + UDim2.fromOffset(math.random(-4, 4), math.random(-1, 1))
                                task.wait(0.04)
                        end
                        titleLbl.Position = titleBase
                end)
        end

        --------------------------------------------------------------
        -- apply / refresh
        --------------------------------------------------------------
        function FXE.refresh()
                local cfg = FXE.cfg
                local on = cfg ~= nil and S.fx == true
                build()
                pLayer.Visible = S.particles and not on
                lightsF.Visible = on and cfg.lights == true
                treeF.Visible = on and cfg.tree == true
                pileF.Visible = on and cfg.pile == true
                edgeF.Visible = on
                scanF.Visible = on and cfg.scan == true
                buildRing(on and cfg or nil)
                if on then
                        local pal = cfg.pal
                        local light = cfg.light
                        edgeGrad.Color = palSeq(pal)
                        titleGrad.Color = palSeq(pal, not light and 0.45 or nil)
                        for i, b in ipairs(bulbs) do
                                local c = pal[(i - 1) % #pal + 1]
                                b.f.BackgroundColor3 = c; b.s.Color = c
                        end
                        local tp = cfg.treePal or pal
                        for i, tl in ipairs(treeLights) do
                                local c = tp[(i - 1) % #tp + 1]
                                tl.f.BackgroundColor3 = c; tl.s.Color = c
                        end
                        for _, g in ipairs(tabGrads) do g.Color = palSeq(pal, not light and 0.4 or nil); g.Enabled = true end
                        for i, d in ipairs(tabDots) do d.f.Visible = true end
                        for i, r in ipairs(ribbons) do
                                r.f.Visible = cfg.rib == true
                                r.g.Color = ColorSequence.new(pal[(i - 1) % #pal + 1], pal[i % #pal + 1])
                        end
                        scanG.Color = ColorSequence.new(pal[1], pal[#pal > 1 and 2 or 1])
                        scanF.BackgroundColor3 = W
                else
                        titleGrad.Color = ColorSequence.new(W)
                        for _, g in ipairs(tabGrads) do g.Enabled = false end
                        for _, d in ipairs(tabDots) do d.f.Visible = false end
                        for _, r in ipairs(ribbons) do r.f.Visible = false end
                        tw(indicator, 0.4, {BackgroundColor3 = Theme.text})
                end
        end

        function FXE.apply(name)
                FXE.cfg = X.ThemeFX[name]
                FXE.refresh()
        end

        -- hook into the existing theme switcher
        do
                local orig = X.applyTheme
                X.applyTheme = function(name)
                        orig(name)
                        FXE.apply(name)
                end
        end

        --------------------------------------------------------------
        -- per-frame loop
        --------------------------------------------------------------
        local t0 = os.clock()
        local nextFlash, nextBurst, nextShoot, nextGlitch = 3, 1, 2, 4
        FXE.conn = RunService.RenderStepped:Connect(function(dt)
                if not gui.Parent then FXE.conn:Disconnect(); return end
                if not visible then return end
                dt = math.min(dt, 0.1)
                local t = os.clock() - t0
                local cfg = FXE.cfg

                -- cursor sparkles (works on every theme)
                if S.trail then
                        local m = UIS:GetMouseLocation()
                        if (m - lastMouse).Magnitude > 9 then
                                lastMouse = m
                                local sc = userScale.Scale * openScale.Scale
                                local lx = (m.X - over.AbsolutePosition.X) / sc
                                local ly = (m.Y - over.AbsolutePosition.Y) / sc
                                if lx > 0 and ly > 0 and lx < 840 and ly < 540 then
                                        local tp = (cfg and S.fx) and cfg.pal or {Theme.accent, Theme.text}
                                        local T = TR[trI]
                                        trI = trI % #TR + 1
                                        T.x, T.y, T.life, T.dur = lx, ly, 0, rnd(0.45, 0.85)
                                        T.vx, T.vy = rnd(-20, 20), rnd(8, 36)
                                        local col = palAt(tp, t * 3)
                                        local gl = cfg and cfg.trail
                                        T.glyph = gl ~= nil and S.fx
                                        if T.glyph then
                                                T.l.Text = gl; T.l.TextColor3 = col; T.l.BackgroundTransparency = 1; T.l.Size = UDim2.fromOffset(16, 16); T.s.Enabled = false
                                        else
                                                T.l.Text = ""; T.l.BackgroundColor3 = col; T.l.Size = UDim2.fromOffset(5, 5); T.s.Enabled = true; T.s.Color = col
                                        end
                                        T.l.Visible = true
                                end
                        end
                end
                for _, T in ipairs(TR) do
                        if T.l.Visible then
                                T.life += dt
                                local f = T.life / T.dur
                                if f >= 1 then
                                        T.l.Visible = false
                                else
                                        T.l.Position = UDim2.fromOffset(T.x + T.vx * T.life, T.y + T.vy * T.life)
                                        if T.glyph then T.l.TextTransparency = f else T.l.BackgroundTransparency = f; T.s.Transparency = 0.7 + 0.3 * f end
                                end
                        end
                end

                if not (cfg and S.fx) then return end
                local pal = cfg.pal

                for i = 1, FXE.active do step(pool[i], dt, t) end

                -- tabs: ornaments + sweeping label colours + cycling indicator
                for i, d in ipairs(tabDots) do
                        local c = palAt(pal, i * 0.8 + t * 0.9)
                        d.f.BackgroundColor3 = c; d.s.Color = c
                        local v = 0.5 + 0.5 * math.sin(t * 3 + i * 1.3)
                        d.f.BackgroundTransparency = 0.5 - 0.45 * v
                        d.s.Transparency = 0.9 - 0.4 * v
                end
                for i, g in ipairs(tabGrads) do g.Offset = Vector2.new(math.sin(t * 0.8 + i) * 0.7, 0) end
                indicator.BackgroundColor3 = palAt(pal, t * 0.9)

                -- animated colourful border
                edgeGrad.Rotation = (t * 60) % 360

                -- string lights
                if cfg.lights then
                        local pat = math.floor(t / 6) % 3
                        for i, b in ipairs(bulbs) do
                                local v
                                if pat == 0 then v = 0.5 + 0.5 * math.sin(t * 4 - i * 0.55)
                                elseif pat == 1 then v = ((i + math.floor(t * 1.6)) % 2 == 0) and 1 or 0.15
                                else v = 0.5 + 0.5 * math.sin(t * 3.1 + i * i * 0.7) end
                                b.f.BackgroundTransparency = 0.75 - 0.7 * v
                                b.s.Transparency = 0.92 - 0.45 * v
                        end
                end

                -- christmas tree
                if cfg.tree then
                        local tp = cfg.treePal or pal
                        for i, tl in ipairs(treeLights) do
                                local v = 0.5 + 0.5 * math.sin(t * 3 + tl.ph)
                                tl.f.BackgroundTransparency = 0.6 - 0.6 * v
                                tl.s.Transparency = 0.9 - 0.4 * v
                                local c = palAt(tp, i + t * 0.5)
                                tl.f.BackgroundColor3 = c; tl.s.Color = c
                        end
                        treeF.Rotation = math.sin(t * 0.8) * 1.2
                        treeStar.Rotation = math.sin(t * 1.4) * 8
                        treeStarStroke.Transparency = 0.35 + 0.35 * math.sin(t * 3)
                end

                -- wreath / ring spin
                if cfg.ringSpin then ringF.Rotation = (t * 8) % 360 end

                -- ribbons (aurora)
                if cfg.rib then
                        for _, r in ipairs(ribbons) do
                                r.f.Position = UDim2.fromScale(0.5, r.base + math.sin(t * r.sp + r.ph) * 0.1)
                                r.f.Rotation = math.sin(t * 0.3 + r.ph) * 7
                        end
                end

                -- scanline sweep + glitch
                if cfg.scan then
                        scanF.Position = UDim2.new(0, 0, ((t * 0.3) % 1.5) - 0.25, 0)
                        if t > nextGlitch then nextGlitch = t + rnd(3, 7); glitch() end
                end

                -- lightning
                if cfg.flash and t > nextFlash then nextFlash = t + rnd(4, 10); lightning() end

                -- fireworks / shooting stars
                if cfg.burst and t > nextBurst then nextBurst = t + rnd(1.1, 2.4); burst(pal) end
                if cfg.shoot and t > nextShoot then nextShoot = t + rnd(2, 5); shoot(pal) end
        end)

        --------------------------------------------------------------
        -- theme gallery (replaces the old dropdown: 100 themes, searchable, with previews)
        --------------------------------------------------------------
        function X.buildThemeGallery(parent)
                local pkey = persistKey("Theme")
                local saved = pkey and Persist.data[pkey]
                local row = frame(parent, "card", UDim2.new(1, 0, 0, 310)); corner(row, 10); stroke(row)
                label(row, "Theme", 14, "text", Enum.Font.GothamMedium, {Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -170, 0, 18)})
                label(row, #ThemeOrder .. " themes  -  effects on most of them", 11, "sub", Enum.Font.Gotham, {Position = UDim2.fromOffset(14, 29), Size = UDim2.new(1, -170, 0, 14)})
                local box = make("TextBox", {Size = UDim2.fromOffset(130, 26), Position = UDim2.new(1, -144, 0, 12), PlaceholderText = "search...", Text = "", Font = Enum.Font.Gotham, TextSize = 12, ClearTextOnFocus = false, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left}, row)
                bind(box, "BackgroundColor3", "hover"); bind(box, "TextColor3", "text"); bind(box, "PlaceholderColor3", "sub")
                corner(box, 8); pad(box, 8, 0, 8, 0)

                local sf = make("ScrollingFrame", {Size = UDim2.new(1, -20, 1, -60), Position = UDim2.fromOffset(10, 50), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, row)
                bind(sf, "ScrollBarImageColor3", "sub")
                make("UIGridLayout", {CellSize = UDim2.new(0.5, -4, 0, 36), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder}, sf)
                pad(sf, 0, 2, 6, 2)

                local cells, sel = {}, S.theme
                local function mark()
                        for n, c in pairs(cells) do
                                local on = n == sel
                                c.st.Thickness = on and 2 or 1
                                c.st.Color = on and Themes[n].accent or Themes[n].stroke
                                c.tick.Visible = on
                        end
                end
                local function choose(n, user)
                        sel = n; mark()
                        X.applyTheme(n)
                        if user then persistSet(pkey, n) end
                end
                for i, n in ipairs(ThemeOrder) do
                        local th = Themes[n]
                        local b = make("TextButton", {Text = "", AutoButtonColor = false, BackgroundColor3 = th.bg, BorderSizePixel = 0, LayoutOrder = i}, sf)
                        corner(b, 8)
                        local st = make("UIStroke", {Thickness = 1, Color = th.stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, b)
                        local sw1 = make("Frame", {Size = UDim2.fromOffset(12, 12), Position = UDim2.new(0, 9, 0.5, -6), BackgroundColor3 = th.accent, BorderSizePixel = 0}, b); circle(sw1)
                        local sw2 = make("Frame", {Size = UDim2.fromOffset(8, 8), Position = UDim2.new(0, 18, 0.5, -1), BackgroundColor3 = th.card, BorderSizePixel = 0}, b); circle(sw2)
                        make("UIStroke", {Thickness = 1, Color = th.stroke, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, sw2)
                        make("TextLabel", {BackgroundTransparency = 1, Text = n, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = th.text, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -70, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd}, b)
                        if X.ThemeFX[n] then
                                make("TextLabel", {BackgroundTransparency = 1, Text = "FX", Font = Enum.Font.GothamBlack, TextSize = 9, TextColor3 = th.sub, Position = UDim2.new(1, -34, 0, 0), Size = UDim2.fromOffset(20, 36)}, b)
                        end
                        local tick = make("Frame", {Size = UDim2.fromOffset(7, 7), Position = UDim2.new(1, -13, 0.5, -3), BackgroundColor3 = th.accent, BorderSizePixel = 0, Visible = false}, b); circle(tick)
                        b.MouseEnter:Connect(function() tw(b, 0.2, {BackgroundColor3 = th.bg:Lerp(th.accent, 0.14)}) end)
                        b.MouseLeave:Connect(function() tw(b, 0.25, {BackgroundColor3 = th.bg}) end)
                        b.MouseButton1Click:Connect(function() choose(n, true) end)
                        cells[n] = {b = b, st = st, tick = tick}
                end
                mark()

                box:GetPropertyChangedSignal("Text"):Connect(function()
                        local q = string.lower(box.Text)
                        for n, c in pairs(cells) do
                                c.b.Visible = q == "" or string.find(string.lower(n), q, 1, true) ~= nil
                        end
                end)

                if type(saved) == "string" and Themes[saved] and saved ~= S.theme then
                        Persist.pending[#Persist.pending + 1] = function() choose(saved, false) end
                end

                X.themeDD = {set = function(n)
                        if not cells[n] then return end
                        sel = n; mark()
                        local idx = table.find(ThemeOrder, n) or 1
                        sf.CanvasPosition = Vector2.new(0, math.max(0, (math.ceil(idx / 2) - 1) * 42 - 40))
                end}
                return row
        end

        FXE.apply(S.theme)
end

