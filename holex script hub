                if ex.discordlink and ex.discordlink ~= "" then lines[#lines + 1] = "Discord: " .. tostring(ex.discordlink) end
                detailPara:SetValue(table.concat(lines, "\n"))
                if ex.websitelink and ex.websitelink ~= "" then pcall(function() if setclipboard then setclipboard(tostring(ex.websitelink)) end end) end
        end
        local function renderWeao()
                if not weaoList then return end
                H.clear(weaoList)
                local n = 0
                for _, ex in ipairs(W.list) do
                        local up, det = ex.updateStatus == true, ex.detected == true
                        local f = W.filter
                        local show = f == "All" or (f == "Updated" and up) or (f == "Undetected" and not det) or (f == "Updated + Undetected" and up and not det) or (f == platBucket(ex))
                        if show then
                                n = n + 1
                                local row = frame(weaoList, "hover", UDim2.new(1, -6, 0, 34), nil, {LayoutOrder = n}); corner(row, 7)
                                local l = label(row, "", 12, "text", Enum.Font.GothamMedium, {Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -80, 1, 0), RichText = true, TextTruncate = Enum.TextTruncate.AtEnd})
