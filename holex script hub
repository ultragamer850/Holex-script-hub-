        --------------------------------------------------------------
        -- INSTANT TRANSMISSION (teleport anywhere)
        --------------------------------------------------------------
        function X.kiTeleDest()
                local fig = X.getMyCharacter()
                local root = fig and X.getRoot(fig)
                if not root then return nil end
                local mode = math.clamp(math.floor(tonumber(m.KiTeleMode) or 1), 1, 4)
                local range = tonumber(m.KiTeleRange) or 3000
                local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
                if flatLook.Magnitude < 0.05 then flatLook = Vector3.new(0, 0, -1) end
                flatLook = flatLook.Unit
                if mode == 2 then
                        local cam = Workspace.CurrentCamera
                        local look = cam and cam.CFrame.LookVector or flatLook
                        look = Vector3.new(look.X, 0, look.Z)
                        if look.Magnitude < 0.05 then look = flatLook end
                        look = look.Unit
                        local dist = tonumber(m.KiTeleDist) or 60
                        local pos = root.Position + look * dist
                        local hitPos = X.kiTrace(root.Position, look, dist)
                        if (hitPos - root.Position).Magnitude < dist - 0.5 then pos = hitPos - look * 3 end
                        return CFrame.lookAt(pos, pos + look)
                elseif mode == 4 then
                        local s = tostring(m.KiTelePoint or "")
                        local x, y, z = s:match("^(-?[%d%.]+),(-?[%d%.]+),(-?[%d%.]+)$")
                        if not x then
                                warn("[HatCollision] Ki teleport: no saved point yet (press " .. tostring(m.KeyKiTeleSet) .. " to save one)")
                                return nil
                        end
                        local pos = Vector3.new(tonumber(x) or 0, tonumber(y) or 0, tonumber(z) or 0)
                        return CFrame.lookAt(pos, pos + flatLook)
                end
                local res, org, adir, far = X.kiAim(range)
                if mode == 3 then
                        local center = res and res.Position or far
                        local op = OverlapParams.new()
                        op.FilterType = Enum.RaycastFilterType.Exclude
                        op.FilterDescendantsInstances = X.kiExclude()
                        op.MaxParts = 200
                        local ok, parts = pcall(function() return Workspace:GetPartBoundsInRadius(center, 80, op) end)
                        local best, bestD = nil, math.huge
                        if ok and type(parts) == "table" then
                                for _, p in ipairs(parts) do
                                        local model = p:IsA("BasePart") and p:FindFirstAncestorOfClass("Model")
                                        if model and model:FindFirstChildOfClass("Humanoid") then
                                                local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                                                if hrp then
                                                        local dd = (hrp.Position - center).Magnitude
                                                        if dd < bestD then best, bestD = hrp, dd end
                                                end
                                        end
                                end
                        end
                        if best then
                                local pos = (best.CFrame * CFrame.new(0, 0, tonumber(m.KiTeleBehind) or 4)).Position
                                return CFrame.lookAt(pos, Vector3.new(best.Position.X, pos.Y, best.Position.Z))
                        end
                end
                local pos
                if res then
                        pos = res.Position + res.Normal * 3.2 + Vector3.new(0, 0.5, 0)
                else
                        pos = org + adir * math.min(range, 250)
                end
                return CFrame.lookAt(pos, pos + flatLook)
        end

