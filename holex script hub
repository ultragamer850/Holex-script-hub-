--==================================================================
-- CLOCK LOGIC  (stops when you leave the tab)
--==================================================================
local clockConn, running, lastSec = nil, false, -1
local angS, angM, angH = 0, 0, 0
local function unwrap(prev, new) while new < prev - 180 do new += 360 end return new end

local function playTick()
        if S.tick then
                tickSound.TimePosition = 0
                tickSound:Play()
        end
end

local function updateHands(first)
        local t = os.date("*t")
        local s, m, h = t.sec, t.min, t.hour % 12
        angS = unwrap(angS, s * 6)
        angM = unwrap(angM, m * 6 + s * 0.1)
        angH = unwrap(angH, h * 30 + m * 0.5)
        if first then
                tw(secHand, 0.8, {Rotation = angS})
                tw(minHand, 0.8, {Rotation = angM})
                tw(hourHand, 0.8, {Rotation = angH})
        else
                tw(secHand, 0.14, {Rotation = angS}, Enum.EasingStyle.Back)   -- the "tick" snap with tiny overshoot
                tw(minHand, 0.3, {Rotation = angM}, Enum.EasingStyle.Quad)
                tw(hourHand, 0.3, {Rotation = angH}, Enum.EasingStyle.Quad)
        end
        timeLbl.Text = os.date("%I:%M:%S %p")
        dateLbl.Text = os.date("%A, %B %d")
        local e = math.floor(os.clock() - sessionStart)
        sessionLbl.Text = string.format("Session %02d:%02d:%02d", e // 3600, (e % 3600) // 60, e % 60)
        if X.updateYear then X.updateYear() end
end

local function setStatus(on)
        running = on
        statusLbl.Text = on and "TICKING" or "PAUSED"
end

function startClock()
        if clockConn then return end
        setStatus(true)
        updateHands(true)
        lastSec = os.time()
        clockConn = RunService.Heartbeat:Connect(function()
                local now = os.time()
                if now ~= lastSec then
                        lastSec = now
                        updateHands(false)
                        playTick()
                end
        end)
end

function stopClock()
        if clockConn then clockConn:Disconnect(); clockConn = nil end
        setStatus(false)
        tickSound:Stop()
end

