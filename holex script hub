-- live colours: always the hub's current theme (good / bad / warn are status colours)
local COL = setmetatable({
        good = Color3.fromRGB(74, 222, 128),
        bad = Color3.fromRGB(248, 113, 113),
        warn = Color3.fromRGB(251, 191, 36),
}, { __index = function(_, k)
        local t = Theme
        if k == "bg" then return t.bg
        elseif k == "side" then return t.panel
