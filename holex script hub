        function X.puFxBuild(noRocks)
                X.puFxClear()
                local root = X.getMyHRP()
                local fig = X.getMyCharacter()
                if not root then return end
                local c1, c2 = X.puAuraColors()
                local size = math.clamp(tonumber(m.PowerUpAuraSize) or 1, 0.2, 5)
                local fx = X.PUFx
                fx.emitters = {}
                local CS, NS, CK, NK = ColorSequence, NumberSequence, ColorSequenceKeypoint, NumberSequenceKeypoint
                local FIRE = "rbxasset://textures/particles/fire_main.dds"
                local SPARK = "rbxasset://textures/particles/sparkles_main.dds"
                local function mkEmitter(att, base, lifeMin, lifeMax, spMin, spMax, sz0, sz1, tex, spread, accel)
                        local e = Instance.new("ParticleEmitter")
                        e.Name = "HC_PU_Emit"
                        e.Texture = tex
                        e.Color = CS.new({ CK.new(0, c1), CK.new(0.6, c1:Lerp(c2, 0.6)), CK.new(1, c2) })
                        e.Size = NS.new({ NK.new(0, sz0 * size), NK.new(1, sz1 * size) })
                        e.Transparency = NS.new({ NK.new(0, 0.25), NK.new(0.65, 0.5), NK.new(1, 1) })
                        e.Lifetime = NumberRange.new(lifeMin, lifeMax)
                        e.Speed = NumberRange.new(spMin, spMax)
                        e.SpreadAngle = Vector2.new(spread, spread)
                        e.Rate = 0
                        e.LightEmission = 1
                        e.LightInfluence = 0
                        e.Rotation = NumberRange.new(0, 360)
                        e.RotSpeed = NumberRange.new(-80, 80)
                        e.Acceleration = accel or Vector3.new(0, 3, 0)
                        e.EmissionDirection = Enum.NormalId.Top
                        e.LockedToPart = false
                        e.ZOffset = 0.5
                        e.Parent = att
                        fx.emitters[#fx.emitters + 1] = { e = e, base = base }
                        return e
                end
                if m.PowerUpAuraFX ~= false then
                        for i = 1, 4 do
                                local a = (i - 1) * math.pi / 2
                                local att = Instance.new("Attachment")
                                att.Name = "HC_PU_Att" .. i
                                att.Position = Vector3.new(math.cos(a) * 1.2, -2.6, math.sin(a) * 1.2)
                                att.Parent = root
                                fx["att" .. i] = att
                                mkEmitter(att, 26, 0.55, 1.0, 10, 16, 2.4, 0.5, FIRE, 10, Vector3.new(0, 5, 0))
                        end
                        local chest = Instance.new("Attachment")
                        chest.Name = "HC_PU_Chest"
                        chest.Position = Vector3.new(0, 0.5, 0)
                        chest.Parent = root
                        fx.chest = chest
                        mkEmitter(chest, 45, 0.4, 0.9, 10, 22, 0.35, 0.05, SPARK, 180, Vector3.new(0, 2, 0))
                        local light = Instance.new("PointLight")
                        light.Name = "HC_PU_Light"
                        light.Color = c1
                        light.Range = 16 * size
                        light.Brightness = 0
                        light.Parent = root
                        fx.light = light
                end
                if m.PowerUpBodyGlow ~= false and fig then
                        pcall(function()
                                local hl = Instance.new("Highlight")
                                hl.Name = "HC_PU_Glow"
                                hl.Adornee = fig
                                hl.FillColor = c1
                                hl.OutlineColor = c2
                                hl.FillTransparency = 1
                                hl.OutlineTransparency = 1
                                hl.DepthMode = Enum.HighlightDepthMode.Occluded
                                hl.Parent = fig
                                fx.glow = hl
                        end)
                end
                if m.PowerUpRocks ~= false and not noRocks then
                        local gpos, ginst = X.puGround(root)
                        local gcol = Color3.fromRGB(110, 100, 90)
                        local gmat = Enum.Material.Slate
                        pcall(function()
                                if ginst and ginst:IsA("BasePart") then
                                        gcol = ginst.Color
                                        gmat = ginst.Material
                                end
                        end)
                        local n = math.clamp(math.floor(tonumber(m.PowerUpRockCount) or 10), 0, 30)
                        for _ = 1, n do
                                local ang = math.random() * math.pi * 2
                                local rad = 3 + math.random() * 4
                                local sz = 0.5 + math.random() * 1.1
                                local p = Instance.new("Part")
                                p.Name = "HC_PU_Rock"
                                p.Anchored = true
                                p.CanCollide = false
                                p.CanTouch = false
                                p.CanQuery = false
                                p.Material = gmat
                                p.Color = gcol
                                p.Size = Vector3.new(sz, sz * (0.6 + math.random() * 0.6), sz * (0.8 + math.random() * 0.5))
                                local basePos = gpos + Vector3.new(math.cos(ang) * rad, 0, math.sin(ang) * rad)
                                p.CFrame = CFrame.new(basePos - Vector3.new(0, sz, 0))
                                p.Parent = Workspace
                                X.PURocks[#X.PURocks + 1] = {
