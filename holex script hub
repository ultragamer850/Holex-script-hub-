-- SAVE FILE  (executor workspace)  -  every setting is saved and reloaded on re-execute
--==================================================================
local HttpService = game:GetService("HttpService")
X.ROOT = "holex script hub v5"
X.DIRS = {
        content = X.ROOT .. "/content",
        media = X.ROOT .. "/holex media",  -- videos / gif / webm / mp4 / frame folders
        music = X.ROOT .. "/music",
        sfx = X.ROOT .. "/sfx",
        hatcollision = X.ROOT .. "/hatcollision",
        cache = X.ROOT .. "/cache",
        data = X.ROOT .. "/holexs data",
}
local SAVE_FILE = X.DIRS.data .. "/settings.json"
local Persist = {data = {}, pending = {}, section = "General", used = {}, queued = false, loaded = false}
local hasFS = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"
local SKIP_SAVE = {["FE only"] = true}
if hasFS and type(makefolder) == "function" and type(isfolder) == "function" then
        for _, p in ipairs({X.ROOT, X.DIRS.content, X.DIRS.media, X.DIRS.music, X.DIRS.sfx, X.DIRS.hatcollision, X.DIRS.cache, X.DIRS.data}) do
                pcall(function() if not isfolder(p) then makefolder(p) end end)
        end
end

if hasFS then
        local ok, raw = pcall(function() if isfile(SAVE_FILE) then return readfile(SAVE_FILE) elseif isfile("Holex Script Hub Ultimate Edition.json") then return readfile("Holex Script Hub Ultimate Edition.json") end end)
        if ok and type(raw) == "string" and #raw > 1 then
                local ok2, t = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok2 and type(t) == "table" then Persist.data = t; Persist.loaded = true end
        end
end

local function persistKey(text)
        if SKIP_SAVE[text] then return nil end
        local base = Persist.section .. "|" .. text
        local n = (Persist.used[base] or 0) + 1
        Persist.used[base] = n
        return n > 1 and (base .. "#" .. n) or base
end

local function persistFlush()
        if not hasFS then return false end
        local ok = pcall(function() writefile(SAVE_FILE, HttpService:JSONEncode(Persist.data)) end)
        return ok
end

local function persistSet(key, v)
        if not key then return end
        Persist.data[key] = v
        if Persist.queued then return end
        Persist.queued = true
        task.delay(0.6, function() Persist.queued = false; persistFlush() end)
end

local function bind(inst, prop, key)
        reg[#reg + 1] = {inst, prop, key}
        inst[prop] = Theme[key]
end

