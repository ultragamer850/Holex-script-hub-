        local CH = "01234567890ABCDEFXZ<>/|=+*#$%&"
        local function rch() local i = math.random(1, #CH); return CH:sub(i, i) end
        local ROWS = 8

        local function style(p)
                local pr, l, sh = p.pr, p.l, p.pr.shape
                p.s.Enabled = false; p.g.Enabled = false
                l.Text = ""; l.BackgroundTransparency = 1; l.TextTransparency = 1
                l.Font = Enum.Font.GothamBold; l.TextYAlignment = Enum.TextYAlignment.Center
                l.Rotation = p.rot
                if sh == "glyph" and pr.kind == "matrix" then
                        p.lines = {}
                        for i = 1, ROWS do p.lines[i] = rch() end
                        l.Font = Enum.Font.Code; l.TextSize = p.sz; l.TextYAlignment = Enum.TextYAlignment.Top
                        l.Size = UDim2.fromOffset(p.sz + 2, ROWS * (p.sz + 2))
                        l.Text = table.concat(p.lines, "\n"); l.TextColor3 = p.col; l.TextTransparency = p.a
                        p.c.CornerRadius = UDim.new(0, 0)
                        p.g.Enabled = true
                elseif sh == "glyph" then
                        l.Text = pr.glyphs[math.random(1, #pr.glyphs)]
                        l.TextSize = p.sz; l.Size = UDim2.fromOffset(p.sz * 1.6, p.sz * 1.6)
                        l.TextColor3 = p.col; l.TextTransparency = p.a
                        p.c.CornerRadius = UDim.new(0, 0)
                else
                        local sz = p.sz
                        l.BackgroundColor3 = p.col; l.BackgroundTransparency = p.a
                        if sh == "dot" then l.Size = UDim2.fromOffset(sz, sz); p.c.CornerRadius = UDim.new(1, 0)
                        elseif sh == "square" then l.Size = UDim2.fromOffset(sz, sz * 0.65); p.c.CornerRadius = UDim.new(0, 1)
                        elseif sh == "petal" then l.Size = UDim2.fromOffset(sz, sz * 0.55); p.c.CornerRadius = UDim.new(0.5, 0)
                        elseif sh == "streak" then l.Size = UDim2.fromOffset(1.6, sz); p.c.CornerRadius = UDim.new(0.5, 0)
                        elseif sh == "rect" then l.Size = UDim2.fromOffset(sz, 2); p.c.CornerRadius = UDim.new(0, 0)
                        elseif sh == "ring" then
                                l.Size = UDim2.fromOffset(sz, sz); p.c.CornerRadius = UDim.new(1, 0)
                                p.s.Enabled = true; p.s.Thickness = 1; p.s.Color = p.col; p.s.Transparency = 0.35
                        end
                        if pr.glow and sh ~= "ring" then
                                p.s.Enabled = true; p.s.Thickness = pr.glow; p.s.Color = p.col; p.s.Transparency = 0.75
                        end
                end
        end

        local function respawn(p, first)
                local pr = p.pr
                local k = pr.kind
                p.ph = math.random() * 6.283
                p.col = p.pal[math.random(1, #p.pal)]
                p.sz = rnd(pr.size[1], pr.size[2])
                p.vy = pr.speed and rnd(pr.speed[1], pr.speed[2]) or 0
                p.spin = pr.spin and rnd(pr.spin[1], pr.spin[2]) or 0
                p.rot = pr.spin and math.random() * 360 or (pr.tilt or 0)
                p.a = rnd(pr.alpha[1], pr.alpha[2])
                p.life = 0
                p.dur = pr.short and rnd(0.08, 0.4) or rnd(2.5, 6)
                p.macc = 0
                if k == "fall" then
                        p.x = math.random(); p.y = first and math.random() or -0.06
                elseif k == "rise" then
                        p.x = math.random(); p.y = first and math.random() or 1.06
                elseif k == "twinkle" then
                        p.x = math.random(); p.y = math.random()
                        if first then p.life = math.random() * p.dur end
                elseif k == "drift" then
                        p.x = math.random(); p.y = math.random(); p.bx, p.by = p.x, p.y
                elseif k == "cross" then
                        p.dir = math.random() < 0.5 and 1 or -1
                        p.x = first and math.random() or (p.dir > 0 and -0.08 or 1.08)
                        p.y = rnd(0.1, 0.85); p.by = p.y
                elseif k == "matrix" then
                        p.x = (math.random(0, 35) + 0.5) / 36
                        p.y = first and rnd(-0.1, 1) or rnd(-0.4, -0.1)
                end
                style(p)
        end

        local function setTr(p, tr)
                if p.pr.shape == "glyph" then p.l.TextTransparency = tr else p.l.BackgroundTransparency = tr end
        end

        local function step(p, dt, t)
                local pr, l, k = p.pr, p.l, p.pr.kind
                local x, y = p.x, p.y
                if k == "fall" or k == "rise" then
                        p.y += (k == "fall" and 1 or -1) * p.vy * dt
                        local w = pr.wind or 0
                        if w ~= 0 then
                                p.x += w * dt
                                if p.x > 1.06 then p.x = -0.06 elseif p.x < -0.06 then p.x = 1.06 end
                        end
                        if p.y > 1.07 or p.y < -0.09 then respawn(p, false); return end
                        x = p.x + math.sin(t * 1.1 + p.ph) * (pr.sway or 0)
                        y = p.y
                elseif k == "twinkle" then
                        p.life += dt
                        local f = p.life / p.dur
                        if f >= 1 then respawn(p, false); return end
                        setTr(p, 1 - (1 - p.a) * math.sin(PI * f))
                elseif k == "drift" then
                        x = p.bx + math.sin(t * 0.31 + p.ph) * 0.05 + math.sin(t * 0.17 + p.ph * 2) * 0.025
                        y = p.by + math.cos(t * 0.27 + p.ph) * 0.06
                elseif k == "cross" then
                        p.x += p.dir * p.vy * dt
                        if p.x > 1.1 or p.x < -0.1 then respawn(p, false); return end
                        x = p.x
                        y = p.by + math.sin(t * 1.7 + p.ph) * 0.03
                elseif k == "matrix" then
                        p.y += p.vy * dt
                        if p.y > 1.25 then respawn(p, false); return end
                        p.macc += dt
                        if p.macc > 0.09 then
                                p.macc = 0
                                p.lines[math.random(1, ROWS)] = rch()
                                l.Text = table.concat(p.lines, "\n")
                        end
                        x, y = p.x, p.y
                end
                if pr.tw then
                        local f = 0.5 - 0.5 * math.sin(t * pr.tf + p.ph)
                        setTr(p, p.a + (1 - p.a) * f * pr.tw)
                        if pr.glow and p.s.Enabled then p.s.Transparency = 0.6 + 0.4 * f end
                end
                if pr.hue then
                        local c = Color3.fromHSV((t * 0.15 + p.ph / 6.283) % 1, 0.65, 1)
                        if pr.shape == "glyph" then l.TextColor3 = c else l.BackgroundColor3 = c end
                        if p.s.Enabled then p.s.Color = c end
                end
                if p.spin ~= 0 then p.rot += p.spin * dt; l.Rotation = p.rot end
                l.Position = UDim2.fromScale(x, y)
        end

        local function build()
                for _, p in ipairs(pool) do p.l.Visible = false end
                FXE.active = 0
                local cfg = FXE.cfg
                if not (cfg and S.fx) then return end
                local names = {}
                for n in string.gmatch(cfg.p or "", "[^+]+") do
                        if PRE[n] then names[#names + 1] = n end
                end
                local total = 0
                for _, n in ipairs(names) do total += PRE[n].n end
                if total == 0 then return end
                FXE.amount = S.fxAmt or 1
                local budget = math.min(MAXP, math.floor(total * FXE.amount + 0.5))
                local pal = cfg.ppal or cfg.pal
                local idx = 0
                for _, n in ipairs(names) do
                        local pr = PRE[n]
                        local cnt = math.floor(budget * pr.n / total + 0.5)
                        for _ = 1, cnt do
                                if idx >= MAXP then break end
                                idx += 1
                                local p = pool[idx]
                                p.pr, p.pal = pr, pal
                                respawn(p, true)
                                p.l.Visible = true
                        end
                end
                FXE.active = idx
        end

