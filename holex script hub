label(settings, "Downloads go into  holex script hub v5/  (music, sfx, content, media, alerts, cache). Delete wipes that whole folder so you can start fresh.", 11, "sub", Enum.Font.Gotham, {Size = UDim2.new(1, -4, 0, 40), TextWrapped = true})

local dlBusy, wipeConfirm = false, 0
Button(settings, "Download ALL assets (music + SFX + content + alerts)", function()
        if not hasFS then Notify("Downloads", "This executor has no writefile / makefolder.", 4); return end
        if dlBusy then Notify("Downloads", "Already downloading — wait for it to finish.", 3); return end
        dlBusy = true
        task.spawn(function()
                local V = X.V14
                local got, fail, skip = 0, 0, 0
                local doneN, totalN = 0, 0
                local currentLabel = "Preparing…"

                local barWrap = frame(settings, "card", UDim2.new(1, 0, 0, 56))
                corner(barWrap, 10); stroke(barWrap)
                barWrap.LayoutOrder = -1
                local barTitle = label(barWrap, "Downloading files…", 12, "text", Enum.Font.GothamBold, {
                        Position = UDim2.fromOffset(12, 6), Size = UDim2.new(1, -24, 0, 16)
                })
                local barSub = label(barWrap, "0 / 0", 11, "sub", Enum.Font.Gotham, {
                        Position = UDim2.fromOffset(12, 22), Size = UDim2.new(1, -24, 0, 14)
                })
                local track = frame(barWrap, "hover", UDim2.new(1, -24, 0, 6), UDim2.fromOffset(12, 40)); circle(track)
                local fillB = frame(track, "accent", UDim2.fromScale(0, 1)); circle(fillB)

                local function setProgress(labelText)
                        currentLabel = labelText or currentLabel
                        local pct = (totalN > 0) and (doneN / totalN) or 0
                        barTitle.Text = currentLabel
                        barSub.Text = string.format("%d / %d   ·   new %d · skip %d · fail %d", doneN, totalN, got, skip, fail)
                        fillB.Size = UDim2.fromScale(math.clamp(pct, 0, 1), 1)
                end

                local function ensure(p)
                        if type(makefolder) == "function" then
                                pcall(function()
                                        local acc = ""
                                        for part in string.gmatch(p, "[^/]+") do
                                                acc = acc == "" and part or (acc .. "/" .. part)
                                                if not isfolder(acc) then makefolder(acc) end
                                        end
                                end)
                        end
                end

                local queue = {}
                local function enqueue(path, url, label)
                        if type(url) ~= "string" or url == "" then return end
                        queue[#queue + 1] = {path = path, url = url, label = label or path}
                end

                local function grabOne(job)
                        local path, url, label = job.path, job.url, job.label
                        ensure((path:match("(.+)/[^/]+$") or X.ROOT))
                        if isfile and isfile(path) then
                                skip += 1
                                doneN += 1
                                setProgress("Skipped (cached): " .. tostring(label))
                                return
                        end
                        setProgress("Downloading: " .. tostring(label))
                        local ok, body = pcall(function() return game:HttpGet(url) end)
                        if ok and type(body) == "string" and #body > 50 then
                                local w
                                if V and V.write then
                                        w = V.write(path, body)
                                else
                                        w = pcall(writefile, path, body)
                                end
                                if w then got += 1 else fail += 1 end
                        else
                                fail += 1
                        end
                        doneN += 1
                        setProgress("Downloaded: " .. tostring(label))
                end

                Notify("Downloads", "Starting full asset download…", 2)
                for _, p in ipairs({X.ROOT, X.DIRS.music, X.DIRS.sfx, X.DIRS.content, X.DIRS.media, X.DIRS.cache, X.DIRS.data, X.DIRS.hatcollision}) do
                        ensure(p)
                end
                if V and V.F then
                        for _, p in pairs({V.F.alerts, V.F.logs, V.F.tts, V.F.chat, V.F.dms}) do
                                if type(p) == "string" then ensure(p) end
                        end
                end

                -- built-in hover/click SFX
                if V and V.SFX and type(V.SFX.urls) == "table" then
                        local sfxRoot = (V.F and V.F.sfx) or X.DIRS.sfx
                        for kind, url in pairs(V.SFX.urls) do
                                enqueue(sfxRoot .. "/gmod_" .. tostring(kind) .. ".mp3", url, "gmod_" .. tostring(kind) .. ".mp3")
                        end
                end
                local sfxList = (V and V.SFX and V.SFX.List) or (X.SFXList) or {}
                if type(sfxList) == "table" then
                        local BASE = "https://raw.githubusercontent.com/ultragamer850/sound-effects/main/"
                        local function enc(s)
                                return tostring(s):gsub(" ", "%%20")
                        end
                        for _, s in ipairs(sfxList) do
                                local file = type(s) == "table" and (s[2] or s.file or s.name) or tostring(s)
                                local url = type(s) == "table" and (s.url or s[3]) or nil
                                if not url and file and file ~= "" then url = BASE .. enc(file) end
                                if file and url then enqueue(X.DIRS.sfx .. "/" .. file, url, file) end
                        end
                end

                local songs = X.MusicSongs or {}
                if type(songs) == "table" then
                        local BASE = "https://raw.githubusercontent.com/ultragamer850/musics/main/"
                        local function enc(s)
                                return tostring(s):gsub(" ", "%%20")
                        end
                        for _, s in ipairs(songs) do
                                local file = type(s) == "table" and s[2] or tostring(s)
                                if file and file ~= "" then
                                        enqueue(X.DIRS.music .. "/" .. file, BASE .. enc(file), file)
                                end
                        end
                end

                local mediaList = (X.Cr and X.Cr.Media) or {}
                if type(mediaList) == "table" then
                        for _, e in ipairs(mediaList) do
                                if type(e) == "table" and e.name then
                                        local url = e.url
                                        if type(e.urls) == "table" and e.urls[1] then url = e.urls[1] end
                                        if url then enqueue((X.DIRS.media or X.DIRS.content) .. "/" .. e.name, url, e.name) end
                                end
                        end
                end

                local RAW = "https://raw.githubusercontent.com/ultragamer850/sound-effects/main/"
                local alerts = {
                        {"Tornado_Siren.mp3", RAW .. "Tornado%20Siren.mp3"},
                        {"tsunami.ogg", RAW .. "tsunami.ogg"},
                        {"earthquake_alert.ogg", RAW .. "earthquake%20alert.ogg"},
                        {"USA_EAS_Alarm.mp3", RAW .. "USA%20EAS%20Alarm.mp3"},
                }
                local alertDir = (V and V.F and V.F.alerts) or (X.DIRS.data .. "/alerts")
                ensure(alertDir)
                for _, a in ipairs(alerts) do
                        enqueue(alertDir .. "/" .. a[1], a[2], a[1])
                end

                if X.Boot and type(X.Boot.FILES) == "table" then
                        for _, f in ipairs(X.Boot.FILES) do
                                if type(f) == "table" and f.url then
                                        local file = f.file or ((f.name or "boot") .. ".bin")
                                        enqueue((X.DIRS.cache or (X.ROOT .. "/cache")) .. "/" .. file, f.url, file)
                                end
                        end
                end

                totalN = #queue
                setProgress("Queued " .. totalN .. " files — downloading in parallel…")

                local PARALLEL = 8
                local i = 1
                while i <= #queue do
                        local batch = {}
                        for b = 0, PARALLEL - 1 do
                                local job = queue[i + b]
                                if job then batch[#batch + 1] = job end
                        end
                        local doneFlag = {}
                        for bi, job in ipairs(batch) do
                                doneFlag[bi] = false
                                task.spawn(function()
                                        pcall(grabOne, job)
                                        doneFlag[bi] = true
                                end)
                        end
                        while true do
                                local all = true
                                for bi = 1, #batch do
                                        if not doneFlag[bi] then all = false; break end
                                end
                                if all then break end
                                task.wait(0.03)
                        end
                        i += PARALLEL
                end

                dlBusy = false
                local msg = string.format("All assets finished.\nNew: %d  ·  Already had: %d  ·  Failed: %d", got, skip, fail)
                setProgress("Done — " .. msg:gsub("\n", " "))
                Notify("Downloads", msg, 6)
                if V and V.ok then V.ok("DOWNLOADS", msg:gsub("\n", " ")) end
                pcall(function() if V and V.SFX and V.SFX.load then V.SFX.load() end end)
                task.delay(4, function()
                        pcall(function() barWrap:Destroy() end)
                end)
        end)
end)

