--==================================================================
-- v6 MERGE  -  SOCIAL TAB  (Holex network: accounts, presence, global chat, friends, DMs,
--              groups, voice-call signalling, feedback, owner database)
--   Wire format is the same as Holex V14 ("chat|user|msg|ts", "presence|..."), so v5+merge and
--   V14 users can still see each other. Uses public ntfy relays with automatic failover.
--==================================================================
do
local function module()
        local SoundService = game:GetService("SoundService")
        local V, H = X.V14, X.H
        local N = {
                hosts = {"https://ntfy.sh/", "https://ntfy.envs.net/", "https://ntfy.adminforge.de/", "https://ntfy.nickolas.me/", "https://ntfy.jae.fi/"},
                topicRT = "holexv14_realtime", topicAcc = "holexv14_accounts",
                host = 1, hostOk = {}, accounts = {}, presence = {}, typing = {}, seen = {}, lastRT = nil, lastAcc = nil,
                joined = os.time(), dirty = false, lastPost = 0, callbacks = {}, unread = {},
        }
        V.Network = N
        local DBFILE = V.F.data .. "/account_database.json"
        N.accounts = (V.json(DBFILE) or {}).accounts or {}

        function V.holexName()
                local n = V.get("username", "")
                if type(n) ~= "string" or n == "" then n = LP.Name end
                return n
        end
        local function me() return V.holexName() end
        local function lower(s) return tostring(s or ""):lower() end
        local function split(s)
                local t = {}
                for f in (tostring(s) .. "|"):gmatch("(.-)|") do t[#t + 1] = f end
                return t
        end

        ----------------------------------------------------------------
        -- v6.8 GLOBAL CHAT HISTORY: every message anyone sent (including yours) is kept in a file and
        -- re-downloaded from the relay, so old messages show up again for everybody.
        ----------------------------------------------------------------
        local CHATFILE = V.F.data .. "/global_chat_history.json"
        N.chatHist, N.chatKeys = {}, {}
        local function chatKey(u, t, m) return lower(u) .. "|" .. tostring(t) .. "|" .. tostring(m) end
        do
                local d = V.json(CHATFILE)
                if type(d) == "table" and type(d.messages) == "table" then
                        for _, e in ipairs(d.messages) do
                                if type(e) == "table" and e.u and e.m then
                                        N.chatHist[#N.chatHist + 1] = {u = tostring(e.u), m = tostring(e.m), t = tonumber(e.t) or 0}
                                        N.chatKeys[chatKey(e.u, tonumber(e.t) or 0, e.m)] = true
                                end
                        end
                        table.sort(N.chatHist, function(a, b) return a.t < b.t end)
                end
        end
        -- returns isNew, outOfOrder
        function N.addChat(u, m, t)
                t = tonumber(t) or os.time()
                local key = chatKey(u, t, m)
                if N.chatKeys[key] then return false end
                N.chatKeys[key] = true
                local Hs = N.chatHist
                local ooo = #Hs > 0 and t < Hs[#Hs].t
                Hs[#Hs + 1] = {u = u, m = m, t = t}
                if ooo then table.sort(Hs, function(a, b) return a.t < b.t end) end
                while #Hs > 300 do
                        local old = table.remove(Hs, 1)
                        N.chatKeys[chatKey(old.u, old.t, old.m)] = nil
                end
                N.chatDirty = true
                return true, ooo
        end

        ----------------------------------------------------------------
        -- relays (post with failover, poll with failover)
        ----------------------------------------------------------------
        local function post(topic, msg, title)
                if not V.cfg.net then return false end
                for off = 0, #N.hosts - 1 do
                        local i = (N.host - 1 + off) % #N.hosts + 1
                        local r = V.http(N.hosts[i] .. topic, "POST", {["Content-Type"] = "text/plain", ["Title"] = title or "holex"}, msg)
                        if r and (r.Status == 200 or (r.Status == 0 and #r.Body > 0)) then
                                N.host = i; N.hostOk[i] = true
                                return true
                        end
                        N.hostOk[i] = false
                end
                return false
        end
        local function poll(topic, since, extra)
                if not V.cfg.net then return {} end
                for off = 0, #N.hosts - 1 do
                        local i = (N.host - 1 + off) % #N.hosts + 1
                        local r = V.http(N.hosts[i] .. topic .. "/json?poll=1&since=" .. tostring(since) .. (extra or ""), "GET")
                        if r and r.Status ~= 404 and r.Status ~= 429 and r.Status < 500 and (r.Status == 200 or #r.Body > 2) then
                                N.host = i; N.hostOk[i] = true
                                local out = {}
                                for line in r.Body:gmatch("[^\r\n]+") do
                                        local o = V.decode(line)
                                        if type(o) == "table" and o.event == "message" and o.message and o.id then out[#out + 1] = o end
                                end
                                return out
                        end
                        N.hostOk[i] = false
                end
                return {}
        end
        N.post, N.poll = post, poll

        ----------------------------------------------------------------
        -- accounts + presence
        ----------------------------------------------------------------
        local function upsert(e)
                if not e.username or e.username == "" then return end
                local k = lower(e.username)
                local a = N.accounts[k] or {createdAt = os.time(), logins = 0}
                a.username = e.username
                a.display = e.display or a.display or e.username
                a.userid = e.userid or a.userid
                a.robloxName = e.robloxName or a.robloxName
                a.version = e.version or a.version
                a.isOwner = e.isOwner or a.isOwner
                a.lastSeen = e.lastSeen or a.lastSeen or os.time()
                a.source = e.source or a.source
                if e.login then a.logins = (a.logins or 0) + 1; a.lastLogin = os.time() end
                N.accounts[k] = a
                N.dirty = true
                return a
        end
        local function markOnline(uname, meta)
                meta = meta or {}
                local k = lower(uname)
                local old = N.presence[k] or {}
                N.presence[k] = {username = uname, display = meta.display or old.display or uname, userid = meta.userid or old.userid, version = meta.version or old.version, lastSeen = os.time()}
                upsert({username = uname, display = meta.display, userid = meta.userid, version = meta.version, lastSeen = os.time(), source = meta.source})
        end
        function N.isOnline(name)
                local p = N.presence[lower(name)]
                return p ~= nil and os.time() - p.lastSeen <= 60, p
        end
        function N.onlineList()
                local out = {}
                for _, p in pairs(N.presence) do if os.time() - p.lastSeen <= 60 then out[#out + 1] = p end end
                table.sort(out, function(a, b) return lower(a.username) < lower(b.username) end)
                return out
        end
        N._lastDiscordPresence = 0
        function N.publishPresence()
                local u = me()
                local ver = "14.1-POWER-merge"
                post(N.topicRT, table.concat({"presence", u, tostring(os.time()), ver, tostring(LP.UserId), LP.DisplayName, "0", tostring(N.joined)}, "|"), "presence")
                markOnline(u, {display = LP.DisplayName, userid = LP.UserId, version = ver, source = "self"})
                -- local presence mirror (same as V14 PowerCore)
                pcall(function()
                        local pf = V.F.data .. "/holex_online.json"
                        local online = V.json(pf) or {}
                        local rec = {username = u, display = LP.DisplayName, userid = LP.UserId, lastSeen = os.time(), version = ver, source = "self", placeId = game.PlaceId}
                        online[tostring(LP.UserId)] = rec
                        online["user:" .. lower(u)] = rec
                        local now = os.time()
                        for k, p in pairs(online) do
                                if type(p) == "table" and now - (p.lastSeen or 0) > 90 then online[k] = nil end
                        end
                        V.saveJson(pf, online)
                end)
                pcall(function()
                        LP:SetAttribute("HolexV14", ver)
                        LP:SetAttribute("HolexUser", u)
                end)
                -- Discord presence (throttled ~25s) — this is what shows as HolexPowerCore APP
                if V.cfg.net and os.time() - (N._lastDiscordPresence or 0) >= 25 then
                        N._lastDiscordPresence = os.time()
                        V.discord(V.NETWORK_WEBHOOK, "Presence · " .. u,
                                "**" .. u .. "** online on Holex V14\nPlace `" .. tostring(game.PlaceId) .. "`", 5763719)
                end
        end
        function N.publishAccount(kind)
                local u = me()
                local rec = upsert({username = u, display = LP.DisplayName, userid = LP.UserId, robloxName = LP.Name, version = "14.0.0", isOwner = V.isOwner, login = true, source = kind})
                post(N.topicAcc, table.concat({"account", kind, u, tostring(os.time()), "14.0.0", tostring(LP.UserId), LP.Name, "0", V.isOwner and "1" or "0", tostring(game.PlaceId)}, "|"), "account")
                if not V.get("announced", false) then
                        V.set("announced", true)
                        V.discord(V.WEBHOOK, "New Holex account", "**" .. u .. "** joined the Holex network", 5763719, {
                                {name = "Roblox name", value = LP.Name, inline = true}, {name = "Roblox ID", value = tostring(LP.UserId), inline = true},
                                {name = "Place", value = tostring(game.PlaceId), inline = true}})
                end
                return rec
        end

        ----------------------------------------------------------------
        -- direct messages (files in holex script hub v5/holexs data/chat/dms)
        ----------------------------------------------------------------
        local function dmPath(who) return V.F.dms .. "/" .. lower(who):gsub("[^%w%-%_]", "_") .. ".json" end
        function N.loadDM(who) return (V.json(dmPath(who)) or {}).messages or {} end
        function N.saveDM(who, msgs) V.saveJson(dmPath(who), {messages = msgs, updated = os.time()}) end
        function N.sendDM(to, text)
                text = tostring(text or ""):match("^%s*(.-)%s*$") or ""
                if text == "" then return false, "Empty message" end
                if lower(to) == lower(me()) then return false, "You cannot message yourself" end
                local msgs = N.loadDM(to)
                msgs[#msgs + 1] = {from = me(), to = to, m = text, t = os.time(), id = tostring(os.time()) .. math.random(100, 999)}
                while #msgs > 200 do table.remove(msgs, 1) end
                N.saveDM(to, msgs)
                local sent = post(N.topicRT, table.concat({"dm", me(), to, (text:gsub("|", "/")), tostring(os.time())}, "|"), "dm")
                return true, sent and "Sent" or "Saved locally (relay unreachable)"
        end

        ----------------------------------------------------------------
        -- event handling
        ----------------------------------------------------------------
        local Call -- forward
        local function handle(ev, firstPoll)
                if N.seen[ev.id] then return end
                N.seen[ev.id] = true
                local age = os.time() - (tonumber(ev.time) or os.time())
                local p = split(ev.message)
                local kind = p[1]
                if kind == "presence" and p[2] and p[2] ~= "" then
                        if age <= 120 and lower(p[2]) ~= lower(me()) then markOnline(p[2], {display = p[6], userid = tonumber(p[5]), version = p[4], source = "ntfy"}) end
                elseif kind == "account" and p[3] and p[3] ~= "" then
                        upsert({username = p[3], version = p[5], userid = tonumber(p[6]), robloxName = p[7], isOwner = p[9] == "1", lastSeen = tonumber(ev.time), source = p[2]})
                elseif kind == "chat" and p[2] and p[3] then
                        local mine = lower(p[2]) == lower(me())
                        local ts = tonumber(p[4]) or tonumber(ev.time) or os.time()
                        local isNew, ooo = N.addChat(p[2], p[3], ts)
                        if isNew then
                                if not mine then N.typing[p[2]] = nil end   -- their message arrived: stop showing "typing"
                                if N.onChat then N.onChat(p[2], p[3], ts, mine, ooo) end
                                if not firstPoll and not mine and age <= 1800 then Notify("Chat - " .. p[2], p[3]:sub(1, 80), 3) end
                        end
                        if not mine and age <= 120 then markOnline(p[2], {source = "chat"}) end
                elseif kind == "typing" and p[2] then
                        if age <= 8 and lower(p[2]) ~= lower(me()) then N.typing[p[2]] = os.time() end
                elseif kind == "dm" and p[2] and p[3] and p[4] then
                        if lower(p[3]) == lower(me()) and lower(p[2]) ~= lower(me()) and age <= 3600 * 3 then
                                local msgs = N.loadDM(p[2])
                                msgs[#msgs + 1] = {from = p[2], to = me(), m = p[4], t = tonumber(ev.time) or os.time(), id = ev.id}
                                while #msgs > 200 do table.remove(msgs, 1) end
                                N.saveDM(p[2], msgs)
                                if not firstPoll then Notify("Message from " .. p[2], p[4]:sub(1, 90), 4) end
                                if N.onDM then N.onDM(p[2]) end
                        end
                elseif kind == "call" and p[2] and age <= 60 then
                        Call.onSignal(p, ev)
                end
        end
        function N.pollAll(first)
                local evs = poll(N.topicRT, N.lastRT or "3h")
                for _, ev in ipairs(evs) do
                        if tonumber(ev.time) and (not N.lastRT or ev.time > N.lastRT) then N.lastRT = ev.time end
                        pcall(handle, ev, first)
                end
                return #evs
        end
        function N.pollChatHistory()
                local evs = poll(N.topicRT, "all", "&title=chat")
                local list = {}
                for _, ev in ipairs(evs) do
                        N.seen[ev.id] = true
                        local p = split(ev.message)
                        if p[1] == "chat" and p[2] and p[3] then
                                list[#list + 1] = {u = p[2], m = p[3], t = tonumber(p[4]) or tonumber(ev.time) or 0}
                        end
                end
                table.sort(list, function(a, b) return a.t < b.t end)
                local from = math.max(1, #list - 299)
                local added = 0
                for i = from, #list do
                        if N.addChat(list[i].u, list[i].m, list[i].t) then added += 1 end
                end
                if added > 0 and N.onChatRebuild then pcall(N.onChatRebuild) end
                return #evs, added
        end
        function N.pollAccounts()
                local evs = poll(N.topicAcc, N.lastAcc or "24h")
                for _, ev in ipairs(evs) do
                        if tonumber(ev.time) and (not N.lastAcc or ev.time > N.lastAcc) then N.lastAcc = ev.time end
                        pcall(handle, ev, true)
                end
        end

        ----------------------------------------------------------------
        -- v6.4  OWNER ACCOUNT TOOLS  (used by Settings > Owner and the
        -- owner panel at the bottom of the Chat tab)
        ----------------------------------------------------------------
        local function clearTbl(t) for k in pairs(t) do t[k] = nil end end
        local function saveAccountsNow()
                N.dirty = false
                pcall(function() V.saveJson(DBFILE, {accounts = N.accounts, saved = os.time()}) end)
        end
        -- deletes ONE account from the database
        function N.deleteAccount(name)
                local k = lower(name)
                local a = N.accounts[k]
                if not a then return false, "No account called " .. tostring(name) end
                N.accounts[k] = nil
                saveAccountsNow()
                V.ok("OWNER", "deleted account " .. tostring(a.username))
                return true, "Deleted " .. tostring(a.username)
        end
        -- resets every login counter
        function N.resetLogins()
                for _, a in pairs(N.accounts) do a.logins = 0 end
                saveAccountsNow()
                V.ok("OWNER", "login counters reset")
                return true
        end
        -- removes all flags
        function N.unflagAll()
                for _, a in pairs(N.accounts) do a.flagged = nil end
                saveAccountsNow()
                V.ok("OWNER", "all flags removed")
                return true
        end
        -- clears the online / presence list
        function N.wipePresence()
                clearTbl(N.presence)
                pcall(function() V.saveJson(V.F.data .. "/holex_online.json", {}) end)
                V.ok("OWNER", "online presence list cleared")
                return true
        end
        -- deletes EVERY account (fresh start). The table is cleared in place so
        -- every reference (PowerCore bridge, open panels) stays valid.
        function N.wipeAccounts()
                clearTbl(N.accounts)
                clearTbl(N.presence)
                N.lastAcc = os.time() + 2   -- do not replay old account events from the relay
                saveAccountsNow()
                pcall(function() V.saveJson(V.F.data .. "/holex_online.json", {}) end)
                V.ok("OWNER", "ALL accounts deleted - database is fresh")
                return true
        end
        -- database summary: accounts, online, flagged, file size (bytes)
        function N.dbInfo()
                local n, flagged, onN = 0, 0, 0
                for _, a in pairs(N.accounts) do
                        if type(a) == "table" and a.username then
                                n += 1
                                if a.flagged then flagged += 1 end
                                if N.isOnline(a.username) then onN += 1 end
                        end
                end
                local size = 0
                pcall(function() if isfile(DBFILE) then size = #readfile(DBFILE) end end)
                return n, onN, flagged, size
        end
        -- writes a readable .txt copy of the whole database, returns file path + count
        function N.dumpDatabase()
                local list = {}
                for _, a in pairs(N.accounts) do if type(a) == "table" and a.username then list[#list + 1] = a end end
                table.sort(list, function(x, y) return (x.lastSeen or 0) > (y.lastSeen or 0) end)
                local lines = {
                        "HOLEX SCRIPT HUB v5 - account database copy",
                        "saved: " .. os.date("%Y-%m-%d %H:%M:%S"),
                        "accounts: " .. #list,
                        "",
                }
                for i, a in ipairs(list) do
                        lines[#lines + 1] = string.format("%d. %s | roblox: %s (id %s) | logins: %s | created: %s | last seen: %s | owner: %s%s",
                                i, a.username or "?", a.robloxName or "?", tostring(a.userid or "?"), tostring(a.logins or 0),
                                a.createdAt and os.date("%Y-%m-%d", a.createdAt) or "?",
                                a.lastSeen and os.date("%Y-%m-%d %H:%M", a.lastSeen) or "?",
                                a.isOwner and "yes" or "no", a.flagged and " | FLAGGED" or "")
                end
                local f = V.F.data .. "/account_database_copy.txt"
                V.write(f, table.concat(lines, "\n"))
                return f, #list
        end

        function N.say(text, ts)
                text = tostring(text or ""):match("^%s*(.-)%s*$") or ""
                if text == "" then return false end
                local safe = text:gsub("|", "/")
                post(N.topicRT, table.concat({"chat", me(), safe, tostring(ts or os.time())}, "|"), "chat")
                V.discord(V.NETWORK_WEBHOOK, "Chat - " .. me(), "**" .. me() .. ":** " .. text:sub(1, 400), 3447003)
                V.act("CHAT", text:sub(1, 60))
                return true
        end

        task.spawn(function()
                task.wait(3)
                local first, lastPres, lastAcc, announced = true, 0, 0, false
                while not V.dead do
                        if V.cfg.net then
                                pcall(function()
                                        if not announced then
                                                announced = true
                                                N.publishAccount("session"); N.publishPresence(); lastPres = os.time()
                                                -- v6.4: owner login announcement
                                                if V.isOwner then
                                                        Notify("OWNER MODE", "Welcome back, owner! Roblox ID " .. LP.UserId .. " (" .. LP.Name .. ") is on the owner list. Owner tools: Settings > Owner and Chat > Owner database.", 6)
                                                        V.ok("OWNER", "owner account detected (Roblox ID " .. LP.UserId .. ")")
                                                end
                                        end
                                        if os.time() - lastPres >= 20 then lastPres = os.time(); N.publishPresence() end
                                        if first then pcall(N.pollChatHistory) end
                                        N.pollAll(first); first = false
                                        if N.chatDirty then N.chatDirty = false; V.saveJson(CHATFILE, {messages = N.chatHist, saved = os.time()}) end
                                        if os.time() - lastAcc >= 40 then lastAcc = os.time(); N.pollAccounts() end
                                        if N.dirty then N.dirty = false; V.saveJson(DBFILE, {accounts = N.accounts, saved = os.time()}) end
                                end)
                        end
                        task.wait(4)
                end
        end)

        ----------------------------------------------------------------
        -- friends + groups (stored in the hub save file)
        ----------------------------------------------------------------
        function N.friends() return V.get("friends", {}) end
        function N.addFriend(name)
                name = tostring(name or ""):match("^%s*(.-)%s*$") or ""
                if name == "" then return false, "Enter a username" end
                if lower(name) == lower(me()) then return false, "You cannot add yourself" end
                local f = N.friends()
                if f[name] then return false, "Already friends" end
                f[name] = {addedAt = os.time()}
                V.set("friends", f)
                V.ok("FRIENDS", "Added " .. name)
                return true, "Added " .. name
        end
        function N.removeFriend(name)
                local f = N.friends()
                if f[name] then f[name] = nil; V.set("friends", f); return true end
                return false
        end
        function N.groups() return V.get("groups", {}) end
        function N.createGroup(name, members)
                name = tostring(name or ""):match("^%s*(.-)%s*$") or ""
                if #name < 2 then return false, "Name too short" end
                if #name > 32 then return false, "Name max 32 characters" end
                local g = N.groups()
                local id = "g_" .. tostring(os.time()) .. "_" .. math.random(100, 999)
                local mem, has = {}, false
                for _, m in ipairs(members) do mem[#mem + 1] = m; if lower(m) == lower(me()) then has = true end end
                if not has then table.insert(mem, 1, me()) end
                g[id] = {id = id, name = name, members = mem, owner = me(), created = os.time(), discord = ""}
                V.set("groups", g)
                return true, id
        end
        function N.groupEdit(id, fn)
                local g = N.groups()
                if not g[id] then return false, "Group id not found" end
                local ok, err = pcall(fn, g[id], g)
                if not ok then return false, (tostring(err):gsub("^.-:%d+: ", "")) end
                V.set("groups", g)
                return true
        end

        ----------------------------------------------------------------
        -- voice calls (signalling over the relay; real audio goes through Discord)
        ----------------------------------------------------------------
        Call = {active = false, id = nil, target = nil, isGroup = false, muted = false, deaf = false, started = 0, discord = "", pending = nil, ring = nil, mic = "Default", people = {}}
        V.Call = Call
        N.ringtones = {
                {"Default ring", "rbxassetid://9066622054"},
                {"Franklin (GTA)", "https://raw.githubusercontent.com/ultragamer850/ringtone/main/Y2Mate.is%20-%20Franklins%20ringtone.mp3"},
                {"Michael (GTA)", "https://raw.githubusercontent.com/ultragamer850/ringtone/main/Y2Mate.is%20-%20Micheal%20ringtone%20gta.mp3"},
                {"Classic", "rbxassetid://12222208"}, {"Digital", "rbxassetid://12222200"}, {"Soft chime", "rbxassetid://515373382"},
                {"Alert", "rbxassetid://9113905846"}, {"Marimba", "rbxassetid://5419306116"}, {"Arcade", "rbxassetid://9113887540"},
                {"Space", "rbxassetid://9125512968"}, {"Retro", "rbxassetid://6026984224"}, {"Glass", "rbxassetid://4590662766"},
                {"Door", "rbxassetid://286833208"}, {"Radar", "rbxassetid://131321552"}, {"Coin", "rbxassetid://276970363"},
