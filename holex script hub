--------------------------------------------------------------
HX.Suspects = {}
HX.NeckPatched = 0
HX.LastScan = {}

local function gToast(title, msg, kind)
        if HX.Settings.GuardToasts == false then return end
        if HX.UI and HX.UI.toast then pcall(HX.UI.toast, title, msg, kind or "good") end
end

local function looksRandomName(n)
        if type(n) ~= "string" or #n < 8 or #n > 16 then return false end
        if not string.match(n, "^%w+$") then return false end
        return string.match(n, "%l") ~= nil and string.match(n, "%u") ~= nil
end

local function jointLinked(a, b)
        for _, root in ipairs({ a, b }) do
                for _, d in ipairs(root:GetChildren()) do
                        if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
                                local p0, p1 = d.Part0, d.Part1
                                if (p0 == a and p1 == b) or (p0 == b and p1 == a) then return true end
                        end
                end
        end
        return false
end

-- Adds a stub "Neck" Motor6D under Torso when an R6-style rig has none, so scripts that do
-- torso.Neck (the reanimate, a game script, an emote script) stop throwing.
function HX.patchNeck(model)
        if HX.Settings.NeckPatch == false then return false end
        if typeof(model) ~= "Instance" or not model.Parent then return false end
        local torso = model:FindFirstChild("Torso")
        if not (torso and torso:IsA("BasePart")) then return false end
        if torso:FindFirstChild("Neck") then return false end
        local ok = pcall(function()
                local neck = Instance.new("Motor6D")
                neck.Name = "Neck"
                neck:SetAttribute("HolexStub", true)
                neck.C0 = CFrame.new(0, 1, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
                neck.C1 = CFrame.new(0, -0.5, 0, -1, 0, 0, 0, 0, 1, 0, 1, 0)
                neck.Part0 = torso
                local head = model:FindFirstChild("Head")
                -- only connect the head if nothing else already holds it (never fight the reanimate's own joints)
                if head and head:IsA("BasePart") and not jointLinked(torso, head) then neck.Part1 = head end
                neck.Parent = torso
        end)
        if ok then
                HX.NeckPatched = HX.NeckPatched + 1
                HX.logAdd("[Holex] Neck patched on " .. model:GetFullName())
        end
        return ok
end

function HX.patchAllNecks()
        local n = 0
        local done = {}
        local function go(m)
                if m and not done[m] then
                        done[m] = true
                        if HX.patchNeck(m) then n = n + 1 end
                end
        end
        pcall(function() go(HX.figure()) end)
        pcall(function() go(LocalPlayer.Character) end)
        pcall(function() for _, e in ipairs(HX.findFakeRigs()) do go(e.model) end end)
        pcall(function() for _, e in ipairs(HX.Suspects) do go(e.model) end end)
        return n
end

local REANIM_PAT = { "genesis", "melon", "reanim", "netless", "fdless", "uhhh", "patchma", "locust", "sier",
        "nexo", "hatsploit", "permadeath", "hatreanim", "fakechar", "fakerig" }

local function matchPat(s)
        s = string.lower(tostring(s))
        for _, p in ipairs(REANIM_PAT) do
                if string.find(s, p, 1, true) then return p end
        end
        return nil
end

local function bodyOf(m)
        return m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso") or m:FindFirstChild("UpperTorso")
end

-- Finds client-side rigs: random-named models, models we network-own, name hits, clones of our name,
-- nil-parented models (optional). Cheap enough to run every couple of seconds.
function HX.scanRigs(includeNil)
        local out, seen = {}, {}
        local char = LocalPlayer.Character
        local function add(m, why)
                if seen[m] then
                        return
                end
                seen[m] = true
                out[#out + 1] = { model = m, why = why }
        end
        local function consider(m)
                if not m:IsA("Model") or m == char or isOtherPlayer(m) then return end
                local body = bodyOf(m)
                if not body then return end
                local reasons = {}
                if looksRandomName(m.Name) and m:FindFirstChildOfClass("Humanoid") then reasons[#reasons + 1] = "random name" end
                local pat = matchPat(m.Name)
                if pat then reasons[#reasons + 1] = "name has '" .. pat .. "'" end
                if string.find(m.Name, LocalPlayer.Name, 1, true) then reasons[#reasons + 1] = "clone of you" end
                if isnetworkowner and body:IsA("BasePart") and m.Parent == Workspace then
                        local okn, own = pcall(isnetworkowner, body)
                        if okn and own and m:FindFirstChildOfClass("Humanoid") and not body.Anchored then reasons[#reasons + 1] = "you own its physics" end
                end
                if #reasons > 0 then add(m, table.concat(reasons, ", ")) end
        end
        for _, m in ipairs(Workspace:GetChildren()) do consider(m) end
        local cam = Workspace.CurrentCamera
        local subj = cam and cam.CameraSubject
        if subj then
                local mdl = subj:IsA("Humanoid") and subj.Parent or (subj:IsA("BasePart") and subj:FindFirstAncestorOfClass("Model")) or nil
                if mdl and mdl:IsA("Model") and mdl ~= char and not isOtherPlayer(mdl) and bodyOf(mdl) then
                        add(mdl, "camera subject")
                end
        end
        if includeNil and getnilinstances then
                pcall(function()
                        for _, i in ipairs(getnilinstances()) do
                                if i:IsA("Model") and bodyOf(i) and not seen[i] then add(i, "nil-parented rig") end
                        end
                end)
        end
        return out
end

-- Everything that hints a reanimate is running: globals, executor env, running scripts, character state.
function HX.reanimateSignals(deep)
        local s = {}
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local cf = cameraFigure()
        if cf and cf ~= char then s[#s + 1] = "camera follows another rig: " .. cf:GetFullName() end
        if hum and hum.Health <= 0 then s[#s + 1] = "real character is dead (permadeath-style reanimate)" end
        if char then
                local loose = 0
                for _, a in ipairs(char:GetChildren()) do
                        if a:IsA("Accessory") then
                                local h = a:FindFirstChild("Handle")
                                if h and not (h:FindFirstChildOfClass("Weld") or h:FindFirstChildOfClass("Motor6D") or h:FindFirstChildOfClass("WeldConstraint")) then
                                        loose = loose + 1
                                end
                        end
                end
                if loose > 0 then s[#s + 1] = loose .. " hat(s) detached from the real character (hat reanimate)" end
                if not (char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")) then
                        s[#s + 1] = "real character has no torso (body replaced / removed)"
                end
        end
        local hits = 0
        pcall(function()
                local envs = { _G }
                if getgenv then envs[#envs + 1] = getgenv() end
                for _, env in ipairs(envs) do
                        for k, v in pairs(env) do
                                if hits < 20 and type(k) == "string" and (type(v) == "table" or type(v) == "function") then
                                        local p = matchPat(k)
                                        if p and v ~= HX and k ~= "__HolexHatCollision" then
                                                hits = hits + 1
                                                s[#s + 1] = "global '" .. k .. "' (" .. type(v) .. ") matches '" .. p .. "'"
                                        end
                                end
                        end
                end
        end)
        if deep then
                pcall(function()
                        local list = (getrunningscripts and getrunningscripts()) or (getscripts and getscripts()) or {}
                        local n = 0
                        for _, sc in ipairs(list) do
                                if n < 15 then
                                        local p = matchPat(sc.Name)
                                        if p then n = n + 1 s[#s + 1] = "script '" .. sc:GetFullName() .. "' matches '" .. p .. "'" end
                                end
                        end
                end)
                pcall(function()
                        for _, h in ipairs(HX.scanGuiHints() or {}) do s[#s + 1] = "GUI [" .. tostring(h.kw) .. "] " .. tostring(h.text) end
                end)
        end
        return s
end

function HX.deepScan()
        local rigs = HX.scanRigs(HX.Settings.ScanNil == true)
        HX.Suspects = rigs
        local sig = HX.reanimateSignals(true)
        local lines = {}
        for _, r in ipairs(rigs) do lines[#lines + 1] = "rig: " .. r.model:GetFullName() .. "  (" .. r.why .. ")" end
        for _, x in ipairs(sig) do lines[#lines + 1] = "signal: " .. x end
        HX.LastScan = lines
        HX._figT = 0
        local patched = HX.patchAllNecks()
        HX.logAdd("[Holex] deep scan: " .. #rigs .. " rig(s), " .. #sig .. " signal(s), " .. patched .. " Neck patch(es)")
        for _, l in ipairs(lines) do HX.logAdd("  " .. l) end
        HX.updateRigList()
        gToast("Scan done", #rigs .. " rig(s) · " .. #sig .. " signal(s) · " .. patched .. " Neck patch(es)", (#rigs + #sig) > 0 and "warn" or "good")
        return lines
end

function HX.updateRigList()
        local ui = HX.UI
        if not (ui and ui.rigList) then return end
        local txt = {}
        for i, l in ipairs(HX.LastScan or {}) do
                if i > 12 then txt[#txt + 1] = "…" break end
                txt[#txt + 1] = l
        end
        pcall(function()
                ui.rigList:SetText(#txt > 0 and table.concat(txt, "\n") or "Scan result: nothing detected yet (press Deep scan)")
        end)
        pcall(function()
                if ui.rigStats then ui.rigStats:SetText("Neck patches: " .. HX.NeckPatched .. "  ·  suspected rigs: " .. #HX.Suspects) end
        end)
end

function HX.applyNoAnim()
        local m = HX.m
        if not m or HX.Settings.NoAnimations == false then return end
        m.FigAnim = false
        m.WalkRunAnim = false
        m.FigKillDefaults = false
        pcall(function() if m.X.FigAnimOn then m.X.figRestore() end end)
        pcall(function()
                for npc in pairs(m.X.NPCAnimTracks) do m.X.stopNPCAnim(npc) end
        end)
end

local function resolvePath(path)
        local cur = game
        for seg in string.gmatch(path, "[^%.]+") do
                if cur == game and seg == "Workspace" then cur = Workspace
                else cur = cur and cur:FindFirstChild(seg) end
                if not cur then return nil end
        end
        return cur
end

function HX.startRigGuard()
        -- 1) react to "X is not a valid member of Part "Workspace.Rig.Torso"" errors in the output log
        pcall(function()
                local LogService = game:GetService("LogService")
                keepConn(LogService.MessageOut:Connect(function(msg, mtype)
                        if HX.unloaded or HX.Settings.AutoPatchErrors == false then return end
                        if mtype ~= Enum.MessageType.MessageError then return end
                        local member, path = string.match(msg, '(%S+) is not a valid member of %S+ "([^"]+)"')
                        if not member then member, path = string.match(msg, "(%S+) is not a valid member of %S+ ([%w%._]+)") end
                        if member == "Neck" and path then
                                local inst = resolvePath(path)
                                local model = inst and (inst.Name == "Torso" and inst.Parent or inst)
                                if model and HX.patchNeck(model) then
                                        gToast("Neck error fixed", "Added a Neck joint to " .. model.Name, "good")
                                end
                        end
                end))
        end)

        -- 2) new models in Workspace: patch right away (twice: children often arrive a moment later)
        keepConn(Workspace.ChildAdded:Connect(function(c)
                if HX.unloaded or not c:IsA("Model") or isOtherPlayer(c) then return end
                for _, d in ipairs({ 0, 0.15, 0.6 }) do
                        task.delay(d, function()
                                if not HX.unloaded and c.Parent and (looksRandomName(c.Name) or matchPat(c.Name) or c == HX._figC) then
                                        pcall(HX.patchNeck, c)
                                end
                        end)
                end
        end))

        -- 3) watchdog
        task.spawn(function()
                while not HX.unloaded do
                        task.wait(math.clamp(tonumber(HX.Settings.WatchdogInterval) or 2, 1, 10))
                        if HX.unloaded then break end
                        if HX.Settings.RigWatchdog ~= false then
                                pcall(function()
                                        HX.Suspects = HX.scanRigs(HX.Settings.ScanNil == true)
                                        HX.patchAllNecks()
                                        HX.applyNoAnim()
                                        HX.updateRigList()
                                end)
                        else
                                pcall(HX.applyNoAnim)
                        end
                end
        end)
end

