        function X.panApplyHit(model, part)
                if not (model and part) then return end
                local dmg = tonumber(m.PanDamage) or 28
                local knock = tonumber(m.PanKnock) or 160
                local up = tonumber(m.PanKnockUp) or 55
                local mult = X.powerMult and X.powerMult() or 1
                X.PanHitCount = (X.PanHitCount or 0) + 1
                local n = X.PanHitCount
                local cam = Workspace.CurrentCamera
                local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
                local vel = look * knock * mult + Vector3.new(0, up * mult, 0)
                -- critical every 3rd hit
                local isCrit = (n % 3 == 0)
                local isSix = (n % 6 == 0)
                if isCrit then
                        dmg = dmg * 1.75
                        vel = vel * 1.45
                end
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum then
                        pcall(X.combatHurtHumanoid, hum, dmg)
                end
                pcall(function()
                        part.AssemblyLinearVelocity = vel
                        for _, p in ipairs(model:GetDescendants()) do
                                if p:IsA("BasePart") and p ~= part then
                                        p.AssemblyLinearVelocity = vel
                                end
                        end
                end)
                -- SFX chain
                X.playSFX(m.PanHitSFXId, m.PanHitSFXVolume or 1, part)
                if isSix then
                        X.playSFX(m.PanSixSFXId, m.PanSixSFXVolume or 1, part)
                        X.playSFX(m.PanLaughSFXId, m.PanLaughSFXVolume or 1, part)
                elseif isCrit then
                        X.playSFX(m.PanCritSFXId, m.PanCritSFXVolume or 1, part)
                        X.playSFX(m.PanLaughSFXId, m.PanLaughSFXVolume or 1, part)
                else
                        X.playSFX(m.PanVoiceSFXId, m.PanVoiceSFXVolume or 1, part)
                end
                warn(string.format("[HatCollision] Pan hit #%d%s dmg=%.0f", n, isSix and " SIX!" or (isCrit and " CRIT!" or ""), dmg * mult))
        end

