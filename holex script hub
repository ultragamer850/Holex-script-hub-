                                        if not okw then return end
                                end
                        end
                        -- v6.2: never hand Roblox a corrupt / renamed media file (engine load-error spam fix)
                        if (ext == "webm" or ext == "mp4" or ext == "ogv") then
                                if not X.vidMagicOk(path) then
                                        if file == "boot_media.webm" and X.RepairBootClip() then
                                                log("OK    cached clip was invalid - rebuilt the built-in clip", "ok")
