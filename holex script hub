        -- ===== Goku power-up pose (applied on top of the figure's procedural pose) =====
        function X.puStancePose(now)
                -- Goku fighting stance: staggered legs, lead fist up in guard, rear fist low, body turned, slow breathing
                local fwdA, abd = 0.34, math.rad(16)
                local th = math.sqrt(abd * abd + fwdA * fwdA)
                local br = math.sin(now * 2.6)
                local br2 = math.sin(now * 2.6 + 1.2)
                return {
                        dy = -(2 - 2 * math.cos(th)) + 0.02 * br, lean = 0.1 + 0.015 * br, hp = 0.1,
                        yaw = 0.35, roll = 0.015 * math.sin(now * 0.9),
                        rL = fwdA, lL = -fwdA, rLA = abd, lLA = abd,
                        rK = 0.9 + 0.05 * br2, rA = math.rad(-18),
                        lK = -0.3 + 0.04 * br, lA = math.rad(28),
                }
        end

        function X.powerUpPoseOverlay(P, state, now)
                local ph = X.PUPhase
                if not ph or m.PowerUpGokuAnim == false then return P end
                if state ~= "Idle" then
                        -- powered walk / run / jump / fall (flying has its own pose); charge + burst still need Idle
                        if ph == "on" and m.PowerUpPoweredStance ~= false and state ~= "Fly" and X.puStateOverlay then
                                return X.puStateOverlay(P, state, now)
                        end
                        return P
                end
                local S = math.clamp(tonumber(m.PowerUpAnimStrength) or 1, 0.2, 1.5)
                local w = math.min(1, S)
                local rad = math.rad
                local function legDy(a) return -(2 - 2 * math.cos(a)) end -- keeps the feet on the floor when the legs spread
                local function setPose(T, k)
                        for key, v in pairs(T) do
                                if P[key] ~= nil then P[key] = lerpn(P[key], v, k) end
                        end
                end
                local trem = 0
                if ph == "charge" then
                        local p = math.clamp((now - X.PUT0) / math.max(X.PUDur, 0.1), 0, 1)
                        local T
                        if p < 0.3 then
                                -- 1) drop into a wide stance, fists pulled down and back
                                local a = ssmooth(p / 0.3)
                                local abd = rad(8 + 18 * a)
                                T = {
                                        dy = legDy(abd), lean = 0.2 * a, hp = 0.05 * a,
                                        rK = lerpn(0.04, -0.4, a), lK = lerpn(0.04, -0.4, a),
                                        rA = rad(10 + 14 * a), lA = rad(10 + 14 * a),
                                        rLA = abd, lLA = abd, rL = 0, lL = 0,
                                }
                                trem = 0.15 * a
                        elseif p < 0.85 then
                                -- 2) the scream: arms flex out, chest rises, head back, whole body shakes harder
                                local b = ssmooth((p - 0.3) / 0.55)
                                local abd = rad(26 + 10 * b)
                                T = {
                                        dy = legDy(abd), lean = lerpn(0.2, -0.04, b), hp = lerpn(0.05, 0.5, b),
                                        rK = lerpn(-0.4, -0.12, b), lK = lerpn(-0.4, -0.12, b),
                                        rA = rad(24 + 40 * b), lA = rad(24 + 40 * b),
                                        rLA = abd, lLA = abd, rL = 0, lL = 0,
                                }
                                trem = 0.35 + 0.65 * b
                        else
                                -- 3) wind-up: crouch tight, fists in, right before the burst
                                local c = ssmooth((p - 0.85) / 0.15)
                                local abd = rad(36 + 2 * c)
                                T = {
                                        dy = legDy(abd), lean = lerpn(-0.04, 0.24, c), hp = lerpn(0.5, 0.15, c),
                                        rK = lerpn(-0.12, -0.5, c), lK = lerpn(-0.12, -0.5, c),
                                        rA = rad(64 - 40 * c), lA = rad(64 - 40 * c),
                                        rLA = abd, lLA = abd, rL = 0, lL = 0,
                                }
                                trem = 1
                        end
                        setPose(T, w)
                elseif ph == "burst" then
                        -- arms snap out, chest forward, head back, then relax into the powered stance
                        local bt = now - X.PUBurstT0
                        local k = 1 - ssmooth(bt / 0.9)
                        local abd = rad(34)
                        local thrust = {
                                dy = legDy(abd), lean = -0.2, hp = 0.6, rK = 0, lK = 0,
                                rA = rad(100), lA = rad(100), rLA = abd, lLA = abd, rL = 0, lL = 0,
                        }
                        local stance = X.puStancePose(now)
                        local T = {}
                        for key, v in pairs(thrust) do T[key] = lerpn(stance[key], v, k) end
                        setPose(T, w)
                        trem = 0.15 + 0.8 * k
                elseif ph == "on" and m.PowerUpPoweredStance ~= false then
                        setPose(X.puStancePose(now), w)
                        trem = 0.12
                end
                if trem > 0 then
                        local tr = trem * S
                        P.yaw = P.yaw + 0.05 * tr * math.sin(now * 57)
                        P.roll = P.roll + 0.04 * tr * math.sin(now * 49 + 1.3)
                        P.dy = P.dy + 0.04 * tr * math.sin(now * 63)
                        P.rA = P.rA + 0.07 * tr * math.sin(now * 51)
                        P.lA = P.lA + 0.07 * tr * math.sin(now * 51 + 2)
                end
                return P
        end


        --------------------------------------------------------------
        -- POWERED ANIMATIONS (v7): better stance + walk / run / jump / fall + FLYING
        --------------------------------------------------------------
        function X.puStateOverlay(P, state, now)
                if m.PowerUpStateAnims == false then return P end
                local S = math.clamp(tonumber(m.PowerUpAnimStrength) or 1, 0.2, 1.5)
                local w = math.min(1, S)
                local rad = math.rad
                local function setPose(T, k)
                        for key, v in pairs(T) do
                                if P[key] ~= nil then P[key] = lerpn(P[key], v, k) end
                        end
                end
                local s = math.sin(X.FigTW or 0)
                if state == "Walk" then
                        -- confident power walk: chest out, arms flared away from the body, smaller arm swing
                        setPose({
                                lean = P.lean + 0.05, hp = 0.1, dy = P.dy - 0.05, yaw = P.yaw * 0.6,
                                rK = P.rK * 0.5, lK = P.lK * 0.5,
                                rA = rad(26) + 0.05 * math.sin(now * 3), lA = rad(26) + 0.05 * math.sin(now * 3 + 1),
                                rLA = rad(9), lLA = rad(9),
                        }, w)
                elseif state == "Run" then
                        -- anime sprint: deep forward lean, arms swept straight back, head up, long strides
                        setPose({
                                lean = 0.5, hp = 0.38, yaw = P.yaw * 0.7,
                                rK = -0.85 - 0.3 * s, lK = -0.85 + 0.3 * s,
                                rA = rad(7), lA = rad(7),
                                rL = P.rL * 1.15, lL = P.lL * 1.15,
                        }, w)
                elseif state == "Jump" then
                        -- launch: arms flung up and out, chest open, one knee tucked
                        local fl = 0.05 * math.sin(now * 9)
                        setPose({
                                lean = -0.06, hp = 0.25,
                                rK = 1.3 + fl, lK = 1.1 - fl, rA = rad(50), lA = rad(50),
                                rL = 0.55, lL = -0.2, rLA = rad(12), lLA = rad(12),
                        }, w)
                elseif state == "Fall" then
                        -- superhero fall: spread arms at first, then dives head-first with arms swept overhead
                        local fk = math.clamp(-(X.FigVy or 0) / 60, 0.2, 1)
                        local fl = math.sin(now * 11)
                        setPose({
                                lean = 0.08 + 0.4 * fk, hp = lerpn(0.3, 0.1, fk),
                                rK = lerpn(0.5, 1.85, fk) + 0.08 * fl, lK = lerpn(0.5, 1.85, fk) - 0.08 * fl,
                                rA = rad(lerpn(62, 14, fk)), lA = rad(lerpn(62, 14, fk)),
                                rL = 0.2 - 0.45 * fk + 0.15 * fl, lL = -0.1 - 0.45 * fk - 0.15 * fl,
                                rLA = rad(14), lLA = rad(14),
                        }, w)
                end
                -- tiny ki tremble on everything powered
                P.rA = P.rA + 0.025 * math.sin(now * 50)
                P.lA = P.lA + 0.025 * math.sin(now * 50 + 2)
                return P
        end

        -- flying pose (works whenever you are flying)
        function X.pfPoseOverlay(P, state, now)
                if state ~= "Fly" then return P end
                local v = X.PFVel or Vector3.zero
                local base = math.max(tonumber(m.PowerFlySpeed) or 70, 5)
                local face = X.PFFace or Vector3.new(0, 0, -1)
                local right = face:Cross(Vector3.yAxis)
                local vf = v:Dot(face) / base
                local lat = (right.Magnitude > 0.01) and (v:Dot(right.Unit) / base) or 0
                local fastK = ssmooth(math.clamp((vf - 0.1) / 0.7, 0, 1))
                local bob = math.sin(now * 2.2)
                local rad = math.rad
                local S = math.clamp(tonumber(m.PowerUpAnimStrength) or 1, 0.2, 1.5)
                local w = math.min(1, S)
                local T = {
                        -- hover: relaxed, arms back at the sides. fast: superman with one fist forward, legs trailing
                        lean = 0.12 + 0.95 * fastK + 0.35 * math.min(vf, 0),
                        hp = lerpn(0.1, 0.55, fastK),
                        rK = lerpn(-0.2, 1.95, fastK), lK = lerpn(-0.2, -0.45, fastK),
                        rA = rad(lerpn(16, 6, fastK)), lA = rad(lerpn(16, 10, fastK)),
                        rL = lerpn(-0.1, -0.35, fastK) + 0.05 * math.sin(now * 5), lL = lerpn(-0.2, -0.5, fastK) - 0.05 * math.sin(now * 5),
                        rLA = rad(lerpn(6, 3, fastK)), lLA = rad(lerpn(6, 3, fastK)),
                        dy = 0.05 * bob, roll = -0.3 * math.clamp(lat, -1, 1),
                }
                for key, val in pairs(T) do
                        if P[key] ~= nil then P[key] = lerpn(P[key], val, w) end
                end
                P.rA = P.rA + 0.02 * math.sin(now * 40)
                P.lA = P.lA + 0.02 * math.sin(now * 40 + 2)
                return P
        end

        function X.pfSet(on)
                on = on and true or false
                if on == (X.Flying == true) then return end
                local fig = X.getMyCharacter()
                local hum = fig and fig:FindFirstChildOfClass("Humanoid")
                if on then
                        local root = fig and X.getRoot(fig)
                        if not root then return end
                        X.Flying = true
                        X.PFHum = hum
                        X.PFOldPS = hum and hum.PlatformStand
                        if hum then pcall(function() hum.PlatformStand = true end) end
                        X.PFVel = Vector3.new(0, 14, 0)
                        X.PFFace = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
                        warn("[HatCollision] Flying ON  (W/A/S/D = camera direction, Space up, Ctrl down, Shift boost)")
                else
                        X.Flying = false
                        local h = X.PFHum or hum
                        if h then pcall(function() h.PlatformStand = (X.PFOldPS == true) end) end
                        X.PFHum, X.PFVel = nil, nil
                        warn("[HatCollision] Flying OFF")
                end
        end

        function X.pfStep(dt)
                if not X.Flying then return end
                local fig = X.getMyCharacter()
                local root = fig and X.getRoot(fig)
                if not root then X.pfSet(false) return end
                local cam = Workspace.CurrentCamera
                if not cam then return end
                local now = os.clock()
                local typing = UserInputService:GetFocusedTextBox() ~= nil
                local function down(k) return (not typing) and UserInputService:IsKeyDown(k) end
                local fwd = (down(Enum.KeyCode.W) and 1 or 0) - (down(Enum.KeyCode.S) and 1 or 0)
                local side = (down(Enum.KeyCode.D) and 1 or 0) - (down(Enum.KeyCode.A) and 1 or 0)
                local up = (down(Enum.KeyCode.Space) and 1 or 0) - (down(Enum.KeyCode.LeftControl) and 1 or 0)
                local dir = cam.CFrame.LookVector * fwd + cam.CFrame.RightVector * side + Vector3.new(0, up, 0)
                local fast = down(Enum.KeyCode.LeftShift)
                local spd = fast and (tonumber(m.PowerFlyFastSpeed) or 140) or (tonumber(m.PowerFlySpeed) or 70)
                local target = Vector3.zero
                if dir.Magnitude > 0.05 then target = dir.Unit * spd end
                target = target + Vector3.new(0, math.sin(now * 2.2) * 1.2, 0) -- hover bob
                local accel = math.max(tonumber(m.PowerFlyAccel) or 7, 1)
                local a = 1 - math.exp(-accel * math.clamp(dt or 0.016, 0, 0.1))
                X.PFVel = (X.PFVel or root.AssemblyLinearVelocity):Lerp(target, a)
                pcall(function()
                        root.AssemblyLinearVelocity = X.PFVel
                        root.AssemblyAngularVelocity = Vector3.zero
                end)
                -- face the camera direction (flat), kept upright
                local look = cam.CFrame.LookVector
                local flat = Vector3.new(look.X, 0, look.Z)
                if flat.Magnitude > 0.05 then
                        flat = flat.Unit
                        X.PFFace = flat
                        pcall(function()
                                root.CFrame = root.CFrame:Lerp(CFrame.lookAt(root.Position, root.Position + flat), 1 - math.exp(-10 * math.clamp(dt or 0.016, 0, 0.1)))
                        end)
                end
        end

