local function switch(name)
        if current == name then return end
        local oldName = current
        current = name
        if oldName == "Home" then stopClock() end
        local hk0 = oldName and X.Tab[oldName]
        if hk0 then pcall(hk0, false) end
        for n, b in pairs(tabBtns) do
                tw(b.lbl, 0.3, {TextColor3 = (n == name) and Theme.text or Theme.sub})
                tw(b.lbl, 0.3, {Position = UDim2.fromOffset(n == name and 26 or 20, 0)})
        end
        for i, n in ipairs(tabOrder) do
                if n == name then tw(indicator, 0.45, {Position = UDim2.fromOffset(0, 14 + (i - 1) * 34)}, Enum.EasingStyle.Back) end
        end
        if oldName then
                local op = pages[oldName]
                if op then
                        tw(op, 0.25, {GroupTransparency = 1, Position = UDim2.fromOffset(0, -14)}).Completed:Connect(function()
                                if current ~= oldName and op then op.Visible = false end
                        end)
                end
        end
        local np = pages[name]
        if not np then return end
        np.Visible = true
        np.GroupTransparency = 1
        np.Position = UDim2.fromOffset(0, 18)
        tw(np, 0.5, {GroupTransparency = 0, Position = UDim2.new()})
        if name == "Home" and visible then startClock() end
