        --------------------------------------------------------------
        -- UNANCHORED PARTS — bring to Steve / orbit around me (12 modes)
        -- Only loose, unanchored parts that are NOT part of any character /
        -- accessory / tool / Uhhhhhh folder are touched, and (by default) only
        -- parts your client is network owner of.
        --------------------------------------------------------------
        local PartList = {}
        local PartSet = setmetatable({}, { __mode = "k" })
        local PartSaved = setmetatable({}, { __mode = "k" })
        local PartAlign = setmetatable({}, { __mode = "k" })
        X.PartsTrail = {}
        X.PartsPoint = nil
        X.PartsActive = false

        local function skipNameSet()
                local set = {}
                for n in string.gmatch(string.lower(tostring(m.PartsSkipNames or "")), "[^,%s]+") do set[n] = true end
                return set
        end

        function X.partsOwned(part)
                if isnetworkowner then
                        local ok, r = pcall(isnetworkowner, part)
                        if ok then return r == true end
                end
                return true
        end

        function X.partsAnchor()
                local t = tonumber(m.PartsTarget) or 1
                if t == 3 then
                        local ok, hit = pcall(function() return Mouse.Hit end)
                        if ok and hit then return CFrame.new(hit.Position) end
                elseif t == 4 then
                        if X.PartsPoint then return X.PartsPoint end
                end
                local root
                if t == 2 then
                        local c = LocalPlayer.Character
                        root = c and X.getRoot(c)
                else
                        root = X.getMyHRP()
                end
                if not root or not root.Parent then
                        local c = LocalPlayer.Character
                        root = c and X.getRoot(c)
                end
                if root and root.Parent then
                        local cf = root.CFrame
                        local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
                        if look.Magnitude < 1e-3 then look = Vector3.new(0, 0, -1) end
                        return CFrame.lookAt(cf.Position, cf.Position + look)
                end
                return nil
        end

        function X.partsIsLoose(part, skip)
                if not part or not part.Parent or not part:IsA("BasePart") then return false end
                if part:IsA("Terrain") or part.Anchored then return false end
                if string.sub(part.Name, 1, 3) == "HC_" then return false end
                if skip[string.lower(part.Name)] then return false end
                local grabAll = (m.PartsGrabAll == true)
                if not grabAll then
                        local sz = part.Size
                        local longest = math.max(sz.X, sz.Y, sz.Z)
                        if longest > (tonumber(m.PartsMaxSize) or 25) or longest < (tonumber(m.PartsMinSize) or 0.3) then return false end
                end
                -- never my own figure / character / hats
                local fig = X.getMyCharacter()
                if fig and part:IsDescendantOf(fig) then return false end
                local mine = LocalPlayer.Character
                if mine and part:IsDescendantOf(mine) then return false end
                local incNPC = grabAll or m.PartsIncludeNPCs == true
                local incTool = grabAll or m.PartsIncludeTools == true
                local a = part.Parent
                while a and a ~= Workspace do
                        if a:IsA("Model") then
                                -- never another player's character
                                if Players:GetPlayerFromCharacter(a) then return false end
                                if a:FindFirstChildOfClass("Humanoid") and not incNPC then return false end
                        end
                        if (a:IsA("Accessory") or a:IsA("Accoutrement") or a:IsA("Tool")) and not incTool then return false end
                        local nm = a.Name
                        if string.sub(nm, 1, 7) == "Uhhhhhh" or string.sub(nm, 1, 6) == "HatRig" then return false end
                        a = a.Parent
                end
                return true
        end

        function X.partsRestoreOne(p)
                local sv = PartSaved[p]
                if sv then
                        pcall(function() if p.Parent then p.CanCollide = sv.cc end end)
                        PartSaved[p] = nil
                end
                local al = PartAlign[p]
                if al then
                        pcall(function() al.ap:Destroy() end)
                        pcall(function() al.ao:Destroy() end)
                        pcall(function() al.att:Destroy() end)
                        PartAlign[p] = nil
                end
                PartSet[p] = nil
                X.PartGrabT[p] = nil
        end

        function X.partsRelease(yeet)
                yeet = yeet or (m.YeetOnRelease == true)
                local didYeet = false
                local look = Vector3.new(0, 0, -1)
                local hrp = X.getMyHRP()
                if hrp then
                        local fl = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
                        if fl.Magnitude > 1e-3 then look = fl.Unit end
                end
                local power = tonumber(m.YeetPower) or 2.2
                local up = tonumber(m.YeetUpBias) or 0.55
                for i = #PartList, 1, -1 do
                        local p = PartList[i]
                        pcall(function()
                                if p.Parent then
                                        if yeet then
                                                local base = p.AssemblyLinearVelocity
                                                if base.Magnitude < 8 then
                                                        base = look * 40 + Vector3.new(0, 25, 0)
                                                end
                                                local v = base * power + Vector3.new(0, math.abs(base.Magnitude) * up * 0.5 + 18, 0)
                                                if v.Magnitude > 500 then v = v.Unit * 500 end
                                                p.AssemblyLinearVelocity = v
                                                p.AssemblyAngularVelocity = Vector3.new(
                                                        (math.random() - 0.5) * 40,
                                                        (math.random() - 0.5) * 60,
                                                        (math.random() - 0.5) * 40
                                                )
                                                didYeet = true
                                        else
                                                p.AssemblyLinearVelocity = Vector3.zero
                                                p.AssemblyAngularVelocity = Vector3.zero
                                        end
                                end
                        end)
                        X.partsRestoreOne(p)
                        PartList[i] = nil
                end
                if didYeet then
                        X.playYeetSFX(hrp)
                end
                X.PartsActive = false
        end

        function X.partsYeetAll()
                local n = #PartList
                if n == 0 then
                        warn("[HatCollision] No parts to yeet")
                        return
                end
                X.partsRelease(true)
                warn("[HatCollision] YEET (" .. tostring(n) .. " parts)")
        end

        function X.partsScan(origin)
                local rad = tonumber(m.PartsRadius) or 120
                if m.PartsGrabAll == true then rad = math.max(rad, 2000) end
                local skip = skipNameSet()
                local maxN = math.max(1, math.floor(tonumber(m.PartsMax) or 40))
                if m.PartsGrabAll == true then maxN = math.max(maxN, 150) end
                -- drop dead / far / newly anchored parts (keep the order of the rest stable)
                for i = #PartList, 1, -1 do
                        local p = PartList[i]
                        local drop = (not p.Parent) or p.Anchored or (p.Position - origin).Magnitude > rad * 1.6
                        if not drop and not X.partsIsLoose(p, skip) then drop = true end
                        if drop then
                                X.partsRestoreOne(p)
                                table.remove(PartList, i)
                        end
                end
                while #PartList > maxN do
                        local p = table.remove(PartList)
                        X.partsRestoreOne(p)
                end
                if #PartList >= maxN then return end
                local found = {}
                local ok, parts = pcall(function()
                        local op = OverlapParams.new()
                        op.MaxParts = (m.PartsGrabAll == true) and 4000 or 800
                        return Workspace:GetPartBoundsInRadius(origin, rad, op)
                end)
                if not ok or type(parts) ~= "table" then parts = {} end
                local seen = {}
                for _, part in ipairs(parts) do
                        local root = part
                        pcall(function() root = part.AssemblyRootPart or part end)
                        if not seen[root] and not PartSet[root] then
                                seen[root] = true
                                if X.partsIsLoose(root, skip) and (m.PartsOnlyOwned == false or m.PartsGrabAll == true or X.partsOwned(root)) then
                                        table.insert(found, root)
                                end
                        end
                end
                table.sort(found, function(a, b)
                        return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
                end)
                local grabbed = 0
                for _, root in ipairs(found) do
                        if #PartList >= maxN then break end
                        PartSet[root] = true
                        table.insert(PartList, root)
                        X.PartGrabT[root] = os.clock()
                        grabbed = grabbed + 1
                end
                if grabbed > 0 then
                        local hrp = X.getMyHRP()
                        X.playGrabSFX(hrp)
                end
        end

        -- target position (and optional facing) for loose part #i of n in formation `mode`
        function X.partsSlot(mode, i, n, t, anchor)
                local R = tonumber(m.PartsOrbitRadius) or 9
                local H = tonumber(m.PartsHeight) or 3
                local S = tonumber(m.PartsOrbitSpeed) or 1.6
                local base = anchor.Position
                local frac = (i - 1) / math.max(n, 1)
                if mode == 1 then
                        local a = i * 2.39996
                        local r = 0.7 * math.sqrt(i)
                        return base + Vector3.new(math.cos(a) * r, H + (i % 3) * 0.35, math.sin(a) * r)
                elseif mode == 2 then
                        local a = t * S + frac * math.pi * 2
                        return base + Vector3.new(math.cos(a) * R, H, math.sin(a) * R)
                elseif mode == 3 then
                        local a = t * S + frac * math.pi * 2
                        return (anchor * CFrame.new(math.cos(a) * R, H + math.sin(a) * R, 0)).Position
                elseif mode == 4 then
                        local y = 1 - 2 * ((i - 0.5) / math.max(n, 1))
                        local rr = math.sqrt(math.max(0, 1 - y * y))
                        local phi = i * 2.39996 + t * S
                        return base + Vector3.new(math.cos(phi) * rr * R, H + y * R, math.sin(phi) * rr * R)
                elseif mode == 5 then
                        local a = t * S + i * 0.7
                        return base + Vector3.new(math.cos(a) * R * 0.6, H + frac * R * 1.6, math.sin(a) * R * 0.6)
                elseif mode == 6 then
                        local r = R * (0.3 + frac * 1.2)
                        local a = t * S * (1.6 - frac) + i * 1.3
                        return base + Vector3.new(math.cos(a) * r, H + frac * R * 2, math.sin(a) * r)
                elseif mode == 7 then
                        local a = t * S * 2 + frac * math.pi * 2
                        local r = math.max(2, R * 0.4)
                        return base + Vector3.new(math.cos(a) * r, H + 2.5, math.sin(a) * r)
                elseif mode == 8 then
                        local cols = math.max(1, math.ceil(math.sqrt(n * 1.5)))
                        local col = (i - 1) % cols
                        local row = math.floor((i - 1) / cols)
                        local sp = 2.5
                        return (anchor * CFrame.new((col - (cols - 1) / 2) * sp, H + row * sp, -R)).Position
                elseif mode == 9 then
                        local side = (i % 2 == 0) and 1 or -1
                        local k = math.floor((i - 1) / 2)
                        local f = k / math.max(math.ceil(n / 2), 1)
                        local flap = math.sin(t * S * 2) * 0.35
                        return (anchor * CFrame.new(side * (1.5 + f * R * 1.2), H + 1 + f * R * 0.8 + flap * f * 4, R * 0.5 + f)).Position
                elseif mode == 10 then
                        local tr = X.PartsTrail
                        local k = #tr - i * 3
                        local pos = tr[math.max(k, 1)] or base
                        return pos + Vector3.new(0, H, 0)
                elseif mode == 11 then
                        return base + Vector3.new(
                                math.sin(t * 0.9 + i * 1.7) * R,
                                H + math.sin(t * 1.3 + i * 2.1) * R * 0.5,
                                math.cos(t * 0.7 + i * 2.9) * R)
                elseif mode == 13 then
                        local strand = i % 2
                        local a = t * S + frac * math.pi * 4 + strand * math.pi
                        return base + Vector3.new(math.cos(a) * R * 0.5, H + frac * R * 1.8, math.sin(a) * R * 0.5)
                elseif mode == 14 then
                        local a = t * S + frac * math.pi * 2
                        return (anchor * CFrame.new(math.sin(a) * R, H, math.sin(2 * a) * R * 0.5)).Position
                elseif mode == 15 then
                        local k = i % 3
                        local r = R * (0.6 + 0.4 * k)
                        local dir = (k % 2 == 0) and 1 or -1
                        local a = t * S * dir * (1.2 - 0.2 * k) + frac * math.pi * 2 * 3
                        local v = CFrame.Angles(0, 0, math.rad(20)) * Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
                        return base + v + Vector3.new(0, H, 0)
                elseif mode == 16 then
                        local side = math.max(1, math.ceil(n ^ (1 / 3)))
                        local idx = i - 1
                        local gx = idx % side
                        local gy = math.floor(idx / side) % side
                        local gz = math.floor(idx / (side * side))
                        local sp = 2.5
                        local v = Vector3.new((gx - (side - 1) / 2) * sp, gy * sp, (gz - (side - 1) / 2) * sp)
                        return base + CFrame.Angles(0, t * S * 0.5, 0) * v + Vector3.new(0, H, 0)
                elseif mode == 17 then
                        local c = {
                                Vector3.new(-1, -1, -1), Vector3.new(1, -1, -1), Vector3.new(1, -1, 1), Vector3.new(-1, -1, 1),
                                Vector3.new(-1, 1, -1), Vector3.new(1, 1, -1), Vector3.new(1, 1, 1), Vector3.new(-1, 1, 1),
                        }
                        local edges = { {1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8} }
                        local u = frac * 12
                        local e = edges[math.clamp(math.floor(u) + 1, 1, 12)]
                        local f = u - math.floor(u)
                        local v = c[e[1]]:Lerp(c[e[2]], f) * (R * 0.5)
                        return base + CFrame.Angles(0, t * S * 0.5, 0) * v + Vector3.new(0, H + R * 0.5, 0)
                elseif mode == 18 then
                        local th = frac * math.pi * 2
                        local hx = 16 * math.sin(th) ^ 3
                        local hy = 13 * math.cos(th) - 5 * math.cos(2 * th) - 2 * math.cos(3 * th) - math.cos(4 * th)
                        local sc = R / 16
                        return (anchor * CFrame.new(hx * sc, H + R * 0.9 + hy * sc, -R)).Position
                elseif mode == 19 then
                        local arm = i % 3
                        local r = R * (0.2 + frac * 1.3)
                        local a = r * 0.5 + arm * (math.pi * 2 / 3) + t * S
                        return base + Vector3.new(math.cos(a) * r, H + math.sin(frac * 8 + t) * 0.3, math.sin(a) * r)
                elseif mode == 20 then
                        local ang = i * 2.39996
                        local rr = R * math.sqrt(frac)
                        local fall = (math.abs(S) * t * 4 + i * 1.7) % (R * 2)
                        return base + Vector3.new(math.cos(ang) * rr, H + R - fall, math.sin(ang) * rr)
                else
                        local sp = 3
                        return (anchor * CFrame.new((i - (n + 1) / 2) * sp, H + 3, 0)).Position
                end
        end

        function X.partsStep(dt)
                if not m.Parts then
                        if X.PartsActive then X.partsRelease() end
                        return
                end
                local now = os.clock()
                X.PartsActive = true
                local anchor = X.partsAnchor()
                if not anchor then return end
                if now - (X.PartsBoostT or 0) > (tonumber(m.PerfBoostInterval) or 2.5) then
                        X.PartsBoostT = now
                        pcall(X.boostNetwork)
                end
                if now - (X.PartsTrailT or 0) > 0.05 then
                        X.PartsTrailT = now
                        local tr = X.PartsTrail
                        tr[#tr + 1] = anchor.Position
                        if #tr > 600 then table.remove(tr, 1) end
                end
                if now - (X.PartsScanT or 0) > (tonumber(m.PartsRescanInterval) or 0.75) then
                        X.PartsScanT = now
                        local hrp = X.getMyHRP()
                        pcall(X.partsScan, hrp and hrp.Position or anchor.Position)
                end
                local n = #PartList
                if n == 0 then return end
                local mode = math.clamp(math.floor(tonumber(m.PartsMode) or 2), 1, #m.PartsModeNames)
                local drive = math.clamp(math.floor(tonumber(m.PartsDrive) or 1), 1, #m.PartsDriveNames)
                local speedCap = tonumber(m.PartsSpeed) or 120
                local gain = tonumber(m.PartsGain) or 14
                local spin = math.rad(tonumber(m.PartsSpin) or 0)
                local noCol = m.PartsNoCollide ~= false
                for i = 1, n do
                        local p = PartList[i]
                        if p and p.Parent and not p.Anchored then
                                if noCol then
                                        if not PartSaved[p] then PartSaved[p] = { cc = p.CanCollide } end
                                        if p.CanCollide then pcall(function() p.CanCollide = false end) end
                                elseif PartSaved[p] then
                                        pcall(function() p.CanCollide = PartSaved[p].cc end)
                                        PartSaved[p] = nil
                                end
                                local target = X.partsSlot(mode, i, n, now, anchor)
                                -- Grab anim: soft lerp snap-in for first ~0.6s after grab (Uhhhhhh-style)
                                if m.GrabAnim and m.GrabAnimLerp and X.PartGrabT[p] then
                                        local age = now - X.PartGrabT[p]
                                        if age < 0.65 then
                                                local alpha = math.clamp((tonumber(m.GrabAnimSpeed) or 16) * (dt or 0.016) * (1 + age), 0, 1)
                                                target = p.Position:Lerp(target, alpha)
                                        else
                                                X.PartGrabT[p] = nil
                                        end
                                end
                                local rot = anchor.Rotation * CFrame.Angles(0, spin * now, 0)
                                local errMag = (target - p.Position).Magnitude
                                if errMag > 2.5 then
                                        X.playWalkSFX(p)
                                end
                                if drive ~= 2 and PartAlign[p] then
                                        X.partsRestoreOne(p) PartSet[p] = true if noCol then PartSaved[p] = { cc = p.CanCollide } end
                                end
                                if drive == 1 then
                                        if PartAlign[p] then X.partsRestoreOne(p) PartSet[p] = true if noCol then PartSaved[p] = { cc = p.CanCollide } end end
                                        local v = (target - p.Position) * gain
                                        if v.Magnitude > speedCap then v = v.Unit * speedCap end
                                        pcall(function()
                                                p.AssemblyLinearVelocity = v
                                                p.AssemblyAngularVelocity = Vector3.new(0, spin, 0)
                                        end)
                                elseif drive == 2 then
                                        pcall(function()
                                                local al = PartAlign[p]
                                                if not al or not al.ap.Parent then
                                                        local att = Instance.new("Attachment")
                                                        att.Name = "HC_PartAtt"
                                                        att.Parent = p
                                                        local ap = Instance.new("AlignPosition")
                                                        ap.Name = "HC_PartAP"
                                                        ap.Mode = Enum.PositionAlignmentMode.OneAttachment
                                                        ap.Attachment0 = att
                                                        ap.RigidityEnabled = false
                                                        ap.ApplyAtCenterOfMass = true
                                                        ap.MaxForce = 1e9
                                                        ap.Responsiveness = 60
                                                        ap.Parent = p
                                                        local ao = Instance.new("AlignOrientation")
                                                        ao.Name = "HC_PartAO"
                                                        ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
                                                        ao.Attachment0 = att
                                                        ao.RigidityEnabled = false
                                                        ao.MaxTorque = 1e9
                                                        ao.Responsiveness = 40
                                                        ao.Parent = p
                                                        al = { att = att, ap = ap, ao = ao }
                                                        PartAlign[p] = al
                                                end
                                                al.ap.MaxVelocity = speedCap
                                                al.ap.Position = target
                                                al.ao.CFrame = rot
                                        end)
                                elseif drive == 3 then
                                        pcall(function()
                                                p.CFrame = CFrame.new(target) * rot
                                                p.AssemblyLinearVelocity = Vector3.zero
                                                p.AssemblyAngularVelocity = Vector3.zero
                                        end)
                                elseif drive == 4 then
                                        pcall(function()
                                                local err = target - p.Position
                                                if err.Magnitude > 25 then
                                                        p.CFrame = CFrame.new(p.Position + err * 0.5) * (p.CFrame - p.Position)
                                                        err = target - p.Position
                                                end
                                                local v = err * gain
                                                if v.Magnitude > speedCap then v = v.Unit * speedCap end
                                                p.AssemblyLinearVelocity = v
                                                p.AssemblyAngularVelocity = Vector3.new(0, spin, 0)
                                        end)
                                else
                                        pcall(function()
                                                local v = (target - p.Position) * gain
                                                if v.Magnitude > speedCap then v = v.Unit * speedCap end
                                                local mass = math.max(p.AssemblyMass, 0.01)
                                                p:ApplyImpulse((v - p.AssemblyLinearVelocity) * mass)
                                                p.AssemblyAngularVelocity = Vector3.new(0, spin, 0)
                                        end)
                                end
                        end
                end
        end

