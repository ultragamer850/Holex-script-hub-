        ----------------------------------------------------------------
        -- Google TTS (chunked + cancellable)
        ----------------------------------------------------------------
        local ttsToken, ttsSounds = 0, {}
        V.canTTS = hasFS and type(getcustomasset) == "function"
        local function chunks(text, n)
                local out, cur = {}, ""
                for w in tostring(text):gmatch("%S+") do
                        if #cur + #w + 1 > n and cur ~= "" then out[#out + 1] = cur; cur = w
                        else cur = (cur == "") and w or (cur .. " " .. w) end
                end
                if cur ~= "" then out[#out + 1] = cur end
                return out
        end
        local function cutUtf8(s, n)
                if #s <= n then return s end
                local cut = n
                while cut > 0 do
                        local b = s:byte(cut + 1)
                        if b and b >= 0x80 and b < 0xC0 then cut = cut - 1 else break end
                end
                return s:sub(1, cut)
        end
        local function playChunk(text, lang, vol, token)
                local path
                local ok, snd = pcall(function()
                        local url = "https://translate.google.com/translate_tts?ie=UTF-8&client=tw-ob&tl=" .. lang .. "&q=" .. HttpService:UrlEncode(cutUtf8(text, 190))
                        local data = game:HttpGet(url)
                        path = V.F.tts .. "/tts_" .. os.time() .. "_" .. math.random(1000, 9999) .. ".mp3"
                        V.write(path, data)
                        local s = Instance.new("Sound")
                        s.Name = "HolexTTS"; s.SoundId = getcustomasset(path); s.Volume = vol; s.Parent = SoundService
                        return s
                end)
                if not ok or not snd then return false end
                if token ~= ttsToken then snd:Destroy(); pcall(delfile, path); return false end
                ttsSounds[#ttsSounds + 1] = snd
                snd:Play()
                local done = false
                snd.Ended:Connect(function() done = true end)
                local t0 = os.clock()
                while not done and snd.Parent and token == ttsToken and os.clock() - t0 < 30 do task.wait(0.1) end
                pcall(function() snd:Stop(); snd:Destroy() end)
                pcall(delfile, path)
                return true
        end
        function V.stopSpeech()
                ttsToken = ttsToken + 1
                for _, s in ipairs(ttsSounds) do pcall(function() s:Stop(); s:Destroy() end) end
                ttsSounds = {}
        end
        -- speaks `text` (any length). Returns a function you can call to wait until it finished.
        function V.say(text, lang, vol)
                if not V.canTTS or V.dead then return end
                V.stopSpeech()
                local tok = ttsToken
                task.spawn(function()
                        for _, c in ipairs(chunks(text, 180)) do
                                if tok ~= ttsToken or V.dead then break end
                                playChunk(c, lang or "en", vol or 1.2, tok)
                        end
                end)
        end
        -- speaks a list of lines in order; blocks the calling thread (use inside task.spawn). `alive()` can cancel it.
        function V.sayLines(lines, lang, vol, alive)
                if not V.canTTS then return end
                V.stopSpeech()
                local tok = ttsToken
                for _, line in ipairs(lines) do
                        if tok ~= ttsToken or V.dead or (alive and not alive()) then break end
                        local t = tostring(line):match("^%s*(.-)%s*$")
                        if t == "" then task.wait(0.4) else
                                for _, c in ipairs(chunks(t, 180)) do
                                        if tok ~= ttsToken or V.dead or (alive and not alive()) then break end
                                        playChunk(c, lang or "en", vol or 3, tok)
                                end
                        end
                end
        end

