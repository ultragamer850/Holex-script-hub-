        function X.combatDamageFor(kind)
                local base = tonumber(m.CombatDamageAmount) or 15
                local map = {
                        punch = m.CombatDamagePunch,
                        dropkick = m.CombatDamageDropkick,
                        barrage = m.CombatDamageBarrage,
                        uppercut = m.CombatDamageUppercut,
                        roundhouse = m.CombatDamageRoundhouse,
                        stomp = m.CombatDamageStomp,
                }
                local d = tonumber(map[kind]) or 0
                local raw = (d > 0) and d or base
                return math.floor(raw * X.powerMult() + 0.5)
        end

        function X.combatRangePower(kind)
                local mult = X.powerMult()
                if kind == "dropkick" then
                        return tonumber(m.DropkickRange) or 10, (tonumber(m.DropkickPower) or 2.4) * mult
                elseif kind == "barrage" then
                        return tonumber(m.BarrageRange) or 7, (tonumber(m.BarragePower) or 0.85) * mult
                elseif kind == "uppercut" then
                        return tonumber(m.UppercutRange) or 8, (tonumber(m.UppercutPower) or 2.0) * mult
                elseif kind == "roundhouse" then
                        return tonumber(m.RoundhouseRange) or 9, (tonumber(m.RoundhousePower) or 2.1) * mult
                elseif kind == "stomp" then
                        return tonumber(m.StompRange) or 11, (tonumber(m.StompPower) or 2.6) * mult
                end
                return tonumber(m.PunchRange) or 8, (tonumber(m.PunchPower) or 1.6) * mult
        end

        -- Locked HP so damaged dummies/NPCs stay damaged for other players (no regen / reset).
        X.HealthLocks = X.HealthLocks or setmetatable({}, { __mode = "k" }) -- hum -> { hp, until, conn }

        function X.combatClearHealthLock(hum)
                local lock = X.HealthLocks[hum]
                if not lock then return end
                if lock.conn then pcall(function() lock.conn:Disconnect() end) end
                X.HealthLocks[hum] = nil
        end

        function X.combatLockHealth(hum, hp)
                if not hum or not hum.Parent then return end
                if m.CombatLockHealth == false then return end
                local secs = tonumber(m.CombatLockSeconds) or 120
                local untilT = (secs <= 0) and (os.clock() + 1e9) or (os.clock() + secs)
                local lock = X.HealthLocks[hum]
                if lock then
                        lock.hp = math.min(lock.hp or hp, hp)
                        lock.untilT = untilT
                else
                        lock = { hp = hp, untilT = untilT, conn = nil }
                        X.HealthLocks[hum] = lock
                        -- if something tries to heal / reset, snap back (replicates while we own)
                        pcall(function()
                                lock.conn = hum.HealthChanged:Connect(function(newHp)
                                        local L = X.HealthLocks[hum]
                                        if not L then return end
                                        if os.clock() > (L.untilT or 0) then
                                                X.combatClearHealthLock(hum)
                                                return
                                        end
                                        if not hum.Parent then
                                                X.combatClearHealthLock(hum)
                                                return
                                        end
                                        if newHp > (L.hp or 0) + 0.05 then
                                                pcall(function() hum.Health = L.hp end)
                                        else
                                                -- allow further damage downward
                                                L.hp = math.min(L.hp or newHp, newHp)
                                        end
                                end)
                        end)
                end
                -- keep applying every so often so remote clients keep seeing the low HP
                pcall(function()
                        if not lock.hb then
                                lock.hb = RunService.Heartbeat:Connect(function()
                                        local L = X.HealthLocks[hum]
                                        if not L or not hum.Parent or os.clock() > (L.untilT or 0) then
                                                if L and L.hb then pcall(function() L.hb:Disconnect() end) end
                                                X.combatClearHealthLock(hum)
                                                return
                                        end
                                        pcall(function()
                                                if hum.Health > (L.hp or 0) + 0.05 then
                                                        hum.Health = L.hp
                                                end
                                        end)
                                end)
                        end
                end)
        end

        -- FE damage: works on dummies/NPCs your client owns (or when sim radius lets you).
        -- Boost ownership first so OTHER PLAYERS see the Health drop; lock HP so it won't reset.
        function X.combatHurtHumanoid(hum, dmg)
                if not hum or not hum.Parent then return false end
                local amount = math.max(0, tonumber(dmg) or 0)
                if amount <= 0 then return false end
                local model = hum.Parent
                local root = model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart)

                -- request / keep network ownership so Health replicates to other clients
                if m.CombatRequestOwner ~= false then
                        pcall(X.boostNetwork)
                        if root then
                                pcall(function()
                                        if setownership then setownership(root, LocalPlayer) end
                                end)
                                pcall(function()
                                        if setnetworkownership then setnetworkownership(root, LocalPlayer) end
                                end)
                                pcall(function()
                                        root:SetNetworkOwner(LocalPlayer)
                                end)
                                -- tiny velocity nudge helps some servers grant ownership
                                pcall(function()
                                        if not root.Anchored then
                                                root.AssemblyLinearVelocity = root.AssemblyLinearVelocity + Vector3.new(0, 0.02, 0)
                                        end
                                end)
                        end
                end

                local ok = false
                local newHp = nil
                pcall(function()
                        local hp = hum.Health
                        newHp = math.max(0, hp - amount)
                        hum.Health = newHp
                        ok = true
                        if m.CombatKillAtZero ~= false and newHp <= 0 then
                                pcall(function() hum.Health = 0 end)
                                if m.CombatForceDead ~= false then
                                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
                                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
                                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
                                end
                        end
                end)
                pcall(function()
                        if hum.TakeDamage then
                                hum:TakeDamage(amount)
                                ok = true
                                pcall(function() newHp = hum.Health end)
                        end
                end)
                -- lock the resulting HP so regen / scripts / other clients don't reset it
                if ok and newHp ~= nil then
                        X.combatLockHealth(hum, newHp)
                end
                return ok
        end

        function X.combatApplyHit(kind)
                local fig = X.getMyCharacter()
                local root = fig and X.getRoot(fig)
                if not root then return end
                local cam = Workspace.CurrentCamera
                local look = cam and cam.CFrame.LookVector or root.CFrame.LookVector
                look = Vector3.new(look.X, 0, look.Z)
                if look.Magnitude < 0.1 then look = root.CFrame.LookVector end
                look = look.Unit
                local range, power = X.combatRangePower(kind)
                local dmg = X.combatDamageFor(kind)
                local yOff = 1.4
                if kind == "dropkick" then yOff = 1.0
                elseif kind == "stomp" then yOff = 0.4
                elseif kind == "uppercut" then yOff = 1.6
                elseif kind == "roundhouse" then yOff = 1.2
                end
                local origin = root.Position + Vector3.new(0, yOff, 0)
                local center = origin + look * (range * 0.4)
                if kind == "stomp" then
                        center = root.Position + Vector3.new(0, 0.5, 0)
                end
                local exclude = { fig }
                if LocalPlayer.Character then table.insert(exclude, LocalPlayer.Character) end
                local op = OverlapParams.new()
                op.FilterType = Enum.RaycastFilterType.Exclude
                op.FilterDescendantsInstances = exclude
                op.MaxParts = 120
                local hitRad = (kind == "stomp") and (range * 0.85) or (range * 0.7)
                local ok, parts = pcall(function()
                        return Workspace:GetPartBoundsInRadius(center, hitRad, op)
                end)
                if not ok or type(parts) ~= "table" then return end
                local hitModels = {}
                local damaged = {}
                -- knockback profile per attack
                local speed, up = 55 * power, 12 * power
                local angPow = 0
                if kind == "dropkick" then
                        speed, up, angPow = 95 * power, 38 * power, 28
                elseif kind == "barrage" then
                        speed, up, angPow = 28 * power, 6 * power, 8
                elseif kind == "uppercut" then
                        speed, up, angPow = 35 * power, 72 * power, 15
                elseif kind == "roundhouse" then
                        speed, up, angPow = 80 * power, 22 * power, 40
                elseif kind == "stomp" then
                        speed, up, angPow = 15 * power, -55 * power, 18
                end
                local doFling = m.CombatFling ~= false
                local doDmg = m.CombatDamage ~= false

                local function tryDamageModel(model)
                        if not model or damaged[model] then return end
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        if not hum then return end
                        if Players:GetPlayerFromCharacter(model) then
                                if m.CombatHitPlayers == false then return end
                        end
                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if m.CombatOnlyOwned and hrp and not X.partOwner(hrp) then return end
                        damaged[model] = true
                        if doDmg then
                                X.combatHurtHumanoid(hum, dmg)
                        end
                end

                for _, p in ipairs(parts) do
                        if p:IsA("BasePart") then
                                if m.CombatHitPlayers == false and X.isPlayerPart(p) then
                                        -- skip players
                                else
                                        local model = p:FindFirstAncestorOfClass("Model")
                                        local target = p
                                        if model and model:FindFirstChildOfClass("Humanoid") then
                                                if not hitModels[model] then
                                                        hitModels[model] = true
                                                        target = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or p
                                                        tryDamageModel(model)
                                                else
                                                        target = nil
                                                end
                                        end
                                        if target and doFling and not target.Anchored then
                                                local owned = X.partOwner(target)
                                                if owned or not m.CombatOnlyOwned then
                                                        local mult = owned and 1 or 0.65
                                                        local flingDir = look
                                                        if kind == "roundhouse" then
                                                                local side = look:Cross(Vector3.yAxis)
                                                                if side.Magnitude > 0.1 then flingDir = (look * 0.6 + side.Unit * 0.8).Unit end
                                                        elseif kind == "stomp" then
                                                                flingDir = Vector3.new(look.X * 0.3, 0, look.Z * 0.3)
                                                                if flingDir.Magnitude < 0.05 then flingDir = Vector3.new(0, 0, 0) end
                                                        end
                                                        pcall(function()
                                                                target.AssemblyLinearVelocity = flingDir * speed * mult + Vector3.new(0, up * mult, 0)
                                                                if angPow > 0 then
                                                                        target.AssemblyAngularVelocity = Vector3.new(
                                                                                (math.random() - 0.5) * angPow,
                                                                                (math.random() - 0.5) * angPow * 1.3,
                                                                                (math.random() - 0.5) * angPow
                                                                        )
                                                                end
                                                        end)
                                                end
                                        end
                                end
                        end
                end

                -- aura splash
                if doDmg and m.CombatAuraStyle ~= false then
                        local splash = tonumber(m.CombatAuraRadius) or 5
                        if kind == "stomp" then splash = math.max(splash, range * 0.55) end
                        local ok2, more = pcall(function()
                                return Workspace:GetPartBoundsInRadius(center, splash, op)
                        end)
                        if ok2 and type(more) == "table" then
                                for _, p in ipairs(more) do
                                        if p:IsA("BasePart") then
                                                local model = p:FindFirstAncestorOfClass("Model")
                                                if model and model:FindFirstChildOfClass("Humanoid") then
                                                        if m.CombatHitPlayers == false and Players:GetPlayerFromCharacter(model) then
                                                                -- skip
                                                        else
                                                                tryDamageModel(model)
                                                        end
                                                end
                                        end
                                end
                        end
                end
                X.CombatHitCount = (X.CombatHitCount or 0) + 1
        end

        -- Frying Pan hold + slam, RPG hold (procedural Source-style on Uhhhhhh R6)
        function X.panRpgPoseOverlay(P, state, now)
                if not P then return P end
                now = now or os.clock()
                local rad = math.rad

                -- RPG hold: left arm supports tube, right arm on grip, slight lean forward
                if X.RpgEquipped and m.RpgEnabled ~= false then
                        P.rK = lerpn(P.rK or 0, 1.05, 0.85)           -- right arm forward on grip
                        P.rA = lerpn(P.rA or 0, rad(18), 0.7)         -- slight outward
                        P.lK = lerpn(P.lK or 0, 0.95, 0.85)           -- left arm supports barrel
                        P.lA = lerpn(P.lA or 0, rad(-12), 0.7)
                        P.lean = (P.lean or 0) + 0.08
                        P.yaw = (P.yaw or 0) - 0.06
                        P.dy = (P.dy or 0) - 0.02
                        -- idle sway while standing
                        if state == "Idle" or state == "Walk" then
                                local s = math.sin(now * 2.2)
                                P.rK = P.rK + 0.03 * s
                                P.lK = P.lK + 0.025 * math.sin(now * 2.0 + 1)
                        end
                end

                -- Pan hold: right arm up holding pan ready, left free or grabbing
                if X.PanEquipped and m.PanEnabled ~= false then
                        local ph = X.PanPhase
                        if ph == "lift" then
                                -- wind-up: both arms raise victim, pan cocked back
                                local liftT = math.max(tonumber(m.PanLiftTime) or 0.28, 0.05)
                                local t = math.clamp((now - (X.PanT0 or now)) / liftT, 0, 1)
                                local e = ssmooth(t)
                                P.rK = lerpn(P.rK or 0, 1.55, e)          -- pan arm high / cocked
                                P.rA = lerpn(P.rA or 0, rad(-55), e)      -- cock back
                                P.lK = lerpn(P.lK or 0, 1.45, e)          -- left lifts victim
                                P.lA = lerpn(P.lA or 0, rad(10), e)
                                P.lean = lerpn(P.lean or 0, -0.15, e)
                                P.dy = lerpn(P.dy or 0, 0.12, e)
                                P.yaw = lerpn(P.yaw or 0, -0.1, e)
                        elseif ph == "slam" then
                                -- explosive overhead slam down
                                local slamT = math.max(tonumber(m.PanSlamTime) or 0.22, 0.05)
                                local t = math.clamp((now - (X.PanT0 or now)) / slamT, 0, 1)
                                local e = ssmooth(t)
                                if t < 0.45 then
                                        -- peak of swing
                                        P.rK = lerpn(1.55, 1.85, e)
                                        P.rA = lerpn(rad(-55), rad(25), e)
                                        P.lK = lerpn(1.45, 0.35, e)
                                        P.lean = lerpn(-0.15, 0.55, e)
                                        P.yaw = lerpn(-0.1, 0.35, e)
                                        P.dy = lerpn(0.12, -0.05, e)
                                else
                                        -- follow-through / impact hold
                                        local e2 = ssmooth((t - 0.45) / 0.55)
                                        P.rK = lerpn(1.85, 1.25, e2)
                                        P.rA = lerpn(rad(25), rad(8), e2)
                                        P.lK = lerpn(0.35, 0.2, e2)
                                        P.lean = lerpn(0.55, 0.15, e2)
                                        P.yaw = lerpn(0.35, 0.08, e2)
                                        P.dy = lerpn(-0.05, 0, e2)
                                end
                        else
                                -- idle pan hold: pan raised at side, ready stance
                                P.rK = lerpn(P.rK or 0, 1.15, 0.8)        -- arm up holding pan
                                P.rA = lerpn(P.rA or 0, rad(-35), 0.75)   -- pan angled
                                P.lK = lerpn(P.lK or 0, 0.25, 0.5)        -- left relaxed / ready to grab
                                P.lA = lerpn(P.lA or 0, rad(6), 0.5)
                                P.lean = (P.lean or 0) + 0.04
                                P.yaw = (P.yaw or 0) + 0.05
                                if state == "Idle" then
                                        local s = math.sin(now * 2.5)
                                        P.rK = P.rK + 0.04 * s
                                        P.rA = P.rA + rad(4) * math.sin(now * 2.1 + 0.5)
                                end
                                -- if also grabbing an NPC, left arm reaches out more
                                if X.Grabbing or X.WorldHold then
                                        P.lK = lerpn(P.lK, 1.35, 0.85)
                                        P.lA = lerpn(P.lA, rad(15), 0.7)
                                        P.lean = (P.lean or 0) + 0.06
                                end
                        end
                end
                return P
        end

        function X.combatPoseOverlay(P, now)
                if not X.combatActive() then return P end
                local kind = X.CombatKind
                local dur = math.max((X.CombatUntil or now) - (X.CombatT0 or now), 0.05)
                local t = math.clamp((now - (X.CombatT0 or now)) / dur, 0, 1)

                -- multi-hit logic (barrage fires many times; others can multi-hit mid-window)
                if kind == "barrage" then
                        local maxHits = math.max(1, math.floor(tonumber(m.BarrageHits) or 8))
                        local iv = tonumber(m.BarrageInterval) or 0.12
                        if (X.CombatBarrageHits or 0) < maxHits and now >= (X.CombatNextHit or 0) then
                                X.CombatBarrageHits = (X.CombatBarrageHits or 0) + 1
                                X.CombatNextHit = now + iv
                                pcall(X.combatApplyHit, kind)
                                if m.CombatSFX ~= false and (X.CombatBarrageHits % 2 == 1) then
                                        X.playGrabSFX(X.getMyHRP())
                                end
                        end
                else
                        local hitStart, hitEnd = 0.22, 0.58
                        if kind == "dropkick" then hitStart, hitEnd = 0.28, 0.62
                        elseif kind == "uppercut" then hitStart, hitEnd = 0.25, 0.55
                        elseif kind == "roundhouse" then hitStart, hitEnd = 0.30, 0.60
                        elseif kind == "stomp" then hitStart, hitEnd = 0.35, 0.65
                        end
                        if m.CombatMultiHit then
                                if t >= hitStart and t <= hitEnd then
                                        local slot = math.floor((t - hitStart) / math.max(hitEnd - hitStart, 0.01) * 3)
                                        if slot ~= X.CombatHitSlot then
                                                X.CombatHitSlot = slot
                                                pcall(X.combatApplyHit, kind)
                                        end
                                end
                        else
                                if not X.CombatHitDone and t >= hitStart and t <= hitEnd then
                                        X.CombatHitDone = true
                                        pcall(X.combatApplyHit, kind)
                                end
                        end
                end

                if kind == "punch" then
                        -- improved punch: wind-up → explosive snap → follow-through → recover
                        local e
                        if t < 0.15 then
                                e = ssmooth(t / 0.15)
                                P.rK = lerpn(P.rK, 0.25, e)
                                P.rA = lerpn(P.rA, math.rad(-35), e)
                                P.lK = lerpn(P.lK, 0.55, e)
                                P.lean = P.lean - 0.12 * e
                                P.yaw = P.yaw - 0.18 * e
                                P.dy = P.dy - 0.04 * e
                        elseif t < 0.38 then
                                e = ssmooth((t - 0.15) / 0.23)
                                P.rK = lerpn(0.25, 1.72, e)
                                P.rA = lerpn(math.rad(-35), math.rad(12), e)
                                P.lK = lerpn(0.55, 0.15, e)
                                P.lean = P.lean + 0.32 * e
                                P.yaw = P.yaw + 0.38 * e
                                P.dy = P.dy + 0.06 * e
                        elseif t < 0.55 then
                                e = ssmooth((t - 0.38) / 0.17)
                                P.rK = lerpn(1.72, 1.35, e)
                                P.rA = lerpn(math.rad(12), math.rad(5), e)
                                P.lean = P.lean * (1 - 0.3 * e)
                        else
                                e = ssmooth((t - 0.55) / 0.45)
                                P.rK = lerpn(1.35, 0.12, e)
                                P.rA = lerpn(math.rad(5), math.rad(4), e)
                                P.lK = lerpn(0.15, 0.08, e)
                                P.lean = P.lean * (1 - e)
                                P.yaw = P.yaw * (1 - e)
                                P.dy = P.dy * (1 - e)
                        end
                elseif kind == "dropkick" then
                        -- improved dropkick: coil → full horizontal launch → hold → land
                        local e
                        if t < 0.18 then
                                e = ssmooth(t / 0.18)
                                P.lean = P.lean - 0.45 * e
                                P.rL = lerpn(P.rL, -0.55, e)
                                P.lL = lerpn(P.lL, 1.05, e)
                                P.rK = lerpn(P.rK, 1.05, e)
                                P.lK = lerpn(P.lK, 1.05, e)
                                P.dy = P.dy + 0.22 * e
                        elseif t < 0.48 then
                                e = ssmooth((t - 0.18) / 0.30)
                                P.lean = lerpn(-0.45, 1.15, e)
                                P.rL = lerpn(-0.55, 1.28, e)
                                P.lL = lerpn(1.05, 1.18, e)
                                P.rK = lerpn(1.05, 0.12, e)
                                P.lK = lerpn(1.05, 0.12, e)
                                P.rA = math.rad(28)
                                P.lA = math.rad(28)
                                P.dy = lerpn(0.22, -0.28, e)
                                P.yaw = 0.14 * math.sin(e * math.pi)
                        elseif t < 0.68 then
                                e = ssmooth((t - 0.48) / 0.20)
                                P.lean = lerpn(1.15, 0.85, e)
                                P.rL = lerpn(1.28, 1.05, e)
                                P.lL = lerpn(1.18, 1.0, e)
                        else
                                e = ssmooth((t - 0.68) / 0.32)
                                P.lean = lerpn(0.85, 0.04, e)
                                P.rL = lerpn(1.05, 0.08, e)
                                P.lL = lerpn(1.0, 0.08, e)
                                P.rK = lerpn(0.12, 0.08, e)
                                P.lK = lerpn(0.12, 0.08, e)
                                P.dy = lerpn(-0.28, 0, e)
                        end
                elseif kind == "barrage" then
                        -- rapid alternating punches (JoJo-style feel)
                        local hits = math.max(1, math.floor(tonumber(m.BarrageHits) or 8))
                        local phase = (t * hits) % 1
                        local side = (math.floor(t * hits) % 2 == 0)
                        local punchE = ssmooth(math.min(phase * 2.2, 1))
                        local recoverE = ssmooth(math.clamp((phase - 0.45) / 0.55, 0, 1))
                        local reach = lerpn(0.3, 1.65, punchE) * (1 - recoverE * 0.85)
                        local armOut = lerpn(math.rad(-20), math.rad(10), punchE)
                        if side then
                                P.rK = lerpn(P.rK, reach, 0.95)
                                P.rA = lerpn(P.rA, armOut, 0.9)
                                P.lK = lerpn(P.lK, 0.35, 0.6)
                        else
                                P.lK = lerpn(P.lK, reach, 0.95)
                                P.lA = lerpn(P.lA, armOut, 0.9)
                                P.rK = lerpn(P.rK, 0.35, 0.6)
                        end
                        P.lean = P.lean + 0.18 * punchE * (1 - recoverE)
                        P.yaw = P.yaw + (side and 0.22 or -0.22) * punchE
                        P.dy = P.dy - 0.03 * math.sin(t * hits * math.pi)
                elseif kind == "uppercut" then
                        local e
                        if t < 0.2 then
                                e = ssmooth(t / 0.2)
                                P.rK = lerpn(P.rK, 0.4, e)
                                P.rA = lerpn(P.rA, math.rad(-40), e)
                                P.lean = P.lean + 0.15 * e
                                P.dy = P.dy - 0.12 * e
                        elseif t < 0.5 then
                                e = ssmooth((t - 0.2) / 0.3)
                                P.rK = lerpn(0.4, 1.85, e)
                                P.rA = lerpn(math.rad(-40), math.rad(-5), e)
                                P.lean = lerpn(0.15, -0.35, e)
                                P.dy = lerpn(-0.12, 0.25, e)
                                P.yaw = P.yaw + 0.15 * e
                        else
                                e = ssmooth((t - 0.5) / 0.5)
                                P.rK = lerpn(1.85, 0.15, e)
                                P.rA = lerpn(math.rad(-5), math.rad(5), e)
                                P.lean = P.lean * (1 - e)
                                P.dy = P.dy * (1 - e)
                                P.yaw = P.yaw * (1 - e)
                        end
                elseif kind == "roundhouse" then
                        local e
                        if t < 0.22 then
                                e = ssmooth(t / 0.22)
                                P.lean = P.lean - 0.2 * e
                                P.yaw = P.yaw - 0.35 * e
                                P.rL = lerpn(P.rL, 0.3, e)
                                P.lL = lerpn(P.lL, -0.2, e)
                                P.rK = lerpn(P.rK, 0.6, e)
                        elseif t < 0.55 then
                                e = ssmooth((t - 0.22) / 0.33)
                                P.lean = lerpn(-0.2, 0.15, e)
                                P.yaw = lerpn(-0.35, 0.55, e)
                                P.rL = lerpn(0.3, 1.2, e)
                                P.lL = lerpn(-0.2, 0.4, e)
                                P.rK = lerpn(0.6, 0.25, e)
                                P.rA = math.rad(20)
                                P.lA = math.rad(15)
                                P.dy = 0.08 * math.sin(e * math.pi)
                        else
                                e = ssmooth((t - 0.55) / 0.45)
                                P.lean = P.lean * (1 - e)
                                P.yaw = P.yaw * (1 - e)
                                P.rL = lerpn(1.2, 0.1, e)
                                P.lL = lerpn(0.4, 0.08, e)
                                P.rK = lerpn(0.25, 0.1, e)
                        end
                elseif kind == "stomp" then
                        local e
                        if t < 0.25 then
                                e = ssmooth(t / 0.25)
                                P.dy = P.dy + 0.45 * e
                                P.lean = P.lean - 0.25 * e
                                P.rL = lerpn(P.rL, -0.3, e)
                                P.lL = lerpn(P.lL, 0.9, e)
                                P.rK = lerpn(P.rK, 0.7, e)
                                P.lK = lerpn(P.lK, 0.7, e)
                        elseif t < 0.45 then
                                e = ssmooth((t - 0.25) / 0.2)
                                P.dy = lerpn(0.45, -0.35, e)
                                P.lean = lerpn(-0.25, 0.4, e)
                                P.rL = lerpn(-0.3, 0.15, e)
                                P.lL = lerpn(0.9, 0.15, e)
                        else
                                e = ssmooth((t - 0.45) / 0.55)
                                P.dy = lerpn(-0.35, 0, e)
                                P.lean = P.lean * (1 - e)
                                P.rL = lerpn(0.15, 0.08, e)
                                P.lL = lerpn(0.15, 0.08, e)
                                P.rK = lerpn(0.7, 0.1, e)
                                P.lK = lerpn(0.7, 0.1, e)
                        end
                end
                return P
        end

        function X.boostNetwork(radius)
                local r = radius or 1e9
                pcall(function() sethiddenproperty(LocalPlayer, "SimulationRadius", r) end)
                pcall(function() sethiddenproperty(LocalPlayer, "MaximumSimulationRadius", r) end)
                pcall(function() LocalPlayer.MaximumSimulationRadius = r end)
                pcall(function() LocalPlayer.SimulationRadius = r end)
                pcall(function() settings().Physics.AllowSleep = false end)
        end

        function X.partOwner(part)
                if not part then return false end
                local ok, owned = pcall(function()
                        if isnetworkowner then return isnetworkowner(part) end
                        return part:GetNetworkOwner() == LocalPlayer
                end)
                if ok and owned then return true end
                local ok2 = pcall(function()
                        local v = part.AssemblyLinearVelocity
                        part.AssemblyLinearVelocity = v
                end)
                return ok2 == true
        end

        function X.isNPC(model)
                if not model or not model:IsA("Model") then return nil end
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if not humanoid then return nil end
                if Players:GetPlayerFromCharacter(model) then return nil end
                return model
        end

        function X.getRoot(model)
                if not model then return nil end
                return model:FindFirstChild("HumanoidRootPart")
                        or model:FindFirstChild("Torso")
                        or model:FindFirstChild("UpperTorso")
                        or model.PrimaryPart
        end

        function X.getMyCharacter()
                local uh = HX.uh()
                if type(uh) == "table" and uh.Character and uh.Character.Parent then
                        return uh.Character
                end
                if type(uh) == "table" and uh.Reanimate and uh.Reanimate.Character and uh.Reanimate.Character.Parent then
                        return uh.Reanimate.Character
                end
                return LocalPlayer.Character
        end

        function X.getMyHRP()
                return X.getRoot(X.getMyCharacter())
        end

