        ----------------------------------------------------------------
        -- media gallery: images + gif/video. Everything auto-downloads into
        -- "holex script hub v5/content" on first run, then shows/plays in the credits roll.
        ----------------------------------------------------------------
        do
                local V = X.V14
                -- Content folder first (that is where the credits media lives), then holex media.
                local DIRS = {}
                for _, d in ipairs({X.DIRS.content, X.DIRS.media}) do
                        if type(d) == "string" and d ~= "" then DIRS[#DIRS + 1] = d end
                end
                if #DIRS == 0 then DIRS[1] = "holex script hub v5/content" end
                local DIR = DIRS[1]
                -- Credits media. urls = download sources, tried in order (GitHub raw is permanent,
                -- the Discord mirror is the backup). Roblox cannot decode .gif files, so the gif card
                -- falls back to roblox_gameplay.webm / roblox_gameplay_frames PNGs / the built-in clip.
                Cr.Media = {
                        {name = "Screenshot 2026-09-18 131825.png", label = "tester · Celeste",
                                urls = {"https://raw.githubusercontent.com/ultragamer850/unknown/main/Screenshot%202026-09-18%20131825.png"}},
                        {name = "Screenshot 2026-10-17 012546.png", label = "credits · whitehole the unc",
                                urls = {"https://raw.githubusercontent.com/ultragamer850/unknown/main/Screenshot%202026-10-17%20012546.png"}},
                        {name = "Screenshot 2026-10-17 142048.png", label = "credits · whitehole the unc",
                                urls = {"https://raw.githubusercontent.com/ultragamer850/unknown/main/Screenshot%202026-10-17%20142048.png"}},
                        {name = "roblox_gameplay.gif", label = "gameplay",
                                urls = {"https://raw.githubusercontent.com/ultragamer850/unknown/main/roblox_gameplay.gif",
                                        "https://github.com/ultragamer850/unknown/raw/main/roblox_gameplay.gif",
                                        "https://media.githubusercontent.com/media/ultragamer850/unknown/main/roblox_gameplay.gif",
                                        "https://cdn.discordapp.com/attachments/1525078889024720957/1550535497330196570/roblox_gameplay.gif"}},
                        -- built-in gameplay clip: the loader writes it to cache/boot_media.webm on first boot
                        {name = "boot_media.webm", label = "gameplay clip (built-in)", dirs = {X.DIRS.cache}},
                }
                local cards, tok = {}, 0
                local badMedia = {}   -- v6.2: files that failed validation / decode (cleared by Reload media)
                local canAsset = hasFS and type(getcustomasset) == "function"
                local function extOf(n) return (tostring(n):match("%.(%w+)$") or ""):lower() end
                local function stemOf(n) return (tostring(n):gsub("%.%w+$", "")) end
                local function leaf(p) return tostring(p):match("([^/\\]+)$") or tostring(p) end
                local function isImg(e) return e == "png" or e == "jpg" or e == "jpeg" or e == "webp" end
                local function isVid(e) return e == "webm" or e == "mp4" end
                local function exists(p) local r = false; pcall(function() r = isfile(p) end); return r end
                local function isDirP(p) local r = false; pcall(function() r = isfolder(p) end); return r end

                local function newCard(caption)
                        local c = frame(roll, "card", UDim2.new(1, 0, 0, 230), nil, {LayoutOrder = 10000 + #cards}); corner(c, 12); stroke(c)
                        cards[#cards + 1] = c
                        local area = frame(c, nil, UDim2.new(1, -16, 1, -36), UDim2.fromOffset(8, 8), {ClipsDescendants = true})
                        local cap = label(c, caption, 11, "sub", Enum.Font.GothamMedium, {Position = UDim2.new(0, 8, 1, -24), Size = UDim2.new(1, -16, 0, 16), TextXAlignment = center, TextTruncate = Enum.TextTruncate.AtEnd})
                        return c, area, cap
                end
                local function showImage(area, path)
                        -- v6.2: check the file really is an image first (a renamed / corrupt file would just show nothing)
                        if badMedia[path] then return false end
                        if X.imgMagicOk and not X.imgMagicOk(path) then badMedia[path] = true; return false end
                        local ok, id = pcall(getcustomasset, path)
                        if not ok or not id then badMedia[path] = true; return false end
                        make("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = id, ScaleType = Enum.ScaleType.Fit}, area)
                        return true
                end
                local function showVideo(area, path)
                        -- v6.2 full fix for "Failed to load rbxasset://textures/....webm":
                        --   1) verify the file has real WebM / MP4 magic bytes BEFORE creating a VideoFrame
                        --   2) wait for IsLoaded and fall back if the codec still refuses to play
                        --   3) remember failed files so they are not retried every time the tab opens
                        if badMedia[path] then return false end
                        if X.vidMagicOk and not X.vidMagicOk(path) then badMedia[path] = true; return false end
                        local ok, id = pcall(getcustomasset, path)
                        if not ok or not id then badMedia[path] = true; return false end
                        local v = make("VideoFrame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Video = id, Looped = true, Volume = 0}, area)
                        local my = tok
                        local t0 = os.clock()
                        while v.Parent and my == tok and not v.IsLoaded and os.clock() - t0 < 2.5 do
                                task.wait(0.1)
                        end
                        if my ~= tok then return true end -- page reloaded, card is gone anyway
                        if not v.IsLoaded then
                                badMedia[path] = true
                                pcall(function() v:Destroy() end)
                                return false
                        end
                        task.spawn(function()
                                while v.Parent and my == tok and not V.dead do
                                        local on = visible and current == "Credits"
                                        if on and not v.Playing then pcall(function() v:Play() end)
                                        elseif not on and v.Playing then pcall(function() v:Pause() end) end
                                        task.wait(0.4)
                                end
                        end)
                        return true
                end
                local function showFrames(area, dirPath, fps)
                        local ok, list = pcall(listfiles, dirPath)
                        if not ok then return false end
                        local files = {}
                        for _, f in ipairs(list) do if isImg(extOf(f)) then files[#files + 1] = leaf(f) end end
                        table.sort(files)
                        -- v6.4: frames.info caps the list to what the gif decoder actually wrote (no stale frames)
                        pcall(function()
                                if isfile(dirPath .. "/frames.info") then
                                        local cnt = tonumber(readfile(dirPath .. "/frames.info"):match("(%d+)"))
                                        if cnt and cnt >= 1 and cnt < #files then
                                                for i = #files, cnt + 1, -1 do files[i] = nil end
                                        end
                                end
                        end)
                        local ids = {}
                        for i, nme in ipairs(files) do
                                if i > 150 then break end
                                local o, id = pcall(getcustomasset, dirPath .. "/" .. nme)
                                if o then ids[#ids + 1] = id end
                        end
                        if #ids == 0 then return false end
                        -- v6.4: real gif frame delays (delays.txt = centiseconds per frame, written by the decoder)
                        local delays = nil
                        pcall(function()
                                if isfile(dirPath .. "/delays.txt") then
                                        local parsed = {}
                                        for v in (readfile(dirPath .. "/delays.txt") .. ","):gmatch("([%d%.]+)") do parsed[#parsed + 1] = tonumber(v) end
                                        if #parsed > 0 then delays = parsed end
                                end
                        end)
                        local img = make("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = ids[1], ScaleType = Enum.ScaleType.Fit}, area)
                        task.spawn(function()
                                local my, i = tok, 1
                                while img.Parent and my == tok and not V.dead do
                                        if visible and current == "Credits" then i = i % #ids + 1; img.Image = ids[i] end
                                        local wt = 1 / (fps or 12)
                                        if delays and delays[i] then wt = math.clamp(delays[i] / 100, 0.03, 2) end
                                        task.wait(wt)
                                end
                        end)
                        return true
                end
                local function note(cap, text)
                        cap.Text = text; cap.TextWrapped = true; cap.TextTruncate = Enum.TextTruncate.None
                        cap.Size = UDim2.new(1, -16, 0, 28); cap.Position = UDim2.new(0, 8, 1, -32)
                end

                -- v6.7: plays the gif straight from memory with EditableImage (no PNG files, no getcustomasset, no video codec)
                X.GifLiveCache = X.GifLiveCache or {}
                local function liveSupported()
                        local ok = pcall(function()
                                local ei = game:GetService("AssetService"):CreateEditableImage({Size = Vector2.new(2, 2)})
                                local t = Instance.new("ImageLabel"); t.ImageContent = Content.fromObject(ei)
                                t:Destroy(); ei:Destroy()
                        end)
                        return ok and type(buffer) == "table"
                end
                local function showLive(area, gifPath, cap, title, name)
                        local entry = X.GifLiveCache[gifPath]
                        if not entry then
                                local opts = {live = {}, maxFrames = 100, maxW = 480, maxH = 270,
                                        progress = function(i, tot) note(cap, string.format("Decoding %s - frame %d/%d (one-time)", name, i, tot or i)) end}
                                local okd, res = X.GifToFrames(gifPath, "", opts)
                                if not okd or not opts.liveInfo then return false, tostring(res) end
                                entry = {frames = opts.live, w = opts.liveInfo.w, h = opts.liveInfo.h, delays = opts.liveInfo.delays}
                                X.GifLiveCache[gifPath] = entry
                        end
                        local okE, ei = pcall(function() return game:GetService("AssetService"):CreateEditableImage({Size = Vector2.new(entry.w, entry.h)}) end)
                        if not okE or not ei then return false, "EditableImage not allowed" end
                        local img = make("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ScaleType = Enum.ScaleType.Fit}, area)
                        local okC = pcall(function()
                                ei:WritePixelsBuffer(Vector2.zero, Vector2.new(entry.w, entry.h), entry.frames[1])
                                img.ImageContent = Content.fromObject(ei)
                        end)
                        if not okC then pcall(function() img:Destroy(); ei:Destroy() end); return false, "EditableImage write failed" end
                        local my = tok
                        task.spawn(function()
                                local i, n = 1, #entry.frames
                                while img.Parent and my == tok and not V.dead do
                                        if visible and current == "Credits" then
                                                i = i % n + 1
                                                pcall(function() ei:WritePixelsBuffer(Vector2.zero, Vector2.new(entry.w, entry.h), entry.frames[i]) end)
                                        end
                                        task.wait(math.clamp((entry.delays[i] or 10) / 100, 0.03, 2))
                                end
                                pcall(function() ei:Destroy() end)
                        end)
                        cap.Text = title .. string.format("  -  %d frames (live)", #entry.frames); cap.TextWrapped = false
                        cap.TextTruncate = Enum.TextTruncate.AtEnd
                        cap.Size = UDim2.new(1, -16, 0, 16); cap.Position = UDim2.new(0, 8, 1, -24)
                        return true
                end

                function Cr.loadMedia(force)
                        if force then table.clear(badMedia) end -- "Reload media" = retry every file
                        tok += 1
                        for _, c in ipairs(cards) do pcall(function() c:Destroy() end) end
                        cards = {}
                        if not canAsset then
                                local _, _, cap = newCard("")
                                note(cap, "Gallery needs writefile + getcustomasset (not available in this executor).")
                                return
                        end
                        task.spawn(function()
                                local my = tok
                                local used = {}
                                local function findPath(name, dirs)
                                        for _, d in ipairs(dirs or DIRS) do
                                                local p = d .. "/" .. name
                                                if exists(p) then return p, d end
                                        end
                                        return nil, (dirs and dirs[1]) or DIR
                                end
                                -- 1) configured gallery entries
                                for _, e in ipairs(Cr.Media) do
                                        if my ~= tok then return end
                                        local path, base = findPath(e.name, e.dirs)
                                        local have = path ~= nil
                                        -- v6.4: a stored .gif that is not really a gif (a bad earlier download saved
                                        -- an error page instead) is detected by its magic bytes and fetched again
                                        if have and extOf(e.name) == "gif" and X.GifMagicOk and not X.GifMagicOk(path) then
                                                have = false
                                                pcall(function() if delfile then delfile(path) end end)
                                        end
                                        if not have then
                                                -- auto-download into the content folder; every url is tried in order
                                                local try = {}
                                                if type(e.urls) == "table" then for _, u in ipairs(e.urls) do try[#try + 1] = u end end
                                                if type(e.url) == "string" and e.url ~= "" then try[#try + 1] = e.url end
                                                for _, u in ipairs(try) do
                                                        local dest = DIR .. "/" .. e.name
                                                        local ok, data = false, nil
                                                        if V and V.http then
                                                                local r = V.http(u, "GET")   -- request() keeps binary files intact
                                                                if r and r.Status == 200 and type(r.Body) == "string" and #r.Body > 100 then ok, data = true, r.Body end
                                                        end
                                                        if not ok then ok, data = pcall(function() return game:HttpGet(u) end) end
                                                        local head = ok and type(data) == "string" and data:sub(1, 200):lower() or ""
                                                        -- v6.4: gif downloads must really be gifs (magic bytes), never an error page
                                                        local gifOk = extOf(e.name) ~= "gif" or (type(data) == "string" and data:sub(1, 3) == "GIF")
                                                        if ok and type(data) == "string" and #data > 100 and not head:find("<!doctype") and not head:find("<html") and gifOk then
                                                                if V and V.write then V.write(dest, data) else pcall(writefile, dest, data) end
                                                                have, path, base = true, dest, DIR
                                                                if V and V.ok then V.ok("CREDITS", "downloaded " .. e.name .. " into content") end
                                                                break
                                                        end
                                                end
                                        end
                                        local ext, stem = extOf(e.name), stemOf(e.name)
                                        used[e.name] = true
                                        used[stem .. ".webm"], used[stem .. ".mp4"], used[stem .. "_frames"] = true, true, true
                                        local title = e.label or e.name
                                        local _, area, cap = newCard(title)
                                        local shown = false
                                        local badNote, decodeErr
                                        if have and isImg(ext) then shown = showImage(area, path) end
                                        if not shown then
                                                for _, ve in ipairs({"webm", "mp4"}) do
                                                        local vp, _ = findPath(stem .. "." .. ve, e.dirs)
                                                        if vp and not shown then
                                                                shown = showVideo(area, vp)
                                                                if not shown and badMedia[vp] then
                                                                        badNote = stem .. "." .. ve .. " exists but is not a playable video (corrupt or a renamed .gif) — skipped"
                                                                end
                                                        end
                                                end
                                        end
                                        -- v6.4: THE GIF ITSELF IS DECODED AND PLAYED. Roblox cannot read .gif files, so the
                                        -- engine LZW-decodes every frame into a PNG (cached in <stem>_frames + frames.info)
                                        -- and animates them with the gif's own frame delays.
                                        if not shown and ext == "gif" and X.GifToFrames and have and not badMedia["live:" .. e.name] and liveSupported() then
                                                local lok, lerr = showLive(area, path, cap, title, e.name)
                                                if lok then shown = true else badMedia["live:" .. e.name] = true; decodeErr = tostring(lerr) end
                                        end
                                        if not shown and ext == "gif" and X.GifToFrames then
                                                local gp = path or ((base or DIR) .. "/" .. e.name)
                                                if not exists(gp) then decodeErr = "the gif could not be downloaded (no internet / blocked)" end
                                                if exists(gp) then
                                                        local fd = (base or DIR) .. "/" .. stem .. "_frames"
                                                        note(cap, "Loading " .. e.name .. " ...")
                                                        local n = X.GifFramesCached and X.GifFramesCached(gp, fd) or nil
                                                        if not n then
                                                                local okd, res = X.GifToFrames(gp, fd, {
                                                                        maxFrames = 150,
                                                                        progress = function(i, tot) note(cap, string.format("Decoding %s — frame %d/%d (one-time)", e.name, i, tot or i)) end,
                                                                })
                                                                if okd then n = res else decodeErr = tostring(res) end
                                                        end
                                                        if n and n > 0 then
                                                                shown = showFrames(area, fd, e.fps or 12)
                                                                if shown then
                                                                        local gl = X.GifLast
                                                                        cap.Text = title .. (gl and gl.frames == n and string.format("  -  %d frames, %dx%d", n, gl.ow, gl.oh) or string.format("  -  %d frames", n)); cap.TextWrapped = false
                                                                        cap.TextTruncate = Enum.TextTruncate.AtEnd
                                                                        cap.Size = UDim2.new(1, -16, 0, 16); cap.Position = UDim2.new(0, 8, 1, -24)
                                                                end
                                                        end
                                                end
                                        end
                                        -- gif fallback: the built-in loader clip (cache/boot_media.webm), auto-rebuilt when invalid
                                        if not shown and ext == "gif" and X.DIRS.cache and stem == "roblox_gameplay" then
                                                local bp = X.DIRS.cache .. "/boot_media.webm"
                                                if X.RepairBootClip and X.RepairBootClip() then
                                                        shown = showVideo(area, bp)
                                                        if not shown then badNote = "built-in clip failed to play — press Reload media after rejoining"
                                                        else note(cap, "Showing the built-in clip because the gif could not be shown" .. (decodeErr and (": " .. decodeErr) or "") .. ". Blank? Your executor cannot render video.") end
                                                else
                                                        badNote = "built-in clip (cache/boot_media.webm) is missing or corrupt and could not be rebuilt"
                                                end
                                        end
                                        if not shown then
                                                for _, d in ipairs(DIRS) do
                                                        if isDirP(d .. "/" .. stem .. "_frames") then
                                                                shown = showFrames(area, d .. "/" .. stem .. "_frames", e.fps or 12)
                                                                if shown then break end
                                                        end
                                                end
                                        end
                                        if not shown then
                                                if ext == "gif" then
                                                        note(cap, (have and (e.name .. " could not be decoded" .. (decodeErr and (" (" .. decodeErr .. ")") or "") .. (badNote and (" — " .. badNote) or "") .. ". Press Reload media to retry.") or ("Missing " .. e.name .. " — it could not be downloaded right now. Press Reload media to try again.")))
                                                elseif badNote then
                                                        note(cap, badNote)
                                                elseif not have then
                                                        -- skip empty optional cards (don't spam dead-link messages for optional files)
                                                        pcall(function() area.Parent:Destroy() end)
                                                else
                                                        note(cap, "Could not display " .. e.name)
                                                end
                                        end
                                end
                                -- 2) everything else dropped into content OR holex media
                                for _, d in ipairs(DIRS) do
                                        pcall(function()
                                                if not listfiles then return end
                                                for _, f in ipairs(listfiles(d)) do
                                                        if my ~= tok then return end
                                                        local nme = leaf(f)
                                                        if not used[nme] then
                                                                used[nme] = true
                                                                if isDirP(f) then
                                                                        if nme:match("_frames$") then
                                                                                local _, area, cap = newCard(nme)
                                                                                if not showFrames(area, d .. "/" .. nme, 12) then note(cap, "No png frames in " .. nme) end
                                                                        end
                                                                else
                                                                        local ext = extOf(nme)
                                                                        if isImg(ext) then
                                                                                local _, area, cap = newCard(nme)
                                                                                if not showImage(area, d .. "/" .. nme) then note(cap, "Could not load " .. nme) end
                                                                        elseif isVid(ext) then
                                                                                local _, area, cap = newCard(nme)
                                                                                if not showVideo(area, d .. "/" .. nme) then note(cap, "Could not play " .. nme) end
                                                                        end
                                                                end
                                                        end
                                                end
                                        end)
                                end
                        end)
                end
        end

        local function edge(top)
                local f = frame(view, "bg", UDim2.new(1, 0, 0, 64), top and UDim2.new() or UDim2.new(0, 0, 1, -64), {ZIndex = 6})
                local pts = top and {NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1)} or {NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0)}
                make("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(pts)}, f)
        end
        edge(true); edge(false)

        local hint = label(view, "click to pause", 10, "sub", Enum.Font.GothamMedium, {Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -22), TextXAlignment = center, ZIndex = 8})
        local y, paused = 0, false

        local function scaleNow() return userScale.Scale * openScale.Scale end
        function Cr.restart()
                local vh = view.AbsoluteSize.Y
                y = (vh > 10) and (vh / scaleNow()) or 491
                paused = false
                hint.Text = "click to pause"
                roll.Position = UDim2.fromOffset(0, y)
        end
        hit.MouseButton1Click:Connect(function()
                paused = not paused
                hint.Text = paused and "paused  -  click to resume" or "click to pause"
        end)
        local rb = Button(view, "Restart", function() Cr.restart() end, UDim2.fromOffset(74, 26))
