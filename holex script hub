-- HolexPowerCore bridge (V14-compatible getgenv API over the merged network module)
do
        local function installCore()
                local V = X.V14
                if not V or not V.Network then return end
                local N = V.Network
                local CORE = {
                        version = "14.1-POWER-merge",
                        topicAccounts = N.topicAcc or "holexv14_accounts",
                        topicChat = N.topicRT or "holexv14_realtime",
                        topicPresence = N.topicRT or "holexv14_realtime",
                        dbFile = (V.F and V.F.data or X.DIRS.data) .. "/account_database.json",
                        presenceFile = (V.F and V.F.data or X.DIRS.data) .. "/holex_online.json",
                        chatFile = (V.F and V.F.data or X.DIRS.data) .. "/global_chat.json",
                        hosts = N.hosts,
                        methods = N.hostOk or {},
                        log = {},
                        Network = N,
                }
                X.PowerCore = CORE
                pcall(function()
                        local g = (getgenv and getgenv()) or _G
                        g.HolexCore = CORE
                        g.HolexPublishAccount = function(...) if N.publishAccount then return N.publishAccount(...) end end
                        g.HolexPublishPresence = function(...) if N.publishPresence then return N.publishPresence(...) end end
                        g.HolexPublishChat = function(...) if N.say then return N.say(...) end end
                        g.HolexPollNetwork = function(...) if N.pollAll then return N.pollAll(...) end end
                        g.HolexIsOnline = function(u)
                                if not N.presence then return false end
                                local k = tostring(u or ""):lower()
                                for name, p in pairs(N.presence) do
                                        if tostring(name):lower() == k then
                                                local at = type(p) == "table" and (p.lastSeen or p.at or 0) or 0
                                                return (os.time() - at) <= 90
                                        end
                                end
                                return false
                        end
                        g.HolexAccountDB = g.HolexAccountDB or { accounts = N.accounts or {}, events = {}, bans = {}, stats = { totalAccounts = 0 } }
                end)
        end
        task.defer(function()
                for _ = 1, 40 do
                        if X.V14 and X.V14.Network then installCore(); break end
                        task.wait(0.25)
                end
        end)
end

