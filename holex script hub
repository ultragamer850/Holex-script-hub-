                                                wipe(child)
                                        end
                                        if delfolder then delfolder(path) end
                                elseif isfile and isfile(path) and delfile then
                                        delfile(path)
                                elseif delfolder then
                                        pcall(delfolder, path)
                                elseif delfile then
                                        pcall(delfile, path)
                                end
                        end)
                end
                -- stop systems that might rewrite files
                pcall(function() if X.V14 then X.V14.cfg = X.V14.cfg or {}; X.V14.cfg.net = false end end)
                pcall(function() if X.V14 and X.V14.Music and X.V14.Music.stop then X.V14.Music.stop() end end)
