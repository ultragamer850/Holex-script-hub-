        local m = HX.m
        if not m or not UI.statTop then return end
        local running = m.Enabled == true
        UI.statDot.BackgroundColor3 = running and COL.good or COL.bad
        UI.statTop.Text = running and "Running" or "Disabled"
        local fig = HX._figC
        UI.statSub.Text = (fig and fig.Name or "no figure") .. " · " .. tostring(HX.FigSource or "")
        if UI.open and UI.tFig then
                local d = HX.detect()
                UI.tFig.Text = d.figure and d.figure.Name or "none"
                UI.tMode.Text = tostring(d.reanimName or (d.uhhhhhh and "Uhhhhhh" or "Generic"))
