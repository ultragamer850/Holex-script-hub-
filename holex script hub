        function X.npcCount()
                return #NPCList
        end

        function X.getPrimaryNPC()
                if X.PrimaryNPC and X.PrimaryNPC.Parent and NPCSet[X.PrimaryNPC] then
                        return X.PrimaryNPC
                end
                if #NPCList > 0 then
                        X.PrimaryNPC = NPCList[#NPCList].model
                        return X.PrimaryNPC
                end
                return nil
        end

        function X.clearNPCList()
                X.stopNPCControl()
                for _, e in ipairs(NPCList) do
                        if e.model then X.stopNPCAnim(e.model) end
                end
                table.clear(NPCList)
                for k in pairs(NPCSet) do NPCSet[k] = nil end
                X.PrimaryNPC = nil
                warn("[HatCollision] All NPCs cleared")
        end

        function X.removeNPC(model)
                local entry = NPCSet[model]
                if not entry then return end
                X.stopNPCAnim(model)
                NPCSet[model] = nil
                for i = #NPCList, 1, -1 do
                        if NPCList[i].model == model then
                                table.remove(NPCList, i)
                                break
                        end
                end
                if X.PrimaryNPC == model then
                        X.PrimaryNPC = (#NPCList > 0) and NPCList[#NPCList].model or nil
                end
        end

        function X.addNPC(model)
                if not model or not X.isNPC(model) then return false end
                if NPCSet[model] then
                        X.removeNPC(model)
                        X.npcLight(model, Color3.fromRGB(255, 120, 0))
                        warn("[HatCollision] NPC deselected: " .. tostring(model.Name) .. " (" .. #NPCList .. "/" .. X.maxFollowCount() .. ")")
                        return false
                end
                local maxN = X.maxFollowCount()
                while #NPCList >= maxN do
                        local oldest = NPCList[1]
                        if oldest then X.removeNPC(oldest.model) else break end
                end
                local entry = { model = model, name = model.Name, lastOwnerOk = os.clock() }
                NPCList[#NPCList + 1] = entry
                NPCSet[model] = entry
                X.PrimaryNPC = model
                X.npcLight(model, Color3.fromRGB(0, 255, 0))
                local root = X.getRoot(model)
                X.playGrabSFX(root)
                if m.GrabAnim then
                        X.ensureNPCAnim(model)
                end
                warn("[HatCollision] NPC selected: " .. tostring(model.Name) .. " (" .. #NPCList .. "/" .. maxN .. ") [primary]")
                return true
        end

        function X.pruneDeadNPCs()
                for i = #NPCList, 1, -1 do
                        local e = NPCList[i]
                        if not e.model or not e.model.Parent then
                                NPCSet[e.model] = nil
                                table.remove(NPCList, i)
                        end
                end
        end

        function X.findNPCByNameNear(name, origin, radius)
                if not name or name == "" then return nil end
                origin = origin or (X.getMyHRP() and X.getMyHRP().Position) or Vector3.zero
                radius = radius or 80
                local best, bestDist = nil, radius + 1
                for _, model in ipairs(Workspace:GetChildren()) do
                        if model:IsA("Model") and model.Name == name and X.isNPC(model) and not NPCSet[model] then
                                local root = X.getRoot(model)
                                if root and not root.Anchored then
                                        local d = (root.Position - origin).Magnitude
                                        if d < bestDist then
                                                bestDist = d
                                                best = model
                                        end
                                end
                        end
                end
                return best
        end

        function X.tryReclaimAll()
                if not m.NPCFollowReclaim then return end
                local now = os.clock()
                if now - (X.LastReclaimT or 0) < 0.4 then return end
                X.LastReclaimT = now
                local hrp = X.getMyHRP()
                local origin = hrp and hrp.Position or Vector3.zero
                local rad = tonumber(m.NPCFollowReclaimRadius) or 80
                for i = #NPCList, 1, -1 do
                        local e = NPCList[i]
                        if not e.model or not e.model.Parent then
                                local found = X.findNPCByNameNear(e.name, origin, rad)
                                if found then
                                        NPCSet[e.model] = nil
                                        e.model = found
                                        e.lastOwnerOk = now
                                        NPCSet[found] = e
                                        X.npcLight(found, Color3.fromRGB(0, 255, 180))
                                        warn("[HatCollision] Reclaimed: " .. tostring(e.name))
                                else
                                        NPCSet[e.model] = nil
                                        table.remove(NPCList, i)
                                end
                        end
                end
        end

