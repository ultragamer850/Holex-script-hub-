                                        if plr ~= LP then attach(plr) end
                                end
                                X._espAddConn = Players.PlayerAdded:Connect(function(plr) if ESP.on and plr ~= LP then attach(plr) end end)
                                X._espRmConn = Players.PlayerRemoving:Connect(function(plr) clearOne(plr) end)
                                loopConn = RunService.Heartbeat:Connect(function()
                                        local myChar = LP.Character
                                        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                                        for plr, w in pairs(ESP.wrap) do
                                                if w.hrp and w.hrp.Parent and w.distL then
