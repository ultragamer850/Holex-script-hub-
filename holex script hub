                                V.act("TOOL", "stalker off")
                        end
                end)
                -- the actual stalker loop (works even after hops if queue_on_teleport re-runs the hub)
                X.stalkerTick = function()
                        local target = getgenv().HolexStalkTarget
                        if type(target) ~= "string" or target == "" then return end
                        for _, p in ipairs(Players:GetPlayers()) do
                                if p.Name:lower() == target:lower() then
                                        Notify("Stalker", target .. " IS IN THIS SERVER.", 6)
                                        V.ok("STALKER", "found " .. target)
                                        getgenv().HolexStalkTarget = nil
                                        return
                                end
                        end
                        task.spawn(function()
                                task.wait(10)
                                if getgenv().HolexStalkTarget ~= target then return end
                                local ok, res = pcall(function() return game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100") end)
                                if not ok then return end
                                local d = V.decode(res)
                                local pool = {}
                                for _, s in ipairs((d and d.data) or {}) do
                                        if s.id ~= tostring(game.JobId) and s.playing < s.maxPlayers then pool[#pool + 1] = s.id end
                                end
                                if #pool == 0 then return end
                                if type(queue_on_teleport) == "function" then
                                        pcall(queue_on_teleport, "task.wait(6) if getgenv and getgenv().HolexStalkTarget then print('[Holex stalker] still searching ' .. tostring(getgenv().HolexStalkTarget)) end")
                                end
                                V.info("STALKER", "hopping to find " .. target)
                                TS:TeleportToPlaceInstance(game.PlaceId, pool[math.random(1, #pool)], LP)
                        end)
                end
                task.spawn(function()
                        task.wait(8)
                        while gui.Parent do
                                task.wait(4)
                                pcall(X.stalkerTick)
                        end
                end)

                -- instant game joiner
                local joinPlace = H.Input(page, "Join game by Place ID", "2753915549", "")
                local joinJob = H.Input(page, "Job ID (optional - joins that exact server)", "leave empty for any server", "")
                Button(page, "Join game now", function()
