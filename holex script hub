-- v6.8: quiet console. Per-hit / per-save / housekeeping lines are debug noise: hidden unless
-- Settings > "Verbose console" is on. Everything else is de-duplicated by its text WITHOUT numbers
-- (so "Pan hit #12" / "Pan hit #13" no longer slip past the old exact-match spam filter).
local NOISY = {
        "pan hit #", "hat dmg ", "settings saved", "settings loaded", "reclaimed:", "module factory running",
        "loop started", "relocked ", "respawn detected", "config called", "auto-filled", "rescan hats",
        "all per-hat", "manual save", "raknet learn:",
}
local lastNorm = {}

function HX.warn(...)
        local parts = table.pack(...)
        local s = {}
        for i = 1, parts.n do s[i] = tostring(parts[i]) end
        local msg = table.concat(s, " ")
        local low = string.lower(msg)
        local isErr = string.find(low, "error", 1, true) or string.find(low, "failed", 1, true)
        local verbose = HX.Settings and HX.Settings.VerboseConsole == true
        if not isErr and not verbose then
                for _, kw in ipairs(NOISY) do
                        if string.find(low, kw, 1, true) then return end
                end
        end
        -- same line (digits ignored) repeated within 6 s = spam
        local norm = (string.gsub(low, "[%d%.]+", "#"))
        local now = os.clock()
        local last = lastNorm[norm]
        if last and now - last < 6 then return end
        local cnt = 0
        for _ in pairs(lastNorm) do cnt = cnt + 1 end
        if cnt > 120 then lastNorm = {} end
        lastNorm[norm] = now
        -- executor console (F9 / print window): only problems, unless verbose
        if isErr or verbose then pcall(nativeWarn, msg) end
        HX.logAdd(msg)
        if isErr then
                if HX.UI and HX.UI.toast then pcall(HX.UI.toast, "Problem", msg, "bad") end
        end
end

