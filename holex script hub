                        if string.find(t, "uhhhh", 1, true) or string.find(t, "steve", 1, true) then return "Uhhhhhh / Steve" end
                        if string.find(t, "genesis", 1, true) or string.find(t, "fdless", 1, true) or string.find(t, "patchma", 1, true) then return "FE Genesis" end
                        if string.find(t, "melon", 1, true) or string.find(t, "locust", 1, true) or string.find(t, "feverse", 1, true) or string.find(t, "emper", 1, true) then return "Melon Scripter" end
                        if string.find(t, "netless", 1, true) then return "Netless" end
                        if string.find(t, "reanimate", 1, true) or string.find(t, "reanim", 1, true) then return "Other reanimate" end
                        return nil
                end
                local now = os.clock()
                if not HX._rsCache or now - HX._rsCache.t > 3 then
                        local found
                        pcall(function()
                                -- executor-side scripts / modules by name
                                for _, getter in ipairs({getrunningscripts, getscripts, getloadedmodules}) do
                                        if type(getter) == "function" then
                                                for _, sc in ipairs(getter()) do
                                                        -- executor-side only (game scripts live under game; a game called "Genesis" must not trigger this)
                                                        local okD, inGame = pcall(function() return sc:IsDescendantOf(game) end)
                                                        local n = (okD and not inGame) and kwName(sc.Name) or nil
                                                        if n and n ~= "Other reanimate" then found = {n, "script:" .. sc.Name} break end
                                                end
                                        end
                                        if found then break end
                                end
                        end)
                        if not found then
                                pcall(function()
                                        local env = (getgenv and getgenv()) or _G
                                        for k, v in pairs(env) do
                                                if type(k) == "string" and (type(v) == "table" or type(v) == "function") then
                                                        local n = kwName(k)
                                                        if n and k ~= "__HolexLS" and k ~= "__HolexHatCollision" and not string.find(string.lower(k), "holex", 1, true) then
                                                                found = {n, "env:" .. k}
                                                                break
                                                        end
                                                end
                                        end
                                end)
                        end
                        HX._rsCache = {t = now, hit = found}
                end
                local h = HX._rsCache.hit
                if h then
                        local fg = HX.figure()
                        HX._lastReanimHint = h[1]
                        return h[1] .. " (detected)", 0.85, h[2], (typeof(fg) == "Instance" and fg.Name) or ""
                end
        end

        -- Genesis loadstring leaves option globals in the env (transparent / fling / breakjointsmethod / placeholders)
        local genesisScore = 0
        local genesisHints = {}
        pcall(function()
                local env = getfenv and getfenv(0) or _G
                local checks = {
                        {"transparent", true}, {"fling", true}, {"placeholders", true},
                        {"breakjointsmethod", true}, {"respawntp", true}, {"ctrltp", true},
                        {"allowshiftlock", true}, {"simrad", true}, {"discharscripts", true},
                }
                for _, c in ipairs(checks) do
                        local v = rawget(_G, c[1])
                        if v == nil and getgenv then v = getgenv()[c[1]] end
                        if v ~= nil then
                                genesisScore = genesisScore + 1
                                genesisHints[#genesisHints + 1] = c[1]
                        end
                end
        end)

        -- Melon FEVerse directories / Locust
        local melonHint = false
        pcall(function()
                if isfolder and isfolder("FEVerse") then melonHint = true end
                if isfolder and isfolder("FEVerse/RBXMs") then melonHint = true end
        end)
        local nonRig = Workspace:FindFirstChild("non")
        if validFig(nonRig) and not isOtherPlayer(nonRig) then
                HX._lastReanimHint = "Melon Scripter"
                return "Melon Scripter (Emper / Locust)", 0.95, "Workspace.non", nonRig.Name
        end

        local genesisKeys = {"FEGenesis", "Genesis", "FEG", "FE_Genesis", "fe_genesis", "FE_GenesisReanimate", "GenesisHub", "GenesisFE", "FDless", "Patchma"}
        for _, key in ipairs(genesisKeys) do
                local g = rawget(_G, key)
                if type(g) == "table" or typeof(g) == "Instance" then
                        local ch = type(g) == "table" and (g.Character or g.FakeCharacter or g.Rig or g.Figure) or g
                        local figN = (typeof(ch) == "Instance" and ch.Name) or ""
                        HX._lastReanimHint = "FE Genesis"
                        return "FE Genesis", 0.94, "_G." .. key, figN
                end
        end
        if genesisScore >= 3 then
                local cam = cameraFigure()
                local figN = cam and cam.Name or ""
                HX._lastReanimHint = "FE Genesis"
                return "FE Genesis (FDless options)", 0.8 + math.min(genesisScore, 6) * 0.02,
                        "globals:" .. table.concat(genesisHints, ","), figN
        end

        local melonKeys = {"Melon", "MelonHub", "MelonScripter", "MelonReanimate", "melon", "MelonScript", "FEVerse", "Locust"}
        for _, key in ipairs(melonKeys) do
                local g = rawget(_G, key)
                if type(g) == "table" or typeof(g) == "Instance" then
                        local ch = type(g) == "table" and (g.Character or g.FakeCharacter or g.Rig) or nil
                        local figN = (typeof(ch) == "Instance" and ch.Name) or ""
                        HX._lastReanimHint = "Melon Scripter"
                        return "Melon Scripter", 0.92, "_G." .. key, figN
                end
        end
        if melonHint then
                local cam = cameraFigure()
                HX._lastReanimHint = "Melon Scripter"
                return "Melon Scripter (FEVerse folder)", 0.75, "FEVerse/", cam and cam.Name or ""
        end

        local other = {
                {"Netless", "Netless"}, {"PermaDeath", "PermaDeath"}, {"Simple", "Simple Reanimate"},
                {"Nexo", "Nexo"}, {"Sier", "Sier"}, {"Hatsploit", "Hatsploit"},
                {"HatReanimator", "Hat Reanimator"}, {"Reanimate", "Generic Reanimate"},
        }
        for _, pair in ipairs(other) do
                local g = rawget(_G, pair[1])
                if type(g) == "table" or typeof(g) == "Instance" then
                        local ch = type(g) == "table" and (g.Character or g.FakeCharacter or g.Rig) or nil
                        local figN = (typeof(ch) == "Instance" and ch.Name) or ""
                        return pair[2], 0.7, "_G." .. pair[1], figN
                end
        end

        local list = HX.findFakeRigs and HX.findFakeRigs() or {}
        if #list > 0 then
                local best = list[1]
                return best.label, best.score, best.label, best.model and best.model.Name or ""
        end

        local gui = HX.scanGuiHints()
        for _, h in ipairs(gui) do
                if h.kw == "uhhhhh" or h.kw == "uhhhh" or h.kw == "steve" then
                        return "Uhhhhhh (GUI hint)", 0.5, h.path, ""
                end
                if h.kw == "genesis" or h.kw == "sin" or h.kw == "dragon" then
                        HX._lastReanimHint = "FE Genesis"
                        return "FE Genesis (GUI hint)", 0.55, h.path, ""
                end
                if h.kw == "melon" or h.kw == "locust" or h.kw == "cherry" then
                        HX._lastReanimHint = "Melon Scripter"
                        return "Melon (GUI hint)", 0.55, h.path, ""
                end
                if h.kw == "reanimate" or h.kw == "reanim" then return "Unknown reanimate (GUI)", 0.4, h.path, "" end
        end

        if HX.FigSource == "Camera subject" or (cameraFigure() and cameraFigure() ~= LocalPlayer.Character) then
                local c = cameraFigure()
                return "Camera subject (fake rig)", 0.5, "CameraSubject", c and c.Name or ""
        end
        return "None / real character", 0.2, "LocalPlayer.Character", LocalPlayer.Character and LocalPlayer.Character.Name or ""
end

function HX.detect()
        local uh = HX.realUhhhhhh()
        local fig = HX.figure()
        local reanimName, conf, reanimSrc, reanimRig = HX.detectReanimateName()
        local info = {
                uhhhhhh = uh ~= nil,
                figure = fig,
                source = HX.FigSource or "Character",
                r15 = false,
                hats = 0,
                owned = 0,
                hatNames = {},
                executor = HX.detectExecutor(),
                reanimName = reanimName,
                reanimConf = conf,
                reanimSrc = reanimSrc,
                reanimRig = reanimRig or "",
                globals = HX.scanGlobals(),
                guiHints = HX.scanGuiHints(),
                placeId = tostring(game.PlaceId),
                gameId = tostring(game.GameId),
                jobId = "",
                player = LocalPlayer.Name,
                userId = tostring(LocalPlayer.UserId),
                fps = 0,
                ping = 0,
                cameraSubject = "",
                profile = HX.Settings.Mode,
        }
        pcall(function() info.jobId = tostring(game.JobId) end)
        pcall(function()
                local cam = Workspace.CurrentCamera
                local s = cam and cam.CameraSubject
                if s then info.cameraSubject = s:GetFullName() end
        end)
        pcall(function()
                info.fps = HX._lastFps or 0
        end)
        pcall(function()
                local st = game:GetService("Stats")
                local n = st:FindFirstChild("PerformanceStats") or st
                local ping = st.Network and st.Network.ServerStatsItem and st.Network.ServerStatsItem["Data Ping"]
                if ping then info.ping = math.floor(ping:GetValue()) end
        end)
        if fig then
                info.r15 = fig:FindFirstChild("UpperTorso") ~= nil and fig:FindFirstChild("Torso") == nil
                info.figPath = fig:GetFullName()
                local hum = fig:FindFirstChildOfClass("Humanoid")
                if hum then
                        info.humHealth = math.floor(hum.Health)
                        info.humMax = math.floor(hum.MaxHealth)
                        info.humState = tostring(hum:GetState())
                end
        end
        local seen = {}
        local function scan(c)
                if not c then return end
                for _, d in ipairs(c:GetChildren()) do
                        if d:IsA("Accessory") or d:IsA("Accoutrement") then
                                local h = d:FindFirstChild("Handle")
                                if h and not seen[h] then
                                        seen[h] = true
                                        info.hats = info.hats + 1
                                        info.hatNames[#info.hatNames + 1] = d.Name
                                        if isnetworkowner then
                                                local ok, own = pcall(isnetworkowner, h)
                                                if ok and own then info.owned = info.owned + 1 end
                                        end
                                end
                        end
                end
        end
        scan(fig)
        if LocalPlayer.Character and LocalPlayer.Character ~= fig then
                scan(LocalPlayer.Character)
        end
        return info
end


