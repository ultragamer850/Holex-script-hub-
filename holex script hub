        function X.relockAllDamaged()
                local n = 0
                for model, rec in pairs(X.NPCDamageLog) do
                        if model and model.Parent and (rec.total or 0) > 0 then
                                local hum = model:FindFirstChildOfClass("Humanoid")
                                if hum and hum.Health > 0 then
                                        X.combatLockHealth(hum, hum.Health)
                                        n = n + 1
                                end
                        end
                end
                -- also every selected
                for _, e in ipairs(NPCList) do
                        local model = e.model
                        if model and model.Parent then
                                local hum = model:FindFirstChildOfClass("Humanoid")
                                if hum then X.combatLockHealth(hum, hum.Health); n = n + 1 end
                        end
                end
                warn("[HatCollision] Relocked " .. n .. " NPC/dummy humanoids")
                return n
        end

        function X.selectAllOwnedNPCs()
                local models = X.scanWorldNPCs(100)
                local n = 0
                for _, model in ipairs(models) do
                        local root = X.getRoot(model)
                        if root and X.partOwner(root) and not NPCSet[model] then
                                if X.addNPC(model) then n = n + 1 end
                        end
                end
                warn("[HatCollision] Selected " .. n .. " owned NPCs")
