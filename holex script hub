--==================================================================
-- NEW YEAR  -  year on the Home tab + full-screen "Happy New Year" show
--==================================================================
-- Test it any time: Settings > New Year > "Test Happy New Year".
-- The show runs on its own full-screen layer, so it appears even if the hub window is closed.
-- Sounds: your tick sound + the GTA V notification sound are layered (pitch shifted) with a few
-- Roblox built-in client sounds. Swap any of them in NY.Sounds if you have better asset ids.
do
local function module()
        local NY = {}
        X.NY = NY
        NY.Sounds = {
                TICK = TICK_SOUND_ID,
                DING = NOTIF_SOUND_ID,
                BOOM = "rbxasset://sounds/impact_explosion_03.mp3",
                WHOOSH = "rbxasset://sounds/Rocket whoosh 01.wav",
                CHEER = "rbxasset://sounds/victory.wav",
        }
        local SND = NY.Sounds
        NY.done = tonumber(Persist.data["NewYear|celebrated"]) or 0
        local active = nil
        local limiter = {}

        local PAL = {
                Color3.fromRGB(255, 82, 82), Color3.fromRGB(255, 190, 50), Color3.fromRGB(255, 240, 120), Color3.fromRGB(90, 255, 150),
                Color3.fromRGB(70, 200, 255), Color3.fromRGB(150, 110, 255), Color3.fromRGB(255, 100, 220), Color3.new(1, 1, 1),
        }
        local function rc() return PAL[math.random(#PAL)] end

        local function play(id, vol, speed, key)
                if not S.nySound then return end
                if key then
                        local n = os.clock()
                        if limiter[key] and n - limiter[key] < 0.07 then return end
                        limiter[key] = n
                end
                pcall(function()
                        local s = Instance.new("Sound")
                        s.SoundId = id
                        s.Volume = vol or 0.6
                        s.PlaybackSpeed = speed or 1
                        s.Parent = (active and active.gui) or gui
                        s:Play()
                        task.delay(10, function() if s then s:Destroy() end end)
                end)
        end

        -- year + progress bar on the Home tab (called every second while Home is open)
        function X.updateYear()
                if not X.yearLbl then return end
                local now = os.time()
                local d = os.date("*t", now)
                local a = os.time({year = d.year, month = 1, day = 1, hour = 0, min = 0, sec = 0})
                local b = os.time({year = d.year + 1, month = 1, day = 1, hour = 0, min = 0, sec = 0})
                local left = math.max(b - now, 0)
                X.yearLbl.Text = tostring(d.year)
                X.yearSub.Text = string.format("%dd %02d:%02d:%02d until %d", left // 86400, (left % 86400) // 3600, (left % 3600) // 60, left % 60, d.year + 1)
                tw(X.yearFill, 0.3, {Size = UDim2.fromScale(math.clamp((now - a) / (b - a), 0, 1), 1)}, Enum.EasingStyle.Quad)
        end

        function NY.cancel()
                if active and active.cleanup then active.cleanup() end
        end

        function NY.run(year, targetTime, isTest)
                if active then return end
                local ov = make("ScreenGui", {Name = "HolexNewYear", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 2000, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, getParent())
                local root = make("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(4, 4, 14), BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true}, ov)
                local st = {gui = ov, dead = false}
                active = st
                if not isTest then
                        NY.done = year
                        persistSet("NewYear|celebrated", year)
                end
                local parts, t0, rsConn = {}, os.clock(), nil

                local function cleanup()
                        if st.dead then return end
                        st.dead = true
                        if rsConn then rsConn:Disconnect() end
                        pcall(function() ov:Destroy() end)
                        active = nil
                end
                st.cleanup = cleanup

                local function size() return root.AbsoluteSize.X, root.AbsoluteSize.Y end

                local function addPart(p)
                        if #parts > 560 then return end
                        p.h = p.h or p.w
                        local f = make("Frame", {Size = UDim2.fromOffset(p.w, p.h), Position = UDim2.fromOffset(p.x, p.y), AnchorPoint = Vector2.new(0.5, 0.5),
                                BackgroundColor3 = p.color, BorderSizePixel = 0, ZIndex = p.z or 4, Rotation = p.rot or 0}, root)
                        if p.round ~= false then circle(f) end
                        p.f = f
                        p.max = p.life
                        parts[#parts + 1] = p
                        return p
                end

                local function ring(x, y, color, sz, t)
                        local r = make("Frame", {Size = UDim2.fromOffset(10, 10), Position = UDim2.fromOffset(x, y), AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2}, root)
                        circle(r)
                        local s = make("UIStroke", {Color = color, Thickness = 4, Transparency = 0.1}, r)
                        tw(r, t, {Size = UDim2.fromOffset(sz, sz)}, Enum.EasingStyle.Quad)
                        tw(s, t, {Transparency = 1, Thickness = 1}, Enum.EasingStyle.Quad)
                        task.delay(t + 0.05, function() r:Destroy() end)
                end

                local flash = make("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20}, root)
                local function doFlash(a, t)
                        flash.BackgroundTransparency = 1 - a
                        tw(flash, t, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
                end

                local STYLES = {"peony", "ring", "heart", "star", "willow", "peony", "double"}
                local function burst(x, y, style, color)
                        style = style or STYLES[math.random(#STYLES)]
                        color = color or rc()
                        play(SND.BOOM, 0.42, 0.85 + math.random() * 0.5, "boom")
                        play(SND.DING, 0.22, 1.1 + math.random() * 1.3, "ding")
                        ring(x, y, color, 180 + math.random(0, 120), 0.55)
                        addPart({x = x, y = y, vx = 0, vy = 0, w = 36, color = Color3.new(1, 1, 1), life = 0.22, g = 0, d = 0})
                        local function emit(n, fn, life, grav, drag, sz, col)
                                for i = 1, n do
                                        local vx, vy = fn(i, n)
                                        addPart({x = x, y = y, vx = vx, vy = vy, w = sz, color = col or color, life = life * (0.75 + math.random() * 0.5), g = grav, d = drag})
                                end
                        end
                        if style == "ring" then
                                emit(40, function(i, n) local a = i / n * math.pi * 2; return math.cos(a) * 270, math.sin(a) * 270 end, 1.4, 80, 1.3, 5)
                        elseif style == "heart" then
                                emit(64, function(i, n)
                                        local a = i / n * math.pi * 2
                                        return 15 * 16 * math.sin(a) ^ 3, -15 * (13 * math.cos(a) - 5 * math.cos(2 * a) - 2 * math.cos(3 * a) - math.cos(4 * a))
                                end, 1.6, 40, 1.2, 5, Color3.fromRGB(255, 80, 130))
                        elseif style == "star" then
                                emit(60, function(i, n)
                                        local a = i / n * math.pi * 2
                                        local sp = 240 * (0.5 + 0.5 * math.abs(math.cos(2.5 * a)))
                                        return math.cos(a - math.pi / 2) * sp, math.sin(a - math.pi / 2) * sp
                                end, 1.5, 50, 1.2, 5, Color3.fromRGB(255, 225, 90))
                        elseif style == "willow" then
                                emit(54, function() local a, sp = math.random() * math.pi * 2, 80 + math.random() * 180; return math.cos(a) * sp, math.sin(a) * sp end,
                                        2.7, 75, 0.9, 4, Color3.fromRGB(255, 200, 90))
                        elseif style == "double" then
                                emit(40, function() local a, sp = math.random() * math.pi * 2, 200 + math.random() * 140; return math.cos(a) * sp, math.sin(a) * sp end, 1.5, 100, 1.4, 5)
                                emit(26, function(i, n) local a = i / n * math.pi * 2; return math.cos(a) * 140, math.sin(a) * 140 end, 1.3, 100, 1.4, 5, rc())
                        else
                                emit(52, function() local a, sp = math.random() * math.pi * 2, math.sqrt(math.random()) * 300 + 40; return math.cos(a) * sp, math.sin(a) * sp end, 1.5, 110, 1.4, 5)
                        end
                end

                local function launch(x, ty, style, color)
                        local _, H = size()
                        local ft = 0.8 + math.random() * 0.4
                        play(SND.WHOOSH, 0.25, 1.3 + math.random() * 0.4, "whoosh")
                        addPart({x = x, y = H + 10, vx = (math.random() - 0.5) * 40, vy = -(H + 10 - ty) / ft, w = 5, color = Color3.fromRGB(255, 235, 170), life = ft, g = 0, d = 0,
                                trail = true, noFade = true, onDie = function(p) burst(p.x, p.y, style, color) end})
                end

                local function confetti(n, fromTop)
                        local W, H = size()
                        for _ = 1, n do
                                addPart({x = math.random() * W, y = fromTop and -20 or -math.random() * H * 0.6, vx = (math.random() - 0.5) * 80, vy = 60 + math.random() * 90,
                                        w = math.random(6, 10), h = math.random(10, 16), color = rc(), life = 16, g = 70, d = 0.9, round = false, spin = (math.random() - 0.5) * 520,
                                        rot = math.random(0, 360), sway = 120, swf = 2 + math.random() * 3, ph = math.random() * 6, noFade = true, z = 3})
                        end
                end

                -- per-frame update: particles, rainbow letters, rotating light beams, year pulse
                rsConn = RunService.RenderStepped:Connect(function(dt)
                        dt = math.min(dt, 0.05)
                        local t = os.clock() - t0
                        local W, H = size()
                        local i = 1
                        while i <= #parts do
                                local p = parts[i]
                                p.life -= dt
                                if p.trail then
                                        p.tr = (p.tr or 0) + dt
                                        if p.tr > 0.022 then
                                                p.tr = 0
                                                addPart({x = p.x, y = p.y, vx = (math.random() - 0.5) * 50, vy = 30 + math.random() * 40, w = 3, color = Color3.fromRGB(255, 200, 120), life = 0.5, g = 60, d = 1.5})
                                        end
                                end
                                if p.life <= 0 or p.y > H + 60 or p.x < -80 or p.x > W + 80 then
                                        local cb = p.onDie
                                        local dead = p.life <= 0
                                        p.f:Destroy()
                                        parts[i] = parts[#parts]
                                        parts[#parts] = nil
                                        if cb and dead then pcall(cb, p) end
                                else
                                        if p.sway then p.vx += math.sin(t * p.swf + p.ph) * p.sway * dt end
                                        p.vy += p.g * dt
                                        local dr = math.max(0, 1 - p.d * dt)
                                        p.vx *= dr
                                        p.vy *= dr
                                        p.x += p.vx * dt
                                        p.y += p.vy * dt
                                        local f = p.f
                                        f.Position = UDim2.fromOffset(p.x, p.y)
                                        if p.spin then p.rot += p.spin * dt; f.Rotation = p.rot end
                                        if not p.noFade then
                                                local a = p.life / p.max
                                                f.BackgroundTransparency = a > 0.4 and 0.05 or (1 - a / 0.4)
                                                local sz = p.w * (0.45 + 0.55 * math.min(1, a * 2))
                                                f.Size = UDim2.fromOffset(sz, sz)
                                        end
                                        i += 1
                                end
                        end
                        if st.letters then
                                for idx, l in ipairs(st.letters) do l.TextColor3 = Color3.fromHSV((t * 0.25 + idx * 0.055) % 1, 0.6, 1) end
                        end
                        if st.beams then st.beams.Rotation = t * 8 end
                        if st.yearGrad then st.yearGrad.Offset = Vector2.new(math.sin(t * 1.5) * 0.6, 0) end
                        if st.pulse and st.yearScale then st.yearScale.Scale = 1 + math.sin(t * 3.2) * 0.035 end
                end)

                -- skip button
                local skip = make("TextButton", {Size = UDim2.fromOffset(74, 30), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 14), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45,
                        Text = "SKIP  X", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1), AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 30}, root)
                corner(skip, 8)
                skip.MouseButton1Click:Connect(cleanup)

                -- countdown widgets
                local W0, H0 = size()
                local cd = make("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromOffset(500, 240), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Text = "",
                        Font = Enum.Font.GothamBlack, TextSize = math.clamp(math.floor(H0 * 0.28), 80, 220), TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.5, ZIndex = 11}, root)
                local cdScale = make("UIScale", {Scale = 1}, cd)
                local cdSub = make("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromOffset(500, 30), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.66),
                        Text = "UNTIL  " .. year, Font = Enum.Font.GothamBold, TextSize = 22, TextColor3 = Color3.fromRGB(255, 220, 130), TextTransparency = 1, ZIndex = 11}, root)

                local function countdownTick(n)
                        local W, H = size()
                        cd.Text = tostring(n)
                        cd.TextColor3 = n <= 3 and Color3.fromRGB(255, 90, 90) or Color3.new(1, 1, 1)
                        cdScale.Scale = 1.7
                        tw(cdScale, 0.55, {Scale = 1}, Enum.EasingStyle.Back)
                        tw(cdSub, 0.3, {TextTransparency = 0})
                        play(SND.TICK, 0.9, 1 + math.max(0, 10 - n) * 0.07, "tick")
                        ring(W / 2, H * 0.45, cd.TextColor3, 520, 0.7)
                        launch(W * (0.1 + 0.8 * math.random()), H * (0.2 + 0.2 * math.random()))
                end

                local function midnight()
                        local W, H = size()
                        cd.Text = ""
                        tw(cdSub, 0.3, {TextTransparency = 1})
                        doFlash(1, 1.1)
                        play(SND.BOOM, 1, 0.7)
                        play(SND.BOOM, 0.9, 1.0)
                        play(SND.DING, 0.8, 0.8)
                        play(SND.DING, 0.8, 1.0)
                        play(SND.DING, 0.8, 1.5)
                        play(SND.CHEER, 0.8, 1)
                        -- rotating light beams
                        local beams = make("Frame", {Size = UDim2.fromOffset(1600, 1600), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), BackgroundTransparency = 1, ZIndex = 1}, root)
                        for k = 0, 15 do
                                local arm = make("Frame", {Size = UDim2.fromOffset(16, 1600), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Rotation = k * 11.25}, beams)
                                local beam = make("Frame", {Size = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.fromRGB(255, 230, 160), BackgroundTransparency = 0.82, BorderSizePixel = 0}, arm)
                                make("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1)})}, beam)
                        end
                        st.beams = beams

                        -- HAPPY NEW YEAR, letter by letter
                        local ts = math.clamp(math.floor(H * 0.085), 26, 80)
                        local holder = make("Frame", {BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.28), ZIndex = 10}, root)
                        make("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, holder)
                        st.letters = {}
                        local text = "HAPPY NEW YEAR"
                        for idx = 1, #text do
                                local ch = text:sub(idx, idx)
                                local w = make("Frame", {BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, ts + 16), LayoutOrder = idx, ZIndex = 10}, holder)
                                local l = make("TextLabel", {BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(ch == " " and ts * 0.35 or 0, ts + 16), Position = UDim2.fromOffset(0, 70),
                                        Text = ch, Font = Enum.Font.GothamBlack, TextSize = ts, TextColor3 = Color3.new(1, 1, 1), TextTransparency = 1, TextStrokeTransparency = 1, TextStrokeColor3 = Color3.fromRGB(20, 10, 40), ZIndex = 10}, w)
                                if ch ~= " " then st.letters[#st.letters + 1] = l end
                                task.delay(idx * 0.06, function()
                                        if st.dead then return end
                                        tw(l, 0.7, {Position = UDim2.fromOffset(0, 0), TextTransparency = 0, TextStrokeTransparency = 0.35}, Enum.EasingStyle.Back)
                                end)
                        end
                        st.title = holder

                        -- the big golden year
                        local ys = math.clamp(math.floor(H * 0.2), 56, 190)
                        local yHolder = make("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(ys * 3.4, ys * 1.2), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), ZIndex = 10}, root)
                        local glow = make("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = tostring(year), Font = Enum.Font.GothamBlack, TextSize = ys,
                                TextColor3 = Color3.fromRGB(255, 140, 30), TextTransparency = 1, ZIndex = 9}, yHolder)
                        make("UIScale", {Scale = 1.1}, glow)
                        local main = make("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = tostring(year), Font = Enum.Font.GothamBlack, TextSize = ys,
                                TextColor3 = Color3.new(1, 1, 1), TextTransparency = 1, ZIndex = 10}, yHolder)
                        st.yearGrad = make("UIGradient", {Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 190, 40)), ColorSequenceKeypoint.new(0.5, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 190, 40))})}, main)
                        local ystroke = make("UIStroke", {Color = Color3.fromRGB(120, 60, 0), Thickness = 3, Transparency = 1}, main)
                        st.yearScale = make("UIScale", {Scale = 0}, yHolder)
                        tw(st.yearScale, 0.9, {Scale = 1}, Enum.EasingStyle.Back)
                        tw(main, 0.6, {TextTransparency = 0})
                        tw(glow, 0.8, {TextTransparency = 0.7})
                        tw(ystroke, 0.6, {Transparency = 0.2})
                        task.delay(1.2, function() st.pulse = true end)

                        local sub = make("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -40, 0, 30), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.7),
                                Text = "Welcome to " .. year .. "   -   Holex Script Hub wishes you an amazing year", Font = Enum.Font.GothamMedium, TextSize = math.clamp(math.floor(H * 0.03), 13, 24),
                                TextColor3 = Color3.fromRGB(255, 240, 210), TextTransparency = 1, ZIndex = 10}, root)
                        task.delay(1.0, function() if not st.dead then tw(sub, 0.8, {TextTransparency = 0}) end end)

                        confetti(140, false)
                        Notify("Happy New Year " .. year, "Wishing you an amazing " .. year .. "!", 6)

                        task.spawn(function()
                                for _ = 1, 12 do
                                        if st.dead then return end
                                        launch(W * (0.08 + 0.84 * math.random()), H * (0.12 + 0.3 * math.random()))
                                        task.wait(0.18)
                                end
                        end)

                        local endAt = os.clock() + (isTest and 14 or 22)
                        local lastConf, lastRing, hue = 0, 0, 0
                        while not st.dead and os.clock() < endAt do
                                task.wait(0.32 + math.random() * 0.2)
                                if st.dead then return end
                                local w2, h2 = size()
                                launch(w2 * (0.06 + 0.88 * math.random()), h2 * (0.1 + 0.35 * math.random()))
                                if math.random() < 0.4 then launch(w2 * (0.06 + 0.88 * math.random()), h2 * (0.1 + 0.35 * math.random())) end
                                local n = os.clock()
                                if n - lastConf > 1.3 then lastConf = n; confetti(26, true) end
                                if n - lastRing > 0.8 then
                                        lastRing = n
                                        hue = (hue + 0.13) % 1
                                        ring(w2 / 2, h2 * 0.42, Color3.fromHSV(hue, 0.7, 1), 900, 1.4)
                                end
                        end
                        if st.dead then return end

                        -- fade out
                        tw(holder, 1, {Position = UDim2.fromScale(0.5, 0.2)})
                        for _, l in ipairs(st.letters) do tw(l, 0.9, {TextTransparency = 1, TextStrokeTransparency = 1}) end
                        tw(main, 0.9, {TextTransparency = 1}); tw(glow, 0.9, {TextTransparency = 1}); tw(ystroke, 0.9, {Transparency = 1}); tw(sub, 0.9, {TextTransparency = 1})
                        st.letters, st.pulse = nil, false
                        tw(root, 2.4, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad)
                        task.wait(3.6)
                        cleanup()
                end

                task.spawn(function()
                        tw(root, 0.7, {BackgroundTransparency = 0.35})
                        if targetTime and targetTime > os.time() then
                                local lastN = -1
                                while not st.dead do
                                        local n = targetTime - os.time()
                                        if n <= 0 then break end
                                        if n ~= lastN then
                                                lastN = n
                                                countdownTick(n)
                                        end
                                        task.wait(0.05)
                                end
                        end
                        if st.dead then return end
                        local ok, err = pcall(midnight)
                        if not ok then
                                warn("[Holex] New Year show error: " .. tostring(err))
                                cleanup()
                        end
                end)
        end

        function NY.test(withCountdown)
                local y = tonumber(os.date("%Y")) + 1
                NY.run(y, withCountdown and (os.time() + 10) or nil, true)
        end

        -- watcher: starts the show during the last 10 seconds of the year
        task.spawn(function()
                local startYear = tonumber(os.date("%Y"))
                local gate = 0
                task.wait(7)
                local t0 = os.date("*t")
                if S.nyOn and t0.month == 1 and t0.day == 1 and NY.done < t0.year and gui.Parent and not active then
                        NY.run(t0.year, nil, false)
                end
                while gui.Parent do
                        task.wait(0.25)
                        if S.nyOn and not active then
                                local now = os.time()
                                local d = os.date("*t", now)
                                local nxt = os.time({year = d.year + 1, month = 1, day = 1, hour = 0, min = 0, sec = 0})
                                local rem = nxt - now
                                if rem <= 10 and rem > 0 and gate ~= d.year and NY.done < d.year + 1 then
                                        gate = d.year
                                        NY.run(d.year + 1, nxt, false)
                                elseif d.year > startYear and NY.done < d.year then
                                        startYear = d.year
                                        NY.run(d.year, nil, false)
                                end
                        end
                end
        end)
end
module()
end

