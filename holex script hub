        -- v6.9 PACKET LOGGER + REMOTE EVENT SNIFFER
        --------------------------------------------------------------
        Section(page, "Packet Logger + Remote Event Sniffer")
        do
                local SN = {on = false, count = 0, logs = {}}
                X.Sniffer = SN
                local snList = H.ListCard(page, 220)
                local snCount = label(page, "0 remotes captured.", 11, "sub", Enum.Font.Gotham, {Size = UDim2.new(1, 0, 0, 16)})
                local function fmtVal(v, depth)
                        depth = depth or 0
                        local tv = typeof(v)
                        if depth > 1 then return tv end
                        if tv == "string" then return '"' .. tostring(v):sub(1, 60) .. '"'
                        elseif tv == "Instance" then return v:GetFullName():sub(1, 90)
                        elseif tv == "table" then return "{...}"
                        elseif tv == "Vector3" then return string.format("(%.1f, %.1f, %.1f)", v.X, v.Y, v.Z)
                        elseif tv == "CFrame" then return "CFrame"
                        elseif tv == "number" or tv == "boolean" or tv == "nil" then return tostring(v)
                        else return tv end
                end
                local function logRemote(method, remote, args)
                        SN.count += 1
                        local line = string.format("#%d %s %s(%s)", SN.count, method, remote.Name, fmtVal(args[1]))
                        for i = 2, math.min(#args, 4) do line = line .. ", " .. fmtVal(args[i]) end
                        SN.logs[#SN.logs + 1] = {line = line, method = method, name = remote.Name}
                        while #SN.logs > 150 do table.remove(SN.logs, 1) end
                        if snList and SN.on then
                                H.Line(snList, H.esc(line), "text", 11)
                                task.defer(function() snList.CanvasPosition = Vector2.new(0, 1e6) end)
                        end
                        snCount.Text = SN.count .. " remotes captured" .. (SN.on and " (logging live)" or " (paused - toggle below)")
                end
                -- one-time global namecall hook (logging only happens while SN.on)
                if not X._remoteHooked and hookmetamethod then
                        X._remoteHooked = true
                        pcall(function()
                                local nc = (newcclosure or function(f) return f end)
                                local old
                                old = hookmetamethod(game, "__namecall", nc(function(self, ...)
                                        local m = getnamecallmethod()
                                        if (m == "FireServer" or m == "InvokeServer") and X.Sniffer and X.Sniffer.on and typeof(self) == "Instance" and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction") or self:IsA("UnreliableRemoteEvent")) then
                                                local ok, err = pcall(logRemote, m, self, table.pack(...))
                                                if not ok then print("[Holex sniffer] " .. tostring(err)) end
                                        end
                                        return old(self, ...)
                                end))
                        end)
                end
                Toggle(page, "Live remote logging (FireServer / InvokeServer)", "Captures every remote your client sends with its arguments", false, function(v)
                        SN.on = v
                        if v and not X._remoteHooked then Notify("Sniffer", "Your executor has no hookmetamethod - live logging unavailable.", 4) end
                end)
                Button(page, "Refresh remote list", function()
                        H.clear(snList)
                        for _, e in ipairs(SN.logs) do H.Line(snList, H.esc(e.line), "text", 11) end
                end)
                Button(page, "Clear remotes", function() SN.logs = {}; SN.count = 0; snCount.Text = "0 remotes captured."; H.clear(snList) end)
                Button(page, "Copy all captured remotes", function()
                        local t = {}
                        for _, e in ipairs(SN.logs) do t[#t + 1] = e.line end
                        V.copy(table.concat(t, "\n"), "Remote log")
                end)
                Dropdown(page, "Highlight method", {"All", "FireServer", "InvokeServer"}, "All", function(v)
