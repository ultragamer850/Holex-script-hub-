        -- face the aim direction while charging / firing
        --------------------------------------------------------------
        function X.kiFace(dt, dir)
                local fig = X.getMyCharacter()
                local root = fig and X.getRoot(fig)
                if not root then return end
                local K = X.Ki
                local hum = fig:FindFirstChildOfClass("Humanoid")
                if hum and K.autoRotHum ~= hum then
                        if K.autoRotHum and K.autoRotHum.Parent then
                                pcall(function() K.autoRotHum.AutoRotate = K.autoRotOld ~= false end)
                        end
                        K.autoRotHum = hum
                        K.autoRotOld = hum.AutoRotate
                end
                if hum then pcall(function() hum.AutoRotate = false end) end
                local flat = Vector3.new(dir.X, 0, dir.Z)
                if flat.Magnitude < 0.05 then return end
                local want = CFrame.lookAt(root.Position, root.Position + flat)
                local a = 1 - math.exp(-16 * math.clamp(dt or 0.016, 0, 0.1))
                pcall(function() root.CFrame = root.CFrame:Lerp(want, a) end)
        end

        function X.kiFaceRestore()
                local K = X.Ki
                if K.autoRotHum then
                        pcall(function()
                                if K.autoRotHum.Parent then K.autoRotHum.AutoRotate = K.autoRotOld ~= false end
                        end)
                end
                K.autoRotHum, K.autoRotOld = nil, nil
        end

        --------------------------------------------------------------
        -- Goku poses (applied on top of the figure pose, needs Figure anims ON)
        --------------------------------------------------------------
        function X.kiPoseOverlay(P, state, now)
                local K = X.Ki
                local ph = K.phase
                if not ph then return P end
                local rad = math.rad
                local function setPose(T, k)
                        for key, v in pairs(T) do
                                if P[key] ~= nil then P[key] = lerpn(P[key], v, k) end
                        end
                end
                if ph == "charge" or ph == "fire" or ph == "recover" then
                        local abd = rad(24)
                        local w, T = 1, nil
                        if ph == "charge" then
                                local c = K.charge or 0
                                w = ssmooth((now - K.t0) / 0.3)
                                T = {
                                        dy = -(2 - 2 * math.cos(abd)), lean = 0.1 + 0.08 * c, yaw = 0.45, hp = 0.1,
                                        rK = -0.55, lK = -0.45, rA = -0.3, lA = -0.3, rLA = abd, lLA = abd, rL = 0, lL = 0,
                                }
                                local tr = 0.2 + 0.8 * c
                                P.rA = P.rA + 0.05 * tr * math.sin(now * 55)
                                P.lA = P.lA + 0.05 * tr * math.sin(now * 55 + 2)
                                P.dy = P.dy + 0.03 * tr * math.sin(now * 61)
                        else
                                local e = (ph == "fire") and ssmooth((now - K.fireT0) / 0.14) or 1
                                T = {
                                        dy = -(2 - 2 * math.cos(abd)), lean = lerpn(0.18, -0.1, e), yaw = lerpn(0.45, 0, e), hp = lerpn(0.1, 0.2, e),
                                        rK = lerpn(-0.55, 1.0, e), lK = lerpn(-0.45, 1.0, e), rA = lerpn(-0.3, -0.42, e), lA = lerpn(-0.3, -0.42, e),
                                        rLA = abd, lLA = abd, rL = 0, lL = 0,
                                }
                                if ph == "recover" then
                                        w = 1 - ssmooth((now - K.t0) / 0.35)
                                else
                                        P.dy = P.dy + 0.02 * math.sin(now * 70)
                                end
                        end
                        if state ~= "Idle" then
                                -- walking / jumping keeps its own legs, only the upper body is posed
                                T.dy, T.rLA, T.lLA, T.rL, T.lL = nil, nil, nil, nil, nil
                        end
                        setPose(T, w)
                elseif ph == "tele" and m.KiTelePose ~= false then
                        -- Instant Transmission: two fingers to the forehead
                        local e = ssmooth((now - K.t0) / 0.18)
                        local after = K.teleDone and ssmooth((now - (K.teleDoneT or now)) / 0.3) or 0
                        setPose({ rK = 1.72, rA = -0.6, lA = rad(8), hp = -0.12, lean = 0.03 }, e * (1 - after))
                        if not K.teleDone then P.dy = P.dy + 0.012 * math.sin(now * 40) end
                end
                return P
        end

