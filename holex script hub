        function X.stepAll(dt)
                if not m.Enabled or X.Dead then return end
                X.Frame = X.Frame + 1
                -- when combat finishes, force present bullets back underground
                local combatOn = X.combatActive and X.combatActive()
                if X._combatWasOn and not combatOn then
                        task.defer(function() pcall(X.kiForceParkPresent, "combat end") end)
                end
                X._combatWasOn = combatOn
                -- LowLag: skip solid step frames
                if m.LowLag then
                        local skip = math.max(1, math.floor(tonumber(m.LowLagSkip) or 2))
                        X.SolidSkip = (X.SolidSkip or 0) + 1
                        if X.SolidSkip < skip then
                                -- still allow debounced autosave
                        else
                                X.SolidSkip = 0
                                pcall(X.hatsSolidStep)
                        end
                else
                        pcall(X.hatsSolidStep)
                end
                pcall(X.partsStep, dt)
                pcall(X.partsGuiStep, os.clock())
                pcall(X.stepWorldHold, dt)
                -- pcall(X.powerUpStep, dt) REMOVED
                -- pcall(X.stepPowerUpEffects, dt) REMOVED
                pcall(X.pfStep, dt)
                -- pcall(X.kiStep, dt) REMOVED
                -- pcall(X.panStep, dt) REMOVED
                -- pcall(X.rpgStep, dt) REMOVED
                -- -- pcall(X.hatOrbitStep, dt) REMOVED REMOVED
                -- figure procedural Idle/Walk/Run/Jump/Fall/Grab (GmodMoveset-style on Uhhhhhh R6)
                pcall(function()
                        local fig = X.getMyCharacter()
                        if fig then X.figAnimate(dt, fig) end
                end)
                if m.AutoSave and X.SaveDirty and (os.clock() - (X.SaveT or 0)) > 2 then
                        X.SaveDirty = false
                        X.SaveT = os.clock()
                        pcall(X.writeSaveFile)
                end
        end

        function X.startLoop()
                if FollowBound or X.Dead then return end
                -- Single Heartbeat only (was Heartbeat + Stepped = double work / lag)
                HBConn = RunService.Heartbeat:Connect(function(dt)
                        pcall(X.stepAll, math.clamp(dt, 0, 0.1))
                end)
                X.LateConns = {}
                X.bindKeys()
                X.bindCharacter()
                X.startNPCSimRadius()
                X.figStartReapply()
                FollowBound = true
                if m.HatsSolidAutoEnableOnStart then
                        m.HatsSolid = true
                end
                if m.HatsSolid then pcall(X.boostNetwork) end
                warn("[HatCollision] loop started | solid=" .. tostring(m.HatsSolid) .. " | figAnim=" .. tostring(m.FigAnim) .. " | lowLag=" .. tostring(m.LowLag))
        end

        function X.stopLoop()
                if HBConn then pcall(function() HBConn:Disconnect() end) HBConn = nil end
                for _, c in ipairs(KeyConns) do pcall(function() c:Disconnect() end) end
                for _, c in ipairs(CharConns) do pcall(function() c:Disconnect() end) end
                for _, c in ipairs(X.LateConns or {}) do pcall(function() c:Disconnect() end) end
                KeyConns, CharConns, X.LateConns = {}, {}, {}
                X.stopNPCFollow()
                X.stopNPCAura("all")
                X.stopNPCControl()
                X.stopNPCSimRadius()
                pcall(X.partsRelease)
                pcall(X.partsGuiDestroy)
                pcall(X.worldHoldRelease, true)
                pcall(X.powerUpStopLoop)
                pcall(X.puStop)
                pcall(X.peReleaseAll)
                pcall(X.kiStopAll)
                pcall(X.pfSet, false)
                X.PUKeepReady = false
                X.PowerUpActive = false
                m.PowerUp = false
                X.hatsSolidRestore()
                X.figStopReapply()
                FollowBound = false
        end

        function X.refreshState()
                if m.Enabled then
                        X.startLoop()
                else
                        X.stopLoop()
                end
        end

