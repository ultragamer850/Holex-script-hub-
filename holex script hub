                end}

                tasks[#tasks + 1] = {"Downloading files", function(sub)
                        if #Boot.FILES == 0 then log("no remote files configured (Boot.FILES is empty)") return end
                        if not hasFileApi then log("MISS  filesystem missing, cannot cache files", "warn") return end
                        for i, f in ipairs(Boot.FILES) do
                                local file = f.file or (f.name .. ".bin")
                                local path = cachePath(file)
                                local have = false
                                pcall(function() have = isfile(path) end)
                                if not have then
                                        log("..    downloading " .. file)
                                        local body = httpGet(f.url)
                                        if body then
                                                local ok = pcall(writefile, path, body)
                                                have = ok
                                                log((ok and "OK    " or "FAIL  ") .. file .. (ok and (" (" .. #body .. " bytes)") or " could not be written"), ok and "ok" or "bad")
