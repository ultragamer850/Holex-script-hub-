        X.playSFX = function(id, volume, parent, pitch)
                if not id or id == "" or id == "0" then return end
                local sid = tostring(id)
                if not string.find(sid, "rbxassetid://", 1, true) then
                        sid = "rbxassetid://" .. sid:gsub("%D", "")
