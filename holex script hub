--==================================================================
-- v6.9 PERFORMANCE CENTER  (shared with Tools > FPS & Performance)
--   FPS unlock (setfpscap), lag switch (freeze incoming replication) and
--   one-tap performance modes. X.Perf is global so the Tools tab and the
--   Dashboard always show the same state. IIFE: zero main-chunk locals.
--==================================================================
;(function()
        local Perf = {fpsCap = false, capValue = 0, lagOn = false, mode = "Normal", saved = nil}
        X.Perf = Perf
        local PerfLighting = game:GetService("Lighting")
        local PerfWorkspace = game:GetService("Workspace")

        local function getRender() local ok, r = pcall(function() return settings().Rendering end) if ok then return r end end
        local function getNet() local ok, r = pcall(function() return settings():GetService("NetworkSettings") end) if ok then return r end end

        function Perf.applyCap(v)
                Perf.capValue = v
                if type(setfpscap) == "function" then
                        pcall(setfpscap, v == 0 and 9999 or v)
                end
                local R = getRender()
                if R then pcall(function() R.MaxFramesPerSecond = (v == 0) and 10000 or v end) end
                Perf.fpsCap = (v ~= nil)
                if X.V14 and X.V14.set then pcall(X.V14.set, "fpsCapValue", v) end
        end

        function Perf.unlockFPS()
                Perf.applyCap(0)
                Notify("FPS Unlock", "Frame cap removed (9999 fps). Restart-proof: re-applies every 30s.", 4)
        end

        function Perf.setLag(on)
                local NS = getNet()
                local done = false
                if NS then
                        -- IncomingReplicationLag is a hidden property: make it writable, then set it
                        pcall(function()
                                if setscriptable then setscriptable(NS, "IncomingReplicationLag", true) end
                        end)
                        pcall(function()
                                if sethiddenproperty then sethiddenproperty(NS, "IncomingReplicationLag", on and 9999 or 0) end
                        end)
                        pcall(function() NS.IncomingReplicationLag = on and 9999 or 0; done = true end)
                end
                Perf.lagOn = on and true or false
                pcall(function() if X.V14 then X.V14.act("PERF", "lag switch " .. tostring(on)) end end)
                return done
        end

        function Perf.apply(mode)
                local R = getRender()
                if mode == "Potato" then
                        if Perf.saved == nil and R then
                                Perf.saved = {q = (pcall(function() return R.QualityLevel end) and R.QualityLevel or nil), sh = PerfLighting.GlobalShadows, fog = PerfLighting.FogEnd}
                        end
                        pcall(function() R.QualityLevel = Enum.QualityLevel.Level01 end)
                        pcall(function() settings().Physics.PhysicsEnvironmentThrottle = Enum.PhysicsThrottle.Always end)
                        PerfLighting.GlobalShadows = false
                        PerfLighting.FogEnd = 1e5
                        Perf.applyCap(0)
                        for _, d in ipairs(PerfWorkspace:GetDescendants()) do
                                pcall(function() if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then d.Enabled = false end end)
                        end
                        Perf.mode = "Potato"
                        Notify("Performance", "POTATO mode: lowest graphics + uncapped fps + effects off.", 4)
                elseif mode == "High FPS" then
                        if R then pcall(function() R.QualityLevel = Enum.QualityLevel.Level03 end) end
                        PerfLighting.GlobalShadows = false
                        Perf.applyCap(0)
                        Perf.mode = "High FPS"
                        Notify("Performance", "HIGH FPS mode: medium graphics + shadows off + uncapped fps.", 4)
                else
                        if Perf.saved and R and Perf.saved.q then pcall(function() R.QualityLevel = Perf.saved.q end) end
                        PerfLighting.GlobalShadows = Perf.saved and Perf.saved.sh or true
                        Perf.applyCap(60)
                        Perf.mode = "Normal"
                        Notify("Performance", "Normal mode restored (60 fps cap).", 3)
                end
                pcall(function() if X.V14 then X.V14.act("PERF", "mode -> " .. mode) end end)
        end

        -- re-assert the fps cap every 30s (some executors reset it on server change)
        task.spawn(function()
                while gui.Parent do
                        task.wait(30)
                        if Perf.fpsCap and Perf.capValue ~= nil then pcall(Perf.applyCap, Perf.capValue) end
                end
        end)

        Section(dash, "Performance Center")
        local perfRow = frame(dash, nil, UDim2.new(1, 0, 0, 44))
        make("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder}, perfRow)
        local modeLbl
        local function pBtn(txt, w, cb)
                local b = Button(perfRow, txt, cb, UDim2.fromOffset(w or 118, 40))
                return b
        end
        pBtn("POTATO", 118, function() Perf.apply("Potato") end)
        pBtn("HIGH FPS", 118, function() Perf.apply("High FPS") end)
        pBtn("NORMAL", 118, function() Perf.apply("Normal") end)
        modeLbl = label(dash, "Mode: Normal   |   press a mode for one-tap performance", 11, "sub", Enum.Font.Gotham, {Size = UDim2.new(1, 0, 0, 14)})
        task.spawn(function()
                while gui.Parent do
                        task.wait(2)
                        local cap = Perf.capValue == 0 and "uncapped" or tostring(Perf.capValue)
                        modeLbl.Text = string.format("Mode: %s   |   fps cap: %s   |   lag switch: %s", Perf.mode, Perf.fpsCap and cap or "default", Perf.lagOn and "ON" or "off")
                end
        end)
        Toggle(dash, "FPS unlock (one-tap)", "Removes the 60 fps cap with setfpscap (stays on until you turn it off)", false, function(v)
                if v then Perf.applyCap(0) else Perf.applyCap(60) end
        end)
        Toggle(dash, "Lag switch (hold L)", "Freezes incoming replication while you hold L - one-tap network freeze", false, function(v)
                if v then
                        X._lagConn = UIS.InputBegan:Connect(function(i, gp)
                                if gp then return end
                                if i.KeyCode == Enum.KeyCode.L then Perf.setLag(true) end
                        end)
                        X._lagConn2 = UIS.InputEnded:Connect(function(i)
                                if i.KeyCode == Enum.KeyCode.L then Perf.setLag(false) end
                        end)
                        Notify("Lag switch", "ON. Hold L to freeze the world, release to resume.", 4)
                else
                        if X._lagConn then pcall(function() X._lagConn:Disconnect() end) end
                        if X._lagConn2 then pcall(function() X._lagConn2:Disconnect() end) end
                        Perf.setLag(false)
                end
        end)
end)()

