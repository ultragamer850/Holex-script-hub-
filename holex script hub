bind(fab, "BackgroundColor3", "card"); bind(fab, "TextColor3", "text"); circle(fab); stroke(fab, "text", 1.5, 0.4)
fab.MouseEnter:Connect(function() tw(fab, 0.3, {Size = UDim2.fromOffset(50, 50), Position = UDim2.new(0, 13, 0.5, -25)}, Enum.EasingStyle.Back) end)
