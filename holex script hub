                                        base = basePos,
                                        h = 2.5 + math.random() * 5,
                                        bob = 1.5 + math.random() * 2,
                                        ph = math.random() * 6.28,
                                        spin = Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 3,
