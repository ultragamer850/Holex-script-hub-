                local a = V.holexName()
                if X.Auth and X.Auth.state and not X.Auth.state.loggedIn then a = "guest-" .. LP.Name end
                return a
        end
        local function loadLocal()
                local d = V.json(NFILE)
                if type(d) == "table" and type(d.notes) == "table" then
                        for _, e in ipairs(d.notes) do
                                if type(e) == "table" and e.k and e.m then
                                        local key = tostring(e.k):lower() .. "|" .. tostring(e.a) .. "|" .. tostring(e.t)
                                        if not NO.keys[key] then
                                                NO.keys[key] = true
                                                NO.notes[#NO.notes + 1] = {k = tostring(e.k), a = tostring(e.a or "?"), t = tonumber(e.t) or 0, m = tostring(e.m)}
                                        end
                                end
                        end
                        table.sort(NO.notes, function(x, y) return x.t < y.t end)
                end
        end
        local function saveLocal()
