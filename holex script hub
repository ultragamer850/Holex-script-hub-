                local l = make("TextLabel", {BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamBold, TextSize = 12, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(5, 5), Visible = false, ZIndex = 4, Active = false}, over)
