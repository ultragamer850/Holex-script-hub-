        function X.cleanHatLabel(label)
                label = tostring(label or "")
                label = label:gsub("^%s+", ""):gsub("%s+$", "")
                if label == "" or label == "(none)" or label == "None" or label == "-" then return "" end
                return label
        end

        function X.hatLabelListRaw()
                -- Every hat we can find, FE (network-owned / real character) hats first.
                -- Duplicate names get " #2", " #3" ... so each one can be picked on its own.
                local handles = X.hatsSolidHandles(true) or {}
                local lc = LocalPlayer.Character
                local rc = nil
                pcall(function()
                        local uh = HX.uh()
                        rc = uh and uh.Reanimate and uh.Reanimate.Character
                end)
                local function rank(h)
                        if isnetworkowner then
                                local ok, own = pcall(isnetworkowner, h)
                                if ok and own then return 0 end
                        end
                        if lc and h:IsDescendantOf(lc) then return 1 end
                        if rc and h:IsDescendantOf(rc) then return 2 end
                        return 3
                end
                local list = {}
                for i, h in ipairs(handles) do
                        if h and h.Parent then list[#list + 1] = { h = h, r = rank(h), i = i } end
                end
                table.sort(list, function(a, b)
                        if a.r ~= b.r then return a.r < b.r end
                        return a.i < b.i
                end)
                local out, counts = {}, {}
                for _, e in ipairs(list) do
                        local an = X.hatAccessoryName(e.h)
                        counts[an] = (counts[an] or 0) + 1
                        local label = (counts[an] == 1) and an or (an .. " #" .. counts[an])
                        out[#out + 1] = { label = label, name = an, handle = e.h, rank = e.r }
                end
                return out
        end

        -- Holex perf patch: the full hat scan + sort ran on every call (it was forced); cache it briefly
        function X.hatLabelList()
                local now = os.clock()
                local c = X._hllC
                if c and now - (X._hllT or 0) < 0.6 then
                        local alive = true
                        for i = 1, #c do
                                if not (c[i].handle and c[i].handle.Parent) then alive = false break end
                        end
                        if alive then return c end
                end
                c = X.hatLabelListRaw()
                X._hllC, X._hllT = c, now
                return c
        end

        function X.dropdownHatNames(includeNone)
                local names = {}
                if includeNone ~= false then names[1] = "(none)" end
                for _, e in ipairs(X.hatLabelList()) do
                        names[#names + 1] = e.label
                end
                return names
        end

        function X.syncSlotStrings()
                local o, p = {}, {}
                for i = 1, 5 do
                        local a = X.cleanHatLabel(m["HatOrbitSlot" .. i])
                        local b = X.cleanHatLabel(m["PowerUpEffectHat" .. i])
                        if a ~= "" then o[#o + 1] = a end
                        if b ~= "" then p[#p + 1] = b end
                end
                m.HatOrbitNames = table.concat(o, ",")
                m.PowerUpEffectNames = table.concat(p, ",")
        end

        function X.parseHatNameList(str, maxN)
                local names = {}
                maxN = maxN or 5
                for name in string.gmatch(tostring(str or ""), "[^,]+") do
                        name = X.trim(name)
                        if name ~= "" then
                                names[#names + 1] = name
                                if #names >= maxN then break end
                        end
                end
                return names
        end

        function X.hatOrbitParseNames()
                X.syncSlotStrings()
                local fromSlots = {}
                for i = 1, math.floor(tonumber(m.HatOrbitMax) or 5) do
                        local lab = X.cleanHatLabel(m["HatOrbitSlot" .. i])
                        if lab ~= "" then fromSlots[#fromSlots + 1] = lab end
                end
                if #fromSlots > 0 then return fromSlots end
                return X.parseHatNameList(m.HatOrbitNames, math.floor(tonumber(m.HatOrbitMax) or 5))
        end

        function X.powerUpEffectParseNames()
                X.syncSlotStrings()
                local fromSlots = {}
                for i = 1, math.floor(tonumber(m.PowerUpEffectMax) or 5) do
                        local lab = X.cleanHatLabel(m["PowerUpEffectHat" .. i])
                        if lab ~= "" then fromSlots[#fromSlots + 1] = lab end
                end
                if #fromSlots > 0 then return fromSlots end
                return X.parseHatNameList(m.PowerUpEffectNames, math.floor(tonumber(m.PowerUpEffectMax) or 5))
        end

        function X.findHandleByLabel(label)
                label = X.cleanHatLabel(label)
                if label == "" then return nil end
                local lname = string.lower(label)
                local now = os.clock()
                local cached = X.LabelCache
                if cached and now - (X.LabelCacheT or 0) < 0.3 then
                        local ch, cn = X.findHandleInList(cached, lname)
                        if ch and ch.Parent then return ch, cn end
                end
                local fresh = X.hatLabelList()
                X.LabelCache, X.LabelCacheT = fresh, now
                return X.findHandleInList(fresh, lname)
        end

        function X.findHandleInList(list, lname)
                for _, e in ipairs(list) do
                        if string.lower(e.label) == lname then return e.handle, e.name end
                end
                for _, e in ipairs(list) do
                        if string.lower(e.name) == lname or string.lower(e.handle.Name) == lname then
                                return e.handle, e.name
                        end
                end
                for _, e in ipairs(list) do
                        local ln = string.lower(e.name)
                        if ln ~= "" and (string.find(ln, lname, 1, true) or string.find(lname, ln, 1, true)) then
                                return e.handle, e.name
                        end
                end
                return nil
        end

        function X.resolveHatSlotsByNames(want)
                local slots = {}
                local used = {}
                for _, name in ipairs(want or {}) do
                        local h = X.findHandleByLabel(name)
                        if h and not used[h] then
                                slots[#slots + 1] = h
                                used[h] = true
                        end
                end
                return slots
        end

        -- FE control for power-up effect hats (adapted from HatOrbit.lua attachFE / driveHandle)
        --------------------------------------------------------------
        X.peReleaseOne = function(handle, held)
                if handle and Claims and Claims[handle] == INSTANCE_ID then Claims[handle] = nil end
                held = held or (handle and X.PowerUpEffectHeld[handle])
                if held then
                        pcall(function() if held.AP then held.AP:Destroy() end end)
                        pcall(function() if held.AO then held.AO:Destroy() end end)
                        pcall(function() if held.Att then held.Att:Destroy() end end)
                        -- hand the hat back to whatever was driving it before we took it
                        for _, rec in ipairs(held.Saved or {}) do
                                pcall(function()
                                        if rec.parent then
                                                if rec.inst and rec.parent.Parent then rec.inst.Parent = rec.parent end
                                        elseif rec.inst and rec.inst.Parent then
                                                rec.inst.Enabled = rec.old
                                        end
                                end)
                        end
                        pcall(function()
                                if held.Handle and held.Handle.Parent then
                                        if held.OldCC ~= nil then held.Handle.CanCollide = held.OldCC end
                                        if held.OldMassless ~= nil then held.Handle.Massless = held.OldMassless end
                                end
                        end)
                end
                if handle then X.PowerUpEffectHeld[handle] = nil end
        end

        X.peReleaseAll = function(keepSet)
                for handle, held in pairs(X.PowerUpEffectHeld) do
                        if not (keepSet and keepSet[handle]) then
                                X.peReleaseOne(handle, held)
                        end
                end
                if not next(X.PowerUpEffectHeld) and X.PEStepConn then
                        pcall(function() X.PEStepConn:Disconnect() end)
                        X.PEStepConn = nil
                end
        end

        X.peAttachFE = function(handle, kind)
                if not handle or not handle.Parent then return nil end
                local ex = X.PowerUpEffectHeld[handle]
                if ex then
                        ex.Kind = kind or ex.Kind
                        return ex
                end
                -- another module owns this hat: take it anyway (you picked it) unless ForceTake is off
                if Claims and Claims[handle] and Claims[handle] ~= INSTANCE_ID and m.PowerUpEffectForceTake == false then
                        return nil
                end
                if Claims then Claims[handle] = INSTANCE_ID end
                pcall(X.boostNetwork)
                local held = { Handle = handle, Kind = kind or "powerup", Saved = {} }
                pcall(function()
                        held.OldCC = handle.CanCollide
                        held.OldMassless = handle.Massless
                end)
                -- switch off whatever else drives this hat (reanimate welds / aligns / body movers)
                local function park(inst)
                        if not inst or not inst.Parent then return end
                        if string.sub(inst.Name, 1, 3) == "HC_" then return end
                        if inst:IsA("BodyMover") then
                                held.Saved[#held.Saved + 1] = { inst = inst, parent = inst.Parent }
                                inst.Parent = nil
                        elseif inst:IsA("Constraint") or inst:IsA("JointInstance") or inst:IsA("WeldConstraint") then
                                local on = false
                                pcall(function() on = inst.Enabled end)
                                if on then
                                        held.Saved[#held.Saved + 1] = { inst = inst, old = true }
                                        pcall(function() inst.Enabled = false end)
                                end
                        end
                end
                for _, d in ipairs(handle:GetChildren()) do park(d) end
                local okj, joints = pcall(function() return handle:GetJoints() end)
                if okj and type(joints) == "table" then
                        for _, j in ipairs(joints) do park(j) end
                end
                pcall(function()
                        handle.Anchored = false
                        handle.CanCollide = false
                        handle.CanTouch = false
                        handle.Massless = true
                end)
                pcall(function()
                        local att = Instance.new("Attachment")
                        att.Name = "HC_PE_Att"
                        att.Parent = handle
                        held.Att = att
                        local ap = Instance.new("AlignPosition")
                        ap.Name = "HC_PE_AP"
                        ap.Mode = Enum.PositionAlignmentMode.OneAttachment
                        ap.Attachment0 = att
                        ap.RigidityEnabled = true
                        ap.MaxForce = math.huge
                        ap.Responsiveness = 200
                        ap.Position = handle.Position
                        ap.Parent = handle
                        held.AP = ap
                        local ao = Instance.new("AlignOrientation")
                        ao.Name = "HC_PE_AO"
                        ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
                        ao.Attachment0 = att
                        ao.RigidityEnabled = true
                        ao.MaxTorque = math.huge
                        ao.Responsiveness = 200
                        ao.CFrame = handle.CFrame
                        ao.Parent = handle
                        held.AO = ao
                end)
                X.PowerUpEffectHeld[handle] = held
                -- second write pass in Stepped so reanimate loops that run before physics can't pull the hat back
                if not X.PEStepConn then
                        X.PEStepConn = RunService.Stepped:Connect(function()
                                if m.PowerUpEffectHardLock == false then return end
                                for _, hd in pairs(X.PowerUpEffectHeld) do
                                        local part = hd.Handle
                                        if hd.TargetCF and part and part.Parent then
                                                pcall(function() part.CFrame = hd.TargetCF end)
                                        end
                                end
                        end)
                end
                return held
        end

        X.peDriveHandle = function(held, cf)
                if not held or not held.Handle then return end
                held.TargetCF = cf
                local part = held.Handle
                pcall(function()
                        if held.AP then held.AP.Position = cf.Position end
                        if held.AO then held.AO.CFrame = cf end
                        if m.PowerUpEffectHardLock ~= false then
                                part.CFrame = cf
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                        end
                end)
        end

        -- Gyroscope / power-up style offsets (1-5 from HatOrbit, 6-7 = Goku styles)
        function X.peOrbitOffset(style, t, idx, total, rad, h, spd)
                local pi2 = math.pi * 2
                local frac = (idx - 1) / math.max(total, 1)
                local ang = t * spd + frac * pi2
                local V = Vector3.new
                style = math.clamp(math.floor(tonumber(style) or 6), 1, 7)
                if style == 2 then
                        return V(math.cos(ang) * rad, h, math.sin(ang) * rad)
                elseif style == 3 then
                        local k = idx % 3
                        if k == 0 then return V(math.cos(ang) * rad, h + math.sin(ang) * rad, 0)
                        elseif k == 1 then return V(0, h + math.sin(ang) * rad, math.cos(ang) * rad) end
                        return V(math.cos(ang) * rad, h, math.sin(ang) * rad)
                elseif style == 4 then
                        return V(math.cos(ang) * rad * 0.7, h + frac * rad * 1.2 + math.sin(t * spd) * 0.4, math.sin(ang) * rad * 0.7)
                elseif style == 5 then
                        local a = (frac - 0.5) * 2.1
                        return V(math.sin(a) * rad, h, math.cos(a) * rad * 0.35)
                elseif style == 6 then
                        -- Goku aura: hats climb the body from the feet to above the head in a fast spiral, then restart
                        local cyc = ((t * spd * 0.35) + frac) % 1
                        local r = rad * (0.55 - 0.25 * cyc) + 0.4
                        local a2 = ang * 1.7 + cyc * 3
                        return V(math.cos(a2) * r, h - 3 + cyc * 9, math.sin(a2) * r)
                elseif style == 7 then
                        -- Ki rings: hats pulse outward from the feet like expanding energy rings
                        local cyc = ((t * spd * 0.25) + frac) % 1
                        local r = rad * (0.25 + 0.9 * cyc)
                        return V(math.cos(ang * 2) * r, h - 2.6 + cyc * 1.2, math.sin(ang * 2) * r)
                else
                        local k = idx % 3
                        local rot = CFrame.Angles(t * 0.5 * (k + 1) * spd / 2, t * 0.3 * (k + 0.5) * spd / 2, k * 1.05)
                        local p = rot * V(math.cos(ang) * rad, 0, math.sin(ang) * rad)
                        return V(p.X, h + p.Y, p.Z)
                end
        end

        -- Resolve the picked hats. Hats are only TAKEN (FE align drive) while the power-up is
        -- charging / on; otherwise they stay with the rig and are untouched.
        function X.rebuildPowerUpEffectSlots(attach)
                local out, used, keep = {}, {}, {}
                local maxN = math.clamp(math.floor(tonumber(m.PowerUpEffectMax) or 5), 1, 5)
                local engaged = (attach == true) or (X.PUPhase and true or false)
                local labels, any = {}, false
                for i = 1, maxN do
                        labels[i] = X.cleanHatLabel(m["PowerUpEffectHat" .. i])
                        if labels[i] ~= "" then any = true end
                end
                if not any and m.HatOrbitUseAsPowerAura ~= false then
                        for i = 1, maxN do labels[i] = X.cleanHatLabel(m["HatOrbitSlot" .. i]) end
                end
                if engaged then pcall(X.boostNetwork) end
                for i = 1, maxN do
                        local lab = labels[i]
                        if lab ~= "" then
                                local h = X.findHandleByLabel(lab)
                                if h and not used[h] and not (X.kiIsPresentBulletHandle and X.kiIsPresentBulletHandle(h)) then
                                        used[h] = true
                                        local held = nil
                                        if engaged and m.PowerUpEffectFE ~= false then
                                                held = X.peAttachFE(h, "powerup")
                                        end
                                        if held then keep[h] = true end
                                        out[i] = {
                                                Handle = h,
                                                Index = i,
                                                Name = lab,
                                                Held = held,
                                                SpdMult = tonumber(m["PowerUpEffectSpd" .. i]) or 1,
                                                RadOff = tonumber(m["PowerUpEffectRad" .. i]) or 0,
                                                VertOff = tonumber(m["PowerUpEffectVert" .. i]) or 0,
                                                SideOff = tonumber(m["PowerUpEffectSide" .. i]) or 0,
                                        }
                                end
                        end
                end
                X.peReleaseAll(keep)
                X.PowerUpEffectSlotData = out
                local flat = {}
                for i = 1, maxN do
                        if out[i] and out[i].Handle then flat[#flat + 1] = out[i].Handle end
                end
                X.PowerUpEffectSlots = flat
                X.PowerUpEffectNeedRebuild = false
                X.syncSlotStrings()
                if attach == true then
                        local nHeld = 0
                        for _ in pairs(keep) do nHeld = nHeld + 1 end
                        warn("[HatCollision] Power-Up effect hats: " .. #flat .. " found, " .. nHeld .. " taken (FE)")
                end
                return out
        end

        function X.rebuildHatOrbitSlots()
                local out = {}
                local used = {}
                local maxN = math.floor(tonumber(m.HatOrbitMax) or 5)
                for i = 1, maxN do
                        local lab = X.cleanHatLabel(m["HatOrbitSlot" .. i])
                        if lab ~= "" then
                                local h = X.findHandleByLabel(lab)
                                if h and not used[h] then
                                        used[h] = true
                                        out[i] = { Handle = h, Index = i, Name = lab }
                                end
                        end
                end
                X.HatOrbitSlotData = out
                local flat = {}
                for i = 1, maxN do
                        if out[i] and out[i].Handle then flat[#flat + 1] = out[i].Handle end
                end
                X.HatOrbitSlots = flat
                X.syncSlotStrings()
                return out
        end

        function X.hatOrbitResolve()
