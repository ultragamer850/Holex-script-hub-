-- v6.8 TYPING SOUND: a short typewriter tick for every key typed into any hub text box.
-- The clip is a long effect, so each keystroke plays a tiny random slice of it (slightly varied
-- speed) on a rotating pool of 3 sounds, which keeps fast typing from cutting itself off.
S.typeSound, S.typeVol = true, 0.5
X.typeSounds, X.typeIdx = {}, 0
for i = 1, 3 do X.typeSounds[i] = make("Sound", {SoundId = "rbxassetid://9120299710", Volume = 0.5}, gui) end
function X.playTypeSound()
        if S.typeSound == false then return end
        X.typeIdx = X.typeIdx % #X.typeSounds + 1
        local snd = X.typeSounds[X.typeIdx]
        pcall(function()
                snd.Volume = S.typeVol or 0.5
                local len = snd.TimeLength
                local start = 0
                if len and len > 0.4 then start = math.random() * (len - 0.3) end
                snd.TimePosition = start
                snd.PlaybackSpeed = 0.92 + math.random() * 0.22
                snd:Play()
                local k = (snd:GetAttribute("k") or 0) + 1
                snd:SetAttribute("k", k)
                task.delay(0.1, function() if snd:GetAttribute("k") == k then snd:Stop() end end)
        end)
end
do
        local function hookBox(tb)
                if tb:GetAttribute("HolexTypeHook") then return end
                tb:SetAttribute("HolexTypeHook", true)
                local last = #tb.Text
                tb:GetPropertyChangedSignal("Text"):Connect(function()
                        local n = #tb.Text
                        -- only real typing: the box must be focused and not just cleared by code
                        if n > 0 and n ~= last and tb:IsFocused() then X.playTypeSound() end
                        last = n
                end)
        end
        for _, d in ipairs(gui:GetDescendants()) do if d:IsA("TextBox") then hookBox(d) end end
        gui.DescendantAdded:Connect(function(d) if d:IsA("TextBox") then hookBox(d) end end)
end

