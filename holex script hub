--==================================================================
-- v6.8 REANIMATE SOURCE WATCHER
--   Remembers which reanimate was started through loadstring(game:HttpGet(url)) so the HatCollision
--   tab can name it exactly (FE Genesis, Melon Scripter, Uhhhhhh, ...). Scripts pasted directly (no
--   loadstring) are covered by the heuristic scan in HX.detectReanimateName.
--==================================================================
X.LS = {log = {}, lastUrl = nil, lastUrlT = 0}
do
        local okG, genv = pcall(function() return (getgenv and getgenv()) or _G end)
        genv = okG and genv or _G
        -- shared across re-executes so the log survives a hub reload
        if type(genv.__HolexLS) == "table" then X.LS = genv.__HolexLS else pcall(function() genv.__HolexLS = X.LS end) end

        local RULES = {
                {"Uhhhhhh / Steve", {"uhhhhhh", "steve-916", "steve916", "uhhhhh"}},
                {"FE Genesis", {"genesisfe", "fe genesis", "fegenesis", "fe_genesis", "genesis/main", "fdless", "patchma", "sin dragon"}},
                {"Melon Scripter", {"melon", "locust", "feverse", "emper"}},
                {"Exire Reanimate", {"exire-reanimate", "exire"}},
                {"Netless", {"netless"}}, {"Nexo", {"nexo"}}, {"Sier", {"sier reanim", "sier-reanim"}},
                {"Hatsploit", {"hatsploit"}}, {"Hat Reanimator", {"hatreanimator", "hat reanimator"}},
        }
        local GENERIC = {"simulationradius", "sethiddenproperty", "breakjoints", "accessory", "netless", "permadeath", "reanimate", "humanoidrootpart"}

        local function classify(text)
                text = string.lower(text)
                for _, r in ipairs(RULES) do
                        for _, kw in ipairs(r[2]) do
                                if string.find(text, kw, 1, true) then return r[1], 0.97 end
                        end
                end
                return nil
        end
        local function generic(text)
                local hit = 0
                for _, kw in ipairs(GENERIC) do if string.find(text, kw, 1, true) then hit += 1 end end
                if hit >= 4 and string.find(text, "reanimate", 1, true) then return "Other reanimate (loadstring)", 0.75 end
                return nil
        end
        local function record(name, conf, url, how)
                local jobId = ""
                pcall(function() jobId = tostring(game.JobId) end)
                local log = X.LS.log
                log[#log + 1] = {name = name, conf = conf, url = url or "", how = how, t = os.clock(), job = jobId, place = game.PlaceId}
                while #log > 40 do table.remove(log, 1) end
        end

        if not X.LS.installed then
                X.LS.installed = true
                -- 1) remember the url of every game:HttpGet / HttpGetAsync call
                for _, fname in ipairs({"HttpGet", "HttpGetAsync"}) do
                        pcall(function()
                                if type(hookfunction) ~= "function" then return end
                                local orig = game[fname]
                                local old
                                old = hookfunction(orig, (newcclosure or function(f) return f end)(function(self, url, ...)
                                        if type(url) == "string" then X.LS.lastUrl, X.LS.lastUrlT = url, os.clock() end
                                        return old(self, url, ...)
                                end))
                        end)
                end
                -- 2) classify every loadstring chunk (url first, then the start of the source text)
                pcall(function()
                        if type(hookfunction) ~= "function" or type(loadstring) ~= "function" then return end
                        local old
                        old = hookfunction(loadstring, (newcclosure or function(f) return f end)(function(src, ...)
                                pcall(function()
                                        if type(src) ~= "string" then return end
                                        local url = (os.clock() - (X.LS.lastUrlT or 0) < 5) and X.LS.lastUrl or nil
                                        local name, conf
                                        if url then name, conf = classify(url) end
                                        if not name then
                                                local head = string.sub(src, 1, 20000)
                                                name, conf = classify(head)
                                                if not name and #src < 600000 then name, conf = generic(string.lower(src)) end
                                        end
                                        if name then record(name, conf, url, url and "loadstring url" or "loadstring source") end
                                end)
                                return old(src, ...)
                        end))
                end)
        end

        -- newest reanimate loadstring seen in THIS server (nil if none)
        function X.LS.latest()
                local job = ""
                pcall(function() job = tostring(game.JobId) end)
                for i = #X.LS.log, 1, -1 do
                        local e = X.LS.log[i]
                        if e.job == job and e.place == game.PlaceId then return e end
                end
                return nil
        end
end

--==================================================================
-- v5 THEME PACK  -  60+ extra themes generated from a few colours + per-theme FX data
--   fx keys: p = particle presets joined with "+", pal = ui/fx palette, ppal = particle palette,
--   lights / tree / pile / ring / rib / scan / flash / burst / shoot / rgb / light / trail
--==================================================================
X.ThemeFX = {}
do
        local W, K = Color3.new(1, 1, 1), Color3.new(0, 0, 0)

        function X.hex(s)
                local r, g, b = tostring(s):match("#?(%x%x)(%x%x)(%x%x)")
                return Color3.fromRGB(tonumber(r or "ff", 16), tonumber(g or "ff", 16), tonumber(b or "ff", 16))
        end
        function X.pals(s)
                local t = {}
                for h in tostring(s):gmatch("#%x%x%x%x%x%x") do t[#t + 1] = X.hex(h) end
                return t
        end
        local function lum(c) return c.R * 0.299 + c.G * 0.587 + c.B * 0.114 end

        local function setFX(name, fx, acc, bg)
                local f = {}
                for k, v in pairs(fx) do f[k] = v end
                f.pal = fx.pal and X.pals(fx.pal) or {acc, acc:Lerp(W, 0.45), bg:Lerp(acc, 0.6)}
                if fx.ppal then f.ppal = X.pals(fx.ppal) end
                if fx.ring then f.ring = X.pals(fx.ring) end
                if fx.treePal then f.treePal = X.pals(fx.treePal) end
                if fx.berry then f.berry = X.hex(fx.berry) end
                if fx.rgb then
                        f.pal = {}
                        for i = 0, 5 do f.pal[#f.pal + 1] = Color3.fromHSV(i / 6, 0.75, 1) end
                end
                X.ThemeFX[name] = f
        end

        -- generated theme: T(name, bgHex, accentHex, fx)
        local function T(name, bg, acc, fx)
                fx = fx or {}
                local B, A = X.hex(bg), X.hex(acc)
                local t = {}
                if fx.light then
                        t.bg = B
                        t.panel = B:Lerp(K, 0.04):Lerp(A, 0.05)
                        t.card = W:Lerp(A, 0.03)
                        t.hover = B:Lerp(A, 0.2)
                        t.text = A:Lerp(K, 0.82)
                        t.sub = B:Lerp(t.text, 0.5)
                        t.stroke = B:Lerp(A, 0.3)
                        t.face = W:Lerp(B, 0.3)
                else
                        t.bg = B
                        t.panel = B:Lerp(A, 0.07)
                        t.card = B:Lerp(A, 0.14)
                        t.hover = B:Lerp(A, 0.27)
                        t.text = A:Lerp(W, 0.9)
                        t.sub = B:Lerp(A:Lerp(W, 0.5), 0.62)
                        t.stroke = B:Lerp(A, 0.38)
                        t.face = B:Lerp(K, 0.35)
                end
                t.accent = A
                t.accentText = lum(A) > 0.58 and Color3.fromRGB(10, 10, 12) or W
                Themes[name] = t
                ThemeOrder[#ThemeOrder + 1] = name
                setFX(name, fx, A, B)
        end
        X.addTheme = T

        -- FX for the existing holiday / seasonal themes (colours stay as they were)
        local function E(name, fx)
                local th = Themes[name]
                if th then setFX(name, fx, th.accent, th.bg) end
        end
        E("Christmas",    {p = "snow+flake", ppal = "#ffffff #e6f4ff #cfe9ff", pal = "#e11d2e #1fa84f #ffd34d #4aa8ff #ffffff",
                treePal = "#ff3b3b #ffd34d #4aa8ff #ffffff #ff7ad9", tree = true, lights = true, pile = true,
                ring = "#2e9e4a #1f7a38 #35b358 #1f7a38", ringShape = "wreath", berry = "#e11d2e", trail = "❄"})
        E("Halloween",    {p = "bat+ember", pal = "#ff7518 #8a2be2 #ffe3a3", lights = true,
                ring = "#ff7518 #8a2be2 #ff9a3c", ringShape = "dot", ringSpin = true})
        E("Valentine",    {p = "heart", pal = "#ff4678 #ff8aa8 #ffffff", ring = "#ff4678 #ff8aa8 #ffd0dc", ringShape = "heart", ringSpin = true, trail = "♥"})
