        --------------------------------------------------------------
        -- METHOD 11: RakNet (executor raknet library). Records the packets your client sends during a hit
        -- and sends them again once, so the server gets a second copy of the touch / physics data.
        -- It never builds packets itself and only resends ones listed in m.RakIds. Use "Learn" to find them.
        -- The raknet API differs between executors, so every call is guarded and tries a few call shapes.
        --------------------------------------------------------------
        X.Rak = X.Rak or {hooked = false, counts = {}, rec = nil, sending = false, busy = false}

        local RAK_HOOK_NAMES = {"add_send_hook", "add_send_hook_v2", "hook_send", "on_send", "send_hook", "register_send_hook", "add_outgoing_hook", "add_hook"}
        local RAK_SEND_NAMES = {"send", "send_packet", "write", "send_raw"}

        -- looks at the raknet library of your executor and remembers which hook / send function exists
        function X.rakInspect()
                local R = X.Rak
                if R.inspected then return R.hookName ~= nil, R.report end
                R.inspected = true
                if type(raknet) ~= "table" and type(raknet) ~= "userdata" then
                        R.report = "no raknet library in this executor"
                        return false, R.report
                end
                local names = {}
                pcall(function()
                        for k, v in pairs(raknet) do names[#names + 1] = tostring(k) .. "(" .. type(v) .. ")" end
                end)
                table.sort(names)
                for _, nm in ipairs(RAK_HOOK_NAMES) do
                        local ok, f = pcall(function() return raknet[nm] end)
                        if ok and type(f) == "function" then R.hookName = nm break end
                end
                for _, nm in ipairs(RAK_SEND_NAMES) do
                        local ok, f = pcall(function() return raknet[nm] end)
                        if ok and type(f) == "function" then R.sendName = nm break end
                end
                R.report = "raknet has: " .. (#names > 0 and table.concat(names, ", ") or "(could not list)")
                        .. "  |  send hook: " .. tostring(R.hookName) .. "  |  send fn: " .. tostring(R.sendName)
                return R.hookName ~= nil, R.report
        end

        function X.rakAvailable()
                local ok = X.rakInspect()
                return ok
        end

        -- raknet.is_enabled() (Medium etc.): false means the executor's RakNet feature is off for this session
        function X.rakEnabledState()
                if type(raknet) ~= "table" then return nil end
                local f = raknet.is_enabled
                if type(f) ~= "function" then return nil end
                local ok, v = pcall(f)
                if ok then return v end
                return nil
        end

        function X.rakCheck()
                local ok, report = X.rakInspect()
                local en = X.rakEnabledState()
                warn("[HatCollision] " .. report .. "  |  is_enabled: " .. tostring(en) .. "  |  hook installed: " .. tostring(X.Rak.hooked == true))
                if en == false then
                        warn("[HatCollision] RakNet reports it is OFF. Turn RakNet on in your executor settings and REJOIN the game, then press 'retry hook'.")
                elseif not ok then
                        warn("[HatCollision] RakNet method 11 cannot record packets here (no send hook). The other 10 methods still work.")
                end
                return ok
        end

        -- tries to install the hook again (for 'RakNet peer is unavailable': the peer only exists once the connection is up)
        function X.rakRetry(tries)
                local R = X.Rak
                R.hooked, R.warnedNoHook, R.warnedPeer = false, false, false
                R.retryLeft = tries or 1
                task.spawn(function()
                        while (R.retryLeft or 0) > 0 and not R.hooked do
                                R.retryLeft = R.retryLeft - 1
                                if X.rakInstall(true) then
                                        warn("[HatCollision] RakNet hook installed")
                                        return
                                end
                                task.wait(2)
                        end
                end)
        end

        local rakData
        local function rakWanted()
                local want = {}
                for tok in string.gmatch(tostring(m.RakIds or ""), "[^,%s]+") do
                        local n = tonumber(tok)
                        if n then want[n] = true end
                end
                return want
        end

        rakData = function(pkt)
                local ok, d = pcall(function() return pkt.AsString end)
                if ok and type(d) == "string" then return d end
                local ok2, b = pcall(function() return pkt.AsBuffer end)
                if ok2 and b ~= nil then
                        if type(b) == "string" then return b end
                        local ok3, str = pcall(function() return buffer.tostring(b) end)
                        if ok3 then return str end
                end
                return nil
        end

        function X.rakInstall(quiet)
                local R = X.Rak
                if R.hooked then return true end
                if not X.rakInspect() then
                        if not R.warnedNoHook then
                                R.warnedNoHook = true
                                warn("[HatCollision] " .. tostring(R.report))
                        end
                        return false
                end
                local ok, err = pcall(function()
                        raknet[R.hookName](function(pkt)
                                if R.sending then return end
                                local okId, id = pcall(function() return pkt.PacketId end)
                                id = okId and tonumber(id) or nil
                                if not id then return end
                                R.counts[id] = (R.counts[id] or 0) + 1
                                if R.rec and #R.rec < 60 and R.want and R.want[id] then
                                        local d = rakData(pkt)
                                        if d then R.rec[#R.rec + 1] = {id = id, data = d} end
                                end
                        end)
                end)
                R.hooked = ok
                if not ok then
                        local msg = tostring(err)
                        if string.find(msg, "unavailable", 1, true) then
                                if not R.warnedPeer and not quiet then
                                        R.warnedPeer = true
                                        local en = X.rakEnabledState()
                                        warn("[HatCollision] RakNet peer is unavailable (is_enabled = " .. tostring(en) .. "). Make sure RakNet is switched on in your executor settings, then REJOIN the game so the peer exists. Retrying in the background...")
                                        X.rakRetry(6)
                                end
                        elseif not quiet then
                                warn("[HatCollision] raknet." .. tostring(R.hookName) .. " failed: " .. msg)
                        end
                end
                return ok
        end

        local function rakSend(id, data)
                local fn = X.Rak.sendName and raknet[X.Rak.sendName]
                if type(fn) ~= "function" then return false end
                if pcall(fn, id, data) then return true end
                if pcall(fn, {PacketId = id, AsString = data}) then return true end
                return false
        end

        -- record for `window` seconds, then resend what was recorded
        function X.rakArm(window)
                local R = X.Rak
                if R.busy or not X.rakInstall() then return end
                R.want = rakWanted()
                if next(R.want) == nil then
                        if not R.warned then R.warned = true; warn("[HatCollision] RakNet method: no packet ids set. Press 'Learn packet ids' first.") end
                        return
                end
                R.busy, R.rec = true, {}
                task.delay(window + 0.1, function()
                        local rec = R.rec or {}
                        R.rec = nil
                        R.sending = true
                        local sent = 0
                        for _, r in ipairs(rec) do
                                if rakSend(r.id, r.data) then sent = sent + 1 end
                        end
                        R.sending = false
                        R.busy = false
                        if sent > 0 then X.Rak.lastSent = sent end
                end)
        end

        -- finds which packet ids your client sends during a hit (compared with idle traffic)
        function X.rakLearn()
                if not X.rakInstall() then warn("[HatCollision] RakNet hook is not installed yet (see the message above). Press 'RakNet: check library' / 'retry hook' first.") return end
                local R = X.Rak
                task.spawn(function()
                        warn("[HatCollision] RakNet learn: measuring idle traffic for 1.5s, stand still...")
                        R.counts = {}
                        task.wait(1.5)
                        local base = R.counts
                        R.counts = {}
                        warn("[HatCollision] RakNet learn: sending a test hit at the nearest other player...")
                        if not X.replTestNearest() then return end
                        local win = (tonumber(m.ReplBurst) or 0.35) + 1.0
                        task.wait(win)
                        local hit, ids = R.counts, {}
                        for id, n in pairs(hit) do
                                local extra = n - (base[id] or 0) * (win / 1.5)
                                if extra >= 3 then ids[#ids + 1] = id end
                        end
                        table.sort(ids)
                        m.RakIds = table.concat(ids, ",")
                        X.markDirty()
                        warn("[HatCollision] RakNet learn done. Packet ids that rose during the hit: " .. (m.RakIds ~= "" and m.RakIds or "(none found)"))
                end)
        end

        function X.serverReplicate(model, dmg, hat)
                if not m.ReplMaster or not model or not model.Parent then return end
                local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                if not root then return end
                local isPlr = Players:GetPlayerFromCharacter(model) ~= nil
                local power = tonumber(m.ReplPower) or 120
                local burst = tonumber(m.ReplBurst) or 0.35
                local hasTouch = type(firetouchinterest) == "function"

                local function touch(a, b)
                        if hasTouch and a and b and a.Parent and b.Parent then
                                pcall(function() firetouchinterest(a, b, 0); firetouchinterest(a, b, 1) end)
                        end
                end

                if m.ReplM11 then X.rakArm(burst) end

                local function once()
                        if not model.Parent or not root.Parent then return end
                        -- 1 simulation radius lock
                        if m.ReplM1 then
                                X.boostNetwork()
                                if type(setsimulationradius) == "function" then pcall(setsimulationradius, 1e9, 1e9) end
                        end
                        if hat and hat.Parent then
                                -- 2 touch root
                                if m.ReplM2 then touch(hat, root) end
                                -- 3 touch every part
                                if m.ReplM3 then
                                        for _, part in ipairs(X.replTargetParts(model)) do touch(hat, part) end
                                end
                                -- 4 velocity slam
                                if m.ReplM4 then
                                        pcall(function()
                                                local dir = root.Position - hat.Position
                                                dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 1, 0)
                                                hat.AssemblyLinearVelocity = dir * power + Vector3.new(0, power * 0.25, 0)
                                                hat.AssemblyAngularVelocity = Vector3.new(0, power, 0)
                                        end)
                                end
                                -- 5 snap onto the root
                                if m.ReplM5 then
                                        pcall(function() hat.CFrame = CFrame.new(root.Position) * (hat.CFrame - hat.CFrame.Position) end)
                                end
                                -- 7 replicatesignal (experimental, executor dependent)
                                if m.ReplM7 and type(replicatesignal) == "function" then
                                        pcall(function() replicatesignal(hat.Touched, root) end)
                                        pcall(function() replicatesignal(root.Touched, hat) end)
                                end
                        end
                        -- 6 tools you hold
                        if m.ReplM6 then
                                local char = LocalPlayer.Character
                                if char then
                                        for _, tool in ipairs(char:GetChildren()) do
                                                if tool:IsA("Tool") then
                                                        local handle = tool:FindFirstChild("Handle")
                                                        if handle then touch(handle, root) end
                                                        pcall(function() tool:Activate() end)
                                                end
                                        end
                                end
                        end
                        -- 8 ownership assist (NPCs / dummies only, players are owned by their own client)
                        if m.ReplM8 and not isPlr then
                                for _, part in ipairs(X.replTargetParts(model)) do
                                        pcall(function() sethiddenproperty(part, "NetworkOwnershipRule", Enum.NetworkOwnership.OnContact) end)
                                        if hat then touch(hat, part) end
                                end
                        end
                        -- 9 fling parts you own
                        if m.ReplM9 and replOwned(root) then
                                pcall(function()
                                        local from = hat and hat.Parent and hat.Position or (root.Position - Vector3.new(0, 1, 0))
                                        local dir = root.Position - from
                                        dir = dir.Magnitude > 0.01 and dir.Unit or Vector3.new(0, 1, 0)
                                        root.AssemblyLinearVelocity = dir * power * 1.5 + Vector3.new(0, power * 0.6, 0)
                                end)
                        end
                end

                once()
                -- 10 burst
                if m.ReplM10 and not X.ReplBusy[model] then
                        X.ReplBusy[model] = true
                        task.spawn(function()
                                local t0 = os.clock()
                                while os.clock() - t0 < burst and model.Parent do
                                        RunService.Heartbeat:Wait()
                                        pcall(once)
                                end
                                X.ReplBusy[model] = nil
                        end)
                end
        end

        -- test button: fires every enabled method at the nearest other player
        function X.replTestNearest()
                local char = LocalPlayer.Character
                local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                local best, bd
                for _, plr in ipairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                                local r = plr.Character:FindFirstChild("HumanoidRootPart")
                                if r then
                                        local d = myRoot and (r.Position - myRoot.Position).Magnitude or 0
                                        if not bd or d < bd then best, bd = plr.Character, d end
                                end
                        end
                end
                if not best then warn("[HatCollision] Server replication test: no other player found") return false end
                local handles = X.filterEnabledHandles(X.hatsSolidHandles())
                if type(handles) ~= "table" or #handles == 0 then handles = X.hatsSolidHandles(true) end
                local hat = type(handles) == "table" and handles[1] or nil
                X.serverReplicate(best, 0, hat)
                warn("[HatCollision] Server replication test sent to " .. best.Name)
                return true
        end

        function X.hatDamageStep(handles, now)
                if not m.Enabled or not m.HatDamageEnabled then return end
                if type(handles) ~= "table" or #handles == 0 then return end
                now = now or os.clock()
                local radius = math.max(0.5, tonumber(m.HatDamageRadius) or 4)
                local cd = math.max(0.02, tonumber(m.HatDamageCooldown) or 0.15)
                local hitPlayers = m.HatDamagePlayers ~= false
                local hitNPCs = m.HatDamageNPCs ~= false
                if not hitPlayers and not hitNPCs then return end
                X.HatDmgCD = X.HatDmgCD or {}
                local combatHurt = X.combatHurtHumanoid
                local combatLock = X.combatLockHealth
                local function tryHurt(model, dmg, hatName, hatPart)
                        if not model or not model.Parent or dmg <= 0 then return end
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health <= 0 then return end
                        local isPlr = Players:GetPlayerFromCharacter(model) ~= nil
                        if isPlr then
                                if not hitPlayers then return end
                                if model == LocalPlayer.Character then return end
                                local fig = X.getMyCharacter and X.getMyCharacter()
                                if fig and model == fig then return end
                        else
                                if not hitNPCs then return end
                        end
                        local last = X.HatDmgCD[model] or 0
                        if now - last < cd then return end
                        X.HatDmgCD[model] = now
                        pcall(function()
                                hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOn
                                hum.HealthDisplayDistance = 200
                        end)
                        pcall(X.serverReplicate, model, dmg, hatPart)
                        local ok = true
                        if combatHurt then ok = combatHurt(hum, dmg) else
                                pcall(function() hum.Health = math.max(0, hum.Health - dmg) end)
                        end
                        if ok then
                                pcall(X.noteHatDamage, model, dmg, hatName or "")
                                if combatLock then pcall(combatLock, hum, hum.Health) end
                        end
                end
                local targets, seen = {}, {}
                local function addTarget(model)
                        if not model or seen[model] or not model.Parent then return end
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        if not hum or hum.Health <= 0 then return end
                        local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                        if not root then return end
                        seen[model] = true
                        targets[#targets + 1] = { model = model, root = root }
                end
                if hitPlayers then
                        for _, plr in ipairs(Players:GetPlayers()) do
                                if plr ~= LocalPlayer and plr.Character then addTarget(plr.Character) end
                        end
                end
                if hitNPCs then
                        for _, d in ipairs(workspace:GetDescendants()) do
                                if d:IsA("Humanoid") and d.Parent then
                                        local plr = Players:GetPlayerFromCharacter(d.Parent)
                                        if not plr then addTarget(d.Parent) end
                                end
                        end
                end
                handles = X.filterEnabledHandles and X.filterEnabledHandles(handles) or handles
                for _, h in ipairs(handles) do
                        if h and h.Parent then
                                local dmg = X.getHatDamage(h)
                                if dmg > 0 then
                                        local hatName = X.hatAccessoryName(h)
                                        local hp = h.Position
                                        for _, t in ipairs(targets) do
                                                if (t.root.Position - hp).Magnitude <= radius then
                                                        tryHurt(t.model, dmg, hatName, h)
                                                end
                                        end
                                end
                        end
                end
        end

        function X.hatsSolidStep()
                if not (m.Enabled and m.HatsSolid) then
                        if X.HatsSolidWas then
                                X.HatsSolidWas = false
                                X.hatsSolidRestore()
                        end
                        return
                end
                X.HatsSolidWas = true
                local now = os.clock()

                local boostIv = tonumber(m.PerfBoostInterval) or 2.5
                if m.HatsSolidBoost ~= false and now - (X.HatsSolidBoostT or 0) > boostIv then
                        X.HatsSolidBoostT = now
                        pcall(X.boostNetwork)
                end

                local handles = X.filterEnabledHandles(X.hatsSolidHandles())
                if next(X.PowerUpEffectHeld) then -- power-up aura hats are driven elsewhere
                        local keepL = {}
                        for i = 1, #handles do
                                if not X.PowerUpEffectHeld[handles[i]] then keepL[#keepL + 1] = handles[i] end
                        end
                        handles = keepL
                end
                local scanIv = tonumber(m.PerfHatScanInterval) or 2.0
                local budget = m.LowLag and 40 or 70
                local needScan = false
                for i = 1, #handles do
                        local h = handles[i]
                        if now - (HatNCT[h] or 0) > scanIv then
                                needScan = true
                                break
                        end
                end

                local ghost = nil
                if needScan then
                        ghost = {}
                        local function addModel(model)
                                if not (model and model.Parent) then return end
                                -- only direct BaseParts + one level of children (cheaper than full GetDescendants)
                                for _, d in ipairs(model:GetChildren()) do
                                        if d:IsA("BasePart") then
                                                ghost[#ghost + 1] = d
                                        elseif d:IsA("Model") or d:IsA("Folder") or d:IsA("Accessory") then
                                                for _, d2 in ipairs(d:GetChildren()) do
                                                        if d2:IsA("BasePart") then ghost[#ghost + 1] = d2 end
                                                end
                                        end
                                end
                        end
                        addModel(X.getMyCharacter())
                        local lc = LocalPlayer.Character
                        if lc and lc ~= X.getMyCharacter() then addModel(lc) end
                        -- skip scanning every other player every time — only when ignore players is off
                        if m.HatsSolidIgnorePlayers == false or m.PlayerCollide then
                                -- intentionally do not ghost other players for NC when ignore is on
                        end
                end

                local onlyMoving = m.HatsSolidOnlyMoving == true
                local minSpeed = tonumber(m.HatsSolidMinSpeed) or 4
                local showHB = m.HatsSolidShowHitbox == true
                local flingPow = m.HatsSolidFlingPower or 1

                for i = 1, #handles do
                        local h = handles[i]
                        local lastP = HatLastPos[h]
                        local lastT = HatLastT[h]
                        local vel = Vector3.zero
                        if lastP and lastT and now > lastT then
                                vel = (h.Position - lastP) / math.max(now - lastT, 1e-4)
                        end
                        HatLastPos[h] = h.Position
                        HatLastT[h] = now

                        local movingOk = (not onlyMoving) or (vel.Magnitude >= minSpeed)

                        -- avoid pcall when possible
                        if movingOk then
                                if h.CanCollide ~= true then h.CanCollide = true end
                                if h.CanTouch ~= true then h.CanTouch = true end
                        else
                                if h.CanCollide then h.CanCollide = false end
                        end

                        -- bigger / normal collision size
                        X.applyHitboxScale(h)

                        if movingOk and flingPow > 1.01 and vel.Magnitude > minSpeed then
                                X.applyFlingVelocity(h, vel)
                        end

                        if showHB then
                                X.updateHitbox(h)
                        end

                        if needScan and ghost and now - (HatNCT[h] or 0) > scanIv and budget > 0 then
                                HatNCT[h] = now
                                local set = HatNC[h]
                                if not set then
                                        set = {}
                                        HatNC[h] = set
                                end
                                for gi = 1, #ghost do
                                        local part = ghost[gi]
                                        if part ~= h and not set[part] and budget > 0 then
                                                budget = budget - 1
                                                local c = Instance.new("NoCollisionConstraint")
                                                c.Name = "HC_HatNC"
                                                c.Part0 = h
                                                c.Part1 = part
                                                c.Parent = h
                                                set[part] = c
                                        end
                                end
                                if budget <= 0 then HatNCT[h] = now - scanIv * 0.5 end
                                for part, c in pairs(set) do
                                        if not part.Parent then
                                                pcall(function() c:Destroy() end)
                                                set[part] = nil
                                        end
                                end
                        end
                end

                if showHB then
                        for h, box in pairs(HatHB) do
                                if not h.Parent then
                                        pcall(function() box:Destroy() end)
                                        HatHB[h] = nil
                                end
                        end
                end

                if m.PlayerCollide then
                        pcall(X.playerCollideStep, handles, now)
                end
                if m.HatDamageEnabled then
                        pcall(X.hatDamageStep, handles, now)
                end
        end

