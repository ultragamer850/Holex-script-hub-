local function megaAutoUpdate()
        local AU = {
                manifest = (V and V.get and V.get("updateManifest", "")) or "",
                lastCheck = nil, lastResult = "never checked",
        }
        if AU.manifest == "" then
                AU.manifest = "https://raw.githubusercontent.com/ultragamer850/random/main/holex_updates.json"
        end
        X.AutoUpdate = AU
        function AU.check(silent)
                task.spawn(function()
                        if not (V and V.http) then return end
                        AU.lastCheck = os.time()
                        local res = V.http(AU.manifest, "GET", {["Cache-Control"] = "no-cache"})
                        local data = (res and V.decode(res.Body)) or nil
                        if type(data) ~= "table" then
                                AU.lastResult = "manifest unreachable (offline, deleted repo or no http)"
                                if not silent then Notify("Auto-update", "Could not reach the update manifest. Check the URL in Settings > GitHub Auto-Update.", 4) end
                                return
                        end
                        local files = type(data.files) == "table" and data.files or {}
                        local n, updated = 0, {}
                        for name, url in pairs(files) do
                                if type(name) == "string" and type(url) == "string" then
                                        local safe = name:gsub("[^%w%-%_%.]", "_")
                                        local r2 = V.http(url, "GET")
                                        if r2 and #r2.Body > 0 then
                                                local localFile = V.F.scripts .. "/auto_update/" .. safe .. ".lua"
                                                local old = V.read(localFile)
                                                if old ~= r2.Body then
                                                        V.write(localFile, r2.Body)
                                                        updated[#updated + 1] = safe
                                                end
                                                n += 1
                                        end
                                        task.wait(0.1)
                                end
                        end
                        if type(data.hubUrl) == "string" and data.hubUrl ~= "" then
                                X.HUB_URL = data.hubUrl
                                V.set("hubUrl", data.hubUrl)
                        end
                        AU.lastResult = string.format("%d files checked, %d updated%s", n, #updated, #updated > 0 and (" (" .. table.concat(updated, ", "):sub(1, 60) .. ")") or "")
                        V.info("AUTOUPDATE", AU.lastResult)
                        if #updated > 0 then
                                Notify("Auto-update", #updated .. " script(s) updated from GitHub into holexs data/scripts/auto_update.", 5)
                        elseif not silent then
                                Notify("Auto-update", n .. " scripts checked - everything is up to date.", 3)
                        end
                end)
        end
        function AU.buildSettings(sp)
                local mIn = H.Input(sp, "Update manifest URL (GitHub raw json)", "https://raw.githubusercontent.com/user/repo/main/holex_updates.json", AU.manifest)
                Button(sp, "Save manifest URL", function()
                        local u = (mIn.Text or ""):match("^%s*(.-)%s*$")
                        if u ~= "" then AU.manifest = u; V.set("updateManifest", u); Notify("Auto-update", "Manifest URL saved.", 3) end
                end)
                Button(sp, "Check for updates now", function() AU.check(false) end)
                local st = label(sp, "Last check: never", 11, "sub", Enum.Font.Gotham, {Size = UDim2.new(1, 0, 0, 16)})
                task.spawn(function()
                        while sp.Parent do
                                st.Text = "Last check: " .. (AU.lastCheck and os.date("%H:%M:%S", AU.lastCheck) or "never") .. "   |   " .. AU.lastResult
                                task.wait(2)
                        end
                end)
        end
        -- auto-run shortly after boot (silent: only notifies when something actually updated)
        task.spawn(function()
                task.wait(6)
                pcall(AU.check, true)
        end)
end
