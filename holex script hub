        local function clean(s)
                if not s then return "" end
                s = s:gsub("<!%[CDATA%[(.-)%]%]>", "%1")
                s = s:gsub("&lt;", "<"):gsub("&gt;", ">"):gsub("&quot;", '"'):gsub("&#39;", "'"):gsub("&nbsp;", " ")
                s = s:gsub("<.->", "")
                s = s:gsub("&amp;", "&")
                s = s:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
                return s
        end

