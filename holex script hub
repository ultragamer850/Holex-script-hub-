        local function parseBody(body)
                if not body or body == "" then return {} end
                local sb = tostring(body)
                if sb:find("Internal Server error") or sb:find("Coming Soon") or sb:find("<!DOCTYPE") then return {} end
                local d = V.decode(sb)
                if type(d) ~= "table" then return {} end
                local list = (d.result and d.result.scripts) or d.scripts or d.result or d.data or {}
                if type(list) ~= "table" then return {} end
                if list[1] == nil then
                        local arr = {}
                        for _, v in pairs(list) do if type(v) == "table" and (v.title or v.name) then arr[#arr + 1] = v end end
                        return arr
                end
                return list
        end
        local function fetchSB(qenc, pg)
                for _, url in ipairs({
                        "https://scriptblox.com/api/script/search?q=" .. qenc .. "&max=20&page=" .. pg .. "&sortBy=views&order=desc",
                        "https://scriptblox.com/api/script/search?q=" .. qenc .. "&page=" .. pg}) do
                        local r = V.http(url, "GET", {["Accept"] = "application/json"})
                        local l = parseBody(r and r.Body)
                        if #l > 0 then return l end
                end
                return {}
        end
        local function fetchRS(qenc, pg)
                local r = V.http("https://rscripts.net/api/scripts?page=" .. pg .. "&q=" .. qenc, "GET", {["Accept"] = "application/json"})
                local l = parseBody(r and r.Body)
                for _, s in ipairs(l) do s.title = s.title or s.name; s.raw = s.raw or s.script or s.download end
                return l
        end
