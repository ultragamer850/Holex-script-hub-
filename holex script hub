        function X.weaponOnRespawn()
                X.HandleCacheT = 0
                pcall(X.boostNetwork)
                -- remember intent (survives even if something clears equipped mid-restore)
                local wantPan = (X.PanEquipped == true) or (X._wantPan == true)
                local wantRpg = (X.RpgEquipped == true) or (X._wantRpg == true)
                if m.PanKeepAfterRespawn == false then wantPan = false end
                if m.RpgKeepAfterRespawn == false then wantRpg = false end
                X._wantPan = wantPan
                X._wantRpg = wantRpg
                X.PanHeld = nil
                X.RpgHeld = nil
                X.weaponEnsureStep()
                local function restore()
                        if X.Dead then return end
                        X.HandleCacheT = 0
                        pcall(X.boostNetwork)
                        if wantPan and m.PanEnabled ~= false and X.cleanHatLabel(m.PanHat) ~= "" then
                                X.PanEquipped = true
                                X._wantPan = true
                                local held = X.panTakeHat()
                                if held then
                                        X.weaponBreakWelds(held.Handle)
                                        X.panDriveInHand(os.clock())
                                        X.weaponEnsureOverride(held, "Weapon")
                                end
                        elseif m.PanUnderground ~= false and X.cleanHatLabel(m.PanHat) ~= "" then
                                X.PanEquipped = false
                                X._wantPan = false
                                if X.panTakeHat() then X.panPark() end
                        end
                        if wantRpg and m.RpgEnabled ~= false and X.cleanHatLabel(m.RpgHat) ~= "" then
                                X.RpgEquipped = true
                                X._wantRpg = true
                                local held = X.rpgTakeHat()
                                if held then
                                        X.weaponBreakWelds(held.Handle)
                                        X.rpgDriveInHand(os.clock())
                                        X.weaponEnsureOverride(held, "Weapon")
                                end
                        elseif m.RpgUnderground ~= false and X.cleanHatLabel(m.RpgHat) ~= "" then
                                X.RpgEquipped = false
                                X._wantRpg = false
                                if X.rpgTakeHat() then X.rpgPark() end
                        end
                end
                -- aggressive retries: Uhhhhhh hat rebuild is staggered
                for _, t in ipairs({ 0.1, 0.3, 0.6, 1.0, 1.8, 3.0 }) do
                        task.delay(t, restore)
                end
                warn("[HatCollision] Pan/RPG force-restore after respawn (pan=" .. tostring(wantPan) .. " rpg=" .. tostring(wantRpg) .. ")")
        end

