        local function palAt(pal, x)
                local n = #pal
                if n == 1 then return pal[1] end
                x = x % n
                local i = math.floor(x)
                return pal[i + 1]:Lerp(pal[(i + 1) % n + 1], x - i)
        end
        local function palSeq(pal, lighten)
                local n = #pal
                local steps = math.max(n, 2)
                local kps = {}
                for i = 0, steps do
                        local c = pal[(i % n) + 1]
                        if lighten then c = c:Lerp(W, lighten) end
                        kps[#kps + 1] = ColorSequenceKeypoint.new(i / steps, c)
