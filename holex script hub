        end

        -- Load / play walk or run anim on an owned NPC (best-effort; many dummies lack proper Animator)
        function X.ensureNPCAnim(npc)
                if HX.Settings.NoAnimations ~= false then return nil end
                if not m.WalkRunAnim or not npc or not npc.Parent then return nil end
                local cache = X.NPCAnimTracks[npc]
                if cache and cache.walk then return cache end
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if not hum then return nil end
                local animator = hum:FindFirstChildOfClass("Animator")
                if not animator then
                        pcall(function()
                                animator = Instance.new("Animator")
                                animator.Parent = hum
                        end)
                end
                if not animator then return nil end
                local function loadTrack(id)
                        if not id or id == "" or id == "0" then return nil end
                        local sid = tostring(id)
                        if not string.find(sid, "rbxassetid://", 1, true) then
                                sid = "rbxassetid://" .. sid:gsub("%D", "")
                        end
                        local ok, track = pcall(function()
                                local anim = Instance.new("Animation")
                                anim.AnimationId = sid
                                local t = animator:LoadAnimation(anim)
                                t.Looped = true
                                t.Priority = Enum.AnimationPriority.Movement
                                return t
                        end)
                        if ok then return track end
                        return nil
                end
                cache = {
                        walk = loadTrack(m.WalkAnimId),
                        run = loadTrack(m.RunAnimId),
                        last = nil,
                }
                X.NPCAnimTracks[npc] = cache
                return cache
        end

        function X.setNPCAnimState(npc, moving, speed)
                if HX.Settings.NoAnimations ~= false then return end
                if not m.WalkRunAnim then return end
                local cache = X.ensureNPCAnim(npc)
                if not cache then return end
                local fade = tonumber(m.AnimFadeTime) or 0.2
                local want = nil
                if moving then
                        if (speed or 0) > 18 and cache.run then
                                want = cache.run
                        else
                                want = cache.walk or cache.run
                        end
                end
                if cache.last == want then return end
                if cache.last then pcall(function() cache.last:Stop(fade) end) end
                cache.last = want
                if want then pcall(function() want:Play(fade) end) end
        end

        function X.stopNPCAnim(npc)
                local cache = X.NPCAnimTracks[npc]
                if not cache then return end
                if cache.last then pcall(function() cache.last:Stop(0.15) end) end
                cache.last = nil
        end

