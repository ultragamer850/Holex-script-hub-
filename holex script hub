        function V.ensureDir(path)
                if not (hasFS and type(makefolder) == "function" and type(isfolder) == "function") then return end
                local folder = path
                if path:find("%.%w+$") then folder = path:match("^(.*)/[^/]*$") or "" end
                local acc = ""
                for part in string.gmatch(folder, "[^/]+") do
                        acc = (acc == "") and part or (acc .. "/" .. part)
                        pcall(function() if not isfolder(acc) then makefolder(acc) end end)
                end
        end
        for _, f in pairs(V.F) do V.ensureDir(f .. "/x.tmp") end

        function V.write(path, data)
                if not hasFS then return false end
                V.ensureDir(path)
                return (pcall(writefile, path, data))
        end
        function V.read(path)
                if not hasFS then return nil end
                local ok, r = pcall(function() if isfile(path) then return readfile(path) end end)
                return ok and r or nil
        end
        function V.json(path)
                local raw = V.read(path)
