        function X.updateHitbox(handle)
                if not m.HatsSolidShowHitbox or not m.HatsSolid then
                        local box = HatHB[handle]
                        if box then
                                pcall(function() box:Destroy() end)
                                HatHB[handle] = nil
                        end
                        return
                end
                local box = HatHB[handle]
                if not box or not box.Parent then
                        box = Instance.new("SelectionBox")
                        box.Name = "HC_Hitbox"
                        box.Adornee = handle
                        box.LineThickness = 0.04
                        box.Parent = handle
                        HatHB[handle] = box
                end
                box.Color3 = X.hitboxColor()
                box.Transparency = math.clamp(tonumber(m.HatsSolidHitboxTransparency) or 0.35, 0, 1)
                box.Visible = true
        end

        -- Scale hat Handle size for bigger/normal collision (1 = original)
        function X.applyHitboxScale(handle)
                if not handle or not handle.Parent then return end
                -- Prefer per-hat scale (default 1). Global slider multiplies only when it is not 1.
                local per = 1
                if X.getHatScale then
                        per = tonumber(X.getHatScale(handle)) or 1
                end
                local glob = tonumber(m.HatsSolidHitboxScale) or 1
                if math.abs(glob - 1) < 0.001 then
                        glob = 1
                end
                local scale = math.clamp(per * glob, 0.25, 100000)
                if not HatOrigSize[handle] then
                        HatOrigSize[handle] = handle.Size
                end
                local orig = HatOrigSize[handle]
                local target = orig * scale
                -- only write when changed enough (avoid constant property spam)
                if (handle.Size - target).Magnitude > 0.02 then
                        pcall(function() handle.Size = target end)
                end
        end

        function X.restoreHitboxScale(handle)
                if not handle then return end
                local orig = HatOrigSize[handle]
                if orig and handle.Parent then
                        pcall(function() handle.Size = orig end)
                end
                HatOrigSize[handle] = nil
        end

        function X.hatsSolidRestore()
                for h, set in pairs(HatNC) do
                        for _, c in pairs(set) do pcall(function() c:Destroy() end) end
                        HatNC[h] = nil
                        if h and h.Parent then
                                pcall(function()
                                        h.CanCollide = false
                                        h.CanTouch = false
                                end)
                        end
                        X.restoreHitboxScale(h)
                end
                -- also restore any scaled handles not in HatNC
                for h, _ in pairs(HatOrigSize) do
                        X.restoreHitboxScale(h)
                end
                X.clearHitboxes()
        end

        function X.applyFlingVelocity(handle, baseVel)
                if not handle or not handle.Parent then return end
                local push = tonumber(m.HatsSolidPush) or 1
                local fling = tonumber(m.HatsSolidFlingPower) or 1
                local up = tonumber(m.HatsSolidFlingUp) or 0
                local cap = tonumber(m.HatsSolidMaxForceCap) or 250
                local v = baseVel * push * fling
                if up > 0 and v.Magnitude > 0.5 then
                        v = v + Vector3.new(0, math.abs(v.Magnitude) * up, 0)
                end
                if v.Magnitude > cap then
                        v = v.Unit * cap
                end
                pcall(function()
                        handle.AssemblyLinearVelocity = v
                end)
        end

        --------------------------------------------------------------
        -- PLAYER COLLISION METHODS (1..12)
        --------------------------------------------------------------
        function X.applyPlayerMethod(method, hat, targetRoot, hatVel, power)
                if not targetRoot or not targetRoot.Parent then return end
                local p = power or 1
                local dir = hatVel
                if dir.Magnitude < 0.5 then
                        local myRoot = X.getMyHRP()
                        if myRoot then
                                dir = (targetRoot.Position - myRoot.Position)
                        else
                                dir = Vector3.new(0, 0, 1)
                        end
                end
                if dir.Magnitude < 1e-3 then dir = Vector3.new(0, 0, 1) end
                dir = dir.Unit
                local speed = math.clamp(hatVel.Magnitude * p, 20, 400)

                if method == 1 then
                        pcall(function() targetRoot.AssemblyLinearVelocity = dir * speed end)
                elseif method == 2 then
                        pcall(function() targetRoot.AssemblyLinearVelocity = dir * speed + Vector3.new(0, speed * 0.45, 0) end)
                elseif method == 3 then
                        pcall(function()
                                local cur = targetRoot.AssemblyLinearVelocity
                                targetRoot.AssemblyLinearVelocity = cur + dir * speed * 0.85
                        end)
                elseif method == 4 then
                        pcall(function()
                                targetRoot.CFrame = targetRoot.CFrame + dir * math.min(4, 1.2 * p) + Vector3.new(0, 0.5 * p, 0)
                        end)
                elseif method == 5 then
                        pcall(function()
                                targetRoot.AssemblyLinearVelocity = dir * speed * 0.7 + Vector3.new(0, speed * 0.3, 0)
                                targetRoot.AssemblyAngularVelocity = Vector3.new(20 * p, 40 * p, 15 * p)
                        end)
                elseif method == 6 then
                        pcall(function()
                                targetRoot.AssemblyLinearVelocity = dir * speed * 0.5 + Vector3.new(0, -speed * 0.9, 0)
                        end)
                elseif method == 7 then
                        local side = dir:Cross(Vector3.yAxis)
                        if side.Magnitude < 0.1 then side = dir:Cross(Vector3.xAxis) end
                        side = side.Unit
                        pcall(function()
                                targetRoot.AssemblyLinearVelocity = side * speed + Vector3.new(0, speed * 0.25, 0)
                        end)
                elseif method == 8 then
                        local n = (targetRoot.Position - hat.Position)
                        if n.Magnitude < 1e-3 then n = dir else n = n.Unit end
                        local reflected = hatVel - 2 * hatVel:Dot(n) * n
                        pcall(function()
                                targetRoot.AssemblyLinearVelocity = -reflected.Unit * speed
                        end)
                elseif method == 9 then
                        pcall(function()
                                local bv = Instance.new("BodyVelocity")
                                bv.Name = "HC_PBV"
                                bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                                bv.Velocity = dir * speed * 0.6 + Vector3.new(0, 30 * p, 0)
                                bv.Parent = targetRoot
                                Debris:AddItem(bv, 0.15)
                        end)
                elseif method == 10 then
                        pcall(function()
                                local bv = Instance.new("BodyVelocity")
                                bv.Name = "HC_PBV"
                                bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                                bv.Velocity = dir * speed + Vector3.new(0, 55 * p, 0)
                                bv.Parent = targetRoot
                                Debris:AddItem(bv, 0.12)
                        end)
                elseif method == 11 then
                        pcall(function()
                                targetRoot.AssemblyLinearVelocity = dir * speed * 0.9 + Vector3.new(0, 25 * p, 0)
                                local pull = (hat.Position - targetRoot.Position)
                                if pull.Magnitude > 1 then
                                        targetRoot.AssemblyLinearVelocity = targetRoot.AssemblyLinearVelocity + pull.Unit * (12 * p)
                                end
                        end)
                elseif method == 12 then
                        local rx = (math.random() - 0.5) * 2
                        local ry = math.random() * 1.2
                        local rz = (math.random() - 0.5) * 2
                        local chaos = Vector3.new(rx, ry, rz)
                        if chaos.Magnitude < 0.2 then chaos = Vector3.new(0, 1, 0) end
                        pcall(function()
                                targetRoot.AssemblyLinearVelocity = chaos.Unit * speed + dir * (speed * 0.4)
                                targetRoot.AssemblyAngularVelocity = Vector3.new(rx * 30, ry * 40, rz * 30)
                        end)
                end
        end

        function X.playerCollideStep(handles, now)
                if not m.PlayerCollide or not m.HatsSolid then return end
                local method = math.clamp(math.floor(m.PlayerCollideMethod or 1), 1, 12)
                local power = tonumber(m.PlayerCollidePower) or 1.5
                local radius = tonumber(m.PlayerCollideRadius) or 6
                local cd = tonumber(m.PlayerCollideCooldown) or 0.08
                local onlyMoving = m.PlayerCollideOnlyMoving ~= false
                local minSpeed = tonumber(m.HatsSolidMinSpeed) or 4

                for _, plr in ipairs(Players:GetPlayers()) do
                        if m.PlayerCollideIgnoreSelf ~= false and plr == LocalPlayer then continue end
                        local char = plr.Character
                        if not char then continue end
                        local root = X.getRoot(char)
                        if not root or not root.Parent or root.Anchored then continue end
                        local lastHit = PlayerHitCD[root] or 0
                        if now - lastHit < cd then continue end

                        for _, h in ipairs(handles) do
                                local lastP = HatLastPos[h]
                                local lastT = HatLastT[h]
                                local vel = Vector3.zero
                                if lastP and lastT and now > lastT then
                                        vel = (h.Position - lastP) / math.max(now - lastT, 1e-4)
                                end
                                if onlyMoving and vel.Magnitude < minSpeed then continue end
                                local dist = (h.Position - root.Position).Magnitude
                                if dist <= radius then
                                        X.applyPlayerMethod(method, h, root, vel, power)
                                        PlayerHitCD[root] = now
                                        break
                                end
                        end
                end
        end

