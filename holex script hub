        function X.hitboxColor()
                local i = math.clamp(math.floor(m.HatsSolidHitboxColor or 1), 1, #m.HatsSolidHitboxColorNames)
                if i >= 25 or m.HatsSolidHitboxColorNames[i] == "25 Rainbow" then
                        local spd = tonumber(m.HatsSolidHitboxRainbowSpeed) or 1.5
                        local h = (os.clock() * spd) % 1
                        return Color3.fromHSV(h, 1, 1)
                end
                i = math.clamp(i, 1, #HITBOX_COLORS)
                return HITBOX_COLORS[i]
        end

        function X.maxFollowCount()
                local n = math.floor(tonumber(m.NPCMaxFollow) or 8)
                return math.clamp(n, 1, 30)
        end

        function X.syncHatDisabledFromString()
                table.clear(X.HatDisabled)
                local s = tostring(m.HatDisabledNames or "")
                for name in string.gmatch(s, "[^,]+") do
                        name = X.trim(name)
                        if name ~= "" then X.HatDisabled[name] = true end
                end
        end

        function X.serializeHatDisabled()
                local t = {}
                for name in pairs(X.HatDisabled) do t[#t + 1] = name end
                table.sort(t)
                m.HatDisabledNames = table.concat(t, ",")
        end

        function X.hatAccessoryName(handle)
                if not handle then return "Hat" end
                local p = handle.Parent
                if p and (p:IsA("Accessory") or p:IsA("Accoutrement")) then return p.Name end
                return handle.Name
        end

        function X.isHatEnabled(handle)
                if m.HatUseAll ~= false then return true end
                local name = type(handle) == "string" and handle or X.hatAccessoryName(handle)
                return not X.HatDisabled[name]
        end

        function X.setHatEnabledByName(name, enabled)
                X.setHatEnabled(tostring(name or ""), enabled)
        end

        function X.setHatEnabled(name, enabled)
                if enabled then X.HatDisabled[name] = nil else X.HatDisabled[name] = true end
                X.serializeHatDisabled()
                X.markDirty()
        end


        X.HatScaleByName = X.HatScaleByName or {}
        X.HatDamageByName = X.HatDamageByName or {}
        X.HatDmgCD = X.HatDmgCD or {}

        function X.syncHatScaleFromString()
                table.clear(X.HatScaleByName)
                local s = tostring(m.HatScaleMap or "")
                for pair in string.gmatch(s, "[^,]+") do
                        local n, v = pair:match("^%s*(.-)%s*=%s*(.-)%s*$")
                        if n and v then
                                n = X.trim(n)
                                if n ~= "" then X.HatScaleByName[n] = math.clamp(tonumber(v) or 1, 0.25, 100000) end
                        end
                end
        end
        function X.serializeHatScale()
                local t = {}
                for name, v in pairs(X.HatScaleByName) do t[#t + 1] = name .. "=" .. tostring(v) end
                table.sort(t)
                m.HatScaleMap = table.concat(t, ",")
        end
        function X.syncHatDamageFromString()
                table.clear(X.HatDamageByName)
                local s = tostring(m.HatDamageMap or "")
                for pair in string.gmatch(s, "[^,]+") do
                        local n, v = pair:match("^%s*(.-)%s*=%s*(.-)%s*$")
                        if n and v then
                                n = X.trim(n)
                                if n ~= "" then X.HatDamageByName[n] = math.clamp(tonumber(v) or 0, 0, 1000) end
                        end
                end
        end
        function X.serializeHatDamage()
                local t = {}
                for name, v in pairs(X.HatDamageByName) do t[#t + 1] = name .. "=" .. tostring(v) end
                table.sort(t)
                m.HatDamageMap = table.concat(t, ",")
        end
        function X.getHatScale(handleOrName)
                local name = type(handleOrName) == "string" and handleOrName or X.hatAccessoryName(handleOrName)
                local per = X.HatScaleByName[name]
                if type(per) == "number" then return math.clamp(per, 0.25, 100000) end
                return 1
        end
        function X.setHatScaleByName(name, scale)
                name = tostring(name or "")
                if name == "" then return end
                scale = math.clamp(tonumber(scale) or 1, 0.25, 100000)
                if math.abs(scale - 1) < 0.001 and not X.HatScaleByName[name] then
                        -- keep default
                else
                        X.HatScaleByName[name] = scale
                end
                X.serializeHatScale()
                X.markDirty()
        end
        function X.getHatDamage(handleOrName)
                local name = type(handleOrName) == "string" and handleOrName or X.hatAccessoryName(handleOrName)
                local per = X.HatDamageByName[name]
                if type(per) == "number" and per > 0 then return math.clamp(per, 0, 1000) end
                if m.HatDamageEnabled then
                        return math.clamp(tonumber(m.HatDamageDefault) or 15, 0, 1000)
                end
                return 0
        end
        function X.setHatDamageByName(name, dmg)
                name = tostring(name or "")
                if name == "" then return end
                dmg = math.clamp(tonumber(dmg) or 0, 0, 1000)
                if dmg <= 0 then X.HatDamageByName[name] = nil else X.HatDamageByName[name] = dmg end
                X.serializeHatDamage()
                X.markDirty()
        end

