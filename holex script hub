        function X.kiOrbFx(pos, size, color)
                local K = X.Ki
                if m.KiOrbFX == false then
                        X.kiDropPart("orb")
                        X.kiDropPart("orbCore")
                        return
                end
                local ball, core = K.parts.orb, K.parts.orbCore
                if not (ball and ball.Parent) then
                        ball = X.kiMkPart("HC_KiOrb", Enum.PartType.Ball, color, 0.3)
                        X.kiAddLight(ball, color, 20, 3)
                        core = X.kiMkPart("HC_KiOrbCore", Enum.PartType.Ball, Color3.new(1, 1, 1), 0.1)
                        K.parts.orb, K.parts.orbCore = ball, core
                end
                local j = 1 + 0.08 * math.sin(os.clock() * 31)
                local s = math.max(size * j, 0.2)
                ball.Color = color
                ball.Size = Vector3.new(s, s, s)
                ball.CFrame = CFrame.new(pos)
                core.Size = Vector3.new(s * 0.55, s * 0.55, s * 0.55)
                core.CFrame = CFrame.new(pos)
        end

        function X.kiBeamFx(muzzle, target, dir, width, color, alpha)
                local K = X.Ki
                local len = (target - muzzle).Magnitude
                if len < 0.2 then return end
                local outer, core, mz, imp = K.parts.bOuter, K.parts.bCore, K.parts.bMuz, K.parts.bImp
                if not (outer and outer.Parent) then
                        outer = X.kiMkPart("HC_KiBeamOuter", Enum.PartType.Cylinder, color, 0.3)
                        core = X.kiMkPart("HC_KiBeamCore", Enum.PartType.Cylinder, Color3.new(1, 1, 1), 0.05)
                        mz = X.kiMkPart("HC_KiMuzzle", Enum.PartType.Ball, color, 0.2)
                        imp = X.kiMkPart("HC_KiImpact", Enum.PartType.Ball, color, 0.25)
                        X.kiAddLight(mz, color, 24, 3)
                        X.kiAddLight(imp, color, 28, 3)
                        K.parts.bOuter, K.parts.bCore, K.parts.bMuz, K.parts.bImp = outer, core, mz, imp
                end
                local pulse = 1 + 0.07 * math.sin(os.clock() * 43)
                local w = math.max(width * alpha * pulse, 0.1)
                local cf = CFrame.lookAt(muzzle, muzzle + dir) * CFrame.new(0, 0, -len / 2) * CFrame.Angles(0, math.rad(90), 0)
                outer.Color = color
                outer.Size = Vector3.new(len, w, w)
                outer.CFrame = cf
                core.Size = Vector3.new(len, math.max(w * 0.45, 0.1), math.max(w * 0.45, 0.1))
                core.CFrame = cf
                local ms = math.max(w * 1.5, 0.2)
                mz.Color = color
                mz.Size = Vector3.new(ms, ms, ms)
                mz.CFrame = CFrame.new(muzzle)
