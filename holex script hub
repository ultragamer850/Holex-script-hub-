        -- Placement offset relative to a hat CFrame for ride mode (reads live — change placement anytime)
        function X.rideOffsetFor(index, total, hatCF)
                local place = math.clamp(math.floor(m.NPCHatRidePlacement or 1), 1, 9)
                local off = tonumber(m.NPCHatRideOffset) or 2.5
                local right = hatCF.RightVector
                local up = hatCF.UpVector
                local look = hatCF.LookVector
                local t = os.clock()
                local orbitSpd = tonumber(m.NPCHatRideOrbitSpeed) or 1.5

                if place == 1 then -- Up
                        return up * off + right * ((index - (total + 1) / 2) * 1.2)
                elseif place == 2 then -- Down
                        return -up * off + right * ((index - (total + 1) / 2) * 1.2)
                elseif place == 3 then -- Left
                        return -right * off + look * ((index - (total + 1) / 2) * 1.2)
                elseif place == 4 then -- Right
                        return right * off + look * ((index - (total + 1) / 2) * 1.2)
                elseif place == 5 then -- Front
                        return look * off + right * ((index - (total + 1) / 2) * 1.2)
                elseif place == 6 then -- Back
                        return -look * off + right * ((index - (total + 1) / 2) * 1.2)
                elseif place == 7 then -- Spread around
                        local ang = ((index - 1) / math.max(total, 1)) * math.pi * 2
                        local ring = (right * math.cos(ang) + look * math.sin(ang)) * off
                        return ring + up * (off * 0.35)
                elseif place == 8 then -- Orbit around hat (animated)
                        local base = ((index - 1) / math.max(total, 1)) * math.pi * 2
                        local ang = base + t * orbitSpd
                        local ring = (right * math.cos(ang) + look * math.sin(ang)) * off
                        return ring + up * (off * 0.25)
                else -- Stack vertical
                        return up * (off * 0.4 + (index - 1) * 2.2)
                end
        end

        function X.getPrimaryHat()
                local handles = X.filterEnabledHandles(X.hatsSolidHandles())
                if #handles == 0 then return nil end
                local best, bestVol = handles[1], 0
                for _, h in ipairs(handles) do
                        local s = h.Size
                        local vol = s.X * s.Y * s.Z
                        if vol > bestVol then bestVol = vol; best = h end
                end
                return best
        end

        function X.applyFollowToNPC(entry, index, total, myHrp, dt)
                local npc = entry.model
                if not npc or not npc.Parent then return end
                local part = X.getRoot(npc)
                if not part then return end

                local owned = X.partOwner(part)
                if owned then
                        entry.lastOwnerOk = os.clock()
                else
                        if not m.NPCFollowKeepTrying then return end
                        if os.clock() - (entry.lastOwnerOk or 0) > 4 then return end
                        return
                end

                local method = math.clamp(math.floor(m.NPCFollowMethod or 1), 1, 4)
                local speed = tonumber(m.NPCFollowSpeed) or 22
                local spread = tonumber(m.NPCFollowSpread) or 2.5
                local ox = tonumber(m.NPCFollowOffsetX) or -4
                local oy = tonumber(m.NPCFollowOffsetY) or 0
                local oz = tonumber(m.NPCFollowOffsetZ) or 0
                local mid = (total + 1) / 2
                local side = (index - mid) * spread
                local look = myHrp.CFrame.LookVector
                local right = myHrp.CFrame.RightVector
                local flatLook = Vector3.new(look.X, 0, look.Z)
                if flatLook.Magnitude < 1e-3 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
                local flatRight = Vector3.new(right.X, 0, right.Z)
                if flatRight.Magnitude < 1e-3 then flatRight = Vector3.new(1, 0, 0) else flatRight = flatRight.Unit end

                -- Behind-ish default using offset + spread between multi NPCs
                local targetPos = myHrp.Position + Vector3.new(ox, oy, oz) + flatRight * side
                local distMode = tonumber(m.NPCFollowDistance) or 0
                if distMode > 0 then
                        targetPos = myHrp.Position - flatLook * distMode + flatRight * side + Vector3.new(0, oy, 0)
                end

                local toTarget = targetPos - part.Position
                local dist = toTarget.Magnitude

                if m.NPCFollowTeleportIfFar and dist > (tonumber(m.NPCFollowTeleportDistance) or 60) then
                        pcall(function()
                                if npc.PivotTo then
                                        npc:PivotTo(CFrame.new(targetPos) * (part.CFrame - part.CFrame.Position))
                                else
                                        part.CFrame = CFrame.new(targetPos) * (part.CFrame - part.CFrame.Position)
                                end
                        end)
                        return
                end

                local hum = npc:FindFirstChildOfClass("Humanoid")
                local moving = dist > 1.5
                local moveSpeed = 0
                if moving then
                        moveSpeed = math.min(speed, dist * 4)
                end
                X.setNPCAnimState(npc, moving, moveSpeed)
                if moving then
                        X.playWalkSFX(part)
                end

                if method == 1 or method == 4 then
                        if hum then
                                pcall(function() hum:MoveTo(targetPos) end)
                        end
                end

                if method == 2 or method == 4 then
                        if dist > 1.2 then
                                local dir = toTarget.Unit
                                local v = dir * math.min(speed, dist * 5)
                                local cur = part.AssemblyLinearVelocity
                                pcall(function()
                                        part.AssemblyLinearVelocity = Vector3.new(v.X, cur.Y, v.Z)
                                end)
                        end
                end

                if method == 3 then
                        if dist > 0.8 then
                                local cf = CFrame.new(targetPos, targetPos + Vector3.new(flatLook.X, 0, flatLook.Z))
                                -- Uhhhhhh-style lerp when GrabAnimLerp is on
                                if m.GrabAnimLerp then
                                        local alpha = math.clamp((tonumber(m.GrabAnimSpeed) or 16) * (dt or 0.016), 0, 1)
                                        local newPos = part.Position:Lerp(targetPos, alpha)
                                        cf = CFrame.new(newPos, newPos + Vector3.new(flatLook.X, 0, flatLook.Z))
                                end
                                pcall(function()
                                        if npc.PivotTo then
                                                npc:PivotTo(cf)
                                        else
                                                part.CFrame = cf
                                        end
                                end)
                        end
                end
        end

        function X.applyHatRideToNPC(entry, index, total, dt)
                local npc = entry.model
                if not npc or not npc.Parent then return end
                local part = X.getRoot(npc)
                if not part then return end

                local owned = X.partOwner(part)
                if owned then
                        entry.lastOwnerOk = os.clock()
                else
                        if not m.NPCFollowKeepTrying then return end
                        if os.clock() - (entry.lastOwnerOk or 0) > 4 then return end
                        return
                end

                local hat = X.getRideHatForIndex and X.getRideHatForIndex(index, total) or X.getPrimaryHat()
                local anchorCF
                if hat then
                        anchorCF = hat.CFrame
                else
                        local myHrp = X.getMyHRP()
                        if not myHrp then return end
                        anchorCF = myHrp.CFrame
                end

                local offset = X.rideOffsetFor(index, total, anchorCF)
                local targetPos = anchorCF.Position + offset
                local look = anchorCF.LookVector
                local targetCF = CFrame.new(targetPos, targetPos + Vector3.new(look.X, 0, look.Z))
                -- riding → stop walk/run anims (held pose)
                X.setNPCAnimState(npc, false, 0)

                if m.NPCHatRideSmooth then
                        local alpha = math.clamp((tonumber(m.NPCHatRideSmoothSpeed) or 18) * (dt or 0.016), 0, 1)
                        local newPos = part.Position:Lerp(targetPos, alpha)
                        local newCF = CFrame.new(newPos, newPos + Vector3.new(look.X, 0, look.Z))
                        pcall(function()
                                if npc.PivotTo then
                                        npc:PivotTo(newCF)
                                else
                                        part.CFrame = newCF
                                end
                        end)
                        if m.NPCHatRideUseVelocity then
                                local to = targetPos - part.Position
                                if to.Magnitude > 0.2 then
                                        pcall(function()
                                                part.AssemblyLinearVelocity = to.Unit * math.min(40, to.Magnitude * 12)
                                        end)
                                end
                        end
                else
                        pcall(function()
                                if npc.PivotTo then
                                        npc:PivotTo(targetCF)
                                else
                                        part.CFrame = targetCF
                                end
                        end)
                end
        end

        function X.stopNPCFollow()
                if X.NPCFollowConn then
                        pcall(function() X.NPCFollowConn:Disconnect() end)
                        X.NPCFollowConn = nil
                end
                m.NPCFollow = false
                m.NPCHatRide = false
        end

        function X.startNPCFollowLoop()
                if X.NPCFollowConn then
                        pcall(function() X.NPCFollowConn:Disconnect() end)
                        X.NPCFollowConn = nil
                end
                X.NPCFollowConn = RunService.Heartbeat:Connect(function(dt)
                        if not m.Enabled then
                                X.stopNPCFollow()
                                return
                        end
                        if not m.NPCFollow and not m.NPCHatRide then
                                X.stopNPCFollow()
                                return
                        end

                        -- frame skip when many NPCs / low-lag
                        local skip = tonumber(m.PerfNPCSkip) or 1
                        if m.LowLag and #NPCList > 6 then
                                skip = math.max(skip, 2)
                        end
                        X.NPCSkip = (X.NPCSkip or 0) + 1
                        if X.NPCSkip <= skip then return end
                        X.NPCSkip = 0

                        X.pruneDeadNPCs()
                        if #NPCList == 0 then
                                X.tryReclaimAll()
                                if #NPCList == 0 then return end
                        end

                        local myHrp = X.getMyHRP()
                        if not myHrp and m.NPCFollow then return end

                        local total = #NPCList
                        local scaledDt = dt * (skip + 1)
                        for i = 1, total do
                                local entry = NPCList[i]
                                if m.NPCHatRide then
                                        X.applyHatRideToNPC(entry, i, total, scaledDt)
                                elseif m.NPCFollow then
                                        X.applyFollowToNPC(entry, i, total, myHrp, scaledDt)
                                end
                        end
                end)
        end

        function X.startNPCFollow()
                m.NPCFollow = true
                m.NPCHatRide = false
                X.startNPCFollowLoop()
                warn("[HatCollision] Multi-NPC Follow ON (" .. #NPCList .. " selected)")
        end

        function X.startNPCHatRide()
                m.NPCHatRide = true
                m.NPCFollow = false
                X.startNPCFollowLoop()
                warn("[HatCollision] Hat Ride ON (" .. #NPCList .. " NPCs → hats)")
        end

