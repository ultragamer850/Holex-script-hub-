        -- things the beam / aim rays must ignore
        function X.kiExclude()
                local K = X.Ki
                local ex = {}
                local fig = X.getMyCharacter()
                if fig then ex[#ex + 1] = fig end
                if LocalPlayer.Character then ex[#ex + 1] = LocalPlayer.Character end
                if K.fx and K.fx.Parent then ex[#ex + 1] = K.fx end
                for h in pairs(K.held) do
                        if h and h.Parent then ex[#ex + 1] = h end
                end
                return ex
        end

        function X.kiAim(range)
                local cam = Workspace.CurrentCamera
                if not cam then return nil end
                range = range or 500
                local loc = UserInputService:GetMouseLocation()
                local ray = cam:ViewportPointToRay(loc.X, loc.Y)
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = X.kiExclude()
                rp.IgnoreWater = true
                local res = Workspace:Raycast(ray.Origin, ray.Direction * range, rp)
                return res, ray.Origin, ray.Direction, ray.Origin + ray.Direction * range
        end

        function X.kiTrace(origin, dir, range)
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = X.kiExclude()
                rp.IgnoreWater = true
                local res = Workspace:Raycast(origin, dir * range, rp)
                if res then return res.Position, res end
                return origin + dir * range, nil
        end

        -- point between both hands (follows the arm pose, so it works for charge + fire)
        function X.kiHandPoint(fig)
                local ra = fig and fig:FindFirstChild("Right Arm")
                local la = fig and fig:FindFirstChild("Left Arm")
                if ra and la and ra:IsA("BasePart") and la:IsA("BasePart") then
                        local rt = ra.Position - ra.CFrame.UpVector * (ra.Size.Y * 0.5)
                        local lt = la.Position - la.CFrame.UpVector * (la.Size.Y * 0.5)
                        return (rt + lt) * 0.5
                end
                local root = X.getRoot(fig)
                if root then return root.Position + root.CFrame.LookVector * 2 + Vector3.new(0, 0.5, 0) end
                return nil
        end

        function X.kiEyePoints(fig)
                local head = fig and fig:FindFirstChild("Head")
                if not (head and head:IsA("BasePart")) then return nil end
                local cf = head.CFrame
                local fwd = cf.LookVector * (head.Size.Z * 0.5 + 0.05)
                local up = cf.UpVector * (head.Size.Y * 0.08)
                local side = cf.RightVector * (head.Size.X * 0.2)
                return head.Position + fwd + up + side, head.Position + fwd + up - side
        end

        --------------------------------------------------------------
        -- hats: take / release / fast rebuild
        --------------------------------------------------------------
        -- placement offset (up / down / sides / forward) for a role's hats
        function X.kiPlace(role)
                local pre = X.KiPlacePrefix[role]
                if not pre then return nil end
                local y = tonumber(m[pre .. "Height"]) or 0
                local side = tonumber(m[pre .. "Side"]) or 0
                local fwd = tonumber(m[pre .. "Forward"]) or 0
                if y == 0 and side == 0 and fwd == 0 then return nil end
                local d = X.Ki.aimDir or Vector3.new(0, 0, -1)
                local f = Vector3.new(d.X, 0, d.Z)
                if f.Magnitude < 0.05 then f = Vector3.new(0, 0, -1) else f = f.Unit end
                local right = f:Cross(Vector3.yAxis)
                return right * side + f * fwd + Vector3.new(0, y, 0)
        end

        -- Uhhhhhh HatCFrameOverride entry (same method as Steve's AK-47 present bullets)
        function X.kiEnsureOverride(held)
                if not held then return end
                local hr = X.getHatReanimator()
                if not hr then return end
                pcall(function()
                        hr.HatCFrameOverride = hr.HatCFrameOverride or {}
                        if held.Override and held.Override._hc then
                                -- already registered
                                return
                        end
                        local entry = {
                                Group = "Bullet",
                                CFrame = held.TargetCF or CFrame.identity,
                                Name = held.Name or (held.Handle and X.hatAccessoryName(held.Handle)) or "Bullet",
                                Handle = held.Handle,
                                _hc = true, -- marked as HatCollision-owned
                        }
                        held.Override = entry
                        table.insert(hr.HatCFrameOverride, entry)
                end)
        end

        function X.kiClearOverride(held)
                if not held or not held.Override then return end
                local hr = X.getHatReanimator()
                pcall(function()
                        if hr and hr.HatCFrameOverride then
                                for i = #hr.HatCFrameOverride, 1, -1 do
                                        if hr.HatCFrameOverride[i] == held.Override or hr.HatCFrameOverride[i]._hc and hr.HatCFrameOverride[i].Handle == held.Handle then
                                                table.remove(hr.HatCFrameOverride, i)
                                        end
                                end
                        end
                end)
                held.Override = nil
        end

        -- driveCF(held, cf, skipPlace)
        -- Always writes TargetCF + HatCFrameOverride + FE Align/CFrame so Uhhhhhh cannot snap hats to the body
        function X.kiDrive(held, cf, skipPlace)
                if not held then return end
                if not skipPlace then
                        local off = X.kiPlace(held.Role)
                        if off then cf = cf + off end
                end
                held.TargetCF = cf
                X.kiEnsureOverride(held)
                if held.Override then held.Override.CFrame = cf end
                X.peDriveHandle(held, cf)
                -- hard lock every call
                local part = held.Handle
                if part and part.Parent then
                        pcall(function()
                                part.Anchored = false
                                part.CanCollide = false
                                part.CFrame = cf
                                part.AssemblyLinearVelocity = Vector3.zero
                                part.AssemblyAngularVelocity = Vector3.zero
                        end)
                end
        end

        function X.kiEnsureStep()
                local K = X.Ki
                if K.stepConn then return end
                -- Stepped + Heartbeat: beat Uhhhhhh limb reattachment on the main rig AND figure
                K.stepConn = RunService.Stepped:Connect(function()
                        if m.KiForceHats == false and m.PowerUpEffectHardLock == false then return end
                        for _, hd in pairs(K.held) do
                                local part = hd.Handle
                                local cf = hd.TargetCF
                                if cf and part and part.Parent then
                                        pcall(function()
                                                part.CFrame = cf
                                                if hd.Override then hd.Override.CFrame = cf end
                                        end)
                                end
                        end
                end)
                K.hbConn = RunService.Heartbeat:Connect(function()
                        if m.KiForceHats == false and m.PowerUpEffectHardLock == false then return end
                        for _, hd in pairs(K.held) do
                                local part = hd.Handle
                                local cf = hd.TargetCF
                                if cf and part and part.Parent then
                                        pcall(function() part.CFrame = cf end)
                                end
                        end
                end)
        end

        function X.kiTake(handle, role)
                local K = X.Ki
                if not handle or not handle.Parent then return nil end
                if K.held[handle] then
                        K.held[handle].Role = role or K.held[handle].Role
                        X.kiEnsureOverride(K.held[handle])
                        return K.held[handle]
                end
                if X.PowerUpEffectHeld[handle] then
                        -- steal back from power-up aura if this is a present bullet
                        pcall(X.peReleaseOne, handle, X.PowerUpEffectHeld[handle])
                        X.PowerUpEffectHeld[handle] = nil
                end
                local oldForce = m.PowerUpEffectForceTake
                if m.KiForceHats ~= false then m.PowerUpEffectForceTake = true end
                local okA, held = pcall(X.peAttachFE, handle, "ki")
                m.PowerUpEffectForceTake = oldForce
                if not okA or not held then
                        -- still track + override even if Align failed
                        held = { Handle = handle, Kind = "ki" }
                end
                X.PowerUpEffectHeld[handle] = nil
                held.Role = role
                held.Name = X.hatAccessoryName(handle)
                K.held[handle] = held
                X.kiEnsureOverride(held)
                X.kiEnsureStep()
                return held
        end

        function X.kiRelease(handle)
                local K = X.Ki
                local held = K.held[handle]
                if not held then return end
                -- present bullets with permanent underground: do NOT release — keep override
                if m.KiPresentUnderground ~= false and (held.Role == "beam" or held.Role == "eyes") then
                        return
                end
                K.held[handle] = nil
                pcall(X.kiClearOverride, held)
                pcall(X.peReleaseOne, handle, held)
                if not next(K.held) then
                        if K.stepConn then pcall(function() K.stepConn:Disconnect() end) K.stepConn = nil end
                        if K.hbConn then pcall(function() K.hbConn:Disconnect() end) K.hbConn = nil end
                end
        end

        function X.kiReleaseRole(role)
                local R = X.Ki.roles[role]
                if not R then return end
                -- permanent underground: present bullets are never given back to the body
                if m.KiPresentUnderground ~= false and (role == "beam" or role == "eyes") then
                        X.kiParkRole(role)
                        return
                end
                for _, held in ipairs(R.list) do
                        if held.Handle then X.kiRelease(held.Handle) end
                end
                R.list = {}
                R.force = true
        end

        -- Keep FE ownership + HatCFrameOverride and stash underground (NEVER return to the rig)
        function X.kiParkRole(role)
                local R = X.Ki.roles[role]
                if not R then return end
                if m.KiPresentUnderground == false then
                        -- true release only when underground parking is disabled
                        for _, held in ipairs(R.list) do
                                if held.Handle then
                                        local K = X.Ki
                                        local h = held.Handle
                                        K.held[h] = nil
                                        pcall(X.kiClearOverride, held)
                                        pcall(X.peReleaseOne, h, held)
                                end
                        end
                        R.list = {}
                        R.force = true
                        return
                end
                local list = X.kiSyncRole(role, true)
                X.kiParkUnderground(list, os.clock())
                R.force = false
                X.Ki.parked = X.Ki.parked or {}
                X.Ki.parked[role] = true
        end

        -- End of an attack: park present-bullet roles, release charge-aura / tele roles
        function X.kiEndAttack(role)
                if role == "beam" or role == "eyes" then
                        X.kiParkRole(role)
                        -- also force-park the other present-bullet role so nothing is left on the body
                        task.defer(function() pcall(X.kiForceParkPresent, role .. " end") end)
                else
                        X.kiReleaseRole(role)
                        task.defer(function() pcall(X.kiForceParkPresent, role .. " end") end)
                end
        end

        -- Force ALL present-bullet hats underground (call after ANY attack ends)
                -- Is an attack currently using present-bullet / aura hats? (do NOT park while true)
        function X.kiBeamBusy()
                local K = X.Ki
                local ph = K.phase
                return ph == "charge" or ph == "fire" or ph == "recover"
        end

        function X.kiEyesBusy()
                return X.Ki.eyes == true
        end

        function X.kiAnyAttackBusy()
                return X.kiBeamBusy() or X.kiEyesBusy() or (X.Ki.phase == "tele")
        end

        -- Force present-bullet hats underground ONLY when not needed by an active attack
        function X.kiForceParkPresent(reason)
                if HX.hatSafeMode and HX.hatSafeMode() then return end
                if m.Ki == false then return end
                if m.KiPresentUnderground == false then return end
                local K = X.Ki
                -- never fight an active charge / fire / laser eyes
                if X.kiAnyAttackBusy() then
                        return
                end
                X.HandleCacheT = 0
                pcall(X.boostNetwork)
                if not X.kiBeamBusy() then
                        local list = X.kiSyncRole("beam", true)
                        if #list > 0 then
                                for _, held in ipairs(list) do
                                        local h = held.Handle
                                        if h and h.Parent then
                                                pcall(function()
                                                        for _, d in ipairs(h:GetDescendants()) do
                                                                if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("AccessoryWeld") then
                                                                        d:Destroy()
                                                                end
                                                        end
                                                end)
                                                if not held.AP then
                                                        local nh = X.kiTake(h, "beam")
                                                        if nh then held = nh end
                                                end
                                        end
                                end
                                X.kiParkUnderground(list, os.clock())
                                K.parked = K.parked or {}
                                K.parked.beam = true
                        end
                end
                if not X.kiEyesBusy() then
                        local list = X.kiSyncRole("eyes", true)
                        if #list > 0 then
                                for _, held in ipairs(list) do
                                        local h = held.Handle
                                        if h and h.Parent then
                                                pcall(function()
                                                        for _, d in ipairs(h:GetDescendants()) do
                                                                if d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("AccessoryWeld") then
                                                                        d:Destroy()
                                                                end
                                                        end
                                                end)
                                                if not held.AP then
                                                        local nh = X.kiTake(h, "eyes")
                                                        if nh then held = nh end
                                                end
                                        end
                                end
                                X.kiParkUnderground(list, os.clock())
                                K.parked = K.parked or {}
                                K.parked.eyes = true
                        end
                end
                K.lastForcePark = os.clock()
        end

function X.kiIsPresentBulletHandle(handle)
                if not handle then return false end
                local K = X.Ki
                if K.held[handle] then
                        local r = K.held[handle].Role
                        if r == "beam" or r == "eyes" then return true end
                end
                local name = string.lower(X.hatAccessoryName(handle) or "")
                if name == "" then return false end
                local maxB = X.kiRoleMax("beam")
                local maxE = X.kiRoleMax("eyes")
                for i = 1, maxB do
                        if string.lower(X.cleanHatLabel(m["KiBeamHat" .. i])) == name then return true end
                end
                for i = 1, maxE do
                        if string.lower(X.cleanHatLabel(m["KiEyeHat" .. i])) == name then return true end
                end
                return false
        end

        -- ===== Uhhhhhh hatmap (Steve): GetHatMap → Bullet / Gun / GunAura groups =====
        -- See https://github.com/STEVE-916-create/Uhhhhhh  GetHatMap() + d_hatsmap.lua Bullet group
        function X.getHatReanimator()
                local uh = HX.uh()
                if type(uh) ~= "table" then return nil end
                return uh.HatReanimator or (uh.Reanimate and uh.Reanimate.HatReanimator) or rawget(_G, "HatReanimator")
        end

        function X.getUhhhhhhHatMapRaw()
                local hr = X.getHatReanimator()
                if not hr then return {} end
                local ok, map = pcall(function()
                        if type(hr.GetHatMap) == "function" then return hr.GetHatMap() end
                        return hr.HatMap or hr.hatMap
                end)
                if ok and type(map) == "table" then return map end
                return {}
        end

        -- Holex perf patch: GetHatMap() rebuilt a table on every call (hit every few frames while a slot was empty)
        function X.getUhhhhhhHatMap()
                local now = os.clock()
                if X._hmC and now - (X._hmT or 0) < 2 then return X._hmC end
                X._hmC, X._hmT = X.getUhhhhhhHatMapRaw(), now
                return X._hmC
        end

        -- hats whose Group is "Bullet" (present bullets used by AK-47 / Ki beam)
        function X.listHatMapByGroup(group)
                group = string.lower(tostring(group or "Bullet"))
                local out = {}
                for _, entry in ipairs(X.getUhhhhhhHatMap()) do
                        local g = string.lower(tostring(entry.Group or entry.group or ""))
                        if g == group then
                                out[#out + 1] = entry
                        end
                end
                return out
        end

        -- resolve a hatmap entry to a live Handle part on the figure
        function X.handleFromHatMapEntry(entry)
                if not entry then return nil end
                local name = entry.Name or entry.name
                if name and name ~= "" then
                        local h = X.findHandleByLabel(name)
                        if h then return h, name end
                end
                -- match by mesh id on handles
                local meshId = tostring(entry.MeshId or entry.meshId or ""):gsub("%D", "")
                if meshId == "" then return nil end
                for _, h in ipairs(X.hatsSolidHandles(true) or {}) do
                        local mid = ""
                        pcall(function()
                                local sm = h:FindFirstChildOfClass("SpecialMesh") or h:FindFirstChildOfClass("MeshPart")
                                if sm then
                                        mid = tostring(sm.MeshId or sm.MeshId):gsub("%D", "")
                                elseif h:IsA("MeshPart") then
                                        mid = tostring(h.MeshId):gsub("%D", "")
                                end
                        end)
                        if mid ~= "" and (mid == meshId or string.find(mid, meshId, 1, true) or string.find(meshId, mid, 1, true)) then
                                return h, X.hatAccessoryName(h)
                        end
                end
                return nil
        end

        -- fill empty KiBeamHat / KiEyeHat slots from hatmap Bullet group
        function X.kiAutoFillFromHatMap(role)
                if m.KiAutoHatMap == false then return 0 end
                role = role or "beam"
                local rc = X.KiRoleCfg[role]
                if not rc then return 0 end
                local maxN = X.kiRoleMax(role)
                local bullets = X.listHatMapByGroup("Bullet")
                if #bullets == 0 then
                        -- fallback: any spare hat not used as body limb
                        return 0
                end
                local filled = 0
                local usedNames = {}
                for i = 1, maxN do
                        local cur = X.cleanHatLabel(m[rc.prefix .. i])
                        if cur ~= "" then usedNames[string.lower(cur)] = true end
                end
                local bi = 1
                for i = 1, maxN do
                        local key = rc.prefix .. i
                        if X.cleanHatLabel(m[key]) == "" then
                                while bi <= #bullets do
                                        local entry = bullets[bi]
                                        bi = bi + 1
                                        local h, nm = X.handleFromHatMapEntry(entry)
                                        nm = nm or entry.Name or ("Bullet" .. i)
                                        if nm and not usedNames[string.lower(nm)] then
                                                m[key] = nm
                                                usedNames[string.lower(nm)] = true
                                                filled = filled + 1
                                                break
                                        end
                                end
                        end
                end
                if filled > 0 then
                        X.kiMarkHats(role)
                        warn("[HatCollision] Auto-filled " .. tostring(filled) .. " " .. role .. " slots from Uhhhhhh hatmap Bullet group")
                end
                return filled
        end

        -- park present bullets UNDERGROUND permanently (idle / after attacks / after respawn)
        -- Uses HatCFrameOverride like Steve's AK-47 so Uhhhhhh never puts them back on the body
        function X.kiParkUnderground(list, now)
                if HX.hatSafeMode and HX.hatSafeMode() then return end
                if m.KiPresentUnderground == false then return end
                local root = X.getMyHRP()
                if not root then return end
                local depth = math.abs(tonumber(m.KiPresentDepth) or 24)
                local spread = tonumber(m.KiPresentSideSpread) or 1.2
                local n = #list
                local base = root.Position + Vector3.new(0, -depth, 0)
                local rt = root.CFrame
                now = now or os.clock()
                for i, held in ipairs(list) do
                        if held and held.Handle and held.Handle.Parent then
                                local frac = (i - 0.5) / math.max(n, 1) - 0.5
                                local pos = base + rt.RightVector * (frac * spread * math.max(n, 1))
                                local cf = CFrame.new(pos) * CFrame.Angles(0, now * 0.35 + i, 0)
                                -- skipPlace = true so attack placement offsets do not pull hats up
                                X.kiDrive(held, cf, true)
                        end
                end
        end

        -- Resolve + take the hats for one role. Cheap when nothing changed, and when a hat is
        -- missing / dropped it retries every KiRebuildInterval (0.08s) so it snaps back fast.
        function X.kiSyncRole(role, force)
                local K = X.Ki
                local R = K.roles[role]
                local rc = X.KiRoleCfg[role]
                if not (R and rc) then return {} end
                local now = os.clock()
                local iv = math.max(tonumber(m.KiRebuildInterval) or 0.08, 0.02)
                if m.KiForceHats ~= false then iv = math.min(iv, 0.04) end
                force = force or R.force
                if not force and now - (R.T or 0) < iv then return R.list end
                local maxN = X.kiRoleMax(role)
                -- auto-fill empty bullet slots from Uhhhhhh hatmap Group "Bullet"
                if (role == "beam" or role == "eyes") and m.KiAutoHatMap ~= false then
                        local anyEmpty = false
                        for i = 1, maxN do
                                if X.cleanHatLabel(m[rc.prefix .. i]) == "" then anyEmpty = true break end
                        end
                        if anyEmpty then pcall(X.kiAutoFillFromHatMap, role) end
                end
                local wanted = 0
                for i = 1, maxN do
                        if X.cleanHatLabel(m[rc.prefix .. i]) ~= "" then wanted = wanted + 1 end
                end
                if not force then
                        local okAll = (#R.list == wanted)
                        if okAll then
                                for _, hd in ipairs(R.list) do
                                        if not (hd.Handle and hd.Handle.Parent) then okAll = false break end
                                end
                        end
                        if okAll then R.T = now return R.list end
                end
                R.T = now
                R.force = false
                pcall(X.boostNetwork)
                local list, seen = {}, {}
                for i = 1, maxN do
                        local lab = X.cleanHatLabel(m[rc.prefix .. i])
                        if lab ~= "" then
                                local h = X.findHandleByLabel(lab)
                                if not h then
                                        -- try hatmap entry match by name/mesh
                                        for _, entry in ipairs(X.listHatMapByGroup("Bullet")) do
                                                if string.lower(tostring(entry.Name or "")) == string.lower(lab) then
                                                        h = select(1, X.handleFromHatMapEntry(entry))
                                                        break
                                                end
                                        end
                                end
                                if h and h.Parent and not seen[h] then
                                        local mine = K.held[h]
                                        if not mine or mine.Role == role then
                                                local held = X.kiTake(h, role)
                                                if held then
                                                        seen[h] = true
                                                        list[#list + 1] = held
                                                end
                                        end
                                end
                        end
                end
                for _, hd in ipairs(R.list) do
                        if hd.Handle and not seen[hd.Handle] then X.kiRelease(hd.Handle) end
                end
                R.list = list
                if #list < wanted then R.T = now + 0.3 end -- missing hat: back off a little instead of rescanning every frame
                return list
        end

        -- aura hats spinning around the hands
        function X.kiOrbDrive(list, center, r, now)
                local n = #list
                local spin = tonumber(m.KiOrbSpin) or 7
                local selfSpin = tonumber(m.KiOrbSpinSelf) or 8
                for i, held in ipairs(list) do
                        local a = now * spin + (i - 1) / math.max(n, 1) * math.pi * 2
                        local rr = (n > 1) and r or 0
                        local pos = center + Vector3.new(math.cos(a) * rr, math.sin(now * 3 + i) * 0.2 * (rr + 0.3), math.sin(a) * rr)
                        X.kiDrive(held, CFrame.new(pos) * CFrame.Angles(0, now * selfSpin + i, 0))
                end
        end

        -- beam hats circling the hands while charging (vertical ring), ready to fire
        function X.kiRingDrive(list, center, r, now, root)
                local n = #list
                local rt = root and root.CFrame or CFrame.new()
                for i, held in ipairs(list) do
                        local a = -now * 9 + (i - 1) / math.max(n, 1) * math.pi * 2
                        local pos = center + rt.RightVector * (math.cos(a) * r) + Vector3.new(0, math.sin(a) * r, 0)
                        X.kiDrive(held, CFrame.new(pos) * CFrame.Angles(now * 6, now * 8, i))
                end
        end

        -- bullet / laser hat movement.
        -- 1 Zip     : hat flips muzzle <-> impact every `period` seconds (AK-47 / STEVE style)
        -- 2 Stream  : hats rush from the muzzle to the impact point over and over
        -- 3 Spiral  : like stream but corkscrewing around the beam
        -- 4 Pulse   : hat jumps to a random spot along the beam every tick
        function X.kiBulletHat(held, style, idx, n, muzzle, target, now, period, width)
                local d = target - muzzle
                local len = d.Magnitude
                if len < 0.5 then return end
                local dir = d / len
                period = math.max(tonumber(period) or 0.05, 0.02)
                style = math.clamp(math.floor(tonumber(style) or 1), 1, 4)
                local cf
                if style == 1 then
                        local ph = (math.floor(now / period) + idx) % 2
                        local pos = (ph == 0) and muzzle or target
                        cf = CFrame.Angles(math.random() * 6.2832, math.random() * 6.2832, math.random() * 6.2832) + pos
                elseif style == 2 or style == 3 then
                        local frac = (now / (period * 4) + (idx - 1) / math.max(n, 1)) % 1
                        local pos = muzzle + d * frac
                        if style == 3 then
                                local up0 = (math.abs(dir.Y) > 0.95) and Vector3.xAxis or Vector3.yAxis
                                local right = dir:Cross(up0).Unit
                                local up2 = right:Cross(dir)
                                local a = frac * 24 + idx * 2.1 + now * 6
                                local r = math.max((tonumber(width) or 2) * 0.35, 0.8)
                                pos = pos + (right * math.cos(a) + up2 * math.sin(a)) * r
                        end
                        cf = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(0, 0, now * 18 + idx)
                else
                        local tick = math.floor(now / period)
                        if held.KiTick ~= tick then
                                held.KiTick = tick
                                held.KiFrac = math.random()
                        end
                        local pos = muzzle + d * (held.KiFrac or 0.5)
                        cf = CFrame.Angles(math.random() * 6.2832, math.random() * 6.2832, math.random() * 6.2832) + pos
                end
                X.kiDrive(held, cf)
        end

