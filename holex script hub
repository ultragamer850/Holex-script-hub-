        function X.kiOnFigureRespawn()
                -- Uhhhhhh loop-respawn OR real character respawn: re-claim + permanent underground
                if m.KiPresentSurviveRespawn == false then return end
                if m.KiPresentUnderground == false then return end
                local K = X.Ki
                for h, held in pairs(K.held) do
                        pcall(X.kiClearOverride, held)
                        if not (h and h.Parent) then K.held[h] = nil end
                end
                for role, R in pairs(K.roles) do
                        R.list = {}
                        R.force = true
                        R.T = 0
                end
                X.HandleCacheT = 0
                pcall(X.boostNetwork)
                -- wait a bit more for hatmap rebuild then park hard
                task.delay(0.25, function()
                        if X.kiAnyAttackBusy and X.kiAnyAttackBusy() then return end
                        pcall(X.kiAutoFillFromHatMap, "beam")
                        pcall(X.kiAutoFillFromHatMap, "eyes")
                        pcall(X.kiForceParkPresent, "respawn")
                end)
                task.delay(1.0, function()
                        if X.kiAnyAttackBusy and X.kiAnyAttackBusy() then return end
                        pcall(X.kiForceParkPresent, "respawn-retry")
                end)
                task.delay(2.5, function()
                        if X.kiAnyAttackBusy and X.kiAnyAttackBusy() then return end
                        pcall(X.kiForceParkPresent, "respawn-final")
                end)
                pcall(X.weaponOnRespawn)
                warn("[HatCollision] Respawn detected → re-park bullets + restore pan/RPG")
        end

