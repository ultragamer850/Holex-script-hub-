local function getEvent(name)
        local ok, ev = pcall(function()
                if string.find(name, "^Render") then return RunService.RenderStepped
                elseif string.find(name, "^Stepped") then return RunService.Stepped
                elseif string.find(name, "^Post") then return RunService.PostSimulation end
                return RunService.Heartbeat
        end)
        return ok and ev or RunService.Heartbeat
end

local function styleKind()
        if string.find(S.feStyle, "^Clone") then return "clone" end
        return "ghost"
end

local okOwn, isOwnerFn = pcall(function() return isnetworkowner end)
local function ownedByMe(part)
        if okOwn and isOwnerFn then
                local ok, r = pcall(isOwnerFn, part)
                if ok then return r end
        end
        return part.ReceiveAge == 0 and not part.Anchored
end

local WHITE = Color3.new(1, 1, 1)
local COL_YES, COL_NO = Color3.fromRGB(80, 255, 130), Color3.fromRGB(255, 80, 80)
local OWN_YES, OWN_NO = Color3.fromRGB(80, 170, 255), Color3.fromRGB(255, 160, 60)
local ARROW_ROTS = {
        CFrame.Angles(0, math.rad(150), 0), CFrame.Angles(0, -math.rad(150), 0),
        CFrame.Angles(math.rad(150), 0, 0), CFrame.Angles(-math.rad(150), 0, 0),
}

local feFolder, feConn, feLabel, feModel, feBill, feArrowFolder
local feOrig, feGhost, feSnaps, feArrows, feFade = {}, {}, {}, {}, {}
local feMap, feKeyOf = {}, {}
local feRoot, feLastSync, feKind, feToken = 1, 0, "ghost", 0
local feKeys = {}
local feTint = {on = false, dirty = false, saved = {}}

local function currentDelay()
        if S.feAuto then
                local ping = 0
                pcall(function() ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
                return math.clamp(ping / 2, 20, 1000) / 1000
        end
        return S.feDelay / 1000
end

local function destroyGhost()
        feToken += 1
        if feConn then feConn:Disconnect(); feConn = nil end
        if feFolder then feFolder:Destroy(); feFolder = nil end
        feOrig, feGhost, feSnaps, feArrows, feFade = {}, {}, {}, {}, {}
        feMap, feKeyOf = {}, {}
        feTint.on, feTint.dirty, feTint.saved = false, false, {}
        feLabel, feModel, feBill, feArrowFolder, feRoot = nil, nil, nil, nil, 1
        feKeys = {}
end

local function relKey(inst, root)
        local k, p = inst.Name, inst.Parent
        while p and p ~= root do k = p.Name .. "/" .. k; p = p.Parent end
        return k
end

local function stripCommon(root)
        for _, d in ipairs(root:GetDescendants()) do
                -- effects (Trail, Beam, ParticleEmitter, Fire, Smoke, Sparkles, lights) are KEPT so hats with trails still show them on the clone
                if d:IsA("BaseScript") or d:IsA("Sound") or d:IsA("ForceField") or d:IsA("Highlight")
                        or d:IsA("BillboardGui") or d:IsA("Animator") then
                        d:Destroy()
                elseif d:IsA("Humanoid") then
                        d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                        d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                end
        end
end

local function freeze(part)
        part.Anchored = true
        part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.CastShadow = false; part.Massless = true
end

-- single-part copy. look=false -> plain white shape (Ghost), look=true -> keeps colors/decals (Clone fallback)
local function makeGhostPart(orig, look)
        local was = orig.Archivable
        orig.Archivable = true
        local g = orig:Clone()
        orig.Archivable = was
        if not g then return nil end
        for _, c in ipairs(g:GetDescendants()) do
                if c:IsA("DataModelMesh") then
                        if not look then
                                if c:IsA("SpecialMesh") then c.TextureId = "" end
                                c.VertexColor = Vector3.new(1, 1, 1)
                        end
                elseif look and (c:IsA("Decal") or c:IsA("Texture") or c:IsA("SurfaceAppearance")
                        or c:IsA("Attachment") or c:IsA("Trail") or c:IsA("Beam") or c:IsA("ParticleEmitter")
                        or c:IsA("Fire") or c:IsA("Smoke") or c:IsA("Sparkles") or c:IsA("Light")) then
                        -- keep (Clone look keeps the hat effects)
                else
                        c:Destroy()
                end
        end
        if look then
                -- trails / beams must point at attachments that live inside this copy, not at the real hat
                for _, c in ipairs(g:GetDescendants()) do
                        if c:IsA("Trail") or c:IsA("Beam") then
                                if not (c.Attachment0 and c.Attachment1 and c.Attachment0:IsDescendantOf(g) and c.Attachment1:IsDescendantOf(g)) then
                                        c:Destroy()
                                end
                        end
                end
        end
        g.Name = orig.Name
        freeze(g)
        if not look then
                g.Color = WHITE
                g.Material = Enum.Material.SmoothPlastic
                if g:IsA("MeshPart") then g.TextureID = "" end
        end
        g.CFrame = orig.CFrame
        return g
end

local function arrowPart()
        return make("Part", {Size = Vector3.new(0.12, 0.12, 0.5), Anchored = true, CanCollide = false, CanTouch = false,
                CanQuery = false, CastShadow = false, Material = Enum.Material.Neon, Color = WHITE, Transparency = 1}, feArrowFolder)
end

local function drawArrow(key, orig, startPos)
        local arr = feArrows[key]
        if not S.feVel then
                if arr then for k = 1, 5 do arr[k].Transparency = 1 end end
                return
        end
        if not arr then
                arr = {}
                for k = 1, 5 do arr[k] = arrowPart() end
                feArrows[key] = arr
        end
        local vel = orig.AssemblyLinearVelocity
        local m = vel.Magnitude
        if m <= 1 then
                for k = 1, 5 do arr[k].Transparency = 1 end
                return
        end
        local dir = vel.Unit
        local up = math.abs(dir.Y) > 0.99 and Vector3.xAxis or Vector3.yAxis
        local len = math.clamp(m * 0.25, 0.4, 14)
        local tip = startPos + dir * len
        arr[1].Size = Vector3.new(0.12, 0.12, len)
        arr[1].CFrame = CFrame.lookAt(startPos + dir * (len / 2), tip, up)
        local hs = S.feArrow
        local base = CFrame.lookAt(tip, tip + dir, up)
        for k = 1, 4 do
                arr[k + 1].Size = Vector3.new(0.12, 0.12, hs)
                arr[k + 1].CFrame = base * ARROW_ROTS[k] * CFrame.new(0, 0, -hs / 2)
        end
        for k = 1, 5 do arr[k].Transparency = 0.1 end
end

-- Clone + highlight: textures, clothes and vertex colors hide the highlight colors, so while a
-- highlight (CanCollide / Ownership) is on we temporarily strip them from the copy and restore after.
local function applyTint(on)
        if not feModel then return end
        if on then
                for _, d in ipairs(feModel:GetDescendants()) do
                        if not feTint.saved[d] then
                                if d:IsA("MeshPart") then
                                        feTint.saved[d] = {{"TextureID", d.TextureID}}
                                        d.TextureID = ""
                                elseif d:IsA("SpecialMesh") then
                                        feTint.saved[d] = {{"TextureId", d.TextureId}, {"VertexColor", d.VertexColor}}
                                        d.TextureId = ""
                                        d.VertexColor = Vector3.new(1, 1, 1)
                                elseif d:IsA("SurfaceAppearance") or d:IsA("Clothing") or d:IsA("ShirtGraphic") or d:IsA("CharacterMesh") then
                                        feTint.saved[d] = {{"Parent", d.Parent}}
                                        d.Parent = nil
                                end
                        end
                end
        else
                for inst, props in pairs(feTint.saved) do
                        for _, pv in ipairs(props) do pcall(function() inst[pv[1]] = pv[2] end) end
                end
                feTint.saved = {}
        end
        feTint.on = on
        feTint.dirty = false
end

-- builds the Ghost / Clone parts (rebuilt automatically if your parts change)
local function rebuildParts()
        local char = LP.Character
        if not char or not feModel then return end
        for _, c in ipairs(feModel:GetChildren()) do c:Destroy() end
        feArrowFolder:ClearAllChildren()
        feOrig, feGhost, feSnaps, feArrows, feFade, feRoot = {}, {}, {}, {}, {}, 1
        feMap, feKeyOf = {}, {}
        feTint.on, feTint.saved = false, {}

        local parts = {}
        for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then parts[#parts + 1] = d end
        end

        local cloneMap
        if feKind == "clone" then
                local was = char.Archivable
                char.Archivable = true
                local cm = char:Clone()
                char.Archivable = was
                if cm then
                        stripCommon(cm)
                        cloneMap = {}
                        local counts = {}
                        for _, d in ipairs(cm:GetDescendants()) do
                                if d:IsA("BasePart") then
                                        freeze(d)
                                        local k = relKey(d, cm)
                                        counts[k] = (counts[k] or 0) + 1
                                        cloneMap[k .. "#" .. counts[k]] = d
                                end
                        end
                        cm.Name = "HolexClone"
                        cm.Parent = feModel
                end
        end

        local counts = {}
        feKeys = {}
        for _, part in ipairs(parts) do
                local g
                local k = relKey(part, char)
                counts[k] = (counts[k] or 0) + 1
                local fullKey = k .. "#" .. counts[k]
                if cloneMap then g = cloneMap[fullKey] end
                if not g then
                        g = makeGhostPart(part, feKind == "clone")
                        if g then g.Parent = feModel end
                end
                if g then
                        feOrig[#feOrig + 1] = part
                        feGhost[#feGhost + 1] = g
                        feKeys[#feOrig] = fullKey
                        feMap[part] = g
                        feKeyOf[part] = fullKey
                        if part.Name == "HumanoidRootPart" then feRoot = #feOrig end
                end
        end

        if feKind == "clone" then
                for _, d in ipairs(feModel:GetDescendants()) do
                        if d:IsA("Decal") or d:IsA("Texture") then
                                feFade[#feFade + 1] = {i = d, base = d.Transparency, part = d.Parent}
                        end
                end
        end
        if feBill then feBill.Adornee = feGhost[feRoot] end
end

local function syncGhost()
        local char = LP.Character
        if not char or not feModel then return end
        local list, present, changed = {}, {}, false
        for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") then
                        list[#list + 1] = d
                        present[d] = true
                        if not feMap[d] then changed = true end
                end
        end
        for p in pairs(feMap) do
                if not present[p] then changed = true; break end
        end
        if not changed then return end

        -- Ghost style or first build: full rebuild
        if feKind ~= "clone" or #feOrig == 0 then rebuildParts(); return end

        -- Clone style: incremental, so effect hats keep their live trails / particles
        for p, g in pairs(feMap) do
                if not present[p] then
                        if g and g.Parent then g:Destroy() end
                        feMap[p] = nil; feKeyOf[p] = nil
                        local arr = feArrows[p]
                        if arr then for _, a in ipairs(arr) do a:Destroy() end; feArrows[p] = nil end
                end
        end
        for _, p in ipairs(list) do
                if not feMap[p] then
                        local g = makeGhostPart(p, true)
                        if g then
                                g.Parent = feModel
                                feMap[p] = g
                                for _, d in ipairs(g:GetDescendants()) do
                                        if d:IsA("Decal") or d:IsA("Texture") then
                                                feFade[#feFade + 1] = {i = d, base = d.Transparency, part = g}
                                        end
                                end
                        end
                end
        end
        for i = #feFade, 1, -1 do
                if not feFade[i].i.Parent then table.remove(feFade, i) end
        end
        feOrig, feGhost, feRoot = {}, {}, 1
        for _, p in ipairs(list) do
                local g = feMap[p]
                if g then
                        feOrig[#feOrig + 1] = p
                        feGhost[#feGhost + 1] = g
                        if p.Name == "HumanoidRootPart" then feRoot = #feOrig end
                end
        end
        feTint.dirty = true
        if feBill then feBill.Adornee = feGhost[feRoot] end
end

-- real server data (needs HolexServerView.server.lua in the game's ServerScriptService)
local srv = {conn = nil, keys = nil, data = nil}
local function srvDisconnect()
        if srv.conn then srv.conn:Disconnect(); srv.conn = nil end
        srv.keys, srv.data = nil, nil
end
local function srvConnect()
        srvDisconnect()
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("HolexServerView")
        if not remote or not remote:IsA("RemoteEvent") then return false end
        srv.conn = remote.OnClientEvent:Connect(function(t, keys, cfs)
                if keys then srv.keys = keys end
                if not srv.keys or type(cfs) ~= "table" then return end
                local map = {}
                for i, k in ipairs(srv.keys) do map[k] = cfs[i] end
                srv.data = {t = t, at = os.clock(), map = map}
        end)
        return true
end

local feLastStep = os.clock()
local function step()
        if not feModel then return end
        local now = os.clock()
        local dt = math.clamp(now - feLastStep, 0, 0.1)
        feLastStep = now

        if now - feLastSync > ((feKind == "clone") and 0.12 or 0.4) then feLastSync = now; syncGhost() end
        if #feOrig == 0 then return end

        local snap = {t = now}
        for _, part in ipairs(feOrig) do snap[part] = part.CFrame end
        feSnaps[#feSnaps + 1] = snap

        local delay = currentDelay()
        local target = now - delay
        while #feSnaps > 2 and feSnaps[2].t <= target do table.remove(feSnaps, 1) end
        local a, b = feSnaps[1], feSnaps[2]
        local alpha = 0
        if b and b.t > a.t then alpha = math.clamp((target - a.t) / (b.t - a.t), 0, 1) end

        local useReal = S.feReal and srv.data and (now - srv.data.at) < 1
        local smooth = 1 - math.exp(-dt * 20)

        local offset = (FEModes[S.feMode] or Vector3.zero) * S.feDist
        local rootOnly = S.feVis == "Root only"
        local opacity = (tonumber(string.match(S.feVis, "(%d+)%%")) or 50) / 100

        local wantTint = feKind == "clone" and (S.feOwner or S.feCollide) and true or false
        if wantTint ~= feTint.on or (wantTint and feTint.dirty) then applyTint(wantTint) end

        local execMode = S.feExec and not useReal
        local ownedN, totalN = 0, 0
        local ghostRootPos
        for i, gp in ipairs(feGhost) do
                local orig = feOrig[i]

                -- where the copy goes: real server CFrame if we have one, else the delayed replay
                local srvCF = useReal and feKeyOf[orig] and srv.data.map[feKeyOf[orig]]
                local cf
                if srvCF then
                        local cur = gp:GetAttribute("HolexReal") and (gp.CFrame - offset) or srvCF
                        cf = cur:Lerp(srvCF, smooth)
                        gp:SetAttribute("HolexReal", true)
                else
                        gp:SetAttribute("HolexReal", nil)
                        local mine = true
                        if execMode then
                                mine = ownedByMe(orig)
                                totalN += 1
                                if mine then ownedN += 1 end
                        end
                        if not mine then
                                -- you do not own this part: what your client shows IS what the server sent, so no delay
                                cf = orig.CFrame
                        else
                        cf = a[orig] and ((b and b[orig]) and a[orig]:Lerp(b[orig], alpha) or a[orig]) or orig.CFrame
                        end
                end
                gp.CFrame = cf + offset
                if i == feRoot then ghostRootPos = cf.Position end

                gp.Transparency = rootOnly and ((i == feRoot) and 0.5 or 1) or (1 - (1 - orig.Transparency) * opacity)
                local col
                if S.feOwner then col = ownedByMe(orig) and OWN_YES or OWN_NO
                elseif S.feCollide then col = orig.CanCollide and COL_YES or COL_NO
                else col = (feKind == "clone") and orig.Color or WHITE end
                gp.Color = col
                drawArrow(orig, orig, gp.Position)
        end
        for _, it in ipairs(feFade) do
                it.i.Transparency = (feTint.on or rootOnly) and ((not feTint.on and it.part == feGhost[feRoot]) and it.base or 1) or (1 - (1 - it.base) * opacity)
        end

        if feLabel and ghostRootPos then
                local me = feOrig[feRoot].Position
                local head
                if useReal then
                        local age = math.max(0, workspace:GetServerTimeNow() - srv.data.t)
                        head = string.format("SERVER (REAL)  %dms old", math.floor(age * 1000 + 0.5))
                elseif execMode then
                        head = string.format("SERVER (EXECUTOR)  ~%dms  |  you own %d/%d parts", math.floor(delay * 1000 + 0.5), ownedN, totalN)
                else
                        head = string.format("FE delayed ~%dms (estimate)", math.floor(delay * 1000 + 0.5))
                end
                if S.feMode == "I just wanna know the positions." then
                        feLabel.Text = string.format("%s\nYou %.1f, %.1f, %.1f\nServer %.1f, %.1f, %.1f", head, me.X, me.Y, me.Z, ghostRootPos.X, ghostRootPos.Y, ghostRootPos.Z)
                else
                        feLabel.Text = string.format("%s  |  off by %.1f studs", head, (me - ghostRootPos).Magnitude)
                end
        end
end

local function connectStep()
        if feConn then feConn:Disconnect() end
        feConn = getEvent(S.feEvent):Connect(step)
end

local function buildGhost()
        destroyGhost()
        if not LP.Character then return end
        feKind = styleKind()

        feFolder = Instance.new("Folder")
        feFolder.Name = "HolexServerView"
        feFolder.Parent = workspace
        feModel = Instance.new("Model")
        feModel.Name = "HolexView"
        feModel.Parent = feFolder
        feArrowFolder = Instance.new("Folder")
        feArrowFolder.Name = "Arrows"
        feArrowFolder.Parent = feFolder

        if feKind == "ghost" then
                make("Highlight", {Adornee = feModel, FillColor = WHITE, FillTransparency = 0.9,
                        OutlineColor = WHITE, OutlineTransparency = 0.25,
                        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop}, feFolder)
        end

        feBill = make("BillboardGui", {Size = UDim2.fromOffset(280, 38), StudsOffset = Vector3.new(0, 4.5, 0), AlwaysOnTop = true}, feFolder)
        feLabel = make("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = WHITE,
                TextStrokeTransparency = 0.4, TextWrapped = true, Text = "SERVER VIEW"}, feBill)

        feLastSync = os.clock()
        rebuildParts()
        connectStep()
end

local function applyFE(v)
        S.fe = v
        if v then buildGhost() else destroyGhost() end
        pcall(Hooks.OnFE, v)
end

-- void level plane (works with or without the ghost)
local voidConn, voidPart
local function setVoid(v)
        S.feVoid = v
        if voidConn then voidConn:Disconnect(); voidConn = nil end
        if voidPart then voidPart:Destroy(); voidPart = nil end
        if not v then return end
        voidPart = make("Part", {Name = "HolexVoidLevel", Size = Vector3.new(4096, 0.3, 4096), Anchored = true, CanCollide = false,
                CanTouch = false, CanQuery = false, CastShadow = false, Material = Enum.Material.SmoothPlastic,
                Color = Color3.fromRGB(255, 60, 60), Transparency = 0.8}, workspace)
        local bb = make("BillboardGui", {Size = UDim2.fromOffset(240, 22), AlwaysOnTop = true, StudsOffset = Vector3.new(0, 3, 0)}, voidPart)
        local lbl = make("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
                TextSize = 12, TextColor3 = Color3.fromRGB(255, 120, 120), TextStrokeTransparency = 0.4, Text = "VOID"}, bb)
        voidConn = RunService.Heartbeat:Connect(function()
                local y = -500
                pcall(function() y = workspace.FallenPartsDestroyHeight end)
                local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                local x, z = root and root.Position.X or 0, root and root.Position.Z or 0
                voidPart.CFrame = CFrame.new(x, y, z)
                lbl.Text = string.format("VOID  y = %d%s", y, root and string.format("  |  %.0f studs below you", root.Position.Y - y) or "")
        end)
end

