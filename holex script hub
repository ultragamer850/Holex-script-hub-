        local function finiteCF(cf)
                local p, l, u = cf.Position, cf.LookVector, cf.UpVector
                local s = p.X + p.Y + p.Z + l.X + l.Y + l.Z + u.X + u.Y + u.Z
                return s == s and math.abs(s) < 1e6
        end
        local function ssmooth(x)
                x = math.clamp(x, 0, 1)
