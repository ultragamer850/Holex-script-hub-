        function X.panFindVictim()
                -- prefer world-held NPC, else nearest NPC in range
                if X.WorldHold and X.WorldHold.model then
                        return X.WorldHold.model, X.WorldHold.part
                end
                if X.WorldHoldList and #X.WorldHoldList > 0 then
                        local g = X.WorldHoldList[#X.WorldHoldList]
                        if g and g.model then return g.model, g.part end
                end
                local root = X.getMyHRP()
                if not root then return nil end
                local range = tonumber(m.PanRange) or 12
                local best, bestD, bestP = nil, range, nil
                for _, inst in ipairs(Workspace:GetChildren()) do
                        if inst:IsA("Model") and inst ~= X.getMyCharacter() and inst ~= LocalPlayer.Character then
                                if not Players:GetPlayerFromCharacter(inst) then
                                        local hum = inst:FindFirstChildOfClass("Humanoid")
                                        local hrp = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart
                                        if hum and hrp and hum.Health > 0 then
                                                local d = (hrp.Position - root.Position).Magnitude
                                                if d < bestD then best, bestD, bestP = inst, d, hrp end
                                        end
                                end
                        end
                end
                return best, bestP
        end

