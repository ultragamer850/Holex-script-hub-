        elseif k == "muted" then return t.sub end
end })
UI.COL = COL

local accent = { Theme.accent, Theme.accent }

local function new(class, props, parent)
        local i = Instance.new(class)
        if props then
                for k, v in pairs(props) do i[k] = v end
        end
        if parent then i.Parent = parent end
        return i
end
local function corner(p, r) return new("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function pad(p, l, t, r, b)
        l, t = l or 0, t or 0
        return new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t),
                PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t) }, p)
end
local function list(p, gap, dir)
        return new("UIListLayout", { Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder,
                FillDirection = dir or Enum.FillDirection.Vertical }, p)
end
local function tween(inst, t, props, style)
        pcall(function()
                TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
        end)
end
-- hub-bound builders (colours are registered with the hub so a theme change recolours them)
local function hstroke(p, key, th, tr)
        local s = new("UIStroke", { Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
        hubBind(s, "Color", key or "stroke")
        return s
end
local function hlabel(parent, text, size, key, font, props)
        local l = new("TextLabel", {
                BackgroundTransparency = 1, Text = tostring(text), TextSize = size or 13, Font = font or F_REG,
                TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, (size or 13) + 4),
        }, parent)
        if props then for k, v in pairs(props) do l[k] = v end end
        hubBind(l, "TextColor3", key or "text")
        return l
end
-- compatibility: callers that pass a COL colour still get a theme-bound label
local function label(parent, text, size, color, font, props)
        local key = "text"
        if color == Theme.sub then key = "sub" elseif color == Theme.accent then key = "accent" end
        return hlabel(parent, text, size, key, font, props)
end
UI.new, UI.corner, UI.pad, UI.list, UI.tween, UI.label = new, corner, pad, list, tween, label

