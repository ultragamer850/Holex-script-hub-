        -- ground point under the figure (+ the part it hit, for rock colour)
        function X.puGround(root)
                local pos = root.Position - Vector3.new(0, 3, 0)
                local inst = nil
                pcall(function()
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        local ex = {}
                        local fig = X.getMyCharacter()
                        if fig then ex[#ex + 1] = fig end
                        if LocalPlayer.Character then ex[#ex + 1] = LocalPlayer.Character end
                        rp.FilterDescendantsInstances = ex
                        local res = Workspace:Raycast(root.Position, Vector3.new(0, -14, 0), rp)
                        if res then
                                pos = res.Position
                                inst = res.Instance
                        end
                end)
                return pos, inst
        end

