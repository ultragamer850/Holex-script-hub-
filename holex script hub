        --------------------------------------------------------------
        -- damage + push along a beam / laser
        --------------------------------------------------------------
        function X.kiDamage(origin, target, width, dmg, pushMul)
                local d = target - origin
                local len = d.Magnitude
                if len < 1 then return end
                local dir = d.Unit
                local cf = CFrame.lookAt(origin + d * 0.5, target)
                local op = OverlapParams.new()
                op.FilterType = Enum.RaycastFilterType.Exclude
                op.FilterDescendantsInstances = X.kiExclude()
                op.MaxParts = 250
                local ok, parts = pcall(function()
                        return Workspace:GetPartBoundsInBox(cf, Vector3.new(width, width, len), op)
                end)
                if not ok or type(parts) ~= "table" then return end
                local doDmg = m.CombatDamage ~= false and (tonumber(dmg) or 0) > 0
                local doFling = m.CombatFling ~= false
                local seen = {}
                for _, p in ipairs(parts) do
                        if p:IsA("BasePart") then
                                local model = p:FindFirstAncestorOfClass("Model")
                                local hum = model and model:FindFirstChildOfClass("Humanoid")
                                if hum then
                                        if not seen[model] then
                                                local isPlr = Players:GetPlayerFromCharacter(model) ~= nil
                                                if not (isPlr and m.CombatHitPlayers == false) then
                                                        local hrp = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
                                                        if not (m.CombatOnlyOwned and hrp and not X.partOwner(hrp)) then
                                                                seen[model] = true
                                                                if doDmg then
                                                                        X.combatHurtHumanoid(hum, math.floor(dmg * X.powerMult() + 0.5))
                                                                end
                                                                if doFling and hrp and not hrp.Anchored then
                                                                        pcall(function()
                                                                                hrp.AssemblyLinearVelocity = dir * 70 * pushMul + Vector3.new(0, 18 * pushMul, 0)
                                                                        end)
                                                                end
                                                        end
                                                end
                                        end
                                elseif doFling and not p.Anchored and not X.isPlayerPart(p) then
                                        pcall(function()
                                                p.AssemblyLinearVelocity = dir * 90 * pushMul + Vector3.new(0, 10 * pushMul, 0)
                                        end)
                                end
                        end
                end
        end

