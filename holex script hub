        -- 0..1 intensity of the aura for the current phase
        function X.puLevel(now)
                local ph = X.PUPhase
                if ph == "charge" then
                        local p = math.clamp((now - X.PUT0) / math.max(X.PUDur, 0.1), 0, 1)
                        return 0.12 + 0.78 * p * p, ph
                elseif ph == "burst" then
                        return 1, ph
                elseif ph == "on" then
                        return 0.7, ph
                end
                return 0, ph
        end

        function X.puFxStep(dt, now)
                local fx = X.PUFx
                local ph = X.PUPhase
                if not fx or not ph then return end
                local lvl = X.puLevel(now)
                local pulse = 0.5 + 0.5 * math.sin(now * 14)
                local rs = math.sqrt(math.clamp(tonumber(m.PowerUpAuraSize) or 1, 0.2, 5))
                local boost = 1
                if ph == "burst" then
                        boost = 1 + 2 * (1 - math.clamp((now - X.PUBurstT0) / 0.5, 0, 1))
                end
                for _, rec in ipairs(fx.emitters or {}) do
                        if rec.e and rec.e.Parent then
                                rec.e.Rate = rec.base * lvl * boost * (0.8 + 0.4 * pulse) * rs
                        end
                end
                if fx.light and fx.light.Parent then
                        fx.light.Brightness = lvl * boost * (3 + 5 * pulse)
                end
                if fx.glow and fx.glow.Parent then
                        fx.glow.FillTransparency = 1 - 0.45 * lvl * (0.6 + 0.4 * pulse)
                        fx.glow.OutlineTransparency = 1 - 0.8 * lvl
                end
                -- the figure got replaced (respawn / re-reanimate): rebuild the aura on the new one
                if ph == "on" and m.PowerUpAuraFX ~= false and (not fx.chest or not fx.chest.Parent) and now - (X.PUFxRetryT or 0) > 1 then
                        X.PUFxRetryT = now
                        pcall(X.puFxBuild, true)
                        return
                end
                -- rocks lift during the charge, then blast outward on the burst
                local rocks = X.PURocks
                if rocks and #rocks > 0 then
                        for i = #rocks, 1, -1 do
                                local r = rocks[i]
                                local part = r.part
                                if not (part and part.Parent) then
                                        table.remove(rocks, i)
                                elseif ph == "charge" then
                                        local e = ssmooth((now - X.PUT0) / math.max(X.PUDur, 0.1))
                                        local pos = r.base + Vector3.new(0, r.h * e + math.sin(now * r.bob + r.ph) * 0.2 - r.sz * (1 - e), 0)
                                        part.CFrame = CFrame.new(pos) * CFrame.Angles(r.spin.X * now * e, r.spin.Y * now * e, r.spin.Z * now * e)
                                else
                                        if not r.fly then
                                                r.fly = true
                                                r.t0 = now
                                                r.pos = part.Position
                                                local out = r.base - (X.PUCenter or r.base)
                                                out = Vector3.new(out.X, 0, out.Z)
                                                if out.Magnitude < 0.1 then out = Vector3.new(math.random() - 0.5, 0, math.random() - 0.5) end
                                                r.v = out.Unit * (14 + math.random() * 16) + Vector3.new(0, 14 + math.random() * 14, 0)
                                        end
                                        r.v = r.v + Vector3.new(0, -70 * dt, 0)
                                        r.pos = r.pos + r.v * dt
                                        local age = now - r.t0
                                        local rot = part.CFrame - part.CFrame.Position
                                        part.CFrame = CFrame.new(r.pos) * rot * CFrame.Angles(dt * 3, dt * 2, dt * 4)
                                        if age > 1.4 then part.Transparency = math.clamp((age - 1.4) / 0.4, 0, 1) end
                                        if age > 1.9 then
                                                pcall(function() part:Destroy() end)
                                                table.remove(rocks, i)
                                        end
                                end
                        end
                end
                -- camera shake
                if m.PowerUpCamShake ~= false then
                        local amp = 0
                        if ph == "charge" then
                                local p = math.clamp((now - X.PUT0) / math.max(X.PUDur, 0.1), 0, 1)
                                amp = 0.03 + 0.22 * p
                        elseif ph == "burst" then
                                amp = 0.6 * (1 - math.clamp((now - X.PUBurstT0) / 0.9, 0, 1))
                        end
                        amp = amp * (tonumber(m.PowerUpCamShakeAmt) or 1)
                        if amp > 0.003 then
                                X.puCamOffset(Vector3.new((math.random() - 0.5) * amp * 2, (math.random() - 0.5) * amp * 2, 0))
                        else
                                X.puCamRestore()
                        end
                end
        end

