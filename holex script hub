function UI.Text(parent, text, size, align)
        local t = tostring(text or "")
        local inner = string.match(t, "^──%s*(.-)%s*──$")
        if inner then
                local pageName = UI.pageFor(inner)
                -- merge sections that belong together into one card per page title
                local body, info = UI.newCard(pageName, inner, true)
                if body then
                        UI.curBody = body
                        UI.cfgCards[#UI.cfgCards + 1] = info
                end
                return {}
        end
        if size and size >= 18 then return {} end
        return UI._text(UI.cur(), t, size, align)
end
function UI.Switch(parent, text, default) return UI._switch(UI.cur(), text, default) end
function UI.Slider(parent, text, value, a, b, step) return UI._slider(UI.cur(), text, value, a, b, step) end
function UI.Dropdown(parent, text, options, start) return UI._dropdown(UI.cur(), text, options, start) end
function UI.Button(parent, text, size) return UI._button(UI.cur(), text, size) end
function UI.Separator(parent) return UI._sep(UI.cur()) end


