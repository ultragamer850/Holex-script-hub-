local function Slider(parent, text, min, max, default, fmt, cb)
        local pkey = persistKey(text)
        local savedV = pkey and Persist.data[pkey]
        local hasSaved = type(savedV) == "number"
        if hasSaved then
                savedV = math.clamp(savedV, min, max)
                default = savedV
                Persist.pending[#Persist.pending + 1] = function() cb(savedV) end
        end
        local row = frame(parent, "card", UDim2.new(1, 0, 0, 62)); corner(row, 10); stroke(row)
        label(row, text, 14, "text", Enum.Font.GothamMedium, {Position = UDim2.fromOffset(14, 9), Size = UDim2.new(1, -100, 0, 18)})
        local val = label(row, "", 12, "sub", Enum.Font.GothamBold, {Position = UDim2.new(1, -84, 0, 10), Size = UDim2.fromOffset(70, 16), TextXAlignment = Enum.TextXAlignment.Right})
        local track = make("TextButton", {Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 44), Text = "", AutoButtonColor = false, BorderSizePixel = 0}, row)
        bind(track, "BackgroundColor3", "hover"); circle(track)
        local fill = make("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0}, track)
        bind(fill, "BackgroundColor3", "accent"); circle(fill)
        local knob = make("Frame", {Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BorderSizePixel = 0}, track)
        bind(knob, "BackgroundColor3", "accent"); circle(knob)
        local function set(a, instant, silent)
                a = math.clamp(a, 0, 1)
                local v = min + (max - min) * a
                val.Text = string.format(fmt, v)
                local t = instant and 0 or 0.12
                tw(fill, t, {Size = UDim2.fromScale(a, 1)}, Enum.EasingStyle.Quad)
                tw(knob, t, {Position = UDim2.fromScale(a, 0.5)}, Enum.EasingStyle.Quad)
                if not silent then cb(v) end
                if not instant then persistSet(pkey, v) end
        end
        set((default - min) / (max - min), true, hasSaved)
        local dragging = false
        local function fromInput(i) set((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X) end
        track.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                        dragging = true; fromInput(i); tw(knob, 0.2, {Size = UDim2.fromOffset(18, 18)}, Enum.EasingStyle.Back)
                end
        end)
        UIS.InputChanged:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromInput(i) end
        end)
        UIS.InputEnded:Connect(function(i)
                if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false; tw(knob, 0.25, {Size = UDim2.fromOffset(14, 14)}, Enum.EasingStyle.Back)
                end
        end)
        return row
end

