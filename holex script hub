local function tw(o, t, props, style, dir)
        local tween = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
        tween:Play()
        return tween
end

local function make(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props or {}) do o[k] = v end
        if parent then o.Parent = parent end
        return o
end

local function corner(o, r) return make("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function circle(o) return make("UICorner", {CornerRadius = UDim.new(1, 0)}, o) end

local function stroke(o, key, th, tr)
        local s = make("UIStroke", {Thickness = th or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
        bind(s, "Color", key or "stroke")
        return s
end

local function pad(o, l, t, r, b)
        return make("UIPadding", {PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t)}, o)
end

local function label(parent, text, size, key, font, props)
        local l = make("TextLabel", {
                BackgroundTransparency = 1, Text = text, TextSize = size, Font = font or Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, size + 4),
        }, parent)
        for k, v in pairs(props or {}) do l[k] = v end
        bind(l, "TextColor3", key or "text")
        return l
end

local function frame(parent, key, size, pos, props)
        local f = make("Frame", {Size = size or UDim2.fromScale(1, 1), Position = pos or UDim2.new(), BorderSizePixel = 0}, parent)
        for k, v in pairs(props or {}) do f[k] = v end
        if key then bind(f, "BackgroundColor3", key) else f.BackgroundTransparency = 1 end
        return f
end

