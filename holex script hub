                                if ext == "gif" then
                                        local gpath = cachePath("boot_media.gif")
                                        local gok = false
                                        pcall(function() gok = isfile(gpath) and X.GifMagicOk and X.GifMagicOk(gpath) end)
                                        if not gok then
                                                local body = httpGet(url)
                                                if not body or body:sub(1, 3) ~= "GIF" then log("FAIL  gif media download failed", "bad") return end
                                                pcall(writefile, gpath, body)
                                        end
                                        local fdir = cachePath("boot_media_frames")
                                        local n = X.GifFramesCached and X.GifFramesCached(gpath, fdir) or nil
                                        if not n then
                                                local okd, res = X.GifToFrames(gpath, fdir, {maxFrames = 80, progress = function(i, tot) log("..    decoding gif frame " .. i .. "/" .. tostring(tot or "?")) end})
                                                if not okd then log("FAIL  gif could not be decoded (" .. tostring(res) .. ")", "bad") return end
                                                n = res
                                        end
                                        local ids = {}
                                        pcall(function()
                                                local lf = (listfiles and listfiles(fdir)) or {}
                                                table.sort(lf)
                                                for _, f in ipairs(lf) do
                                                        if (f:match("%.(%w+)$") or ""):lower() == "png" then
                                                                local o, id = pcall(customAsset, f)
                                                                if o and id then ids[#ids + 1] = id end
                                                        end
                                                end
                                        end)
                                        if #ids == 0 then log("FAIL  gif frames could not be loaded", "bad") return end
                                        -- use the gif's own speed (average delay from delays.txt)
                                        local fps = 10
                                        pcall(function()
                                                if isfile(cachePath("boot_media_frames/delays.txt")) then
                                                        local sum, cnt = 0, 0
                                                        for v in (readfile(cachePath("boot_media_frames/delays.txt")) .. ","):gmatch("([%d%.]+)") do sum += tonumber(v); cnt += 1 end
                                                        if cnt > 0 then fps = math.clamp(100 / (sum / cnt), 2, 20) end
                                                end
                                        end)
                                        local holder = mkHolder()
                                        local img = make("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = ids[1], ScaleType = Enum.ScaleType.Crop}, holder)
                                        animFn = function(t)
                                                img.Image = ids[math.floor(t * fps) % #ids + 1]
                                        end
                                        log("OK    gif decoded into " .. #ids .. " frames and playing", "ok")
                                        return
                                end
                                file = "boot_media." .. (ext ~= "" and ext or "bin")
                                path = cachePath(file)
                                pcall(function() have = isfile(path) end)
                                if not have then
                                        local body = httpGet(url)
                                        if not body then log("FAIL  media download failed", "bad") return end
                                        pcall(writefile, path, body)
                                end
                        else
                                if Boot.EMBED_WEBM == "" then return end
                                ext, file = "webm", "boot_media.webm"
                                path = cachePath(file)
                                pcall(function() have = isfile(path) end)
                                if not have then
                                        local okw = pcall(writefile, path, b64decode(Boot.EMBED_WEBM))
