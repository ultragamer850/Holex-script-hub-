        local function ringAsset()
                local want = V.get("ringtone", "Default ring")
                for _, r in ipairs(N.ringtones) do
                        if r[1] == want then
                                if r[2]:find("^https?://") then
                                        if not (hasFS and type(getcustomasset) == "function") then return N.ringtones[1][2] end
                                        local path = V.F.ringtones .. "/" .. r[1]:gsub("[^%w]", "_") .. ".mp3"
                                        local ok, id = pcall(function() if not isfile(path) then V.write(path, game:HttpGet(r[2])) end return getcustomasset(path) end)
                                        return ok and id or N.ringtones[1][2]
                                end
                                return r[2]
                        end
                end
                return N.ringtones[1][2]
        end
        function Call.ringing(on)
                if Call.ring then pcall(function() Call.ring:Stop(); Call.ring:Destroy() end); Call.ring = nil end
                if not on then return end
                task.spawn(function()
                        local id = ringAsset()
                        if Call.ring then return end
                        local s = Instance.new("Sound")
                        s.Name = "HolexRingtone"; s.SoundId = id; s.Volume = 0.7; s.Looped = true; s.Parent = SoundService
                        Call.ring = s; s:Play()
                        task.delay(45, function() if Call.ring == s then Call.ringing(false) end end)
                end)
        end
        local function signal(kind, to, extra)
                return post(N.topicRT, table.concat({"call", kind, Call.id or "x", me(), to, Call.discord or "", tostring(os.time()), extra or ""}, "|"), "call")
        end
        function Call.status(msg) Notify("Voice call", msg, 4); V.info("VOICE", msg) if N.onCall then N.onCall() end end
        function Call.start(target, isGroup)
                if Call.active then return false, "Already in a call - hang up first" end
                target = tostring(target or ""):match("^%s*(.-)%s*$") or ""
                if target == "" then return false, "No target" end
                local people, discord = {}, V.get("discordLink", "")
                if isGroup then
                        local g = N.groups()[target]
                        if not g then return false, "Group not found" end
                        for _, m in ipairs(g.members) do if lower(m) ~= lower(me()) then people[#people + 1] = m end end
                        if g.discord and g.discord ~= "" then discord = g.discord end
                else
                        people = {target}
                end
                Call.active, Call.isGroup, Call.target, Call.people = true, isGroup and true or false, target, people
                Call.id = "call_" .. LP.UserId .. "_" .. os.time()
                Call.started, Call.discord = os.time(), discord
                for _, who in ipairs(people) do signal("invite", who, isGroup and N.groups()[target].name or "") end
                Call.ringing(true)
                task.delay(30, function() if Call.active and Call.ring and Call.started and os.time() - Call.started >= 29 then Call.ringing(false) end end)
                if discord ~= "" and V.get("autoDiscord", false) then V.copy(discord, "Discord link") end
                V.act("VOICE", "call " .. target)
                Call.status((isGroup and "Group call started: " or "Calling ") .. target)
                return true
        end
        function Call.accept()
                local s = Call.pending
                if not s then return false, "No incoming call" end
                if Call.active then return false, "Already in a call" end
                Call.ringing(false)
                Call.active, Call.id, Call.target, Call.started, Call.discord, Call.people, Call.isGroup = true, s.id, s.from, os.time(), s.discord or "", {s.from}, false
                Call.pending = nil
                signal("accept", s.from)
                if Call.discord ~= "" then V.copy(Call.discord, "Discord link (join for real-time audio)") end
                Call.status("Joined call with " .. s.from)
                return true
        end
        function Call.decline()
                local s = Call.pending
                Call.ringing(false)
                if s then Call.id = s.id; signal("decline", s.from); Call.id = nil; Call.pending = nil; Call.status("Declined call from " .. s.from) end
        end
        function Call.hangup()
                if not Call.active then return false, "Not in a call" end
                for _, who in ipairs(Call.people) do signal("hangup", who) end
                Call.ringing(false)
                local was = Call.target
                Call.active, Call.id, Call.target, Call.people, Call.started = false, nil, nil, {}, 0
                Call.status("Call ended (" .. tostring(was) .. ")")
                return true
        end
        function Call.onSignal(p, ev)
                -- p: call | kind | id | from | to | discord | ts | extra
                local kind, id, from, to = p[2], p[3], p[4], p[5]
                if lower(from) == lower(me()) then return end
                if kind == "invite" and lower(to) == lower(me()) and not Call.active then
                        Call.pending = {id = id, from = from, discord = p[6], group = p[8]}
                        Call.ringing(true)
                        Notify("Incoming call", from .. " is calling you. Open Social > Voice Calls to accept.", 10)
                        V.info("VOICE", "incoming call from " .. from)
                        if N.onCall then N.onCall() end
                elseif kind == "accept" and Call.active and id == Call.id then
                        Call.ringing(false)
                        Call.status(from .. " joined the call")
                elseif kind == "decline" and Call.active and id == Call.id and not Call.isGroup then
                        Call.ringing(false)
                        Call.status(from .. " declined")
                        Call.active, Call.id, Call.target, Call.people = false, nil, nil, {}
                elseif kind == "hangup" and id == Call.id and Call.active and not Call.isGroup then
                        Call.ringing(false)
                        Call.active, Call.id, Call.target, Call.people = false, nil, nil, {}
                        Call.status(from .. " ended the call")
                elseif kind == "hangup" and Call.pending and Call.pending.id == id then
                        Call.pending = nil; Call.ringing(false)
                        if N.onCall then N.onCall() end
                end
        end

