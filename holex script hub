                TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
        local track = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(44, 22), AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0), BorderSizePixel = 0 }, row)
        corner(track, 11)
        local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(3, 3), BorderSizePixel = 0 }, track)
        corner(knob, 8)
        local ctrl = { Changed = event, Value = default == true }
        local function paint(v, instant)
                local bgc = v and Theme.accent or Theme.hover
                local kc = v and Theme.accentText or Theme.sub
                local kp = v and UDim2.fromOffset(25, 3) or UDim2.fromOffset(3, 3)
                if instant then
                        track.BackgroundColor3, knob.BackgroundColor3, knob.Position = bgc, kc, kp
                else
                        tween(track, 0.18, { BackgroundColor3 = bgc })
                        tween(knob, 0.18, { Position = kp, BackgroundColor3 = kc }, Enum.EasingStyle.Back)
                end
        end
        paint(ctrl.Value, true)
        UI.swRepaint[#UI.swRepaint + 1] = function() if track.Parent then paint(ctrl.Value, true) end end
        function ctrl:Set(v, fire)
                v = v == true
                if v == self.Value then return end
                self.Value = v
                paint(v)
                if fire ~= false then ev:Fire(v) end
        end
        track.Activated:Connect(function() ctrl:Set(not ctrl.Value, true) end)
        ctrl.Label = text
        UI.byLabel = UI.byLabel or {}
        if UI.building and UI.byLabel[text] == nil then UI.byLabel[text] = ctrl end
        return ctrl
end

function UI._slider(body, text, value, minV, maxV, step)
        local ev, event = sig()
        minV, maxV = tonumber(minV) or 0, tonumber(maxV) or 1
        step = tonumber(step) or 0
        local dec = 0
        if step > 0 then
                local s = step
                while s < 0.999 and dec < 4 do s = s * 10 dec = dec + 1 end
        else
                dec = 2
        end
        local fmt = "%." .. dec .. "f"
        local row = mkRow(body, 62, text)
        row.AutomaticSize = Enum.AutomaticSize.None
        row.Size = UDim2.new(1, 0, 0, 62)
        hlabel(row, tostring(text), 13, "text", F_MED, { Position = UDim2.fromOffset(14, 9), Size = UDim2.new(1, -112, 0, 18),
                TextTruncate = Enum.TextTruncate.AtEnd })
        local box = new("TextBox", { Text = "", Font = F_BOLD, TextSize = 12, Size = UDim2.fromOffset(70, 22), AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -14, 0, 8), ClearTextOnFocus = false, BorderSizePixel = 0 }, row)
        hubBind(box, "BackgroundColor3", "hover")
        hubBind(box, "TextColor3", "text")
        corner(box, 6)
        local track = new("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 44), BorderSizePixel = 0 }, row)
        hubBind(track, "BackgroundColor3", "hover")
        corner(track, 3)
        local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, track)
        hubBind(fill, "BackgroundColor3", "accent")
        corner(fill, 3)
        local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
                BorderSizePixel = 0, ZIndex = 2 }, track)
        hubBind(knob, "BackgroundColor3", "accent")
        corner(knob, 7)
        local hit = new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, -28, 0, 26), Position = UDim2.fromOffset(14, 34), ZIndex = 3 }, row)
        local ctrl = { Changed = event, Value = tonumber(value) or minV }
        local function snap(v)
                -- slider-drag path: keep step + min/max so the track stays usable
                if step > 0 then v = math.floor((v - minV) / step + 0.5) * step + minV end
                v = math.clamp(v, minV, maxV)
                return tonumber(string.format(fmt, v))
        end
        local function freeNum(v)
                -- typed path: allow ANY finite number (big or small), no min/max clamp
                v = tonumber(v)
                if not v or v ~= v or v == math.huge or v == -math.huge then return nil end
                if step > 0 and step < 1 then
                        local f = tonumber(string.format(fmt, v))
                        if f then v = f end
                end
                return v
        end
        local function paint(v)
                local pct = (maxV > minV) and math.clamp((v - minV) / (maxV - minV), 0, 1) or 0
                fill.Size = UDim2.new(pct, 0, 1, 0)
                knob.Position = UDim2.new(pct, 0, 0.5, 0)
                if not box:IsFocused() then
                        -- show full precision for free-typed values outside the slider range
                        if v < minV or v > maxV then
                                box.Text = tostring(v)
                        else
                                box.Text = string.format(fmt, v)
                        end
                end
        end
        ctrl.Value = snap(ctrl.Value)
        paint(ctrl.Value)
        function ctrl:Set(v, fire, free)
                local n = tonumber(v)
                if free then
                        n = freeNum(n)
                        if n == nil then paint(self.Value); return end
                        v = n
                else
                        v = snap(n or self.Value)
                end
                if v == self.Value then paint(v) return end
                self.Value = v
                paint(v)
                if fire ~= false then ev:Fire(v) end
        end
        local dragging = false
        local function fromX(x)
                local w = track.AbsoluteSize.X
                if w <= 0 then return end
                local pct = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
                ctrl:Set(minV + pct * (maxV - minV), true)
        end
        hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        tween(knob, 0.1, { Size = UDim2.fromOffset(18, 18) })
                        fromX(input.Position.X)
                end
        end)
        keepConn(UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        fromX(input.Position.X)
                end
        end))
        keepConn(UserInputService.InputEnded:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        tween(knob, 0.1, { Size = UDim2.fromOffset(14, 14) })
                end
        end))
        box.FocusLost:Connect(function()
                local n = tonumber(box.Text)
                if n then
                        ctrl:Set(n, true, true)  -- free = true → any number allowed
                else
                        paint(ctrl.Value)
                end
                paint(ctrl.Value)
        end)
        ctrl.Label = text
        return ctrl
end

-- dropdown: opens inline inside its row, exactly like the hub's own dropdown
function UI._dropdown(body, text, options, startIdx)
        local ev, event = sig()
        options = options or {}
        local HEAD, ITEM = 66, 28
        local row = mkRow(body, HEAD, text)
        row.AutomaticSize = Enum.AutomaticSize.None
        row.Size = UDim2.new(1, 0, 0, HEAD)
        row.ClipsDescendants = true
        hlabel(row, tostring(text), 13, "text", F_MED, { Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -28, 0, 18),
                TextTruncate = Enum.TextTruncate.AtEnd })
        local head = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, -28, 0, 28), Position = UDim2.fromOffset(14, 32), BorderSizePixel = 0 }, row)
        hubBind(head, "BackgroundColor3", "hover")
        corner(head, 8)
        local cur = hlabel(head, "", 12, "text", F_MED, { Size = UDim2.new(1, -36, 1, 0), Position = UDim2.fromOffset(12, 0), TextTruncate = Enum.TextTruncate.AtEnd })
        local arrow = hlabel(head, "v", 11, "sub", F_BLACK, { Size = UDim2.fromOffset(20, 28), Position = UDim2.new(1, -26, 0, 0), TextXAlignment = Enum.TextXAlignment.Center })
        local ctrl = { Changed = event, Index = math.clamp(math.floor(tonumber(startIdx) or 1), 1, math.max(#options, 1)), Options = options, Row = row }
        local function paint() cur.Text = tostring(options[ctrl.Index] or "-") end
        paint()
        function ctrl:Set(i, fire)
                i = math.clamp(math.floor(tonumber(i) or 1), 1, math.max(#options, 1))
                self.Index = i
                paint()
                if fire ~= false then ev:Fire(i) end
        end

        local searchable = #options > 10
        local shown = math.min(math.max(#options, 1), 7)
        local listTop = HEAD + (searchable and 36 or 4)
        local openH = listTop + shown * ITEM + 10
        local sbox
        if searchable then
                sbox = new("TextBox", { PlaceholderText = "search...", Text = "", Font = F_MED, TextSize = 12, ClearTextOnFocus = false,
                        Size = UDim2.new(1, -28, 0, 26), Position = UDim2.fromOffset(14, HEAD + 2), BorderSizePixel = 0,
                        TextXAlignment = Enum.TextXAlignment.Left, Visible = false }, row)
                hubBind(sbox, "BackgroundColor3", "hover")
                hubBind(sbox, "TextColor3", "text")
                hubBind(sbox, "PlaceholderColor3", "sub")
                corner(sbox, 7)
                pad(sbox, 10, 0, 10, 0)
        end
        local sf = new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, -28, 0, shown * ITEM),
                Position = UDim2.fromOffset(14, listTop), ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
                Visible = false }, row)
        hubBind(sf, "ScrollBarImageColor3", "sub")
        list(sf, 0)

        local items, isOpen = {}, false
        local close
        local function fill(filter)
                for _, it in ipairs(items) do it:Destroy() end
                items = {}
                local f = filter and string.lower(filter) or ""
                for i, name in ipairs(options) do
                        local nm = tostring(name)
                        if f == "" or string.find(string.lower(nm), f, 1, true) then
                                local sel = i == ctrl.Index
                                local it = new("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, -4, 0, ITEM - 2), BorderSizePixel = 0,
                                        LayoutOrder = i, BackgroundColor3 = Theme.accent, BackgroundTransparency = sel and 0.8 or 1 }, sf)
                                corner(it, 6)
                                new("TextLabel", { BackgroundTransparency = 1, Text = nm, Font = sel and F_BOLD or F_MED, TextSize = 12,
                                        TextColor3 = sel and Theme.text or Theme.sub, TextXAlignment = Enum.TextXAlignment.Left, Position = UDim2.fromOffset(10, 0),
                                        Size = UDim2.new(1, -16, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd }, it)
                                it.MouseEnter:Connect(function() if i ~= ctrl.Index then tween(it, 0.08, { BackgroundTransparency = 0.88 }) end end)
                                it.MouseLeave:Connect(function() if i ~= ctrl.Index then tween(it, 0.08, { BackgroundTransparency = 1 }) end end)
                                it.Activated:Connect(function()
                                        ctrl:Set(i, true)
                                        close()
                                end)
                                items[#items + 1] = it
                        end
                end
        end
        local function open()
                if UI._ddClose and UI._ddClose ~= close then pcall(UI._ddClose) end
                isOpen = true
                UI._ddClose = close
                if sbox then sbox.Text = "" end
                fill("")
                sf.Visible = true
                if sbox then sbox.Visible = true end
                tween(row, 0.2, { Size = UDim2.new(1, 0, 0, openH) })
                tween(arrow, 0.2, { Rotation = 180 })
                if ctrl.Index > 5 then pcall(function() sf.CanvasPosition = Vector2.new(0, (ctrl.Index - 3) * ITEM) end) end
        end
        close = function()
                if not isOpen then return end
                isOpen = false
                if UI._ddClose == close then UI._ddClose = nil end
                tween(row, 0.18, { Size = UDim2.new(1, 0, 0, HEAD) })
                tween(arrow, 0.18, { Rotation = 0 })
                task.delay(0.2, function()
                        if not isOpen then
                                sf.Visible = false
                                if sbox then sbox.Visible = false end
                        end
                end)
        end
        if sbox then sbox:GetPropertyChangedSignal("Text"):Connect(function() fill(sbox.Text) end) end
        head.Activated:Connect(function()
                if isOpen then close() else open() end
        end)
        ctrl.Label = text
        return ctrl
end

