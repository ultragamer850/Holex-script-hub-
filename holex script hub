        function News.fetch(single)
                task.spawn(function()
                        V.info("NEWS", "Fetching real-world news...")
                        Notify("Breaking News", "Fetching news for " .. Net.country .. "...", 3)
                        local cc = (Net.countryCode or "US"):upper()
                        local city = Net.city ~= "Unknown" and Net.city or ""
                        local localQ = ((city ~= "" and city or Net.country):gsub("%s+", "+")) .. "+news"
                        local queries = {
                                {label = "Top Stories", q = "top+stories"},
                                {label = "World", q = "world+news"},
                                {label = "War & Conflict", q = "war+OR+conflict+OR+military"},
                                {label = "Crime", q = "crime+OR+murder+OR+arrest"},
                                {label = "FBI / Federal", q = "FBI+OR+federal+investigation+OR+indictment"},
                                {label = "Politics", q = "politics+OR+government+election"},
                                {label = "Local", q = localQ, local_ = true},
                        }
                        if single then queries = {single} end
                        local headlines, seen = {}, {}
                        for _, cat in ipairs(queries) do
                                local hl, gl, ceid = "en-US", "US", "US:en"
                                if cat.local_ then hl, gl, ceid = "en-" .. cc, cc, cc .. ":en" end
                                local url = string.format("https://news.google.com/rss/search?q=%s&hl=%s&gl=%s&ceid=%s", cat.q, hl, gl, ceid)
                                local ok, res = pcall(function() return game:HttpGet(url) end)
                                if ok and type(res) == "string" then
                                        local count = 0
                                        for item in res:gmatch("<item>(.-)</item>") do
                                                local title = clean(item:match("<title>(.-)</title>"))
                                                local desc = clean(item:match("<description>(.-)</description>"))
                                                if #title > 10 and not seen[title] and not title:lower():find("google news") then
                                                        seen[title] = true
                                                        headlines[#headlines + 1] = {category = cat.label, title = title, desc = (#desc > 5 and desc) or ("Report from the " .. cat.label .. " desk.")}
                                                        count = count + 1
                                                        if count >= 2 then break end
                                                end
                                        end
                                end
                                task.wait(0.12)
                        end
                        if #headlines == 0 then
                                Notify("Breaking News", "Could not fetch news right now. Try again later.", 4)
                                V.warn("NEWS", "no headlines")
                                return
                        end
                        local parts = {string.format("News briefing for %s.", (city ~= "" and (city .. ", ") or "") .. Net.country)}
                        local desc = ""
                        for i, h in ipairs(headlines) do
                                if i > 8 then break end
                                parts[#parts + 1] = h.category .. ": " .. h.title .. "."
                                desc = desc .. string.format("[%s] %s\n", h.category, h.title)
                                News.history[#News.history + 1] = {title = h.title, desc = h.desc, category = h.category, time = os.time()}
                        end
                        desc = desc .. "\nYou are in " .. (city ~= "" and (city .. ", ") or "") .. Net.region .. ", " .. Net.country .. "."
                        News.show(headlines[1].title, desc, table.concat(parts, " "))
                        renderHistory()
                        Notify("Breaking News", #headlines .. " reports loaded.", 3)
                end)
        end

