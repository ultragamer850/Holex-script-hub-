function UI.refreshReanimate()
        if not UI.raLines then return end
        local d = HX.detect()
        local confPct = math.floor((d.reanimConf or 0) * 100)
        UI.raLines.reanim:SetText("Reanimate:  " .. tostring(d.reanimName or "?") .. ((d.reanimRig and d.reanimRig ~= "") and ("  |  Rig: " .. d.reanimRig) or ""))
        if UI.raLines.reanim.Label then UI.raLines.reanim.Label.TextColor3 = (d.reanimConf or 0) >= 0.7 and COL.good or ((d.reanimConf or 0) >= 0.4 and COL.warn or COL.muted) end
        UI.raLines.conf:SetText("Confidence:  " .. confPct .. "%   ·   Profile:  " .. tostring(d.profile))
        UI.raLines.src:SetText("Source path:  " .. tostring(d.reanimSrc or d.source))
        UI.raLines.exec:SetText("Executor:  " .. tostring(d.executor))
        local fname = d.figure and d.figure.Name or "none"
        local fpath = d.figPath or ""
        UI.raLines.fig:SetText("Figure:  " .. fname .. "   (" .. tostring(d.source) .. ")" .. (fpath ~= "" and ("\n  " .. fpath) or ""))
        local rigTxt = "Rig:  no figure found yet"
        if d.figure then
                rigTxt = "Rig:  " .. (d.r15 and "R15 (figure Idle/Walk need R6; hats & collision still work)" or "R6")
                if d.humHealth then
                        rigTxt = rigTxt .. "   ·   HP " .. d.humHealth .. "/" .. d.humMax .. "   ·   " .. tostring(d.humState)
                end
        end
        UI.raLines.rig:SetText(rigTxt)
        UI.raLines.hats:SetText("Hats:  " .. d.hats .. " found   ·   " .. d.owned .. " network-owned by you")
        local names = {}
        if d.hatNames and #d.hatNames > 0 then
                for i = 1, math.min(#d.hatNames, 16) do names[#names + 1] = d.hatNames[i] end
                if #d.hatNames > 16 then names[#names + 1] = "... +" .. (#d.hatNames - 16) end
        else
                local ok, labels = pcall(function() return HX.m and HX.m.X and HX.m.X.hatLabelList() end)
                if ok and type(labels) == "table" then
                        for i = 1, math.min(#labels, 14) do names[#names + 1] = labels[i].label end
                end
        end
        UI.raLines.hatList:SetText(#names > 0 and ("Hat list:  " .. table.concat(names, "  ·  ")) or "Hat list:  (empty — equip hats or Rescan after reanimate loads)")
        UI.raLines.cam:SetText("Camera subject:  " .. (d.cameraSubject ~= "" and d.cameraSubject or "(none)"))
        UI.raLines.session:SetText(string.format(
                "Player: %s (%s)  ·  Place %s  ·  FPS ~%s  ·  Ping ~%sms",
                tostring(d.player), tostring(d.userId), tostring(d.placeId), tostring(d.fps), tostring(d.ping)
        ))
        local gparts = {}
        for i, g in ipairs(d.globals or {}) do
                if i > 10 then gparts[#gparts + 1] = "…" break end
                gparts[#gparts + 1] = g.name
        end
        UI.raLines.globals:SetText(#gparts > 0 and ("_G hits:  " .. table.concat(gparts, ", ")) or "_G hits:  (none of the known reanimate keys)")
        local guip = {}
        for i, h in ipairs(d.guiHints or {}) do
                if i > 6 then guip[#guip + 1] = "…" break end
                guip[#guip + 1] = "[" .. h.kw .. "] " .. h.text
        end
        UI.raLines.gui:SetText(#guip > 0 and ("GUI hints:  " .. table.concat(guip, "  |  ")) or "GUI hints:  (no reanimate-related UI text found)")
end

