                        end
                        local res = V.http("https://api.weather.gov/alerts/active?area=" .. Net.regionCode, "GET", {["User-Agent"] = "HolexHub (roblox script hub)", ["Accept"] = "application/geo+json"})
                        local d = res and V.decode(res.Body)
                        if not d or not d.features then
                                if manual then Notify("Emergency", "Could not reach the weather service.", 3) end
                                return
                        end
                        for _, f in ipairs(d.features) do
                                local p = f.properties or {}
                                local ev = tostring(p.event or ""):lower()
                                local id = tostring(f.id or p.id or ev)
                                local key
                                if ev:find("tornado warning") or ev:find("tornado emergency") then key = "tornado"
                                elseif ev:find("tsunami warning") then key = "tsunami"
                                elseif ev:find("earthquake warning") then key = "earthquake" end
                                if key and not Em.seen[id] then
                                        Em.seen[id] = true
                                        Em.trigger(key)
                                        return
                                end
                        end
                        if manual then Notify("Emergency", "No active tornado / tsunami / earthquake warnings for " .. Net.regionCode .. ".", 4) end
                end)
