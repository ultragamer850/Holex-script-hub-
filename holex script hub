                        pcall(function() X.NPCAuraJumpConn:Disconnect() end)
                        X.NPCAuraJumpConn = nil
                        m.NPCAuraJump = false
                end
                if (not kind or kind == "all" or kind == "ragdoll") and X.NPCAuraRagConn then
                        pcall(function() X.NPCAuraRagConn:Disconnect() end)
                        X.NPCAuraRagConn = nil
                        m.NPCAuraRagdoll = false
                end
