        function V.applyLanguage(lang, opts)
                opts = opts or {}
                if not TR[lang] then lang = "English" end
                local row = TR[lang] or TR.English
                V.cfg.lang = lang
                pcall(function() persistSet("Language|UI language", lang) end)
                pcall(function() Persist.data["Language|UI language"] = lang end)
                for _, name in ipairs(tabOrder) do
                        local tb = tabBtns[name]
                        if tb and tb.lbl then
                                local idx
                                for k, key in ipairs(TAB_KEYS) do if key == name then idx = k break end end
                                tb.lbl.Text = (idx and row[idx]) or name
                        end
                end
                local S = V.getLangStrings(lang)
                pcall(function()
                        if titleLbl then titleLbl.Text = S.title end
                        for _, d in ipairs(main:GetDescendants()) do
                                if d:IsA("TextLabel") then
                                        local t = d.Text
                                        if t == "SCRIPT HUB v5  /  ULTIMATE EDITION" or (type(t) == "string" and t:find("SCRIPT HUB v5")) then d.Text = S.subtitle
                                        elseif t == "WELCOME BACK" then d.Text = S.welcome
                                        elseif t == "TICKING" or t == "PAUSED" then d.Text = (running and S.ticking) or S.paused end
                                end
                        end
                end)
                if X.langGalleryMark then pcall(X.langGalleryMark, lang) end
                if not opts.silent then Notify("Language", string.format(S.langChanged, lang), 3) end
                if opts.restart then
                        task.spawn(function()
                                task.wait(0.75)
                                Notify("Language", S.restarting, 2)
                                persistFlush()
                                local okRestart = false
                                pcall(function()
                                        local src
                                        if type(readfile) == "function" and type(isfile) == "function" then
                                                for _, p in ipairs({"HolexScriptHub.lua", "Holex Script Hub Ultimate Edition.lua", "holex script hub v5/HolexScriptHub.lua", (X.ROOT or "holex script hub v5") .. "/HolexScriptHub.lua"}) do
                                                        if isfile(p) then
                                                                local ok, body = pcall(readfile, p)
                                                                if ok and type(body) == "string" and #body > 1000 and body:find("HOLEX SCRIPT HUB") then src = body break end
                                                        end
                                                end
                                        end
                                        if src and type(loadstring) == "function" then
                                                gui:Destroy()
                                                task.wait(0.15)
                                                loadstring(src)()
                                                okRestart = true
                                        end
                                end)
                                if not okRestart then
                                        pcall(function()
                                                if current then local n = current; current = nil; switch(n) end
                                        end)
                                        Notify("Language", "UI updated to " .. lang .. ". Re-execute the script for a full restart.", 4)
