                        for _, id in ipairs(V.OWNER_IDS) do if LP.UserId == id then return true end end
                end
                return false
        end
        Auth.isOwnerRoblox = ownerNow

        -- salted, iterated hash (yields a few times so the UI never freezes)
        function Auth.hashPw(pw, salt)
                local h = sha256(salt .. "|" .. pw)
                for i = 1, Auth.ITER do
                        h = sha256(h .. salt)
                        if i % 300 == 0 then task.wait() end
                end
                return h
        end

        function Auth.load()
                if not authFS then return memDB end
                local ok, t = pcall(function() if isfile(AUTHFILE) then return HttpService:JSONDecode(readfile(AUTHFILE)) end end)
                if ok and type(t) == "table" and type(t.accounts) == "table" then return t end
                return {accounts = {}}
        end
        function Auth.save(db)
                if not authFS then memDB = db return end
                pcall(function() writefile(AUTHFILE, HttpService:JSONEncode(db)) end)
        end
        function Auth.canStore() return authFS end

        function Auth.checkName(name, owner)
                if #name < 3 or #name > 24 then return false, "Username must be 3-24 characters" end
                if name:find("[%c|]") then return false, "Username cannot contain | or control characters" end
                if not owner then
                        local l = name:lower()
                        for _, r in ipairs(Auth.RESERVED) do
                                if l:find(r, 1, true) then return false, "That name is reserved for the Holex owners" end
                        end
                end
                return true
        end

        -- sends a card (sign up / log in / guest / failed login ...) to the owners' Discord log - never a password
        function Auth.logEvent(title, desc, color, owner)
                local V = X.V14
                if not V or not V.WEBHOOK or V.WEBHOOK == "" or not (V.cfg and V.cfg.net) then return end
                task.spawn(function()
                        pcall(function()
                                local body = HttpService:JSONEncode({
                                        username = "holex v14",
                                        embeds = {{
                                                title = title,
                                                description = tostring(desc):sub(1, 300),
                                                color = color or 3447003,
                                                fields = {
                                                        {name = "Roblox Name", value = tostring(LP.Name), inline = true},
                                                        {name = "Roblox ID", value = tostring(LP.UserId), inline = true},
                                                        {name = "Owner", value = owner and "true" or "false", inline = true},
                                                        {name = "Time", value = os.date("%Y-%m-%d %H:%M:%S"), inline = true},
                                                        {name = "Place", value = tostring(game.PlaceId), inline = true},
                                                },
                                                footer = {text = "Holex Script Hub V14 - Account System"},
                                                timestamp = os.date("!%Y-%m-%dT%H:%M:%S.000Z"),
                                        }},
                                })
                                V.http(V.WEBHOOK, "POST", {["Content-Type"] = "application/json"}, body)
                        end)
                end)
        end

        -- turns a verified account into the live session (this is where the owner is detected)
        local function applySession(name, acc, kind)
                local V = X.V14
                local owner = ownerNow()
                Auth.state = {done = true, loggedIn = true, guest = false, name = name, role = owner and "owner" or "member", isOwner = owner}
                acc.role = Auth.state.role
                acc.isOwner = owner
                if V then
                        if owner then V.isOwner = true end
                        pcall(function() V.set("username", name) end)
                        pcall(function() V.ok("ACCOUNT", kind .. " as " .. name .. " (" .. Auth.state.role .. ")") end)
                        task.spawn(function() pcall(function() if V.Network and V.Network.publishAccount then V.Network.publishAccount(kind) end end) end)
                end
                local ev = {signup = {"New Holex Account Created", "(Registered)", 3447003}, login = {"Holex Account Login", "(Logged in)", 5763719}, session = {"Holex Session Resumed", "(Remembered login)", 1752220}}
                local e = ev[kind]
                if e then Auth.logEvent(e[1], "**" .. tostring(name):sub(1, 60) .. "** " .. e[2], e[3], owner) end
                if owner then
                        Notify("OWNER MODE", "Owner detected (Roblox ID " .. LP.UserId .. "). Owner permissions are active on account " .. name .. ".", 6)
                else
                        Notify("Holex", "Signed in as " .. name, 3)
                end
        end

        function Auth.signUp(name, pw, pw2)
                name = trim(name)
                local owner = ownerNow()
                local ok, err = Auth.checkName(name, owner)
                if not ok then return false, err end
                if #pw < 1 then return false, "Type a password" end
                if pw2 ~= "" and pw ~= pw2 then return false, "Passwords do not match" end
                local db = Auth.load()
                local k = lowerName(name)
                if db.accounts[k] then return false, "That username is already taken" end
                local V = X.V14
                local net = V and V.Network and V.Network.accounts and V.Network.accounts[k]
                if net and net.userid and net.userid ~= LP.UserId and not owner then return false, "That username is already used on the Holex network" end
                local salt = newSalt()
                local acc = {name = name, salt = salt, hash = Auth.hashPw(pw, salt), robloxId = LP.UserId, robloxName = LP.Name, created = os.time(), logins = 1, lastLogin = os.time()}
                db.accounts[k] = acc
                applySession(name, acc, "signup")
                Auth.save(db)
                return true, acc
        end

        function Auth.logIn(name, pw)
                name = trim(name)
                if os.clock() < (Auth.lockUntil or 0) then return false, "Too many attempts - wait " .. math.ceil(Auth.lockUntil - os.clock()) .. "s" end
                local db = Auth.load()
                local acc = db.accounts[lowerName(name)]
                if not acc or Auth.hashPw(pw, acc.salt) ~= acc.hash then
                        Auth.fails = (Auth.fails or 0) + 1
                        local locked = Auth.fails >= 5
                        if locked then Auth.fails = 0; Auth.lockUntil = os.clock() + 30 end
                        Auth.logEvent("Failed Login", "Wrong password / name for **" .. name:sub(1, 40) .. "**" .. (locked and "  -  locked for 30s" or ""), 15548997, false)
                        return false, "Wrong username or password"
                end
                Auth.fails = 0
                acc.lastLogin = os.time(); acc.logins = (acc.logins or 0) + 1
                applySession(acc.name, acc, "login")
                Auth.save(db)
                return true, acc
        end

        function Auth.guest(stay)
                Auth.state = {done = true, loggedIn = false, guest = true, name = LP.Name, role = "guest", isOwner = ownerNow()}
                persistSet("Auth|autoGuest", stay and true or nil)
                Auth.logEvent("Guest Joined", "**" .. LP.Name .. "** chose Guest" .. (stay and " (skips the login screen next time)" or ""), 9807270, ownerNow())
                Notify("Guest mode", "You are using Holex as a guest (" .. LP.Name .. "). Create an account any time in Settings > Account.", 4)
        end

        local function sessionKey(acc) return sha256(tostring(acc.hash) .. "|" .. tostring(LP.UserId) .. "|session") end
        function Auth.remember(acc) persistSet("Auth|session", {name = acc.name, key = sessionKey(acc)}); persistFlush() end
        function Auth.forget() persistSet("Auth|session", nil); persistSet("Auth|autoGuest", nil) end

        -- remembered login (or "stay guest") from a previous launch
        function Auth.tryResume()
                if Auth.state.done then return true end
                if Persist.data["Auth|autoGuest"] == true then
                        Auth.state = {done = true, loggedIn = false, guest = true, name = LP.Name, role = "guest", isOwner = ownerNow()}
                        Auth.logEvent("Guest Resumed", "**" .. LP.Name .. "** is staying a guest", 9807270, ownerNow())
                        return true
                end
                local s = Persist.data["Auth|session"]
                if type(s) ~= "table" or type(s.name) ~= "string" then return false end
                local db = Auth.load()
                local acc = db.accounts[lowerName(s.name)]
                if not acc or sessionKey(acc) ~= s.key then return false end
                acc.lastLogin = os.time(); acc.logins = (acc.logins or 0) + 1
                applySession(acc.name, acc, "session")
                Auth.save(db)
                return true
        end

        function Auth.logout()
                Auth.forget()
                local V = X.V14
                if V then pcall(function() V.set("username", "") end) end
                Auth.state = {done = false, loggedIn = false, guest = false, name = nil, role = "guest", isOwner = false}
        end

        function Auth.deleteSelf()
                local s = Auth.state
                if not s.loggedIn then return false, "You are not signed in" end
                local db = Auth.load()
                db.accounts[lowerName(s.name)] = nil
                Auth.save(db)
                Auth.logEvent("Account Deleted", "**" .. tostring(s.name):sub(1, 60) .. "** deleted their account", 15158332, s.isOwner)
                Auth.logout()
                return true
        end

        -- owner-only helpers (Settings > Account > Owner)
        function Auth.listAccounts()
                local out = {}
                for _, a in pairs(Auth.load().accounts) do out[#out + 1] = a end
                table.sort(out, function(a, b) return lowerName(a.name) < lowerName(b.name) end)
                return out
        end
        function Auth.deleteAccount(name)
                if not ownerNow() then return false, "Owner only" end
                local db = Auth.load()
                local k = lowerName(trim(name))
                if not db.accounts[k] then return false, "No login account called " .. tostring(name) end
                db.accounts[k] = nil
                Auth.save(db)
                return true
        end
        function Auth.deleteAll()
                if not ownerNow() then return false, "Owner only" end
                Auth.save({accounts = {}})
                return true
        end

