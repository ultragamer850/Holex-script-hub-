        X.hatsSolidHandles = function(force)
                local now = os.clock()
                if not force and X.HandleCache and #X.HandleCache > 0 and (now - (X.HandleCacheT or 0)) < (tonumber(m.PerfHandleCacheInterval) or 0.35) then
                        -- drop dead handles cheaply
                        local alive = true
                        for i = 1, #X.HandleCache do
                                if not X.HandleCache[i].Parent then alive = false break end
                        end
                        if alive then return X.HandleCache end
                end
                local list, seen = {}, {}
                local function add(h)
                        if h and h:IsA("BasePart") and h.Parent and not seen[h] then
                                seen[h] = true
                                list[#list + 1] = h
                        end
                end
                local function scan(char)
                        if not (char and char.Parent) then return end
                        for _, d in ipairs(char:GetChildren()) do
                                if d:IsA("Accessory") or d:IsA("Accoutrement") then
                                        add(d:FindFirstChild("Handle"))
                                end
                        end
                end
                pcall(function()
                        local uh = HX.uh()
                        if uh then
                                scan(uh.Character)
                                if uh.Reanimate then scan(uh.Reanimate.Character) end
                        end
                end)
                scan(LocalPlayer.Character)
                X.HandleCache = list
                X.HandleCacheT = now
                return list
        end

        function X.clearHitboxes()
                for h, box in pairs(HatHB) do
                        pcall(function() box:Destroy() end)
                        HatHB[h] = nil
                end
