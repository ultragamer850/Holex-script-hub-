        function X.figGetJoints(fig)
                if not fig then return nil end
                local root = fig:FindFirstChild("HumanoidRootPart")
                local torso = fig:FindFirstChild("Torso")
                if not (root and torso) then return nil end
                -- NEVER use torso.Neck (errors on non-R6 / hat-only / Genesis effect bodies)
                local function joint(parent, name)
                        if not parent then return nil end
                        local j = parent:FindFirstChild(name)
                        if j and j:IsA("Motor6D") and not j:GetAttribute("HolexStub") then return j end
                        return nil
                end
                local J = {
                        Root = joint(root, "RootJoint"),
                        Neck = joint(torso, "Neck"),
                        RS = joint(torso, "Right Shoulder"),
                        LS = joint(torso, "Left Shoulder"),
                        RH = joint(torso, "Right Hip"),
                        LH = joint(torso, "Left Hip"),
                }
                for _, n in ipairs(FIG_JOINTS) do
                        if not J[n] then return nil end
                end
                return J
        end

        function X.figRestOf(j, jn, scale)
                local r = X.FigRest[j]
                if r then return r end
                local live = j.C0
                local canon = FIG_CANON[jn]
                local c0 = live
                if canon and ((live.RightVector - canon.RightVector).Magnitude > 0.02 or (live.UpVector - canon.UpVector).Magnitude > 0.02) then
                        c0 = CFrame.new(canon.Position * scale) * rotOnly(canon)
                end
                r = { c0 = c0, s = scale }
                X.FigRest[j] = r
                return r
        end

        function X.figComputeOut(j, jn, W, scale)
                local r = X.figRestOf(j, jn, scale)
                local rc = rotOnly(r.c0)
                local c = r.c0.Position * (scale / math.max(r.s, 1e-4))
                return { j = j, c0 = CFrame.new(c) * W * rc }
        end

        function X.figCfDiff(a, b)
                return (a.Position - b.Position).Magnitude,
                        (a.RightVector - b.RightVector).Magnitude + (a.UpVector - b.UpVector).Magnitude
        end

        -- True when something other than us moved a joint since our last write
        -- (Uhhhhhh dance, emote script, Animator). Joints that merely sit at their rest pose
        -- (a reset) are NOT counted, so a rig that is just being re-centred never blocks us.
        function X.figCheckDriven()
                if m.FigYieldExternal == false then return false end
                local scale = X.FigScale or 1
                for _, o in pairs(X.FigOut) do
                        local j = o.j
                        if o.wrote and j and j.Parent then
                                local driven = false
                                pcall(function()
                                        local tp, tr = X.figCfDiff(j.Transform, IDENT)
                                        if tp > 0.03 * scale or tr > 0.06 then driven = true return end
                                        local dp, dr = X.figCfDiff(j.C0, o.c0)
                                        if dp > 0.03 * scale or dr > 0.05 then
                                                local r = X.FigRest[j]
                                                if r then
                                                        local rc = CFrame.new(r.c0.Position * (scale / math.max(r.s, 1e-4))) * rotOnly(r.c0)
                                                        local rp, rr = X.figCfDiff(j.C0, rc)
                                                        if rp <= 0.03 * scale and rr <= 0.08 then return end
                                                end
                                                driven = true
                                        end
                                end)
                                if driven then return true end
                        end
                end
                return false
        end

        -- Holex perf patch: animation-track scan at most 4x per second (it allocated tables every frame)
        function X.figHasUserDance(fig)
                local now = os.clock()
                if X._fdFig == fig and now - (X._fdT or 0) < 0.25 then return X._fdV end
                X._fdFig, X._fdT = fig, now
                X._fdV = X.figHasUserDanceRaw(fig)
                return X._fdV
        end

        function X.figBeginYield()
                X.FigExtActive = true
                X.FigDanceActive = true
                X.FigDanceUntil = os.clock() + (tonumber(m.FigYieldHold) or 0.7)
                X.FigExtSnap = nil
                X.FigAnimOn = false
                X.FigSmooth = nil
                X.FigOut = {}
        end

        -- While yielding: keep watching the joints; stay out of the way until they stop moving.
        function X.figExtWatch(J, now)
                local snap = X.FigExtSnap
                local cur, moved = {}, false
                for _, n in ipairs(FIG_JOINTS) do
                        local j = J[n]
                        local c0, tf = j.C0, j.Transform
                        cur[n] = { c0, tf }
                        local sn = snap and snap[n]
                        if sn then
                                local dp, dr = X.figCfDiff(c0, sn[1])
                                local tp, tr = X.figCfDiff(tf, sn[2])
                                if dp > 0.004 or dr > 0.01 or tp > 0.004 or tr > 0.01 then moved = true end
                        else
                                moved = true
                        end
                end
                X.FigExtSnap = cur
                if moved then X.FigDanceUntil = now + (tonumber(m.FigYieldHold) or 0.7) end
                X.FigDanceActive = true
                return now < X.FigDanceUntil
        end

        function X.figApplyOut()
                if X.figCheckDriven() then
                        X.figBeginYield()
                        return
                end
                for _, o in pairs(X.FigOut) do
                        local j = o.j
                        if j and j.Parent then
                                pcall(function()
                                        j.C0 = o.c0
                                        j.Transform = IDENT
                                        o.wrote = true
                                end)
                        end
                end
        end

        function X.figRestore()
                local s = X.FigScale or 1
                for j, r in pairs(X.FigRest) do
                        if j and j.Parent then
                                pcall(function()
                                        j.C0 = CFrame.new(r.c0.Position * (s / math.max(r.s, 1e-4))) * rotOnly(r.c0)
                                        j.Transform = IDENT
                                end)
                        end
                end
                X.FigSmooth = nil
                X.FigOut = {}
                X.FigAnimOn = false
        end

        -- True when a dance / emote / high-priority user anim is playing on the figure
        -- (or on the real character). Used so dances work while the script is on.
        function X.figHasUserDanceRaw(fig)
                if m.FigAllowDances == false then return false end
                local function scanAnimator(an)
                        if not an then return false end
                        local ok, tracks = pcall(function() return an:GetPlayingAnimationTracks() end)
                        if not ok or type(tracks) ~= "table" then return false end
                        for _, tr in ipairs(tracks) do
                                local pri = tr.Priority
                                -- Action / Action2-4 / Core = dances, emotes, catalog dances
                                if pri == Enum.AnimationPriority.Action
                                        or pri == Enum.AnimationPriority.Action2
                                        or pri == Enum.AnimationPriority.Action3
                                        or pri == Enum.AnimationPriority.Action4
                                        or pri == Enum.AnimationPriority.Core then
                                        if tr.IsPlaying and (tr.TimePosition or 0) >= 0 then
                                                return true
                                        end
                                end
                                -- also catch Movement tracks that look like dances (long loop, not walk)
                                if m.FigDancePriority ~= false and pri == Enum.AnimationPriority.Movement then
                                        local len = 0
                                        pcall(function() len = tr.Length or 0 end)
                                        if tr.IsPlaying and len > 2.5 and tr.Looped then
                                                -- heuristic: long looped movement track while nearly idle = dance
                                                if (X.FigHv or 0) < 2.5 then return true end
                                        end
                                end
                        end
                        return false
                end
                local function scanModel(model)
                        if not model then return false end
                        local hum = model:FindFirstChildOfClass("Humanoid")
                        if hum then
                                if scanAnimator(hum:FindFirstChildOfClass("Animator")) then return true end
                        end
                        -- some dance scripts parent Animator under character
                        local an = model:FindFirstChildOfClass("Animator")
                        if scanAnimator(an) then return true end
                        return false
                end
                if scanModel(fig) then return true end
                if LocalPlayer.Character and LocalPlayer.Character ~= fig then
                        if scanModel(LocalPlayer.Character) then return true end
                end
                return false
        end

        function X.figKillDefaults(fig)
                if HX.Settings.NoAnimations ~= false or m.FigKillDefaults == false or not fig then return end
                -- never kill defaults while a dance is active
                if X.figHasUserDance(fig) then
                        X.FigDanceActive = true
                        X.FigDanceUntil = os.clock() + 0.35
                        return
                end
                local now = os.clock()
                if now - (X.FigLastKill or 0) < 0.5 then return end
                X.FigLastKill = now
                pcall(function()
                        local a = fig:FindFirstChild("Animate")
                        if a and (a:IsA("LocalScript") or a:IsA("Script")) and not a.Disabled then
                                X.FigAnimateOff[a] = true
                                a.Disabled = true
                        end
                end)
                pcall(function()
                        local hum = fig:FindFirstChildOfClass("Humanoid")
                        local an = hum and hum:FindFirstChildOfClass("Animator")
                        if an then
                                for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
                                        local pri = tr.Priority
                                        -- NEVER stop Action+ / Core (dances & emotes)
                                        if pri == Enum.AnimationPriority.Action
                                                or pri == Enum.AnimationPriority.Action2
                                                or pri == Enum.AnimationPriority.Action3
                                                or pri == Enum.AnimationPriority.Action4
                                                or pri == Enum.AnimationPriority.Core then
                                                -- leave alone
                                        else
                                                -- only stop default idle/walk/run tracks so procedural can drive
                                                pcall(function() tr:Stop(0) end)
                                        end
                                end
                        end
                end)
        end

        function X.figTrack(dt, fig)
                local root = fig:FindFirstChild("HumanoidRootPart")
                local hum = fig:FindFirstChildOfClass("Humanoid")
                if not root then return end
                local scale = 1
                pcall(function() scale = fig:GetScale() end)
                scale = math.max(scale, 0.01)
                X.FigScale = scale
                local v = root.AssemblyLinearVelocity
                X.FigHv = Vector3.new(v.X, 0, v.Z).Magnitude / scale
                X.FigVy = v.Y / scale
                local onground = false
                pcall(function()
                        if hum then
                                local st = hum:GetState()
                                onground = st == Enum.HumanoidStateType.Running or st == Enum.HumanoidStateType.RunningNoPhysics
                                        or st == Enum.HumanoidStateType.Landed or hum.FloorMaterial ~= Enum.Material.Air
                        end
                end)
                pcall(function()
                        local rp = RaycastParams.new()
                        rp.FilterType = Enum.RaycastFilterType.Exclude
                        local excl = { fig }
                        if LocalPlayer.Character then table.insert(excl, LocalPlayer.Character) end
                        rp.FilterDescendantsInstances = excl
                        local res = Workspace:Raycast(root.Position, Vector3.new(0, -(3.9 * scale + 0.6), 0), rp)
                        if res and math.abs(X.FigVy) < 7 then onground = true end
                end)
                if not X.FigOnGround and onground then
                        X.FigLandAt = os.clock()
                        X.FigLandPow = math.clamp(math.abs(X.FigVy) / 40, 0.2, 1)
                end
                X.FigOnGround = onground
        end

        function X.figPickState()
                if X.Flying then return "Fly" end
                local hv = X.FigHv or 0
                local runAt = tonumber(m.FigRunSpeed) or 18
                if not X.FigOnGround then
                        if (X.FigVy or 0) > 1.2 then return "Jump" end
                        return "Fall"
                end
                if hv > runAt then return "Run" end
                if hv > 1.5 then return "Walk" end
                return "Idle"
        end

        function X.figBuildPose(state, now)
                local A = tonumber(m.FigAnimAmp) or 1
                local P = {
                        lean = 0, roll = 0, yaw = 0, dy = 0, hp = 0, hy = 0,
                        rK = 0.04, lK = 0.04, rA = math.rad(5), lA = math.rad(5),
                        rL = 0, lL = 0, rLA = math.rad(4), lLA = math.rad(4),
                }
                if state == "Idle" then
                        local t = now
                        local br = math.sin(t * 1.8)
                        P.dy = 0.02 * br
                        P.rK = 0.04 + 0.025 * br
                        P.lK = 0.04 + 0.025 * br
                        P.roll = 0.012 * math.sin(t * 0.7)
                elseif state == "Walk" or state == "Run" then
                        local run = state == "Run"
                        local s = math.sin(X.FigTW)
                        local amp = (run and 0.9 or 0.58) * A
                        local armAmp = (run and 0.85 or 0.42) * A
                        local dirS = m.FigFlipArmSwing and -1 or 1
                        P.rL = amp * s
                        P.lL = -amp * s
                        P.rK = 0.04 - dirS * armAmp * s
                        P.lK = 0.04 + dirS * armAmp * s
                        P.rA = math.rad(run and 9 or 5)
                        P.lA = P.rA
                        P.dy = -0.9 * (1 - math.cos(amp * math.abs(s)))
                        P.lean = (run and 0.14 or 0.035)
                        P.yaw = -(run and 0.16 or 0.09) * s * A
                        P.roll = 0.02 * s
                elseif state == "Jump" then
                        P.lean = -0.04
                        P.rK = 0.75
                        P.lK = 0.75
                        P.rA = math.rad(30)
                        P.lA = math.rad(30)
                        P.rL = 0.55
                        P.lL = -0.12
                elseif state == "Fall" then
                        local fl = math.sin(now * 12.5)
                        local fk = math.clamp(-(X.FigVy or 0) / 48, 0.25, 1)
                        P.lean = -0.1
                        P.rK = 1.15 + 0.22 * fl * fk * A
                        P.lK = 1.15 - 0.22 * fl * fk * A
                        P.rA = math.rad(32)
                        P.lA = math.rad(32)
                        P.rL = 0.3 + 0.38 * fl * fk * A
                        P.lL = 0.3 - 0.38 * fl * fk * A
                end
                -- grab pose: reach + arm spin styles when world-holding / parts / NPC follow
                local grabbing = m.FigGrabPose and (m.Parts or m.NPCFollow or m.NPCHatRide or X.Grabbing or X.WorldHold)
                if grabbing and m.GrabAnim ~= false then
                        local reach = 1.25
                        local armOut = math.rad(14)
                        local leanAmt = 0.14
                        local yawExtra = 0.1
                        local rollExtra = 0
                        local lReach = 0.28
                        -- pickup reach animation (first 0.45s)
                        if X.WorldHold and X.WorldHoldGrabT0 then
                                local gt = (now - X.WorldHoldGrabT0) / math.max(m.WorldHoldGrabAnimDur or 0.45, 0.1)
                                if gt < 1 then
                                        local e = ssmooth(math.clamp(gt, 0, 1))
                                        reach = lerpn(0.4, 1.45, e)
                                        armOut = lerpn(math.rad(5), math.rad(22), e)
                                        leanAmt = lerpn(0.02, 0.22, e)
                                end
                        end
                        -- arm spin styles while holding
                        if X.WorldHold and m.WorldHoldArmSpin ~= false then
                                local t = X.WorldHoldSpinT or 0
                                local spd = tonumber(m.WorldHoldSpinSpeed) or 2.8
                                local amp = tonumber(m.WorldHoldSpinAmp) or 0.55
                                local style = math.clamp(math.floor(tonumber(m.WorldHoldSpinStyle) or 2), 1, 5)
                                local peak = m.WorldHoldPeakMode ~= false
                                local ang = t * spd

                                if style == 1 then
                                        -- Sector: simple side swing
                                        local spin = math.sin(ang) * amp
                                        reach = reach + spin * 0.35
                                        armOut = armOut + spin * 0.4
                                        yawExtra = yawExtra + spin * 0.2
                                elseif style == 2 then
                                        -- Peak Windmill: full circular arm + body lean, secondary harmonic
                                        local s1 = math.sin(ang)
                                        local s2 = math.sin(ang * 2 + 0.4)
                                        local c1 = math.cos(ang)
                                        local k = peak and 1.35 or 1.0
                                        reach = 1.05 + (0.55 + amp * 0.5) * (0.5 + 0.5 * s1) * k
                                        armOut = math.rad(8) + (0.55 + amp * 0.45) * c1 * k
                                        leanAmt = leanAmt + (0.12 + amp * 0.18) * s1 * k
                                        yawExtra = yawExtra + 0.22 * s1 * k + 0.08 * s2
                                        rollExtra = 0.1 * c1 * k
                                        lReach = 0.2 + 0.15 * math.abs(s1)
                                        -- punchy "peak" snap near the top of the circle
                                        if peak then
                                                local top = math.max(0, s1)
                                                reach = reach + top * top * 0.25
                                                armOut = armOut - top * 0.12
                                        end
                                elseif style == 3 then
                                        -- Figure-8: smooth infinity path on arm
                                        local s = math.sin(ang)
                                        local s2 = math.sin(ang * 2)
                                        reach = 1.15 + amp * 0.4 * s2
                                        armOut = math.rad(10) + amp * 0.55 * s
                                        leanAmt = leanAmt + 0.1 * s2
                                        yawExtra = yawExtra + 0.18 * s
                                        rollExtra = 0.08 * s2
                                elseif style == 4 then
                                        -- Overhead Slam cycle: lift up, arc over, pull down
                                        local phase = (ang / (math.pi * 2)) % 1
                                        local e
                                        if phase < 0.35 then
                                                e = ssmooth(phase / 0.35)
                                                reach = lerpn(0.9, 1.7, e)
                                                armOut = lerpn(math.rad(20), math.rad(-5), e)
                                                leanAmt = leanAmt + lerpn(0.05, 0.28, e)
                                        elseif phase < 0.55 then
                                                e = ssmooth((phase - 0.35) / 0.2)
                                                reach = lerpn(1.7, 1.35, e)
                                                armOut = lerpn(math.rad(-5), math.rad(35), e)
                                                leanAmt = leanAmt + lerpn(0.28, -0.05, e)
                                        else
                                                e = ssmooth((phase - 0.55) / 0.45)
                                                reach = lerpn(1.35, 0.9, e)
                                                armOut = lerpn(math.rad(35), math.rad(20), e)
                                                leanAmt = leanAmt + lerpn(-0.05, 0.05, e)
                                        end
                                        yawExtra = yawExtra + 0.15 * math.sin(ang)
                                else
                                        -- Helicopter: fast dual-axis spin
                                        local s1 = math.sin(ang * 1.6)
                                        local s2 = math.cos(ang * 2.1)
                                        local k = peak and 1.2 or 1.0
                                        reach = 1.2 + amp * 0.5 * s1 * k
                                        armOut = math.rad(12) + amp * 0.6 * s2 * k
                                        leanAmt = leanAmt + 0.08 * s1
                                        yawExtra = yawExtra + 0.25 * s2 * k
                                        rollExtra = 0.14 * s1 * k
                                        lReach = 0.35 + 0.2 * math.abs(s2)
                                end
                        end
                        P.rK = lerpn(P.rK, reach, 0.9)
                        P.rA = lerpn(P.rA, armOut, 0.75)
                        P.lK = lerpn(P.lK, lReach, 0.5)
                        P.lean = P.lean + leanAmt
                        P.yaw = P.yaw + yawExtra
                        P.roll = (P.roll or 0) + rollExtra
                end
                -- power-up (Goku charge / burst / powered stance)
                if X.powerUpPoseOverlay then
                        local okp, np = false, nil -- power-up REMOVED
                        if okp and np then P = np end
                end
                -- punch / dropkick overlay (takes priority while active)
                if X.combatPoseOverlay then
                        P = P -- combat REMOVED
                end
                -- flying pose (v7)
                if X.pfPoseOverlay then
                        local okf, nf = pcall(X.pfPoseOverlay, P, state, now)
                        if okf and nf then P = nf end
                end
                -- Goku Ki beam / teleport pose (v7)
                if X.kiPoseOverlay then
                        local okk, np2 = false, nil -- ki REMOVED
                        if okk and np2 then P = np2 end
                end
                -- Frying Pan / RPG hold + slam poses
                if X.panRpgPoseOverlay then
                        local okw, nw = false, nil -- pan/rpg REMOVED
                        if okw and nw then P = nw end
                end
                return P
        end

        function X.figFootsteps(dt, fig)
                if m.FigWalkSFX == false or m.WalkSFX == false then return end
                local hv = X.FigHv or 0
                if not X.FigOnGround or hv < 2 then
                        X.FigStepAcc = 6
                        return
                end
                local root = fig:FindFirstChild("HumanoidRootPart")
                local stride = 7.0 - math.clamp(hv / 24 - 1, 0, 1) * 1.6
                X.FigStepAcc = (X.FigStepAcc or stride) + hv * dt
                if X.FigStepAcc >= stride then
                        X.FigStepAcc = X.FigStepAcc - stride
                        X.playWalkSFX(root)
                end
        end

        function X.figAnimate(dt, fig)
                if HX.Settings.NoAnimations ~= false or not m.FigAnim or not fig or not fig.Parent then
                        if X.FigAnimOn then X.figRestore() end
                        return
                end
                X.figTrack(dt, fig)
                local J = X.figGetJoints(fig)
                if not J then
                        -- R15 or non-standard: skip (procedural is R6)
                        return
                end
                local now = os.clock()
                -- manual hard pause (Config > Figure anims > Pause figure anims)
                if m.FigPause then
                        if X.FigAnimOn or X.FigExtActive then
                                X.FigExtActive = false
                                X.FigDanceActive = false
                                for a in pairs(X.FigAnimateOff) do
                                        pcall(function() if a and a.Parent then a.Disabled = false end end)
                                end
                                X.FigAnimateOff = {}
                                X.figRestore()
                        end
                        return
                end
                -- OUTSIDE DRIVER (Uhhhhhh dances write joints directly, not via AnimationTracks)
                if X.FigExtActive then
                        if X.figExtWatch(J, now) then return end
                        X.FigExtActive = false
                        X.FigDanceActive = false
                        X.FigSmooth = nil
                        X.FigOut = {}
                elseif X.FigAnimOn and X.figCheckDriven() then
                        X.figBeginYield()
                        X.figExtWatch(J, now)
                        return
                end
                -- DANCE / EMOTE COMPAT: pause procedural pose so catalog dances & emotes play cleanly
                if m.FigAllowDances ~= false then
                        local dancing = X.figHasUserDance(fig)
                        if dancing then
                                X.FigDanceActive = true
                                X.FigDanceUntil = now + 0.4
                        end
                        if X.FigDanceActive and now < (X.FigDanceUntil or 0) then
                                -- re-enable Animate so dances can drive joints
                                for a in pairs(X.FigAnimateOff) do
                                        pcall(function() if a and a.Parent then a.Disabled = false end end)
                                end
                                X.FigAnimateOff = {}
                                -- stop writing C0 this frame (let the dance track control the rig)
                                X.FigAnimOn = false
                                X.FigSmooth = nil
                                X.FigOut = {}
                                return
                        elseif X.FigDanceActive then
                                X.FigDanceActive = false
                        end
                end
                X.FigAnimOn = true
                X.figKillDefaults(fig)
                local state = X.figPickState()
                X.FigState = state
                local hv = X.FigHv or 0
                local scale = X.FigScale or 1
                if state == "Walk" or state == "Run" then
                        local spd = math.max(hv, 3)
                        local cyc = (state == "Run") and 17 or 13.5
                        X.FigTW = X.FigTW + dt * (spd / cyc) * 2 * PI * (tonumber(m.FigAnimSpeed) or 1)
                end
                local P = X.figBuildPose(state, now)
                -- landing squat
                local landT = now - (X.FigLandAt or -10)
                if landT >= 0 and landT < 0.42 and (state == "Idle" or state == "Walk" or state == "Run") then
                        local landK = ((landT < 0.055) and (landT / 0.055) or (1 - ssmooth((landT - 0.055) / 0.365))) * (X.FigLandPow or 0)
                        P.dy = P.dy - 0.48 * landK
                        P.lean = P.lean + 0.2 * landK
                        P.rL = lerpn(P.rL, 0.55, landK)
                        P.lL = lerpn(P.lL, 0.55, landK)
                end
                local W = {}
                W.Root = CFrame.new(0, P.dy * scale, 0) * Ry(P.yaw) * Rz(P.roll) * Rx(-P.lean)
                W.Neck = Ry(P.hy - P.yaw * 0.55) * Rx(P.hp + P.lean * 0.6)
                W.RS = Rx(P.rK * HALF_PI) * Rz(P.rA)
                W.LS = Rx(P.lK * HALF_PI) * Rz(-P.lA)
                W.RH = Rx(P.rL) * Rz(P.rLA)
                W.LH = Rx(P.lL) * Rz(-P.lLA)
                local S = X.FigSmooth
                if not S then
                        S = {}
                        for _, n in ipairs(FIG_JOINTS) do S[n] = W[n] end
                        X.FigSmooth = S
                end
                local fast = 17
                if X.FigLastState ~= state then
                        X.FigLastState = state
                        X.FigStateBlendUntil = now + 0.25
                end
                if now < (X.FigStateBlendUntil or 0) then fast = math.min(fast, 12) end
                local alpha = math.exp(-fast * math.clamp(dt, 0, 0.1))
                for _, n in ipairs(FIG_JOINTS) do
                        local w = W[n]
                        if not finiteCF(w) then w = IDENT end
                        local prev = S[n]
                        if not (prev and finiteCF(prev)) then prev = w end
                        local sm = w:Lerp(prev, alpha)
                        S[n] = sm
                        X.FigOut[n] = X.figComputeOut(J[n], n, sm, scale)
                end
                X.figApplyOut()
                X.figFootsteps(dt, fig)
        end

        function X.figReapply()
                if not m.FigAnim or not m.FigReapply or not X.FigAnimOn then return end
                -- never force joints while a dance is active
                if X.FigDanceActive and os.clock() < (X.FigDanceUntil or 0) then return end
                X.figApplyOut()
        end

        function X.figStartReapply()
                if X.FigReapplyConn then return end
                X.FigReapplyConn = RunService.Heartbeat:Connect(function()
                        if X.Dead or not m.Enabled then return end
                        pcall(X.figReapply)
                end)
                X.FigSteppedConn = RunService.Stepped:Connect(function()
                        if X.Dead or not m.Enabled then return end
                        pcall(X.figReapply)
                end)
        end

        function X.figStopReapply()
                if X.FigReapplyConn then pcall(function() X.FigReapplyConn:Disconnect() end) X.FigReapplyConn = nil end
                if X.FigSteppedConn then pcall(function() X.FigSteppedConn:Disconnect() end) X.FigSteppedConn = nil end
                -- restore disabled Animate scripts
                for a in pairs(X.FigAnimateOff) do
                        pcall(function() if a and a.Parent then a.Disabled = false end end)
                end
                X.FigAnimateOff = {}
                X.figRestore()
        end

        --------------------------------------------------------------
        -- WORLD HOLD: pick up one NPC / dummy / unanchored part
        -- Arm reach + spin sector on the figure, yeet with mouse / key
        --------------------------------------------------------------
        function X.isPlayerPart(part)
                if not part then return false end
                local model = part:FindFirstAncestorOfClass("Model")
                if model and Players:GetPlayerFromCharacter(model) then return true end
                return false
        end

        function X.resolveHoldPart(part)
                if not part or not part:IsA("BasePart") then return nil end
                if m.WorldHoldPreferRoot ~= false then
                        local model = part:FindFirstAncestorOfClass("Model")
                        if model and model:FindFirstChildOfClass("Humanoid") then
                                local root = model:FindFirstChild("HumanoidRootPart")
                                        or model:FindFirstChild("Torso")
                                        or model:FindFirstChild("UpperTorso")
                                        or model.PrimaryPart
                                if root and root:IsA("BasePart") then return root, model end
                        end
                end
                local root = part
                pcall(function() root = part.AssemblyRootPart or part end)
                return root, part:FindFirstAncestorOfClass("Model")
        end

        function X.worldHoldCanTake(part)
                if not part or not part:IsA("BasePart") or not part.Parent then return false end
                local myChar = X.getMyCharacter()
                if myChar and part:IsDescendantOf(myChar) then return false end
                if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then return false end
                if m.WorldHoldIgnorePlayers ~= false and X.isPlayerPart(part) then return false end
                -- allow NPC roots even if slightly weird; only skip hard-anchored non-NPC when flag on
                local model = part:FindFirstAncestorOfClass("Model")
                local isNpc = model and model:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(model)
                if m.WorldHoldIgnoreAnchored ~= false and part.Anchored and not isNpc then return false end
                for _, h in ipairs(X.hatsSolidHandles(true) or {}) do
                        if part == h then return false end
                end
                if string.sub(part.Name, 1, 3) == "HC_" then return false end
                if m.WorldHoldMaxMass and m.WorldHoldMaxMass > 0 then
                        local mass = 0
                        pcall(function() mass = part.AssemblyMass or part:GetMass() end)
                        if mass > m.WorldHoldMaxMass then return false end
                end
                return true
        end

        function X.findWorldHoldTarget(origin, dir, range)
                range = range or m.WorldHoldRange or 14
                dir = dir.Unit
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                local exclude = {}
                local myChar = X.getMyCharacter()
                if myChar then table.insert(exclude, myChar) end
                if LocalPlayer.Character then table.insert(exclude, LocalPlayer.Character) end
                rp.FilterDescendantsInstances = exclude

                -- 1) primary camera ray
                local candidates = {}
                local res = Workspace:Raycast(origin, dir * range, rp)
                if res and res.Instance and res.Instance:IsA("BasePart") then
                        table.insert(candidates, { part = res.Instance, dist = res.Distance })
                end
                -- 2) Mouse.Target (often works when ray filters oddly)
                pcall(function()
                        local t = Mouse.Target
                        if t and t:IsA("BasePart") then
                                local d = (t.Position - origin).Magnitude
                                if d <= range * 1.25 then
                                        table.insert(candidates, { part = t, dist = d })
                                end
                        end
                end)
                -- 3) sphere near mouse hit / ray end as fallback (fixes "sometimes doesn't grab")
                local hitPos = origin + dir * math.min(range, 12)
                if res then hitPos = res.Position end
                pcall(function()
                        if Mouse.Hit then hitPos = Mouse.Hit.Position end
                end)
                local rad = tonumber(m.WorldHoldFallbackRadius) or 6
                local ok, parts = pcall(function()
                        local op = OverlapParams.new()
                        op.FilterType = Enum.RaycastFilterType.Exclude
                        op.FilterDescendantsInstances = exclude
                        op.MaxParts = 80
                        return Workspace:GetPartBoundsInRadius(hitPos, rad, op)
                end)
                if ok and type(parts) == "table" then
                        for _, p in ipairs(parts) do
                                if p:IsA("BasePart") then
                                        table.insert(candidates, { part = p, dist = (p.Position - origin).Magnitude })
                                end
                        end
                end
                -- score: prefer NPC roots, then closer
                local best, bestScore = nil, -1e9
                local seen = {}
                for _, c in ipairs(candidates) do
                        local holdPart, model = X.resolveHoldPart(c.part)
                        if holdPart and not seen[holdPart] and X.worldHoldCanTake(holdPart) then
                                seen[holdPart] = true
                                local score = -c.dist
                                if model and model:FindFirstChildOfClass("Humanoid") then score = score + 40 end
                                if not holdPart.Anchored then score = score + 10 end
                                if score > bestScore then
                                        bestScore = score
                                        best = { part = holdPart, model = model }
                                end
                        end
                end
                if best then return best.part, best.model end
                return nil
        end

        function X.worldHoldMaxCount()
                local n = math.floor(tonumber(m.WorldHoldMax) or 3)
                return math.clamp(n, 1, 20)
        end

        function X.worldHoldCount()
                local n = 0
                for i = #X.WorldHoldList, 1, -1 do
                        local g = X.WorldHoldList[i]
                        if not g or not g.part or not g.part.Parent then
                                if g then
                                        pcall(function() if g.ap then g.ap:Destroy() end end)
                                        pcall(function() if g.ao then g.ao:Destroy() end end)
                                        pcall(function() if g.att then g.att:Destroy() end end)
                                end
                                table.remove(X.WorldHoldList, i)
                        else
                                n = n + 1
                        end
                end
                return n
        end

        function X.worldHoldReleaseOne(g, silent)
                if not g then return end
                pcall(function() if g.ap then g.ap:Destroy() end end)
                pcall(function() if g.ao then g.ao:Destroy() end end)
                pcall(function() if g.att then g.att:Destroy() end end)
                for i = #X.WorldHoldList, 1, -1 do
                        if X.WorldHoldList[i] == g then table.remove(X.WorldHoldList, i) break end
                end
                if X.WorldHold == g then X.WorldHold = X.WorldHoldList[#X.WorldHoldList] end
                if #X.WorldHoldList == 0 then
                        X.WorldHold = nil
                        X.Grabbing = false
                        X.WorldHoldSpinT = 0
                end
                if not silent then
                        warn("[HatCollision] Released held object (" .. #X.WorldHoldList .. "/" .. X.worldHoldMaxCount() .. ")")
                end
        end

        function X.worldHoldRelease(silent)
                -- release ALL held
                for i = #X.WorldHoldList, 1, -1 do
                        local g = X.WorldHoldList[i]
                        pcall(function() if g.ap then g.ap:Destroy() end end)
                        pcall(function() if g.ao then g.ao:Destroy() end end)
                        pcall(function() if g.att then g.att:Destroy() end end)
                        table.remove(X.WorldHoldList, i)
                end
                X.WorldHold = nil
                X.Grabbing = false
                X.WorldHoldSpinT = 0
                if not silent then
                        warn("[HatCollision] Released all held objects")
                end
                task.defer(function() pcall(X.kiForceParkPresent, "world-hold end") end)
        end

        function X.worldHoldStart(part, model)
                if not part or not part.Parent then return false end
                -- already holding this part?
                for _, g in ipairs(X.WorldHoldList) do
                        if g.part == part then
                                X.worldHoldReleaseOne(g)
                                return false
                        end
                end
                local maxN = X.worldHoldMaxCount()
                while #X.WorldHoldList >= maxN do
                        local oldest = X.WorldHoldList[1]
                        if oldest then X.worldHoldReleaseOne(oldest, true) else break end
                end
                if m.WorldHoldRetryBoost ~= false then
                        pcall(X.boostNetwork)
                end
                -- unanchor + nudge so client can take ownership
                pcall(function()
                        part.Anchored = false
                        local v = part.AssemblyLinearVelocity
                        part.AssemblyLinearVelocity = v + Vector3.new(0, 0.05, 0)
                end)
                if model then
                        for _, p in ipairs(model:GetDescendants()) do
                                if p:IsA("BasePart") then
                                        pcall(function() p.Anchored = false end)
                                end
                        end
                end
                local att = Instance.new("Attachment")
                att.Name = "HC_WorldHoldAtt"
                att.Parent = part
                local ap = Instance.new("AlignPosition")
                ap.Name = "HC_WorldHoldAP"
                ap.Mode = Enum.PositionAlignmentMode.OneAttachment
                ap.Attachment0 = att
                ap.RigidityEnabled = false
                ap.MaxForce = 1e9
                ap.MaxVelocity = m.WorldHoldMaxVel or 220
                ap.Responsiveness = m.WorldHoldResponsiveness or 50
                ap.ApplyAtCenterOfMass = true
                ap.Position = part.Position
                ap.Parent = part
                local ao = Instance.new("AlignOrientation")
                ao.Name = "HC_WorldHoldAO"
                ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
                ao.Attachment0 = att
                ao.RigidityEnabled = false
                ao.MaxTorque = 1e9
                ao.Responsiveness = 35
                ao.CFrame = part.CFrame
                ao.Parent = part
                local entry = {
                        part = part,
                        model = model,
                        att = att,
                        ap = ap,
                        ao = ao,
                        t0 = os.clock(),
                }
                X.WorldHoldList[#X.WorldHoldList + 1] = entry
                X.WorldHold = entry
                X.WorldHoldGrabT0 = os.clock()
                X.WorldHoldSpinT = 0
                X.Grabbing = true
                X.playGrabSFX(part)
                warn("[HatCollision] Grabbed: " .. tostring(part.Name) .. (model and (" (" .. model.Name .. ")") or "")
                        .. " (" .. #X.WorldHoldList .. "/" .. maxN .. ")")
                return true
        end

        function X.stepWorldHold(dt)
                X.worldHoldCount() -- prune dead
                if #X.WorldHoldList == 0 then
                        X.Grabbing = false
                        X.WorldHold = nil
                        return
                end
                X.Grabbing = true
                X.WorldHoldSpinT = (X.WorldHoldSpinT or 0) + (dt or 0.016)
                local fig = X.getMyCharacter()
                local root = fig and X.getRoot(fig)
                local arm = fig and (fig:FindFirstChild("Right Arm") or fig:FindFirstChild("RightHand") or fig:FindFirstChild("RightUpperArm"))
                local cam = Workspace.CurrentCamera
                local lookDir = (cam and cam.CFrame.LookVector) or (root and root.CFrame.LookVector) or Vector3.new(0, 0, -1)
                local dist = tonumber(m.WorldHoldDist) or 3.5
                local n = #X.WorldHoldList
                for i, g in ipairs(X.WorldHoldList) do
                        if not g.part or not g.part.Parent then
                                -- pruned next count
                        else
                                local holdPos
                                local slotAng = (i - 1) / math.max(n, 1) * math.pi * 2
                                local ox, oy, oz = 0, 0.4, 0
                                if arm and arm:IsA("BasePart") then
                                        local hand = arm.Position - arm.CFrame.UpVector * 0.85 + arm.CFrame.LookVector * 0.3
                                        if m.WorldHoldArmSpin ~= false then
                                                local spd = tonumber(m.WorldHoldSpinSpeed) or 2.8
                                                local amp = tonumber(m.WorldHoldSpinAmp) or 0.55
                                                local t = X.WorldHoldSpinT or 0
                                                local ang = t * spd + slotAng
                                                local style = math.clamp(math.floor(tonumber(m.WorldHoldSpinStyle) or 2), 1, 5)
                                                local peak = m.WorldHoldPeakMode ~= false
                                                if style == 1 then
                                                        local spin = math.sin(ang) * amp
                                                        ox, oy = spin * 0.8, 0.4 + math.abs(spin) * 0.3
                                                elseif style == 2 then
                                                        local s1, c1 = math.sin(ang), math.cos(ang)
                                                        local k = peak and 1.25 or 1
                                                        ox = c1 * amp * 1.1 * k
                                                        oy = 0.5 + (0.5 + 0.5 * s1) * amp * 1.2 * k
                                                        oz = s1 * amp * 0.35 * k
                                                elseif style == 3 then
                                                        ox = math.sin(ang) * amp * 0.9
                                                        oy = 0.45 + math.sin(ang * 2) * amp * 0.55
                                                        oz = math.sin(ang * 2) * amp * 0.25
                                                elseif style == 4 then
                                                        local phase = (ang / (math.pi * 2)) % 1
                                                        oy = 0.3 + math.sin(phase * math.pi) * amp * 1.4
                                                        ox = math.sin(phase * math.pi * 2) * amp * 0.4
                                                else
                                                        ox = math.cos(ang * 2.1) * amp * 1.0
                                                        oy = 0.5 + math.sin(ang * 1.6) * amp * 0.7
                                                        oz = math.sin(ang * 2.1) * amp * 0.4
                                                end
                                        else
                                                -- fan multiple holds to the sides
                                                ox = math.sin(slotAng) * (n > 1 and 1.2 or 0)
                                                oz = math.cos(slotAng) * (n > 1 and 0.6 or 0)
                                        end
                                        local right = arm.CFrame.RightVector
                                        local up = arm.CFrame.UpVector
                                        holdPos = hand + lookDir * dist + right * ox + up * oy + lookDir * oz
                                elseif cam then
                                        holdPos = cam.CFrame.Position + lookDir * dist + cam.CFrame.RightVector * math.sin(slotAng) * 1.5
                                elseif root then
                                        holdPos = root.Position + lookDir * dist + Vector3.new(0, 1.5, 0) + root.CFrame.RightVector * math.sin(slotAng) * 1.5
                                else
                                        return
                                end
                                local aim = (Mouse.Hit and Mouse.Hit.Position) or (holdPos + lookDir)
                                local target = CFrame.lookAt(holdPos, aim)
                                pcall(function()
                                        if g.ap then
                                                g.ap.MaxVelocity = m.WorldHoldMaxVel or 220
                                                g.ap.Responsiveness = m.WorldHoldResponsiveness or 50
                                                g.ap.Position = target.Position
                                        end
                                        if g.ao then g.ao.CFrame = target end
                                end)
                        end
                end
        end

        function X.tryWorldHold()
                if m.WorldHold == false then return end
                -- if already at max, release all on toggle; if holding some, try add another
                if m.WorldHoldRetryBoost ~= false then
                        pcall(X.boostNetwork)
                end
                local cam = Workspace.CurrentCamera
                if not cam then return end
                local origin = cam.CFrame.Position
                local myRoot = X.getMyHRP()
                local origins = { origin }
                if myRoot then table.insert(origins, myRoot.Position + Vector3.new(0, 1.5, 0)) end
                local hitPos = (Mouse.Hit and Mouse.Hit.Position) or (origin + cam.CFrame.LookVector * (m.WorldHoldRange or 14))
                local dir = hitPos - origin
                if dir.Magnitude < 0.01 then dir = cam.CFrame.LookVector else dir = dir.Unit end
                local range = m.WorldHoldRange or 14
                local part, model
                for _, o in ipairs(origins) do
                        part, model = X.findWorldHoldTarget(o, dir, range)
                        if part then break end
                        local right = cam.CFrame.RightVector
                        local up = cam.CFrame.UpVector
                        for _, off in ipairs({ right * 0.15, -right * 0.15, up * 0.12, -up * 0.08 }) do
                                local d2 = (dir + off)
                                if d2.Magnitude > 0.01 then
                                        part, model = X.findWorldHoldTarget(o, d2.Unit, range)
                                        if part then break end
                                end
                        end
                        if part then break end
                end
                if part then
                        -- if already holding this one, release just it
                        for _, g in ipairs(X.WorldHoldList) do
                                if g.part == part then
                                        X.worldHoldReleaseOne(g)
                                        return
                                end
                        end
                        X.worldHoldStart(part, model)
                else
                        -- nothing under crosshair: if holding, release all
                        if #X.WorldHoldList > 0 then
                                X.worldHoldRelease()
                        else
                                warn("[HatCollision] Nothing to grab (look closer at an NPC / dummy / loose part)")
                        end
                end
        end

        function X.worldHoldYeet()
                if #X.WorldHoldList == 0 then
                        warn("[HatCollision] Nothing to yeet")
                        return
                end
                local cam = Workspace.CurrentCamera
                local look = cam and cam.CFrame.LookVector or Vector3.new(0, 0, -1)
                local force = tonumber(m.WorldHoldYeetForce) or 130
                local up = tonumber(m.WorldHoldYeetUp) or 45
                local mult = X.powerMult()
                local vel = look * force * mult + Vector3.new(0, up * mult, 0)
                local n = #X.WorldHoldList
                for i = #X.WorldHoldList, 1, -1 do
                        local g = X.WorldHoldList[i]
                        local part, model = g.part, g.model
                        pcall(function() if g.ap then g.ap:Destroy() end end)
                        pcall(function() if g.ao then g.ao:Destroy() end end)
                        pcall(function() if g.att then g.att:Destroy() end end)
                        table.remove(X.WorldHoldList, i)
                        if part and part.Parent then
                                pcall(function() part.Anchored = false end)
                                pcall(function() part.AssemblyLinearVelocity = vel end)
                                if m.WorldHoldYeetSpin ~= false then
                                        local sp = tonumber(m.WorldHoldYeetSpinPower) or 30
                                        pcall(function()
                                                part.AssemblyAngularVelocity = Vector3.new(
                                                        (math.random() - 0.5) * sp * 2,
                                                        (math.random() - 0.5) * sp * 2,
                                                        (math.random() - 0.5) * sp * 2
                                                )
                                        end)
                                end
                                if model then
                                        for _, p in ipairs(model:GetDescendants()) do
                                                if p:IsA("BasePart") and p ~= part then
                                                        pcall(function() p.AssemblyLinearVelocity = vel end)
                                                end
                                        end
                                end
                                X.playYeetSFX(part)
                        end
                end
                X.WorldHold = nil
                X.Grabbing = false
                X.WorldHoldSpinT = 0
                warn("[HatCollision] YEET! (" .. tostring(n) .. ")")
                task.defer(function() pcall(X.kiForceParkPresent, "yeet end") end)
        end

