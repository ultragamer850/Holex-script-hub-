                -- also remove legacy save if present
                pcall(function() if isfile and isfile("Holex Script Hub Ultimate Edition.json") and delfile then delfile("Holex Script Hub Ultimate Edition.json") end end)
                Persist.data = {}
                Notify("Wipe", "Deleted  " .. root .. "  (and legacy save if any).\nRe-execute the hub to recreate empty folders / defaults.", 6)
        end)
