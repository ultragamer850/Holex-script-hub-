        function X.startNPCAura(kind)
                local stateMap = {
                        kill = Enum.HumanoidStateType.Dead,
                        jump = Enum.HumanoidStateType.Jumping,
                        ragdoll = Enum.HumanoidStateType.Physics,
                }
                local state = stateMap[kind] or Enum.HumanoidStateType.Dead
                local function applyAuraAt(pos, rad, st, myChar, isKill)
                        local nbp = Workspace:GetPartBoundsInRadius(pos, rad)
                        for _, part in pairs(nbp) do
                                local model = part:FindFirstAncestorOfClass("Model")
                                if model and X.isNPC(model) then
                                        local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
                                        if hrp and not hrp.Anchored and model ~= LocalPlayer.Character and model ~= myChar then
                                                -- solid hats / FE: try ownership boost so aura still works
                                                local owned = X.partOwner(hrp)
                                                if not owned then
                                                        pcall(function()
                                                                hrp:SetNetworkOwner(LocalPlayer)
                                                        end)
                                                        pcall(function()
                                                                if sethiddenproperty then sethiddenproperty(LocalPlayer, "SimulationRadius", 1e5) end
                                                        end)
                                                        owned = X.partOwner(hrp) or (m.HatsSolid == true)
                                                end
                                                if owned then
                                                        local hum = model:FindFirstChildOfClass("Humanoid")
                                                        if hum then
                                                                pcall(function() hum:ChangeState(st) end)
                                                                if isKill then
                                                                        pcall(function()
                                                                                hum.Health = 0
                                                                                X.combatLockHealth(hum, 0)
                                                                        end)
                                                                end
                                                        end
                                                end
                                        end
                                end
                        end
                end
                local isKill = (kind == "kill")
                local auraLast = 0
                local function stepAura()
                        -- Holex perf patch: spatial queries 10x per second instead of every frame
                        local auraNow = os.clock()
                        if auraNow - auraLast < 0.1 then return end
                        auraLast = auraNow
                        local rad = tonumber(m.NPCAuraRadius) or 13
                        local myChar = X.getMyCharacter()
                        if m.HatAuraUseHats ~= true or m.HatAuraAlsoPlayer ~= false then
                                local hrp1 = X.getMyHRP()
                                if hrp1 then applyAuraAt(hrp1.Position, rad, state, myChar, isKill) end
                        end
                        if m.HatAuraUseHats == true then
                                local handles = X.filterEnabledHandles(X.hatsSolidHandles())
                                for i = 1, #handles do
                                        local h = handles[i]
                                        if h and h.Parent then applyAuraAt(h.Position, rad, state, myChar, isKill) end
                                end
                        end
                end
                if kind == "kill" then
                        if X.NPCAuraConn then pcall(function() X.NPCAuraConn:Disconnect() end) end
                        m.NPCAuraKill = true
                        if m.HatsSolid then m.HatAuraUseHats = true end
                        X.NPCAuraConn = RunService.Stepped:Connect(stepAura)
                elseif kind == "jump" then
                        if X.NPCAuraJumpConn then pcall(function() X.NPCAuraJumpConn:Disconnect() end) end
                        m.NPCAuraJump = true
                        X.NPCAuraJumpConn = RunService.Stepped:Connect(stepAura)
                else
                        if X.NPCAuraRagConn then pcall(function() X.NPCAuraRagConn:Disconnect() end) end
                        m.NPCAuraRagdoll = true
                        X.NPCAuraRagConn = RunService.Stepped:Connect(stepAura)
                end
        end

        -- Primary NPC actions (@im_patrick panel)
        function X.npcRequirePrimary()
                local npc = X.getPrimaryNPC()
                if not npc then
                        warn("[HatCollision] No primary NPC selected (click an owned NPC)")
                        return nil
                end
                local part = X.getRoot(npc)
                if not (part and X.partOwner(part)) then
                        X.npcLight(npc, Color3.fromRGB(255, 0, 0))
                        return nil
                end
                return npc, part
        end

        function X.npcKillPrimary()
                local npc = X.npcRequirePrimary()
                if not npc then return end
                local hum = npc:FindFirstChildOfClass("Humanoid")
                if hum then
                        -- full FE kill: ownership + Health 0 + Dead + lock so others see it and it stays dead
                        X.combatHurtHumanoid(hum, (hum.Health or 100) + 50)
                        pcall(function() hum.Health = 0 end)
                        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
