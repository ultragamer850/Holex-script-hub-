HX.FakeRig = nil
HX.FakeRigConn = nil

function HX.destroyClientFakeRig()
        if HX.FakeRigConn then pcall(function() HX.FakeRigConn:Disconnect() end) HX.FakeRigConn = nil end
        if HX.FakeRig then pcall(function() HX.FakeRig:Destroy() end) HX.FakeRig = nil end
        HX.Settings.ClientFakeRig = false
        HX._figT = 0
end

function HX.createClientFakeRig()
        HX.destroyClientFakeRig()
        local char = LocalPlayer.Character
        if not char then
                if UI and UI.toast then UI.toast("Fake rig", "No character yet", "bad") end
                return nil
        end
        local ok, fake = pcall(function()
                char.Archivable = true
                local f = char:Clone()
                f.Name = LocalPlayer.Name .. "_HolexFake"
                for _, d in ipairs(f:GetDescendants()) do
                        if d:IsA("BasePart") then
                                d.CanCollide = false
                                d.Anchored = false
                                d.Massless = true
                        elseif d:IsA("LocalScript") or d:IsA("Script") then
                                d.Disabled = true
                        end
                end
                f.Parent = Workspace
                return f
        end)
        if not ok or not fake then
                HX.warn("[Holex] Fake rig clone failed: " .. tostring(fake))
                return nil
        end
        HX.FakeRig = fake
        HX.Settings.ClientFakeRig = true
        HX.Settings.Mode = "Custom model name"
        HX.Settings.CustomName = fake.Name
        HX._figT = 0
        -- follow real character root each frame
        HX.FakeRigConn = RunService.RenderStepped:Connect(function()
                if not HX.FakeRig or not HX.FakeRig.Parent then return end
                local real = LocalPlayer.Character
                local rh = real and (real:FindFirstChild("HumanoidRootPart") or real:FindFirstChild("Torso") or real:FindFirstChild("UpperTorso"))
                local fh = HX.FakeRig:FindFirstChild("HumanoidRootPart") or HX.FakeRig:FindFirstChild("Torso") or HX.FakeRig:FindFirstChild("UpperTorso")
                if rh and fh then
                        pcall(function()
                                for _, d in ipairs(HX.FakeRig:GetDescendants()) do
                                        if d:IsA("BasePart") then
                                                local src = real:FindFirstChild(d.Name, true)
                                                if src and src:IsA("BasePart") then
                                                        d.CFrame = src.CFrame
                                                        d.AssemblyLinearVelocity = Vector3.zero
                                                        d.AssemblyAngularVelocity = Vector3.zero
                                                end
                                        end
                                end
                        end)
                end
        end)
        -- point camera at fake humanoid
        pcall(function()
                local hum = fake:FindFirstChildOfClass("Humanoid")
                if hum and Workspace.CurrentCamera then
                        Workspace.CurrentCamera.CameraSubject = hum
                end
        end)
        HX.saveSettings()
        if UI and UI.toast then UI.toast("Fake rig", "Client fake rig ON: " .. fake.Name, "good") end
        if UI and UI.refreshReanimate then UI.refreshReanimate() end
        return fake
end

function HX.toggleClientFakeRig()
        if HX.FakeRig and HX.FakeRig.Parent then
                HX.destroyClientFakeRig()
                if UI and UI.toast then UI.toast("Fake rig", "Client fake rig OFF", "warn") end
                if UI and UI.refreshReanimate then UI.refreshReanimate() end
        else
                HX.createClientFakeRig()
        end
end

