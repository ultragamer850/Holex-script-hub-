                                local b = Button(row, "Info", function() showInfo(ex) end, UDim2.fromOffset(56, 24)); b.Position = UDim2.new(1, -64, 0.5, -12)
                        end
                end
                if n == 0 then H.Line(weaoList, "No executors match this filter.", "sub") end
        end
        function W.refresh(silent)
                W.lastRefresh = os.time()
                task.spawn(function()
                        if not silent then Notify("WEAO", "Fetching executor status...", 2) end
                        local versions = weaoReq("https://weao.xyz/api/versions/current") or weaoReq("https://whatexpsare.online/api/versions/current")
                        local exploits = weaoReq("https://weao.xyz/api/status/exploits") or weaoReq("https://whatexpsare.online/api/status/exploits")
                        if type(versions) == "table" then
                                rbxPara:SetValue(string.format("Windows: %s  (%s)\nMac: %s  (%s)", tostring(versions.Windows or versions.windows or "?"), tostring(versions.WindowsDate or versions.windowsDate or ""), tostring(versions.Mac or versions.mac or "?"), tostring(versions.MacDate or versions.macDate or "")))
                        else
                                rbxPara:SetValue("Could not load versions (the API needs request + a custom User-Agent).\nOpen https://whatexpsare.online/ in a browser.")
                        end
                        local list = {}
                        if type(exploits) == "table" then
                                if exploits[1] then list = exploits else
                                        for _, v in pairs(exploits) do if type(v) == "table" and (v.title or v.name) then list[#list + 1] = v end end
                                end
                        end
                        table.sort(list, function(a, b)
                                local au, bu = a.updateStatus == true, b.updateStatus == true
                                if au ~= bu then return au end
                                return tostring(a.title or ""):lower() < tostring(b.title or ""):lower()
                        end)
                        W.list = list
                        renderWeao()
                        local upN, undN = 0, 0
                        for _, ex in ipairs(list) do
                                if ex.updateStatus == true then upN = upN + 1 end
                                if ex.detected ~= true then undN = undN + 1 end
                        end
                        if #list == 0 then
                                if not silent then Notify("WEAO", "No data - open the site in a browser.", 4) end
                                V.warn("WEAO", "no data from the status api")
                        elseif not silent then
                                Notify("WEAO", string.format("%d executors | %d updated | %d undetected", #list, upN, undN), 4)
                        end
                end)
        end
        Button(wpage, "Refresh executor status", W.refresh)
        Dropdown(wpage, "Show", {"All", "Updated", "Undetected", "Updated + Undetected", "Windows", "Android", "iOS", "Mac"}, "All", function(v) W.filter = v; renderWeao() end)
        weaoList, weaoCard = H.ListCard(wpage, 300)
