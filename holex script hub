function UI.buildConsole()
        local card, info = UI.newCard("Console", "Log")
        info.noSearch = true
        local box = new("ScrollingFrame", { Size = UDim2.new(1, 0, 0, 260), BorderSizePixel = 0, ScrollBarThickness = 3,
                CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y }, card)
        hubBind(box, "BackgroundColor3", "card")
        hubBind(box, "ScrollBarImageColor3", "sub")
        corner(box, 10)
        hstroke(box, "stroke")
        list(box, 1)
        pad(box, 10, 8, 10, 8)
        UI.logBox = box
        local function add(e)
                local l = label(box, "[" .. e.t .. "]  " .. e.msg, 11, COL.muted, Enum.Font.Code, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
                        TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
                local low = string.lower(e.msg)
                if string.find(low, "error", 1, true) or string.find(low, "failed", 1, true) then l.TextColor3 = COL.bad
                elseif string.find(low, "%f[%a]ok%f[%A]") then l.TextColor3 = COL.good end
                local kids = box:GetChildren()
                local n = 0
                for _, k in ipairs(kids) do if k:IsA("TextLabel") then n = n + 1 end end
                if n > 80 then
                        for _, k in ipairs(kids) do if k:IsA("TextLabel") then k:Destroy() break end end
                end
                if UI.open then
                        task.defer(function() pcall(function() box.CanvasPosition = Vector2.new(0, 1e6) end) end)
                end
        end
        UI.onLog = add
        for _, e in ipairs(HX.Log) do add(e) end
        local cp = UI._button(card, "Copy log to clipboard")
        cp.Activated:Connect(function()
                local lines = {}
                for _, e in ipairs(HX.Log) do lines[#lines + 1] = "[" .. e.t .. "] " .. e.msg end
                pcall(function() setclipboard(table.concat(lines, "\n")) end)
                UI.toast("Console", "Copied " .. #lines .. " lines", "good")
        end)
        local cl = UI._button(card, "Clear")
        cl.Activated:Connect(function()
                HX.Log = {}
                for _, k in ipairs(box:GetChildren()) do if k:IsA("TextLabel") then k:Destroy() end end
        end)
end

